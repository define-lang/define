from typing import final

@final
class SourceLocation:
    def __new__(
        cls,
        *,
        line: int,
        column: int,
        end_line: int,
        end_column: int,
        file_path: str | None = None,
    ) -> SourceLocation: ...
    @property
    def line(self) -> int: ...
    @property
    def column(self) -> int: ...
    @property
    def end_line(self) -> int: ...
    @property
    def end_column(self) -> int: ...
    @property
    def file_path(self) -> str | None: ...
    def at(
        self, *, line: int, column: int, end_line: int, end_column: int
    ) -> SourceLocation: ...
    def render(self, source_line: str | None) -> str: ...

@final
class SourceMap:
    def __new__(cls, in_memory_source: str | None = None) -> SourceMap: ...
    # ast-grep-ignore: no-none-return-annotation
    def register_file(self, path: str, source: bytes) -> None: ...
    def render_header_without_position(self, path: str) -> str: ...
    def render_location(self, location: SourceLocation) -> str: ...
