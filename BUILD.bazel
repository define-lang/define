# Root package

load("@bazel_skylib//rules:native_binary.bzl", "native_binary", "native_test")
load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")

exports_files([
    "pyproject.toml",
    ".claude/settings.json",
    ".cursor/cli.json",
])

gazelle_binary(
    name = "gazelle_bin",
    languages = [
        "@gazelle//language/proto",
        "@gazelle//language/go",
    ],
)

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_bin",
)

# --- Lock file management ---

native_binary(
    name = "update_lock",
    src = "//tools:update_lock",
    out = "update_lock_bin",
    data = [
        "pyproject.toml",
        "uv.lock",
        "//compiler:pyproject.toml",
        "//defcl:pyproject.toml",
        "//tools:pyproject.toml",
        "@multitool//tools/uv",
    ],
    args = ["$(location @multitool//tools/uv)"],
    tags = [
        "local",
        "requires-network",
    ],
)

# --- Lock file freshness ---

native_test(
    name = "uv_lock_test",
    src = "//tools:uv_lock_test",
    out = "uv_lock_test_bin",
    data = [
        "pyproject.toml",
        "uv.lock",
        "//compiler:pyproject.toml",
        "//defcl:pyproject.toml",
        "//tools:pyproject.toml",
        "@multitool//tools/uv",
    ],
    args = ["$(location @multitool//tools/uv)"],
    tags = [
        "local",
        "requires-network",
    ],
)
