# Root package

load("@bazel_skylib//rules:native_binary.bzl", "native_binary", "native_test")
load("@gazelle//:def.bzl", "gazelle")

exports_files([
    "pyproject.toml",
    ".claude/settings.json",
    ".cursor/cli.json",
])

