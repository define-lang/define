# Root package

load("@npm//:basedpyright/package_json.bzl", basedpyright_bin = "bin")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")

exports_files([
    "Cargo.toml",
    ".codex/rules/default.rules",
    "pyproject.toml",
    ".claude/settings.json",
    ".cursor/cli.json",
])

exports_files(
    ["dprint.jsonc"],
    visibility = ["//tools/format:__pkg__"],
)

exports_files(
    ["uv.lock"],
    visibility = ["//tools:__pkg__"],
)

exports_files(
    ["sgconfig.yml"],
    visibility = [
        "//checks:__pkg__",
        "//tools/bzl:__pkg__",
    ],
)

# basedpyright has to go here instead of in tools/, because otherwise
# it tries to type check its own code, which is slow.
npm_link_all_packages(name = "node_modules")

basedpyright_bin.basedpyright_binary(
    name = "basedpyright",
    chdir = package_name(),
    visibility = ["//:__subpackages__"],
)

basedpyright_bin.basedpyright_langserver_binary(
    name = "basedpyright-langserver",
    chdir = package_name(),
    visibility = ["//:__subpackages__"],
)

# --- Formatting ---

alias(
    name = "format",
    actual = "//tools/format",
)

# --- Lock file management ---

alias(
    name = "update_lock",
    actual = "//tools:update_lock",
)

check_build_file()
