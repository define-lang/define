load("@rules_py//py:defs.bzl", "py_binary", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_library(
    name = "analyzer",
    srcs = ["analyzer.py"],
    visibility = ["//tools:__pkg__"],
    deps = [
        ":call_counter",
        ":call_tree",
        ":cpu_stacks",
        ":tachyon_profile",
        ":wall_timeline",
        "@pypi//click",
        "@pypi//msgspec",
    ],
)

py_library(
    name = "call_count_target",
    srcs = ["call_count_target.py"],
)

py_library(
    name = "call_counter",
    srcs = ["call_counter.py"],
    data = [":call_count_target"],
    visibility = ["//tools:__pkg__"],
    deps = [
        ":call_tree",
        ":tachyon_profiler",
        "@pypi//msgspec",
    ],
)

py_test(
    name = "call_counter_test",
    size = "small",
    srcs = ["call_counter_test.py"],
    deps = [
        ":call_counter",
    ],
)

py_library(
    name = "call_tree",
    srcs = ["call_tree.py"],
    deps = ["@pypi//msgspec"],
)

py_test(
    name = "call_tree_test",
    size = "small",
    srcs = ["call_tree_test.py"],
    deps = [
        ":call_tree",
        "@pypi//pytest",
    ],
)

py_library(
    name = "cpu_stacks",
    srcs = ["cpu_stacks.py"],
    visibility = ["//tools:__pkg__"],
    deps = [
        ":call_tree",
        "@pypi//msgspec",
    ],
)

py_test(
    name = "cpu_stacks_test",
    size = "small",
    srcs = ["cpu_stacks_test.py"],
    deps = [
        ":call_tree",
        ":cpu_stacks",
        "@pypi//pytest",
    ],
)

py_library(
    name = "perf_access",
    srcs = ["perf_access.py"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//tools:__pkg__"],
)

py_test(
    name = "perf_access_test",
    size = "small",
    srcs = ["perf_access_test.py"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":perf_access",
        "@pypi//pytest",
    ],
)

py_library(
    name = "perf_profiler",
    srcs = ["perf_profiler.py"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//tools:__pkg__"],
    deps = [
        ":cpu_stacks",
        ":perf_access",
        ":python_target",
    ],
)

py_test(
    name = "perf_profiler_test",
    size = "small",
    timeout = "moderate",
    srcs = ["perf_profiler_test.py"],
    deps = [
        ":perf_access",
        ":perf_profiler",
        ":perf_test_support",
        "@pypi//pytest",
    ],
)

py_library(
    name = "perf_test_support",
    testonly = True,
    srcs = ["perf_test_support.py"],
    visibility = ["//tools:__pkg__"],
    deps = [
        ":perf_profiler",
        "@pypi//pytest",
    ],
)

py_library(
    name = "python_target",
    srcs = ["python_target.py"],
    visibility = ["//tools:__pkg__"],
)

py_binary(
    name = "regenerate_test_profiles",
    srcs = ["regenerate_test_profiles.py"],
    data = ["//tools/profiler/testdata:critical_path_target.py"],
    deps = [
        ":tachyon_profile",
        ":tachyon_profiler",
    ],
)

py_library(
    name = "tachyon_profile",
    srcs = ["tachyon_profile.py"],
    visibility = ["//tools:__pkg__"],
    deps = [
        ":call_tree",
        ":wall_model",
        "@pypi//msgspec",
    ],
)

py_library(
    name = "tachyon_profiler",
    srcs = ["tachyon_profiler.py"],
    data = [":tachyon_target"],
    visibility = ["//tools:__pkg__"],
    deps = [":python_target"],
)

py_test(
    name = "tachyon_profiler_test",
    size = "small",
    srcs = ["tachyon_profiler_test.py"],
    args = [
        "-s",
        "-o",
        "faulthandler_timeout=15",
    ],
    data = [
        "//tools:analyze_profile",
        "//tools/profiler/testdata:critical_path_profile.bin",
        "//tools/profiler/testdata:critical_path_target.py",
        "//tools/profiler/testdata:failure_target",
        "//tools/profiler/testdata:failure_target.py",
    ],
    env = {
        "ANALYZER_BINARY": "$(rlocationpath //tools:analyze_profile)",
        "PROFILER_CRITICAL_PATH_PROFILE": "$(rlocationpath //tools/profiler/testdata:critical_path_profile.bin)",
        "PROFILER_CRITICAL_PATH_SOURCE": "$(rlocationpath //tools/profiler/testdata:critical_path_target.py)",
        "PROFILER_FAILURE_BINARY": "$(rlocationpath //tools/profiler/testdata:failure_target)",
        "PROFILER_FAILURE_SOURCE": "$(rlocationpath //tools/profiler/testdata:failure_target.py)",
    },
    deps = [
        ":analyzer",
        ":tachyon_profile",
        ":tachyon_profiler",
        ":wall_timeline",
        "//tools:runfiles",
        "@pypi//click",
        "@pypi//pytest",
    ],
)

py_library(
    name = "tachyon_target",
    srcs = ["tachyon_target.py"],
)

py_library(
    name = "wall_model",
    srcs = ["wall_model.py"],
    visibility = ["//tools:__pkg__"],
    deps = ["@pypi//msgspec"],
)

py_library(
    name = "wall_timeline",
    srcs = ["wall_timeline.py"],
    deps = [
        ":call_tree",
        ":tachyon_profile",
        ":wall_model",
        "@pypi//msgspec",
    ],
)

py_test(
    name = "wall_timeline_test",
    size = "small",
    srcs = ["wall_timeline_test.py"],
    deps = [
        ":call_tree",
        ":tachyon_profile",
        ":wall_model",
        ":wall_timeline",
        "@pypi//msgspec",
        "@pypi//pytest",
    ],
)

pyright_test(
    name = "pyright_test",
    deps = [
        ":analyzer",
        ":call_count_target",
        ":call_counter",
        ":call_counter_test",
        ":call_tree",
        ":call_tree_test",
        ":cpu_stacks",
        ":cpu_stacks_test",
        ":perf_access",
        ":perf_access_test",
        ":perf_profiler",
        ":perf_profiler_test",
        ":perf_test_support",
        ":python_target",
        ":regenerate_test_profiles",
        ":tachyon_profile",
        ":tachyon_profiler",
        ":tachyon_profiler_test",
        ":tachyon_target",
        ":wall_model",
        ":wall_timeline",
        ":wall_timeline_test",
    ],
)

check_build_file()
