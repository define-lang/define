load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("//tools/bzl:format.bzl", "format_test")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

# PRF-020: Machine and human interfaces.
py_binary(
    name = "__main__",
    srcs = ["__main__.py"],
    visibility = ["//tools:__pkg__"],
    deps = [":profiler"],
)

# PRF-010: Raw-data preservation. PRF-018: Focused analysis.
# PRF-019: Concurrency semantics. PRF-020: Machine and human interfaces.
py_library(
    name = "analyzer",
    srcs = ["analyzer.py"],
    visibility = ["//tools:__pkg__"],
    deps = [
        ":schema",
        "@pypi//click",
    ],
)

# PRF-001: No call-correlated wall profiling work.
py_library(
    name = "profiler",
    srcs = ["profiler.py"],
    deps = [
        ":schema",
        "@pypi//click",
    ],
)

# PRF-041: Realistic tests. PRF-043: Analyzer at every checkpoint.
py_test(
    name = "profiler_test",
    size = "small",
    srcs = ["profiler_test.py"],
    data = [
        ":__main__",
        "//tools:analyze_profile",
        "//tools/profiler/testdata:continuous_target",
        "//tools/profiler/testdata:continuous_target.py",
        "//tools/profiler/testdata:failure_target",
        "//tools/profiler/testdata:failure_target.py",
        "//tools/profiler/testdata:race_target",
        "//tools/profiler/testdata:race_target.py",
    ],
    env = {
        "ANALYZER_BINARY": "$(rlocationpath //tools:analyze_profile)",
        "PROFILER_BINARY": "$(rlocationpath :__main__)",
        "PROFILER_CONTINUOUS_SOURCE": "$(rlocationpath //tools/profiler/testdata:continuous_target.py)",
        "PROFILER_FAILURE_SOURCE": "$(rlocationpath //tools/profiler/testdata:failure_target.py)",
        "PROFILER_RACE_SOURCE": "$(rlocationpath //tools/profiler/testdata:race_target.py)",
    },
    # PRF-041: Realistic tests. Remote memory reads cannot cross Bazel's sandbox.
    tags = ["local"],
    deps = [
        ":analyzer",
        ":profiler",
        ":schema",
        "@pypi//click",
        "@rules_python//python/runfiles",
    ],
)

# PRF-010: Raw-data preservation.
py_library(
    name = "schema",
    srcs = ["schema.py"],
    visibility = ["//tools:__pkg__"],
)

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@multitool//tools/ruff",
)

pyright_test(
    name = "pyright_test",
    deps = [
        ":__main__",
        ":analyzer",
        ":profiler",
        ":profiler_test",
        ":schema",
    ],
)
