py_test(
    name = "profiler_test",
    size = "small",
    srcs = ["profiler_test.py"],
    data = [
        ":__main__",
        "//tools:analyze_profile",
        "//tools/profiler/testdata:ambiguous_critical_path_profile.jsonl",
        "//tools/profiler/testdata:continuous_profile.jsonl",
        "//tools/profiler/testdata:continuous_target",
        "//tools/profiler/testdata:continuous_target.py",
        "//tools/profiler/testdata:cpu_target",
        "//tools/profiler/testdata:cpu_target.py",
        "//tools/profiler/testdata:critical_path_profile.jsonl",
        "//tools/profiler/testdata:exit_target",
        "//tools/profiler/testdata:exit_target.py",
        "//tools/profiler/testdata:failure_target",
        "//tools/profiler/testdata:failure_target.py",
        "//tools/profiler/testdata:initial_wait_critical_path_profile.jsonl",
        "//tools/profiler/testdata:interrupt_target",
        "//tools/profiler/testdata:interrupt_target.py",
        "//tools/profiler/testdata:unresolved_critical_path_profile.jsonl",
    ],
    env = {
        "ANALYZER_BINARY": "$(rlocationpath //tools:analyze_profile)",
        "PROFILER_BINARY": "$(rlocationpath :__main__)",
        "PROFILER_AMBIGUOUS_CRITICAL_PATH_PROFILE": "$(rlocationpath //tools/profiler/testdata:ambiguous_critical_path_profile.jsonl)",
        "PROFILER_CONTINUOUS_PROFILE": "$(rlocationpath //tools/profiler/testdata:continuous_profile.jsonl)",
        "PROFILER_CONTINUOUS_SOURCE": "$(rlocationpath //tools/profiler/testdata:continuous_target.py)",
        "PROFILER_CRITICAL_PATH_PROFILE": "$(rlocationpath //tools/profiler/testdata:critical_path_profile.jsonl)",
        "PROFILER_CPU_SOURCE": "$(rlocationpath //tools/profiler/testdata:cpu_target.py)",
        "PROFILER_EXIT_SOURCE": "$(rlocationpath //tools/profiler/testdata:exit_target.py)",
        "PROFILER_FAILURE_SOURCE": "$(rlocationpath //tools/profiler/testdata:failure_target.py)",
        "PROFILER_INITIAL_WAIT_CRITICAL_PATH_PROFILE": "$(rlocationpath //tools/profiler/testdata:initial_wait_critical_path_profile.jsonl)",
        "PROFILER_INTERRUPT_SOURCE": "$(rlocationpath //tools/profiler/testdata:interrupt_target.py)",
        "PROFILER_UNRESOLVED_CRITICAL_PATH_PROFILE": "$(rlocationpath //tools/profiler/testdata:unresolved_critical_path_profile.jsonl)",
    },
    deps = [
        ":analyzer",
        ":analyzer_model",
        ":cpu_analyzer",
        ":profiler",
        ":schema",
        ":wall_analyzer",
        ":wall_critical_path",
        ":wall_model",
        "@pypi//click",
        "@pypi//pytest",
        "@rules_python//python/runfiles",
    ],
)

