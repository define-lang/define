)

py_test(
    name = "fixtures_test",
    srcs = ["fixtures_test.py"],
    data = [
        "testdata/expected_outcomes.txt",
        ":tester",
        "//tools/bazel_mutation_testing/bzl:lint_flags_json",
        "//tools/bazel_mutation_testing/rust:runtime_cargo",
        "@multitool//tools/cargo-mutants",
    ],
    # A py_binary's env applies only under `bazel run`, so the tester gets
    # CARGO, CARGO_MUTANTS and LINT_FLAGS from this test.
    env = {
        "CARGO": "$(rlocationpath //tools/bazel_mutation_testing/rust:runtime_cargo)",
        "CARGO_MUTANTS": "$(rlocationpath @multitool//tools/cargo-mutants)",
        "EXPECTED_OUTCOMES": "$(rlocationpath testdata/expected_outcomes.txt)",
        "LINT_FLAGS": "$(rlocationpath //tools/bazel_mutation_testing/bzl:lint_flags_json)",
        "TESTER": "$(rlocationpath :tester)",
    },
    # The tester runs bazelisk and Git from PATH, and bazelisk keeps its
    # downloads in HOME.
    env_inherit = [
        "HOME",
        "PATH",
    ],
    # It runs Bazel on the workspace, so it runs only through `bazel run`.
    tags = ["manual"],
    deps = [
        ":bazel",
        ":results",
        "//tools:runfiles",
        "@pypi//msgspec",
        "@pypi//pytest",
    ],
)

filegroup(
    name = "lint_examples",
    srcs = glob(["lint_examples/*.rs"]),
)

py_test(
    name = "lint_examples_test",
    size = "small",
    srcs = ["lint_examples_test.py"],
    data = [
        ":lint_examples",
        "//:clippy.toml",
        "//tools/bazel_mutation_testing/bzl:lint_flags_json",
        "@rules_rust//rust/toolchain:current_clippy_files",
        "@rules_rust//rust/toolchain:current_rust_stdlib_files",
        "@rules_rust//rust/toolchain:current_rustc_files",
        "@rules_rust//rust/toolchain:current_rustc_lib_files",
    ],
    env = {
        "CLIPPY_CONFIGURATION": "$(rlocationpath //:clippy.toml)",
        "CLIPPY_DRIVER": "$(rlocationpath @rules_rust//rust/toolchain:current_clippy_files)",
        "LINT_EXAMPLES": "$(rlocationpaths :lint_examples)",
        "RUSTC": "$(rlocationpath @rules_rust//rust/toolchain:current_rustc_files)",
        "LINT_FLAGS": "$(rlocationpath //tools/bazel_mutation_testing/bzl:lint_flags_json)",
    },
    # The Windows VM gets the Linux rustc from the cross build. The lints are
    # the same on every platform, so Linux checks them.
    tags = ["no_windows_vm"],
    deps = [
        ":diagnostics",
        ":lint_flags",
        "//tools:runfiles",
        "@pypi//pytest",
    ],
)

