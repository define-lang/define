load("@rules_py//py:defs.bzl", "py_library")
load("@rules_rust//cargo:cargo_toolchain.bzl", "cargo_toolchain_alias")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_library(
    name = "canary",
    srcs = ["canary.py"],
    visibility = ["//tools/bazel_mutation_testing:__pkg__"],
    deps = [
        ":crates",
        "//tools/bazel_mutation_testing:mutant",
        "@pypi//msgspec",
    ],
)

py_test(
    name = "canary_test",
    size = "small",
    srcs = ["canary_test.py"],
    deps = [
        ":canary",
        ":crates",
        "@pypi//pytest",
    ],
)

py_library(
    name = "crates",
    srcs = ["crates.py"],
    visibility = ["//tools/bazel_mutation_testing:__pkg__"],
    deps = [
        "//tools/bazel_mutation_testing:bazel",
        "@pypi//msgspec",
    ],
)

py_test(
    name = "crates_test",
    size = "small",
    srcs = ["crates_test.py"],
    deps = [
        ":crates",
        "@pypi//pytest",
    ],
)

py_library(
    name = "generator",
    srcs = ["generator.py"],
    visibility = ["//tools/bazel_mutation_testing:__pkg__"],
    deps = [
        ":crates",
        "//tools/bazel_mutation_testing:bazel",
        "//tools/bazel_mutation_testing:mutant",
        "@pypi//msgspec",
    ],
)

py_test(
    name = "generator_test",
    size = "small",
    srcs = ["generator_test.py"],
    data = [
        ":runtime_cargo",
        "@multitool//tools/cargo-mutants",
    ],
    env = {
        "CARGO": "$(rlocationpath :runtime_cargo)",
        "CARGO_MUTANTS": "$(rlocationpath @multitool//tools/cargo-mutants)",
    },
    deps = [
        ":crates",
        ":generator",
        "//tools:runfiles",
    ],
)

# The Cargo toolchain resolves for the build execution platform. cargo-mutants
# needs Cargo for the platform where the tester or test itself runs.
alias(
    name = "runtime_cargo",
    actual = select({
        "@platforms//os:windows": ":windows_cargo",
        "//conditions:default": "@rules_rust//cargo:current_cargo_toolchain",
    }),
    visibility = ["//tools/bazel_mutation_testing:__pkg__"],
)

cargo_toolchain_alias(
    name = "windows_cargo",
    exec_compatible_with = ["@platforms//os:windows"],
    target_compatible_with = ["@platforms//os:windows"],
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    deps = [
        ":canary",
        ":canary_test",
        ":crates",
        ":crates_test",
        ":generator",
        ":generator_test",
    ],
)

check_build_file()
