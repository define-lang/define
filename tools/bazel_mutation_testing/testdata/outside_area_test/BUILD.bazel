load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")
load("//tools/bzl:rust.bzl", "lint_config")

rust_test(
    name = "outside_area_test",
    size = "small",
    srcs = ["outside_area_test.rs"],
    lint_config = lint_config(),
    deps = [
        "//tools/bazel_mutation_testing/testdata/rust/outside_area",
        "@crates//googletest",
    ],
)

py_test(
    name = "python_outside_area_test",
    size = "small",
    srcs = ["python_outside_area_test.py"],
    deps = ["//tools/bazel_mutation_testing/testdata/python/outside_area:lib"],
)

# --- Linting ---

rust_clippy_test(
    name = "clippy_test",
    tags = [
        "clippy",
    ],
    targets = [":outside_area_test"],
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    deps = [":python_outside_area_test"],
)

check_build_file()
