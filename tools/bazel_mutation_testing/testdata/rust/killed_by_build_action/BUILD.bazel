load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:rust.bzl", "binary_rustc_flags", "lint_config")

rust_binary(
    name = "generate_greeting",
    srcs = ["main.rs"],
    lint_config = lint_config(),
    rustc_flags = binary_rustc_flags(),
)

genrule(
    name = "greeting",
    outs = ["greeting.txt"],
    cmd = "$(execpath :generate_greeting) $@",
    tools = [":generate_greeting"],
)

build_test(
    name = "greeting_test",
    targets = [":greeting"],
)

# --- Linting ---

rust_clippy_test(
    name = "clippy_test",
    tags = [
        "clippy",
    ],
    targets = [":generate_greeting"],
)

check_build_file()
