load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_library(
    name = "fake_tools",
    testonly = True,
    srcs = ["fake_tools.py"],
    deps = [
        "@pypi//pytest",
    ],
)

py_test(
    name = "run_python_test",
    size = "small",
    srcs = ["run_python_test.py"],
    data = ["run_python.sh"],
    env = {"RUN_PYTHON": "$(rlocationpath run_python.sh)"},
    deps = [
        ":fake_tools",
        "//tools:runfiles",
        "@pypi//pytest",
    ],
)

py_binary(
    name = "shell_command_checks",
    srcs = ["shell_command_checks.py"],
)

py_test(
    name = "shell_command_checks_test",
    size = "small",
    srcs = ["shell_command_checks_test.py"],
    data = [
        "run_python.sh",
        "shell_command_checks.sh",
    ],
    env = {
        "PREFILTER": "$(rlocationpath shell_command_checks.sh)",
        "RUN_PYTHON": "$(rlocationpath run_python.sh)",
    },
    deps = [
        ":fake_tools",
        ":shell_command_checks",
        "//tools:runfiles",
        "@pypi//pytest",
    ],
)

py_binary(
    name = "turn_end_checks",
    srcs = ["turn_end_checks.py"],
)

py_test(
    name = "turn_end_checks_test",
    size = "small",
    srcs = ["turn_end_checks_test.py"],
    deps = [
        ":fake_tools",
        ":turn_end_checks",
        "@pypi//pytest",
    ],
)

pyright_test(
    name = "pyright_test",
    deps = [
        ":fake_tools",
        ":run_python_test",
        ":shell_command_checks",
        ":shell_command_checks_test",
        ":turn_end_checks",
        ":turn_end_checks_test",
    ],
)

check_build_file()
