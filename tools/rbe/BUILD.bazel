load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")

go_binary(
    name = "rbe",
    embed = [":rbe_lib"],
    visibility = ["//tools/rbe/deploy:__pkg__"],
)

go_library(
    name = "rbe_lib",
    srcs = [
        "main.go",
        "main_unix.go",
        "main_windows.go",
    ],
    importpath = "github.com/define-lang/define/tools/rbe",
    deps = [
        "//tools/rbe/cas",
        "//tools/rbe/execution",
        "//tools/rbe/service",
        "@org_golang_google_grpc//:grpc",
    ] + select({
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows/svc",
            "@org_golang_x_sys//windows/svc/eventlog",
        ],
        "//conditions:default": [],
    }),
)

check_build_file()
