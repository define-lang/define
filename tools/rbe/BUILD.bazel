    name = "rbe",
    embed = [":rbe_lib"],
)

go_library(
    name = "rbe_lib",
    srcs = ["main.go"],
    importpath = "github.com/define-lang/define/tools/rbe",
    deps = [
        "//tools/rbe/cas",
        "//tools/rbe/execution",
        "//tools/rbe/service",
        "@org_golang_google_grpc//:grpc",
    ],
