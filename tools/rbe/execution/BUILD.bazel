load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")

go_library(
    name = "execution",
    srcs = [
        "execution.go",
        "process_unix.go",
        "process_windows.go",
    ],
    importpath = "github.com/define-lang/define/tools/rbe/execution",
    visibility = ["//tools/rbe:__subpackages__"],
    deps = [
        "//tools/rbe/cas",
        "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:execution",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ] + select({
        "@rules_go//go/platform:windows": ["@org_golang_x_sys//windows"],
        "//conditions:default": [],
    }),
)

go_test(
    name = "execution_test",
    size = "small",
    srcs = [
        "execution_test.go",
        "execution_unix_test.go",
        "execution_windows_test.go",
    ],
    embed = [":execution"],
    deps = [
        "//tools/rbe/cas",
        "//tools/rbe/testprogram",
        "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:execution",
        "@org_golang_google_protobuf//types/known/durationpb",
    ],
)

check_build_file()
