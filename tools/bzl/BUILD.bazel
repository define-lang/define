load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@protobuf//bazel/toolchains:proto_lang_toolchain.bzl", "proto_lang_toolchain")
load("@rules_rust//extensions/pyo3:defs.bzl", "rust_pyo3_toolchain")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load(":build_file_checks_test.bzl", "build_file_checks_test_suite")

bzl_library(
    name = "ast_grep",
    srcs = ["ast_grep.bzl"],
    deps = [":lint_batches"],
)

bzl_library(
    name = "build_file_checks",
    srcs = ["build_file_checks.bzl"],
    visibility = ["//visibility:public"],
)

build_file_checks_test_suite(name = "build_file_checks_test")

config_setting(
    name = "coverage_enabled",
    values = {"collect_code_coverage": "true"},
    visibility = ["//visibility:public"],
)

alias(
    name = "coverage_pytest_dependency",
    actual = select({
        ":coverage_enabled": "@pypi//coverage",
        "//conditions:default": "@pypi//pytest",
    }),
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "lint_batches",
    srcs = ["lint_batches.bzl"],
)

bzl_library(
    name = "linters",
    srcs = ["linters.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":ast_grep",
        ":ruff",
    ],
)

alias(
    name = "loop_coverage_pytest_dependency",
    actual = select({
        ":coverage_enabled": "//tools:loop_coverage",
        "//conditions:default": "@pypi//pytest",
    }),
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "package_checks",
    srcs = ["package_checks.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "py_test",
    srcs = ["py_test.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "pyo3",
    srcs = ["pyo3.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "pyright",
    srcs = ["pyright.bzl"],
    visibility = ["//visibility:public"],
)

exports_files([
    "pyright_test_runner.py",
])

proto_lang_toolchain(
    name = "python_toolchain",
    command_line = "--python_out=%s",
    progress_message = "Generating Python proto_library %{label}",
    runtime = "@protobuf//:protobuf_python",
    toolchain_type = "@protobuf//bazel/private:python_toolchain_type",
)

bzl_library(
    name = "ruff",
    srcs = ["ruff.bzl"],
    deps = [":lint_batches"],
)

alias(
    name = "rust_coverage_collector",
    actual = select({
        ":coverage_enabled": "//tools/rust_coverage:collect_rust_coverage",
        "//conditions:default": "//:pyproject.toml",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "rust_coverage_llvm_cov",
    actual = select({
        ":coverage_enabled": "@llvm//tools:llvm-cov",
        "//conditions:default": "//:pyproject.toml",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "rust_coverage_llvm_profdata",
    actual = select({
        ":coverage_enabled": "@llvm//tools:llvm-profdata",
        "//conditions:default": "//:pyproject.toml",
    }),
    visibility = ["//visibility:public"],
)

rust_pyo3_toolchain(
    name = "rust_pyo3",
    pyo3 = "@crates//:pyo3",
    pyo3_introspection = "@crates//:pyo3-introspection",
)

toolchain(
    name = "rust_pyo3_toolchain",
    toolchain = ":rust_pyo3",
    toolchain_type = "@rules_rust//extensions/pyo3:rust_toolchain_type",
)

bzl_library(
    name = "validate_proposals",
    srcs = ["validate_proposals.bzl"],
    visibility = ["//visibility:public"],
)

check_build_file()
