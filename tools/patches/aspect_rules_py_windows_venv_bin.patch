diff --git a/py/private/py_venv/toolchains_resolver.bzl b/py/private/py_venv/toolchains_resolver.bzl
index 89d8f367..54dc6289 100644
--- a/py/private/py_venv/toolchains_resolver.bzl
+++ b/py/private/py_venv/toolchains_resolver.bzl
@@ -132,6 +132,52 @@ def _bin_python_target_path(ctx, py_toolchain, package_depth):
         to_rlocation_path(ctx, py_toolchain.python),
     )
 
+def _interpreter_dir_dlls(py_toolchain):
+    """The runtime's ``python*.dll`` and ``vcruntime*.dll`` beside its interpreter.
+
+    The last resort for toolchains that have neither rules_py's ``venv_dlls`` nor
+    rules_python 2.0's ``venv_bin_files``, such as rules_python before 2.0. It
+    flattens all of the runtime's files, which ``venv_dlls`` exists to avoid.
+    Matches the ``venv_dlls`` glob in the interpreter repositories rules_py
+    generates, case-insensitively as ``python -m venv --symlinks`` does.
+    """
+    interpreter_dir = py_toolchain.python.dirname
+    dlls = []
+    for f in py_toolchain.files.to_list():
+        if (f.dirname == interpreter_dir and
+            f.extension.lower() == "dll" and
+            f.basename.lower().startswith(("python", "vcruntime"))):
+            dlls.append(f)
+    return sorted(dlls, key = lambda f: f.basename)
+
+def _windows_bin_links(ctx, py_toolchain, package_depth):
+    """Extra ``bin/`` symlinks that Windows needs to find and start the venv's interpreter.
+
+    Windows finds only ``python.exe`` on ``PATH``, and loads a program's DLLs from
+    the directory it was started from, so ``bin/`` gets both.
+
+    Returns:
+      dict of ``bin/``-relative name to symlink ``target_path``.
+    """
+    links = {"python.exe": "python"}
+    dlls = py_toolchain.venv_dlls
+
+    # Toolchains not generated by rules_py don't provide `venv_dlls`.
+    # rules_python 2.0+ runtimes declare the same DLLs as `venv_bin_files`
+    # (`*.dll` beside the interpreter), and link all of them into their own
+    # venvs. Older runtimes declare nothing, so as a last resort find the DLLs
+    # among the runtime's files, which flattens the whole runtime.
+    if dlls == None:
+        dlls = getattr(py_toolchain.toolchain, "venv_bin_files", None)
+        if not dlls:
+            dlls = _interpreter_dir_dlls(py_toolchain)
+    for dll in dlls:
+        links[dll.basename] = "{}/{}".format(
+            _relative_up(3 + package_depth),
+            to_rlocation_path(ctx, dll),
+        )
+    return links
+
 def resolve_venv_toolchain(ctx, *, py_toolchain, is_windows, venv_name):
     """Compute toolchain-derived paths and flags for venv assembly.
 
