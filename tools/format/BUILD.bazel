load("@rules_go//go:def.bzl", "go_binary", "go_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")

go_binary(
    name = "format",
    srcs = ["main.go"],
    data = [
        "@dprint_plugin_markdown//file",
        "@dprint_plugin_oxc//file",
        "@dprint_plugin_sh//file",
        "@dprint_plugin_toml//file",
        "@dprint_plugin_yaml//file",
        "@multitool//tools/buf",
        "@multitool//tools/buildifier",
        "@multitool//tools/dprint",
        "@multitool//tools/gofumpt",
        "@multitool//tools/ruff",
        "@rules_rust//rust/toolchain:current_rustfmt_toolchain",
    ],
    visibility = ["//:__pkg__"],
    x_defs = {
        "bufRlocationPath": "$(rlocationpath @multitool//tools/buf)",
        "buildifierRlocationPath": "$(rlocationpath @multitool//tools/buildifier)",
        "dprintMarkdownPluginRlocationPath": "$(rlocationpath @dprint_plugin_markdown//file)",
        "dprintOxcPluginRlocationPath": "$(rlocationpath @dprint_plugin_oxc//file)",
        "dprintShellPluginRlocationPath": "$(rlocationpath @dprint_plugin_sh//file)",
        "dprintTOMLPluginRlocationPath": "$(rlocationpath @dprint_plugin_toml//file)",
        "dprintYAMLPluginRlocationPath": "$(rlocationpath @dprint_plugin_yaml//file)",
        "dprintRlocationPath": "$(rlocationpath @multitool//tools/dprint)",
        "gofumptRlocationPath": "$(rlocationpath @multitool//tools/gofumpt)",
        "ruffRlocationPath": "$(rlocationpath @multitool//tools/ruff)",
        "rustfmtRlocationPath": "$(rlocationpath @rules_rust//rust/toolchain:current_rustfmt_toolchain)",
    },
    deps = ["@rules_go//go/runfiles"],
)

go_test(
    name = "format_test",
    size = "small",
    srcs = ["main_test.go"],
    data = [
        ":format",
        "//:dprint.jsonc",
    ],
    x_defs = {
        "dprintConfigRlocationPath": "$(rlocationpath //:dprint.jsonc)",
        "formatRlocationPath": "$(rlocationpath :format)",
    },
    deps = ["@rules_go//go/runfiles"],
)

check_build_file()
