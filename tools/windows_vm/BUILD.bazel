load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_binary(
    name = "bazel_tools_override",
    srcs = ["bazel_tools_override.py"],
    deps = ["@pypi//click"],
)

py_test(
    name = "bazel_tools_override_test",
    size = "small",
    srcs = ["bazel_tools_override_test.py"],
    deps = [
        ":bazel_tools_override",
    ],
)

py_binary(
    name = "create_windows_vm",
    srcs = ["create_windows_vm.py"],
    data = [
        "autounattend.xml",
        "extend_evaluation.ps1",
        "first_logon.ps1",
    ],
    env = {
        "AUTOUNATTEND": "$(rlocationpath autounattend.xml)",
        "EXTEND_EVALUATION": "$(rlocationpath extend_evaluation.ps1)",
        "FIRST_LOGON": "$(rlocationpath first_logon.ps1)",
    },
    deps = [
        ":vm",
        "//tools:runfiles",
        "@pypi//click",
    ],
)

py_test(
    name = "create_windows_vm_test",
    size = "small",
    srcs = ["create_windows_vm_test.py"],
    data = ["autounattend.xml"],
    env = {"AUTOUNATTEND": "$(rlocationpath autounattend.xml)"},
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":create_windows_vm",
        "//tools:runfiles",
        "@pypi//click",
        "@pypi//pytest",
    ],
)

py_binary(
    name = "deploy_rbe",
    srcs = ["deploy_rbe.py"],
    data = ["install_rbe.ps1"],
    env = {"INSTALL_RBE": "$(rlocationpath install_rbe.ps1)"},
    deps = [
        ":vm",
        "//tools:runfiles",
        "@pypi//click",
    ],
)

py_test(
    name = "deploy_rbe_test",
    size = "small",
    srcs = ["deploy_rbe_test.py"],
    deps = [
        ":deploy_rbe",
    ],
)

py_binary(
    name = "hermetic_launcher_override",
    srcs = ["hermetic_launcher_override.py"],
    deps = [
        ":bazel_tools_override",
        "@pypi//click",
    ],
)

py_test(
    name = "hermetic_launcher_override_test",
    size = "small",
    srcs = ["hermetic_launcher_override_test.py"],
    deps = [
        ":hermetic_launcher_override",
    ],
)

py_binary(
    name = "sync_windows_vm",
    srcs = ["sync_windows_vm.py"],
    deps = [
        ":vm",
        "@pypi//click",
    ],
)

py_test(
    name = "sync_windows_vm_test",
    size = "small",
    srcs = ["sync_windows_vm_test.py"],
    deps = [":sync_windows_vm"],
)

py_library(
    name = "vm",
    srcs = ["vm.py"],
    deps = ["@pypi//click"],
)

pyright_test(
    name = "pyright_test",
    deps = [
        ":bazel_tools_override",
        ":bazel_tools_override_test",
        ":create_windows_vm",
        ":create_windows_vm_test",
        ":deploy_rbe",
        ":deploy_rbe_test",
        ":hermetic_launcher_override",
        ":hermetic_launcher_override_test",
        ":sync_windows_vm",
        ":sync_windows_vm_test",
        ":vm",
    ],
)

check_build_file()
