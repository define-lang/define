load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@aspect_rules_lint//format:defs.bzl", "format_multirun")
load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary", "native_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//tools:prettier/package_json.bzl", prettier_bin = "bin")
load("//tools/bzl:format.bzl", "format_test")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

npm_link_all_packages()

py_binary(
    name = "analyze_profile",
    srcs = ["analyze_profile.py"],
)

py_binary(
    name = "check_python_deps",
    srcs = ["check_python_deps.py"],
)

py_test(
    name = "check_python_deps_test",
    size = "small",
    srcs = ["check_python_deps_test.py"],
    deps = [
        ":check_python_deps",
        "@pypi//pytest",
    ],
)

py_binary(
    name = "compile_jinja_templates",
    srcs = ["compile_jinja_templates.py"],
    visibility = ["//visibility:public"],
    deps = ["//define/compiler/codegen/literal/python:template_env"],
)

py_binary(
    name = "generate_lark_standalone",
    srcs = ["generate_lark_standalone.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//lark",
        "@pypi//regex",  # keep
    ],
)

py_binary(
    name = "git_commit_via_api",
    srcs = ["git_commit_via_api.py"],
    deps = [
        "@pypi//click",
        "@pypi//pygithub",
    ],
)

py_binary(
    name = "generate_programming_languages",
    srcs = ["generate_programming_languages.py"],
    deps = ["@pypi//pyyaml"],
)

py_binary(
    name = "j2lint_runner",
    srcs = ["j2lint_runner.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//j2lint"],
)

py_binary(
    name = "regenerate_codegen_testdata",
    srcs = ["regenerate_codegen_testdata.py"],
    deps = [
        "//define/compiler:driver",
        "//define/compiler/codegen:generated_program_runner",
        "//define/runtime:literal",  # keep
        "//define/runtime:tracing",  # keep
    ],
)

prettier_bin.prettier_binary(
    name = "prettier",
    env = {
        "BAZEL_BINDIR": ".",
    },
    visibility = ["//:__subpackages__"],
)

py_binary(
    name = "run_profile",
    srcs = ["run_profile.py"],
    deps = [
        "//define/compiler:driver",
        "//define/compiler/validator/reference_graph:reference_graph_validator",
        "//define/compiler/validator/structural:program_validator",
    ],
)

py_binary(
    name = "setup_local_dev",
    srcs = ["setup_local_dev.py"],
    args = ["$(location @multitool//tools/uv)"],
    data = ["@multitool//tools/uv"],
)

py_binary(
    name = "sync_agent_permissions",
    srcs = ["sync_agent_permissions.py"],
)

py_binary(
    name = "update_toolchains",
    srcs = ["update_toolchains.py"],
    deps = ["@pypi//requests"],
)

js_binary(
    name = "validate_mermaid",
    data = [":node_modules/@a24z/mermaid-parser"],
    entry_point = "validate_mermaid.mjs",
    env = {
        "BAZEL_BINDIR": ".",
    },
    visibility = ["//:__subpackages__"],
)

js_test(
    name = "validate_mermaid_test",
    size = "small",
    data = [":node_modules/@a24z/mermaid-parser"],
    entry_point = "validate_mermaid_test.mjs",
)

native_test(
    name = "sync_agent_permissions_test",
    size = "small",
    src = ":sync_agent_permissions",
    out = "sync_agent_permissions_test_runner",
    args = ["--check"],
    data = [
        "//:.claude/settings.json",
        "//:.codex/rules/default.rules",
        "//:.cursor/cli.json",
    ],
)

native_binary(
    name = "basedpyright_langserver_sh",
    src = "basedpyright-langserver.sh",
    data = ["//:basedpyright-langserver"],
)

native_binary(
    name = "update_lock",
    src = "update_lock.sh",
    out = "update_lock_runner",
    visibility = ["//:__pkg__"],
)

native_binary(
    name = "uv_lock_test",
    src = "uv_lock_test.sh",
    out = "uv_lock_test_runner",
    visibility = ["//:__pkg__"],
)

py_binary(
    name = "validate_proposals",
    srcs = ["validate_proposals.py"],
    visibility = [
        "//defcl/proposals:__pkg__",
        "//define/proposals:__pkg__",
    ],
)

# --- Format checking ---

format_multirun(
    name = "format",
    javascript = ":prettier",
    javascript_check_args = [
        "--check",
        "--log-level=warn",
    ],
    javascript_fix_args = [
        "--write",
        "--log-level=warn",
    ],
    markdown = ":prettier",
    markdown_check_args = [
        "--check",
        "--log-level=warn",
    ],
    markdown_fix_args = [
        "--write",
        "--log-level=warn",
    ],
    protocol_buffer = "@multitool//tools/buf",
    python = "@multitool//tools/ruff",
    starlark = "@multitool//tools/buildifier",
    starlark_check_args = [
        "-mode=check",
        "-lint=warn",
    ],
    starlark_fix_args = [
        "-mode=fix",
        "-lint=fix",
    ],
    yaml = ":prettier",
    yaml_check_args = [
        "--check",
        "--log-level=warn",
    ],
    yaml_fix_args = [
        "--write",
        "--log-level=warn",
    ],
)

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@multitool//tools/ruff",
)

# --- Type-checking ---

# IMPORTANT: When adding a new py_library, py_binary, or py_test target to this
# package or any of its sub-packages, you must also add it to the deps list below.
pyright_test(
    name = "pyright_test",
    tags = ["include-subpackages"],
    deps = [
        ":analyze_profile",
        ":check_python_deps",
        ":check_python_deps_test",
        ":compile_jinja_templates",
        ":generate_lark_standalone",
        ":generate_programming_languages",
        ":git_commit_via_api",
        ":j2lint_runner",
        ":regenerate_codegen_testdata",
        ":run_profile",
        ":setup_local_dev",
        ":sync_agent_permissions",
        ":update_toolchains",
        ":validate_proposals",
        "//tools/generators:generate_action_graph_source",
        "//tools/generators:generate_action_graph_source_test",
        "//tools/generators:generate_large_define_source",
        "//tools/generators:generate_large_define_source_test",
        "//tools/generators:generate_operation_graph_source",
        "//tools/generators:generate_operation_graph_source_test",
        "//tools/generators:generate_reference_graph_project",
        "//tools/generators:generate_reference_graph_project_test",
    ],
)
