# PRF-012: Orchestration boundary. PRF-014: CPU mode.
# PRF-041: Realistic tests. PRF-043: Analyzer at every checkpoint.
py_test(
    name = "run_profile_test",
    size = "small",
    timeout = "moderate",
    srcs = ["run_profile_test.py"],
    data = [
        "//define/compiler:main",
        "//tools:analyze_profile",
        "//tools/profiler:__main__",
    ],
    env = {
        "ANALYZER_BINARY": "$(rlocationpath //tools:analyze_profile)",
        "COMPILER_BINARY": "$(rlocationpath //define/compiler:main)",
    },
    # PRF-041: Realistic tests. Remote memory reads cannot cross Bazel's sandbox.
    tags = ["local"],
    deps = [
        ":profile_orchestration",
        ":runfiles",
        "//tools/profiler:analyzer",
        "//tools/profiler:perf_analyzer",
        "//tools/profiler:perf_test_support",
        "//tools/profiler:schema",
        "@pypi//click",
        "@pypi//pytest",
        "@rules_python//python/runfiles",
    ],
)

