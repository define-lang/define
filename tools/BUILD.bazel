# --- Format checking ---

format_multirun(
    name = "format",
    javascript = ":prettier",
    javascript_check_args = [
        "--check",
        "--log-level=warn",
    ],
    javascript_fix_args = [
        "--write",
        "--log-level=warn",
    ],
    markdown = ":prettier",
    markdown_check_args = [
        "--check",
        "--log-level=warn",
    ],
    markdown_fix_args = [
        "--write",
        "--log-level=warn",
    ],
    protocol_buffer = "@multitool//tools/buf",
    python = "@multitool//tools/ruff",
    starlark = "@multitool//tools/buildifier",
    starlark_check_args = [
        "-mode=check",
        "-lint=warn",
    ],
    starlark_fix_args = [
        "-mode=fix",
        "-lint=fix",
    ],
    yaml = ":prettier",
    yaml_check_args = [
        "--check",
        "--log-level=warn",
    ],
    yaml_fix_args = [
        "--write",
        "--log-level=warn",
    ],
)

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@multitool//tools/ruff",
)

