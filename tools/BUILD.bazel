load("@aspect_rules_lint//format:defs.bzl", "format_test")
load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library", "py_test")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("//tools/lint:pyright.bzl", "pyright_test")

exports_files(["pyproject.toml"])

native_binary(
    name = "uv_lock_test",
    src = "uv_lock_test.sh",
    out = "uv_lock_test_runner",
    visibility = ["//:__pkg__"],
)

native_binary(
    name = "update_lock",
    src = "update_lock.sh",
    out = "update_lock_runner",
    visibility = ["//:__pkg__"],
)

py_library(
    name = "run_ci_checks_lib",
    srcs = ["run_ci_checks.py"],
    imports = ["."],
    deps = ["@pypi//requests"],
)

py_binary(
    name = "run_ci_checks",
    srcs = ["run_ci_checks.py"],
    imports = ["."],
    deps = ["@pypi//requests"],
)

py_test(
    name = "run_ci_checks_test",
    srcs = ["run_ci_checks_test.py"],
    pytest_main = True,
    deps = [
        ":run_ci_checks_lib",
        "@pypi//pytest",
        "@pypi//requests",
    ],
)

py_binary(
    name = "generate_programming_languages",
    srcs = ["generate_programming_languages.py"],
    deps = ["@pypi//pyyaml"],
)

py_binary(
    name = "validate_proposals",
    srcs = ["validate_proposals.py"],
    visibility = [
        "//defcl/proposals:__pkg__",
        "//proposals:__pkg__",
    ],
)

py_binary(
    name = "sync_cursor_permissions",
    srcs = ["sync_cursor_permissions.py"],
)

py_test(
    name = "sync_cursor_permissions_test",
    srcs = ["sync_cursor_permissions.py"],
    args = ["--check"],
    data = [
        "//:.claude/settings.json",
        "//:.cursor/cli.json",
    ],
    main = "sync_cursor_permissions.py",
)

# --- Format checking ---

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@aspect_rules_lint//format:ruff",
)

# --- Type-checking ---

# IMPORTANT: When adding a new py_library, py_binary, or py_test target to this
# package or any of its sub-packages, you must also add it to the deps list below.
pyright_test(
    name = "pyright_test",
    pyproject = "//tools:pyproject.toml",
    deps = [
        ":generate_programming_languages",
        ":run_ci_checks",
        ":run_ci_checks_test",
        ":sync_cursor_permissions",
        ":sync_cursor_permissions_test",
        ":validate_proposals",
    ],
)
