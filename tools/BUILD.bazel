load("@aspect_rules_lint//format:defs.bzl", "format_multirun")
load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary", "native_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//tools:prettier/package_json.bzl", prettier_bin = "bin")
load("//tools/lint:format.bzl", "format_test")
load("//tools/lint:pyright.bzl", "pyright_test")

npm_link_all_packages()

exports_files(["pyproject.toml"])

py_binary(
    name = "generate_lark_standalone",
    srcs = ["generate_lark_standalone.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//lark",
        "@pypi//regex",
    ],
)

py_binary(
    name = "generate_programming_languages",
    srcs = ["generate_programming_languages.py"],
    deps = ["@pypi//pyyaml"],
)

prettier_bin.prettier_binary(
    name = "prettier",
    env = {
        "BAZEL_BINDIR": ".",
    },
    visibility = ["//:__subpackages__"],
)

py_binary(
    name = "sync_agent_permissions",
    srcs = ["sync_agent_permissions.py"],
)

py_binary(
    name = "update_toolchains",
    srcs = ["update_toolchains.py"],
    deps = ["@pypi//requests"],
)

native_test(
    name = "sync_agent_permissions_test",
    size = "small",
    src = ":sync_agent_permissions",
    out = "sync_agent_permissions_test_runner",
    args = ["--check"],
    data = [
        "//:.claude/settings.json",
        "//:.codex/rules/default.rules",
        "//:.cursor/cli.json",
    ],
)

native_binary(
    name = "update_lock",
    src = "update_lock.sh",
    out = "update_lock_runner",
    visibility = ["//:__pkg__"],
)

native_binary(
    name = "uv_lock_test",
    src = "uv_lock_test.sh",
    out = "uv_lock_test_runner",
    visibility = ["//:__pkg__"],
)

py_binary(
    name = "validate_proposals",
    srcs = ["validate_proposals.py"],
    visibility = [
        "//defcl/proposals:__pkg__",
        "//define/proposals:__pkg__",
    ],
)

# --- Format checking ---

format_multirun(
    name = "format",
    javascript = ":prettier",
    javascript_check_args = [
        "--check",
        "--log-level=warn",
    ],
    javascript_fix_args = [
        "--write",
        "--log-level=warn",
    ],
    markdown = ":prettier",
    markdown_check_args = [
        "--check",
        "--log-level=warn",
    ],
    markdown_fix_args = [
        "--write",
        "--log-level=warn",
    ],
    protocol_buffer = "@multitool//tools/buf",
    python = "@multitool//tools/ruff",
    starlark = "@multitool//tools/buildifier",
    starlark_check_args = [
        "-mode=check",
        "-lint=warn",
    ],
    starlark_fix_args = [
        "-mode=fix",
        "-lint=fix",
    ],
    yaml = ":prettier",
    yaml_check_args = [
        "--check",
        "--log-level=warn",
    ],
    yaml_fix_args = [
        "--write",
        "--log-level=warn",
    ],
)

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@multitool//tools/ruff",
)

# --- Type-checking ---

# IMPORTANT: When adding a new py_library, py_binary, or py_test target to this
# package or any of its sub-packages, you must also add it to the deps list below.
pyright_test(
    name = "pyright_test",
    pyproject = "//tools:pyproject.toml",
    deps = [
        ":generate_lark_standalone",
        ":generate_programming_languages",
        ":sync_agent_permissions",
        ":update_toolchains",
        ":validate_proposals",
    ],
)
