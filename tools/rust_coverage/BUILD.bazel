load("@crates//:defs.bzl", "lint_config")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")

rust_binary(
    name = "collect_rust_coverage",
    srcs = ["collect_rust_coverage.rs"],
    lint_config = lint_config(),
    visibility = [
        "//tools/bzl:__pkg__",
        "@rules_rust//rust/coverage:__pkg__",
    ],
    deps = ["@crates//:serde_json"],
)

# --- Linting ---

rust_clippy_test(
    name = "clippy_test",
    size = "small",
    tags = [
        "clippy",
        "precommit",
    ],
    targets = [":collect_rust_coverage"],
)

check_build_file()
