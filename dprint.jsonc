{
  "lineWidth": 80,
  "markdown": {
    "textWrap": "always",
    "wrapCodeSpans": false,
    "codeBlock.preserveIndentation": true,
    "codeBlock.preserveBlankLines": true,
  },
  // The oxc plugin would otherwise also format the files the other plugins
  // format.
  "oxc": {
    "associations": [
      "**/*.json",
      "**/*.json5",
      "**/*.jsonc",
      "!**/*.toml",
      "!**/*.yaml",
      "!**/*.yml",
    ],
  },
  // //:format downloads these plugins through Bazel, which requires the sha256
  // after each URL.
  "plugins": [
    // renovate: depName=dprint/dprint-plugin-markdown
    "https://plugins.dprint.dev/markdown-0.29.0.wasm@714aea7555dd9831861be466da8b26b2d92316d3cde550ef3e1f63b31f4ea302",
    // renovate: depName=dprint/dprint-plugin-oxc
    "https://plugins.dprint.dev/oxc-0.49.1.wasm@3e57b8336212859784b0b5bc9fc828be1f0daa24cf6fa690b97bfdf7a3aeaee7",
    // renovate: depName=kachick/dprint-plugin-sh
    "https://plugins.dprint.dev/kachick/sh-0.2.5.wasm@8c1ba49d3b88c8a502074211b0ceb456e45a6efbb62417465ac1fbab6ac78160",
    // renovate: depName=dprint/dprint-plugin-toml
    "https://plugins.dprint.dev/toml-0.10.0.wasm@0a8af7f5fe70c7ec652d77198867b2a97a1e690d5f3697542c603610aa47d3b3",
    // renovate: depName=g-plane/pretty_yaml
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm@40a2fdda7040317eb1b23520f3a00769a5571eedb049c4ca9175c1b9eeba01ae",
  ],
}
