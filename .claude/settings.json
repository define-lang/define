{
  "permissions": {
    "allow": [
      "Read(~/.cache/bazel/**)",
      "WebSearch",
      "WebFetch(domain:registry.bazel.build)",
      "WebFetch(domain:buf.build)",
      "WebFetch(domain:rules-python.readthedocs.io)",
      "WebFetch(domain:bazel.build)",
      "WebFetch(domain:releases.bazel.build)",
      "WebFetch(domain:blog.aspect.build)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:blog.bazel.build)",
      "Bash(find * -exec cat *)",
      "Bash(echo *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(printf *)",
      "Bash(xxd *)",
      "Bash(go get *)",
      "Bash(go mod tidy *)",
      "Bash(git add *)",
      "Bash(git mv *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git worktree add *)",
      "Bash(gh api repos/*/releases *)",
      "Bash(gh api repos/*/contents/*)",
      "Bash(gh issue view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh search *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(uv add *)",
      "Bash(uv sync *)",
      "Bash(uv help *)",
      "Bash(uv lock *)",
      "Bash(uv --help *)",
      "Bash(source .venv/bin/activate)",
      "Bash(prettier *)",
      "Bash(npx @bufbuild/buf format *)",
      "Bash(npx @bufbuild/buf lint *)",
      "Bash(npx @bazel/buildifier *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(uv run python -c *)",
      "Bash(uv run python3 -c *)",
      "Bash(uv run python - *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run tools/check_python_deps.py *)",
      "Bash(uv run tools/sync_agent_permissions.py)",
      "Bash(uv run tools/setup_local_dev.py)",
      "Bash(uv run tools/run_profile.py *)",
      "Bash(uv run mutmut *)",
      "Bash(uv run py-spy *)",
      "Bash(bazelisk *)",
      "Bash(bazel *)"
    ],
    "deny": [
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(pipx *)",
      "Bash(python -m pip *)",
      "Bash(uv run pip *)",
      "Bash(uv run pip3 *)",
      "Bash(uv run pipx *)",
      "Bash(uv run python -m pip *)",
      "Bash(uv run python -m pip3 *)",
      "Bash(uv run python -m pipx *)"
    ],
    "ask": [
      "Bash(git checkout*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git reset)"
    ]
  },
  "enabledPlugins": {
    "bazel-basedpyright-lsp@define-plugins": false
  },
  "extraKnownMarketplaces": {
    "define-plugins": {
      "source": {
        "source": "directory",
        "path": "./claude-plugins"
      }
    }
  }
}
