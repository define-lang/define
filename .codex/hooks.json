{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hooks=\"$(git rev-parse --show-toplevel)/tools/agent_hooks\"; \"$hooks/run_python.sh\" \"$hooks/turn_end_checks.py\"",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/agent_hooks/shell_command_checks.sh\"",
            "timeout": 180
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hooks=\"$(git rev-parse --show-toplevel)/tools/agent_hooks\"; \"$hooks/run_python.sh\" \"$hooks/turn_end_checks.py\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
