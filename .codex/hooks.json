{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/tools/agent_hooks/turn_end_checks.py\"",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tools/agent_hooks/shell_command_checks.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
