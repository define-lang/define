{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  automerge: false,
  postUpdateOptions: ["gomodTidy"],
  lockFileMaintenance: {
    enabled: true,
  },
  "pre-commit": {
    enabled: true,
  },
  customDatasources: {
    // Unicode has no release API; this ReadMe names the latest final version,
    // unlike the version listing, which also has drafts.
    unicode: {
      defaultRegistryUrlTemplate: "https://www.unicode.org/Public/UCD/latest/ucd/ReadMe.txt",
      format: "plain",
      transformTemplates: [
        '{"releases": [{"version": $match($join(releases.version, " "), /final data files for version (\\d+\\.\\d+\\.\\d+)/).groups[0]}]}',
      ],
    },
  },
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^tools/generate_invisible_characters\\.py$/"],
      matchStrings: [
        'UNICODE_VERSION = "(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
        "unicode\\.org/Public/(?<currentValue>\\d+\\.\\d+\\.\\d+)/",
      ],
      depNameTemplate: "unicode",
      datasourceTemplate: "custom.unicode",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)MODULE\\.bazel$/"],
      matchStrings: [
        'interpreters\\.configure\\(releases = \\["(?<currentValue>\\d{8})"\\]\\)',
      ],
      depNameTemplate: "astral-sh/python-build-standalone",
      datasourceTemplate: "github-releases",
      versioningTemplate: "regex:^(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^Cargo\\.toml$/", "/^MODULE\\.bazel$/"],
      matchStrings: [
        'rust-version\\s*=\\s*"(?<currentValue>\\d+\\.\\d+)"',
        'rust_toolchains\\.toolchain\\([\\s\\S]*?version\\s*=\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
      ],
      depNameTemplate: "rust",
      datasourceTemplate: "rust-version",
      versioningTemplate: "rust-release-channel",
    },
  ],
  packageRules: [
    {
      matchManagers: ["bazel-module"],
      groupName: "bazel modules",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    {
      matchManagers: ["github-actions"],
      matchFileNames: ["vendored/**"],
      enabled: false,
    },
    {
      matchManagers: ["pre-commit"],
      groupName: "pre-commit hooks",
    },
    {
      matchManagers: ["gomod"],
      groupName: "go dependencies",
    },
    {
      matchManagers: ["pep621"],
      groupName: "python dependencies",
    },
    {
      matchManagers: ["rust-toolchain", "custom.regex"],
      matchDepNames: ["rust"],
      groupName: "Rust toolchain",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      matchManagers: ["pep621"],
      commitMessageTopic: "Python lock file (uv.lock)",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      matchManagers: ["gomod"],
      commitMessageTopic: "Go lock file (go.sum)",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      matchManagers: ["npm"],
      commitMessageTopic: "pnpm lock file (pnpm-lock.yaml)",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      matchManagers: ["pre-commit"],
      commitMessageTopic: "pre-commit lock file",
    },
  ],
  ignorePaths: ["experimental/**"],
}
