{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  automerge: false,
  postUpdateOptions: ["gomodTidy"],
  lockFileMaintenance: {
    enabled: true,
  },
  "pre-commit": {
    enabled: true,
  },
  customDatasources: {
    // Unicode has no release API; this ReadMe names the latest final version,
    // unlike the version listing, which also has drafts.
    unicode: {
      defaultRegistryUrlTemplate: "https://www.unicode.org/Public/UCD/latest/ucd/ReadMe.txt",
      format: "plain",
      transformTemplates: [
        '{"releases": [{"version": $match($join(releases.version, " "), /final data files for version (\\d+\\.\\d+\\.\\d+)/).groups[0]}]}',
      ],
    },
    // rules_nodejs can only download the Node.js versions it has hashes for,
    // so its node_versions.bzl lists the versions we can use. Each version is
    // a dictionary key on a line of its own.
    rules_nodejs: {
      format: "plain",
      transformTemplates: [
        '{"releases": releases[$contains(version, /^"\\d+\\.\\d+\\.\\d+": \\{$/)].{"version": $substringBefore($substring(version, 1), "\\"")}}',
      ],
    },
  },
  customManagers: [
    {
      // The github-actions manager reads only literal runs-on values, not the
      // runners of a matrix.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/ci\\.yaml$/"],
      matchStrings: ["- (?<depName>ubuntu|macos)-(?<currentValue>[\\d.]+)"],
      datasourceTemplate: "github-runners",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^tools/generate_invisible_characters\\.py$/"],
      matchStrings: [
        'UNICODE_VERSION = "(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
        "unicode\\.org/Public/(?<currentValue>\\d+\\.\\d+\\.\\d+)/",
      ],
      depNameTemplate: "unicode",
      datasourceTemplate: "custom.unicode",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)MODULE\\.bazel$/"],
      matchStrings: [
        'interpreters\\.configure\\(releases = \\["(?<currentValue>\\d{8})"\\]\\)',
      ],
      depNameTemplate: "astral-sh/python-build-standalone",
      datasourceTemplate: "github-releases",
      versioningTemplate: "regex:^(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^Cargo\\.toml$/", "/^MODULE\\.bazel$/"],
      matchStrings: [
        'rust-version\\s*=\\s*"(?<currentValue>\\d+\\.\\d+)"',
        'rust_toolchains\\.toolchain\\([\\s\\S]*?version\\s*=\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
      ],
      depNameTemplate: "rust",
      datasourceTemplate: "rust-version",
      versioningTemplate: "rust-release-channel",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^MODULE\\.bazel$/"],
      matchStrings: [
        'go_sdk\\.download\\(version = "(?<currentValue>[^"]+)"\\)',
      ],
      depNameTemplate: "go",
      datasourceTemplate: "golang-version",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^MODULE\\.bazel$/"],
      matchStrings: [
        'buf\\.toolchains\\(\\s*sha256 = "(?<currentDigest>[0-9a-f]{64})",\\s*version = "(?<currentValue>[^"]+)",\\s*\\)',
      ],
      depNameTemplate: "bufbuild/buf",
      datasourceTemplate: "github-release-attachments",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^MODULE\\.bazel$/"],
      matchStringsStrategy: "combination",
      matchStrings: [
        'bazel_dep\\(name = "rules_nodejs", version = "(?<rulesNodejsVersion>[^"]+)"\\)',
        'node\\.toolchain\\(node_version = "(?<currentValue>[^"]+)"\\)',
      ],
      depNameTemplate: "node",
      datasourceTemplate: "custom.rules_nodejs",
      registryUrlTemplate: "https://raw.githubusercontent.com/bazel-contrib/rules_nodejs/v{{{rulesNodejsVersion}}}/nodejs/private/node_versions.bzl",
      // Only LTS versions are stable in node versioning.
      versioningTemplate: "node",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^tools/multitool\\.lock\\.json$/"],
      matchStrings: [
        '"url": "https://github\\.com/(?<depName>[^/"]+/[^/"]+)/releases/download/(?<currentValue>[^/"]+)/[^"]+",(?:\\s*"file": "[^"]*",)?\\s*"sha256": "(?<currentDigest>[0-9a-f]{64})"',
      ],
      datasourceTemplate: "github-release-attachments",
      // Some asset names drop the "v" of their release tag, so replace the
      // version without it everywhere in the match.
      autoReplaceStringTemplate: "{{{replace currentDigest newDigest (replace (replace '\\.' '\\.' (replace '^v' '' currentValue)) (replace '^v' '' newValue) replaceString)}}}",
    },
  ],
  packageRules: [
    {
      matchManagers: ["bazel-module"],
      groupName: "bazel modules",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    {
      matchManagers: ["github-actions"],
      matchDepTypes: ["action", "workflow"],
      // Matches action-release-cooldown in .github/jactionlint.yaml.
      minimumReleaseAge: "2 days",
    },
    {
      // The runners of the test matrix come from a custom manager.
      matchDatasources: ["github-runners"],
      groupName: "github actions",
    },
    {
      matchManagers: ["github-actions"],
      matchFileNames: ["vendored/**"],
      enabled: false,
    },
    {
      matchManagers: ["pre-commit"],
      groupName: "pre-commit hooks",
    },
    {
      matchManagers: ["gomod"],
      groupName: "go dependencies",
    },
    {
      // MODULE.bazel and go.mod name the same Go version.
      matchDatasources: ["golang-version"],
      groupName: "Go SDK",
      rangeStrategy: "bump",
    },
    {
      matchManagers: ["pep621"],
      groupName: "python dependencies",
    },
    {
      matchManagers: ["rust-toolchain", "custom.regex"],
      matchDepNames: ["rust"],
      groupName: "Rust toolchain",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      matchManagers: ["pep621"],
      commitMessageTopic: "Python lock file (uv.lock)",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      matchManagers: ["gomod"],
      commitMessageTopic: "Go lock file (go.sum)",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      matchManagers: ["npm"],
      commitMessageTopic: "pnpm lock file (pnpm-lock.yaml)",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      matchManagers: ["pre-commit"],
      commitMessageTopic: "pre-commit lock file",
    },
  ],
  ignorePaths: ["experimental/**"],
}
