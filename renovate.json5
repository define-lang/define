{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  automerge: false,
  postUpdateOptions: ["gomodTidy"],
  lockFileMaintenance: {
    enabled: true,
  },
  "pre-commit": {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: ["bazel-module"],
      groupName: "bazel modules",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    {
      matchManagers: ["pre-commit"],
      groupName: "pre-commit hooks",
    },
    {
      matchManagers: ["gomod"],
      groupName: "go dependencies",
    },
    {
      matchManagers: ["pep621"],
      groupName: "python dependencies",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      matchManagers: ["pep621"],
      commitMessageTopic: "Python lock file (uv.lock)",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      matchManagers: ["gomod"],
      commitMessageTopic: "Go lock file (go.sum)",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      matchManagers: ["npm"],
      commitMessageTopic: "pnpm lock file (pnpm-lock.yaml)",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      matchManagers: ["pre-commit"],
      commitMessageTopic: "pre-commit lock file",
    },
  ],
  ignorePaths: ["experimental/**"],
}
