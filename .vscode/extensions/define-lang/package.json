{
  "name": "define-lang",
  "displayName": "Define Language",
  "version": "0.0.1",
  "description": "Minimal highlighting for Define",
  "contributes": {
    "languages": [
      {
        "id": "define",
        "aliases": [
          "Define",
          "define"
        ],
        "extensions": [
          ".define",
          ".dfn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "define",
        "scopeName": "source.define",
        "path": "./syntaxes/define.tmLanguage.json"
      }
    ]
  },
  "engines": {
    "vscode": "^1.0.0"
  }
}
