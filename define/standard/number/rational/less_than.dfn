define the operation<standard:/number/rational/less_than> {
    define the view<a> {
        it is read.
        it may only contain particles where {
            it has the value</number/rational>.
        }
    }
    define the view<b> {
        it is read.
        it may only contain particles where {
            it has the value</number/rational>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value</boolean>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
