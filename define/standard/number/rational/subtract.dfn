define the operation<standard:/number/rational/subtract> {
    define the view<from> {
        it is read.
        it may only contain particles where {
            it has the value</number/rational>.
        }
    }
    define the view<take_away> {
        it is read.
        it may only contain particles where {
            it has the value</number/rational>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value</number/rational>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
