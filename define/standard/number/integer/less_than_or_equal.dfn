define the operation<standard:/number/integer/less_than_or_equal> {
    define the view<a> {
        it is read.
        it may only contain particles where {
            it has the value</number/integer>.
        }
    }
    define the view<b> {
        it is read.
        it may only contain particles where {
            it has the value</number/integer>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value</boolean>.
        }
    }

    it does {
        # a is at most b if b is not less than a.
        define the view<greater> {
            it may only contain particles where {
                it has the value</boolean>.
            }
        }
        execute the logical_operation</number/less_than> {
            with view<a> looking at view<b>.
            with view<b> looking at view<a>.
            with view<result> looking at view<greater>.
        }
        execute the logical_operation</boolean/not> {
            with view<a> looking at view<greater>.
            with view<result> looking at view<result>.
        }
    }
}
