define the operation<standard:/number/integer/less_than_or_equal> {
    define the view<a> {
        it is read.
        it may only contain particles where {
            it has the value</number/integer>.
        }
    }
    define the view<b> {
        it is read.
        it may only contain particles where {
            it has the value</number/integer>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value</boolean>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
