define the operation<standard:/number/integer/multiply> {
    define the view<a> {
        it is read.
        it may only contain particles where {
            it has the value</number/integer>.
        }
    }
    define the view<b> {
        it is read.
        it may only contain particles where {
            it has the value</number/integer>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value</number/integer>.
        }
    }

    it does {
        execute the logical_operation</number/multiply> {
            with view<a> looking at view<a>.
            with view<b> looking at view<b>.
            with view<result> looking at view<result>.
        }
    }
}
