define the encoding_operation<standard:/number/integer/ascii/increment> {
    define the view<value> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the encoding</number/integer/ascii>.
        }
    }

    it does {
        define the view<sum> {
            it may only contain particles where {
                it has the encoding</number/integer/ascii>.
            }
        }
        execute the encoding_operation</number/integer/ascii/add> {
            with view<a> looking at view<value>.
            with view<b> looking at literal</number>"1".
            with view<result> looking at view<sum>.
        }
        set the value of view<value> from view<sum>.
    }
}
