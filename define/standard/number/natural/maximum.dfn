define the operation<standard:/number/natural/maximum> {
    define the view<a> {
        it is read.
        it may only contain particles where {
            it has the value</number/natural>.
        }
    }
    define the view<b> {
        it is read.
        it may only contain particles where {
            it has the value</number/natural>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value</number/natural>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
