define the operation<standard:/number/natural/maximum> {
    define the view<a> {
        it is read.
        it may only contain particles where {
            it has the value</number/natural>.
        }
    }
    define the view<b> {
        it is read.
        it may only contain particles where {
            it has the value</number/natural>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value</number/natural>.
        }
    }

    it does {
        # The maximum of a and b is their sum minus their minimum.
        define the view<sum> {
            it may only contain particles where {
                it has the value</number/natural>.
            }
        }
        execute the logical_operation</number/add> {
            with view<a> looking at view<a>.
            with view<b> looking at view<b>.
            with view<result> looking at view<sum>.
        }
        define the view<smaller> {
            it may only contain particles where {
                it has the value</number/natural>.
            }
        }
        execute the logical_operation</number/minimum> {
            with view<a> looking at view<a>.
            with view<b> looking at view<b>.
            with view<result> looking at view<smaller>.
        }
        execute the operation</number/natural/subtract_saturating> {
            with view<a> looking at view<sum>.
            with view<b> looking at view<smaller>.
            with view<result> looking at view<result>.
        }
    }
}
