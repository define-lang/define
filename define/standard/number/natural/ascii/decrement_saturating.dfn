define the encoding_operation<standard:/number/natural/ascii/decrement_saturating> {
    define the view<value> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the encoding</number/natural/ascii>.
        }
    }

    it does {
        define the view<difference> {
            it may only contain particles where {
                it has the encoding</number/natural/ascii>.
            }
        }
        execute the encoding_operation</number/natural/ascii/subtract_saturating> {
            with view<a> looking at view<value>.
            with view<b> looking at literal</number>"1".
            with view<result> looking at view<difference>.
        }
        set the value of view<value> from view<difference>.
    }
}
