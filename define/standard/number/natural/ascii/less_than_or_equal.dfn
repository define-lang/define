define the encoding_operation<standard:/number/natural/ascii/less_than_or_equal> {
    define the view<a> {
        it is read.
        it may only contain particles where {
            it has the encoding</number/natural/ascii>.
        }
    }
    define the view<b> {
        it is read.
        it may only contain particles where {
            it has the encoding</number/natural/ascii>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the encoding</boolean/ascii>.
        }
    }

    it does {
        define the view<greater> {
            it may only contain particles where {
                it has the encoding</boolean/ascii>.
            }
        }
        execute the encoding_operation</number/natural/ascii/less_than> {
            with view<a> looking at view<b>.
            with view<b> looking at view<a>.
            with view<result> looking at view<greater>.
        }
        execute the encoding_operation</boolean/ascii/not> {
            with view<a> looking at view<greater>.
            with view<result> looking at view<result>.
        }
    }
}
