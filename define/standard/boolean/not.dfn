define the logical_operation<standard:/boolean/not> {
    define the view<a> {
        it is read.
    }
    define the view<result> {
        it is written.
    }
}
define the operation<standard:/boolean/not> {
    define the view<a> {
        it is read.
        it may only contain particles where {
            it has the value</boolean>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value</boolean>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
