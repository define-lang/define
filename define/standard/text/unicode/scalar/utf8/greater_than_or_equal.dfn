define the encoding_operation<standard:/text/unicode/scalar/utf8/greater_than_or_equal> {
    define the view<a> {
        it is read.
        it may only contain particles where {
            it has the encoding</text/unicode/scalar/utf8>.
        }
    }
    define the view<b> {
        it is read.
        it may only contain particles where {
            it has the encoding</text/unicode/scalar/utf8>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the encoding</boolean/ascii>.
        }
    }

    it does {
        define the view<less> {
            it may only contain particles where {
                it has the encoding</boolean/ascii>.
            }
        }
        execute the encoding_operation</text/unicode/scalar/utf8/less_than> {
            with view<a> looking at view<a>.
            with view<b> looking at view<b>.
            with view<result> looking at view<less>.
        }
        execute the encoding_operation</boolean/ascii/not> {
            with view<a> looking at view<less>.
            with view<result> looking at view<result>.
        }
    }
}
