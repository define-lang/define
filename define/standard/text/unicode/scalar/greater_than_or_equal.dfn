define the operation<standard:/text/unicode/scalar/greater_than_or_equal> {
    define the view<a> {
        it is read.
        it may only contain particles where {
            it has the value</text/unicode/scalar>.
        }
    }
    define the view<b> {
        it is read.
        it may only contain particles where {
            it has the value</text/unicode/scalar>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value</boolean>.
        }
    }

    it does {
        # a is at least b if a is not less than b.
        define the view<less> {
            it may only contain particles where {
                it has the value</boolean>.
            }
        }
        execute the logical_operation</text/less_than> {
            with view<a> looking at view<a>.
            with view<b> looking at view<b>.
            with view<result> looking at view<less>.
        }
        execute the logical_operation</boolean/not> {
            with view<a> looking at view<less>.
            with view<result> looking at view<result>.
        }
    }
}
