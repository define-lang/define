# TODO: No DLP defines this logical operation. It exists only so that
# text values have a logical operation to support, and needs to be fixed
# later.
define the logical_operation<standard:/text/equality> {
    define the view<a> {
        it is read.
    }
    define the view<b> {
        it is read.
    }
    define the view<result> {
        it is written.
    }
}
