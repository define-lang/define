load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:validate_proposals.bzl", "validate_proposals_test")

filegroup(
    name = "proposals",
    srcs = glob(["0*.md"]),
)

validate_proposals_test(
    name = "validate_proposals_test",
    size = "small",
    proposals = ":proposals",
    tags = ["precommit"],
)

check_build_file()
