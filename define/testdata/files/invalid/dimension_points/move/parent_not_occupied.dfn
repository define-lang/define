define the potential action<mv:define-lang.org:test_files:/invalid/dimension_points/move/parent_not_occupied> {
    define the position<run>.
    it happens when {
        the position<run> has a dimension point.
    } and it does {
        define the position<local> {
            it may only contain dimension points where {
                it has the position</valid/minimal_position>.
            }
        }
        define the position<src>.
        create a dimension point in position<src>.
        move the dimension point in position<src> to position<local>::position</valid/minimal_position>.
    }
}
