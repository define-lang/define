define the potential action<mv:define-lang.org:test_files:/invalid/dimension_points/move/from_empty_position> {
    define the position<run>.
    it happens when {
        the position<run> has a dimension point.
    } and it does {
        define the position<from_pos>.
        define the position<to_pos>.
        move the dimension point in position<from_pos> to position<to_pos>.
    }
}
