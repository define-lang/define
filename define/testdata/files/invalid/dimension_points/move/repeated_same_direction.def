define the potential action<mv:define-lang.org:test_files:/invalid/dimension_points/move/repeated_same_direction> {
    define the position<run>.
    it happens when {
        the position<run> has a dimension point.
    } and it does {
        define the position<pos_a>.
        define the position<pos_b>.
        create a dimension point in position<pos_a>.
        move the dimension point in position<pos_a> to position<pos_b>.
        move the dimension point in position<pos_a> to position<pos_b>.
    }
}
