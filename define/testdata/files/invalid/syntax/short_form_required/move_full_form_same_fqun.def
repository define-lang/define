define the potential action<mv:define-lang.org:test_files:/invalid/syntax/short_form_required/move_full_form_same_fqun> {
    define the position<from_pos>.
    define the position<gateway> {
        it may only contain dimension points where {
            it has the position<mv:define-lang.org:test_files:/child>.
        }
    }
    it happens when {
        the position<from_pos> has a dimension point.
