define the potential position<mv:define-lang.org:test_files:/valid/action_move_particle_chain>.
define the potential action<mv:define-lang.org:test_files:/valid/action_move_particle_chain> {
    define the position<run>.
    define the position<src> {
        it may only contain particles where {
            it has the position</valid/action_move_particle_chain>.
        }
    }
    define the position<dest>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<src>.
        move the particle in position<src>::position</valid/action_move_particle_chain> to position<dest>.
    }
}
