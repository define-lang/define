define the potential position<mv:define-lang.org:test_files:/valid/action_local_pos_requires_global>.
define the potential action<mv:define-lang.org:test_files:/valid/action_local_pos_requires_global> {
    define the position<my_pos> {
        it may only contain particles where {
            it has the position</valid/action_local_pos_requires_global>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<_noop>.
        create a particle in position<_noop>.
        create a particle in position<my_pos>.
    }
}
