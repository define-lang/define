define the potential action<mv:define-lang.org:test_files:/valid/action_with_multiple_local_positions> {
    define the position<first_pos>.
    define the position<second_pos>.
    it happens when {
        the position<first_pos> has a particle.
    } and it does {
        define the position<_noop>.
        create a particle in position<_noop>.
        create a particle in position<second_pos>.
    }
}
