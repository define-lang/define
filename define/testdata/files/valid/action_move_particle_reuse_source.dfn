define the potential action<mv:define-lang.org:test_files:/valid/action_move_particle_reuse_source> {
    define the position<pos_a>.
    define the position<pos_b>.
    define the position<pos_c>.
    it happens when {
        the position<pos_a> has a particle.
    } and it does {
        move the particle in position<pos_a> to position<pos_b>.
        create a particle in position<pos_c>.
    }
}
