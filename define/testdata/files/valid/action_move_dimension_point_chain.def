define the potential position<mv:define-lang.org:test_files:/valid/action_move_dimension_point_chain>.
define the potential action<mv:define-lang.org:test_files:/valid/action_move_dimension_point_chain> {
    define the position<run>.
    define the position<src> {
        it may only contain dimension points where {
            it has the position</valid/action_move_dimension_point_chain>.
        }
    }
    define the position<dest>.
    it happens when {
        the position<run> has a dimension point.
    } and it does {
        create a dimension point in position<src>.
        move the dimension point in position<src>::position</valid/action_move_dimension_point_chain> to position<dest>.
    }
}
