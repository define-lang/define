define the potential action<mv:define-lang.org:test_files:/valid/destroy/destroy_chained> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<parent> {
            it may only contain particles where {
                it has the position</valid/minimal_position>.
            }
        }
        create a particle in position<parent>.
        create a particle in position<parent>::position</valid/minimal_position>.
        destroy the particle in position<parent>::position</valid/minimal_position>.
    }
}
