define the potential action<mv:define-lang.org:test_files:/valid/destroy/destroy_chained> {
    define the position<run>.
    it happens when {
        the position<run> has a dimension point.
    } and it does {
        define the position<parent> {
            it may only contain dimension points where {
                it has the position</valid/minimal_position>.
            }
        }
        create a dimension point in position<parent>.
        create a dimension point in position<parent>::position</valid/minimal_position>.
        destroy the dimension point in position<parent>::position</valid/minimal_position>.
    }
}
