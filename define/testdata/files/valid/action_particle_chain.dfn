define the potential position<mv:define-lang.org:test_files:/valid/action_particle_chain>.
define the potential action<mv:define-lang.org:test_files:/valid/action_particle_chain> {
    define the position<local_pos> {
        it may only contain particles where {
            it has the position</valid/action_particle_chain>.
        }
    }
    it happens when {
        the position<local_pos> has a particle.
    } and it does {
        create a particle in position<local_pos>::position</valid/action_particle_chain>.
    }
}
