define the potential action<mv:define-lang.org:test_action_requires_occupied:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a dimension point.
    } and it does {
        define the position<box> {
            it may only contain dimension points where {
                it has the action</other>.
            }
        }
        create a dimension point in position<box>.
        create a dimension point in position<box>::action</other>::position<trigger_pos>.
    }
}
