define the potential action<mv:define-lang.org:test_pos_init_move_bad:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<local> {
            it may only contain particles where {
                it has the position</x>.
            }
        }
        define the position<bad_dest> {
            it may only contain particles where {
                it has the position</y>.
            }
        }
        create a particle in position<local>.
        create a particle in position<local>::position</x>.
        move the particle in position<local> to position<bad_dest>.
        create a particle in position<bad_dest>::position</y>.
    }
}
