define the potential action<mv:define-lang.org:test_dim_global:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a dimension point.
    } and it does {
        define the position<dest> {
            it may only contain dimension points where {
                it has the position</target_pos>.
            }
        }
        create a dimension point in position<dest>.
    }
}
