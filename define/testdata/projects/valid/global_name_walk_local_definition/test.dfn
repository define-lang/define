define the potential action<mv:define-lang.org:test_walk_local_definition:/test> {
    define the position<inner_pos> {
        it may only contain particles where {
            it has the position</target>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<_noop>.
        create a particle in position<_noop>.
    }
}
