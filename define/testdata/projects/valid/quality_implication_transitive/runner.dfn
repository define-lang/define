define the potential action<mv:define-lang.org:test_qual_impl_transitive:/runner> {
    define the position<run>.
    define the position<source> {
        it may only contain particles where {
            it has the action</implier_one>.
            it has the action</implier_two>.
        }
    }
    define the position<dest> {
        it may only contain particles where {
            it has the position</implied>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<source>.
        move the particle in position<source> to position<dest>.
    }
}
