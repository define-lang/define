define the potential action<mv:define-lang.org:test_dim_multi:/test> {
    define the position<run>.
    define the position<local_pos>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<dest> {
            it may only contain particles where {
                it has the position</global_pos>.
            }
        }
        create a particle in position<local_pos>.
        create a particle in position<dest>.
    }
}
