define the potential action<mv:define-lang.org:test_move_dim_global:/test> {
    define the position<local_pos> {
        it may only contain particles where {
            it has the position</target_pos>.
        }
    }
    it happens when {
        the position<local_pos> has a particle.
    } and it does {
        define the position<dest> {
            it may only contain particles where {
                it has the position</target_pos>.
            }
        }
        move the particle in position<local_pos> to position<dest>.
        create a particle in position<dest>::position</target_pos>.
    }
}
