define the potential action<mv:define-lang.org:test_walk_action_statements:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<inner_pos> {
            it may only contain particles where {
                it has the position</target>.
            }
        }
        create a particle in position<inner_pos>.
    }
}
