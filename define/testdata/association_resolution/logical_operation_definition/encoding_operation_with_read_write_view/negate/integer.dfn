define the encoding_operation<my.domain.com:my_lib:/negate/integer> {
    define the view<a> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/integer/ascii>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/integer/ascii>.
        }
    }

    it does {
        define the view<negated> {
            it may only contain particles where {
                it has the encoding<standard:/number/integer/ascii>.
            }
        }
        execute the encoding_operation<standard:/number/integer/ascii/negate> {
            with view<a> looking at view<a>.
            with view<result> looking at view<result>.
        }
        execute the encoding_operation<standard:/number/integer/ascii/negate> {
            with view<a> looking at view<a>.
            with view<result> looking at view<negated>.
        }
        set the value of view<a> from view<negated>.
    }
}
