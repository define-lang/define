# Source compiled in a non-filesystem context defines a logical operation and the Encoding Operation that the project associates with it. Executing the logical operation chooses the source's Encoding Operation, and no file is loaded.
define the encoding_operation<my.domain.com:my_lib:/negate/ascii> {
    define the view<a> {
        it is read.
        it may only contain particles where {
            it has the encoding<standard:/number/integer/ascii>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/integer/ascii>.
        }
    }

    it does {
        execute the computer operation.
    }
}
define the logical_operation<my.domain.com:my_lib:/negate> {
    define the view<a> {
        it is read.
    }
    define the view<result> {
        it is written.
    }
}
define the potential value<my.domain.com:my_lib:/number> {
    it supports the logical_operation</negate> {
        it may be read.
        it may be written.
    }
}
define the operation<my.domain.com:my_lib:/negated> {
    define the view<a> {
        it is read.
        it may only contain particles where {
            it has the value</number>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }

    it does {
        execute the logical_operation</negate> {
            with view<a> looking at view<a>.
            with view<result> looking at view<result>.
        }
    }
}
define the potential position<my.domain.com:my_lib:/result> {
    it may only contain particles where {
        it has the value</number>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</result>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<start> {
            it may only contain particles where {
                it has the value</number>.
            }
        }
        create a particle in position<start>.
        set the value of position<start> from literal<standard:/number>"1".
        create a particle in position</result>.
        execute the operation</negated> {
            with view<a> looking at position<start>.
            with view<result> looking at position</result>.
        }
    }
}
