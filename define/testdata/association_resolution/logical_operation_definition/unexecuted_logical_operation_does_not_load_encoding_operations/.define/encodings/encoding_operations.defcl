encoding_operations: {
  operation_encodings: [
    {
      logical_operation: "/negate"
      encoding_operation: {
        name: "/negate/missing"
        views: [
          {
            view: "a"
            encoding: "standard:/number/integer/ascii"
          },
          {
            view: "result"
            encoding: "standard:/number/integer/ascii"
          }
        ]
      }
    }
  ]
}
