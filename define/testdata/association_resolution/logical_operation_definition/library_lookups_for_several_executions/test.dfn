# /flip and /flip_again each execute /number/negate with the same encodings, so the library's associations of /number/negate are looked up once. /measure executes /number/absolute_value, which the library does not associate with an Encoding Operation for those encodings.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</final_result>.
    it also assigns the position</second_result>.
    it also assigns the position</third_result>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<source> {
            it may only contain particles where {
                it has the value</number>.
            }
        }
        create a particle in position<source>.
        set the value of position<source> from literal<standard:/number>"5".
        create a particle in position</final_result>.
        execute the operation</flip> {
            with view<a> looking at position<source>.
            with view<result> looking at position</final_result>.
        }
        create a particle in position</second_result>.
        execute the operation</flip_again> {
            with view<a> looking at position<source>.
            with view<result> looking at position</second_result>.
        }
        create a particle in position</third_result>.
        execute the operation</measure> {
            with view<a> looking at position<source>.
            with view<result> looking at position</third_result>.
        }
    }
}
