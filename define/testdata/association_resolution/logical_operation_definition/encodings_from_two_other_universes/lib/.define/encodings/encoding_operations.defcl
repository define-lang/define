encoding_operations: {
  operation_encodings: [
    {
      logical_operation: "standard:/number/negate"
      encoding_operation: {
        name: "/number/digits/negate"
        views: [
          {
            view: "a"
            encoding: "standard:/number/integer/ascii"
          },
          {
            view: "result"
            encoding: "/number/digits"
          }
        ]
      }
    }
  ]
}
