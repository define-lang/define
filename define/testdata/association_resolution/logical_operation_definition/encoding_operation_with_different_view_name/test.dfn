# An association must list its logical operation's Interface Views by their names, which its Encoding Operation must have. The project associates /number/integer/ascii/negate with /negate, and lists its first view, view<a>, where /negate's first view is view<value>.
define the operation<my.domain.com:my_lib:/test> {
    define the view<first> {
        it is read.
        it may only contain particles where {
            it has the value</number>.
        }
    }
    define the view<second> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }

    it does {
        execute the logical_operation</negate> {
            with view<value> looking at view<first>.
            with view<result> looking at view<second>.
        }
    }
}
