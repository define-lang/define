# 'abc' cannot be a natural number. The action executes /double, so its statements are compiled and its literal is encoded.
define the operation<my.domain.com:my_lib:/copy> {
    define the view<source> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }
    define the view<target> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }

    it does {
        execute the operation<standard:/number/natural/add> {
            with view<a> looking at view<source>.
            with view<b> looking at literal<standard:/number>"0".
            with view<result> looking at view<target>.
        }
    }
}
define the operation<my.domain.com:my_lib:/double> {
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }

    it does {
        execute the operation</copy> {
            with view<source> looking at literal<standard:/number>"abc".
            with view<target> looking at view<result>.
        }
    }
}

define the potential position<my.domain.com:my_lib:/doubled> {
    it may only contain particles where {
        it has the value<standard:/number/natural>.
    }
}

define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</doubled>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</doubled>.
        execute the operation</double> {
            with view<result> looking at position</doubled>.
        }
    }
}
