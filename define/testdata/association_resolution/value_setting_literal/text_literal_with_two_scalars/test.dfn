# A text literal cannot set a scalar to e followed by a combining acute accent, because that is two scalars.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</target>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</target>.
        set the value of position</target> from literal<standard:/text>"é".
    }
}
