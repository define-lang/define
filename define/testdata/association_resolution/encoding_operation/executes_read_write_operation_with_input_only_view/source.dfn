# view<total> writes to view<number>, which is only read.
define the encoding_operation<my.domain.com:my_lib:/increment_by> {
    define the view<total> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/integer/ascii>.
        }
    }
    define the view<amount> {
        it is read.
        it may only contain particles where {
            it has the encoding<standard:/number/integer/ascii>.
        }
    }

    it does {
        define the view<sum> {
            it may only contain particles where {
                it has the encoding<standard:/number/integer/ascii>.
            }
        }
        execute the encoding_operation<standard:/number/integer/ascii/add> {
            with view<a> looking at view<total>.
            with view<b> looking at view<amount>.
            with view<result> looking at view<sum>.
        }
        set the value of view<total> from view<sum>.
    }
}
define the encoding_operation<my.domain.com:my_lib:/bump> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the encoding<standard:/number/integer/ascii>.
        }
    }

    it does {
        execute the encoding_operation</increment_by> {
            with view<total> looking at view<number>.
            with view<amount> looking at literal<standard:/number>"1".
        }
    }
}
