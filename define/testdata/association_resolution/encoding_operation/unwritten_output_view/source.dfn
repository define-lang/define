# view<number> says it is written, but nothing writes to it.
define the encoding_operation<my.domain.com:my_lib:/check> {
    define the view<number> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/integer/ascii>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/integer/ascii>.
        }
    }

    it does {
        execute the encoding_operation<standard:/number/integer/ascii/negate> {
            with view<a> looking at view<number>.
            with view<result> looking at view<result>.
        }
    }
}
