# view<source> requires an encoding that the particles in view<number> may not have.
define the encoding<my.domain.com:my_lib:/text>.
define the encoding_operation<my.domain.com:my_lib:/copy> {
    define the view<source> {
        it is read.
        it may only contain particles where {
            it has the encoding<standard:/number/integer/ascii>.
            it has the encoding</text>.
        }
    }
    define the view<target> {
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/integer/ascii>.
        }
    }

    it does {
        execute the encoding_operation<standard:/number/integer/ascii/negate> {
            with view<a> looking at view<source>.
            with view<result> looking at view<target>.
        }
    }
}
define the encoding_operation<my.domain.com:my_lib:/duplicate> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the encoding<standard:/number/integer/ascii>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/integer/ascii>.
        }
    }

    it does {
        execute the encoding_operation</copy> {
            with view<source> looking at view<number>.
            with view<target> looking at view<result>.
        }
    }
}
