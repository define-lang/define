# The entry file must cause the driver to discover and validate dependency.dfn.
define the potential action<mv:define-lang.org:driver_multifile:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the position</dependency>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</dependency>.
    }
}
