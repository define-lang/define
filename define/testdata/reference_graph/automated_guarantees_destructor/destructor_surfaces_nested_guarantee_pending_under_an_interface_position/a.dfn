define the potential action<my.domain.com:my_lib:/a> {
    define the position<box> {
        it may only contain particles where {
            it has the action</b>.
        }
    }
    it happens when {
        the position<box> has a particle.
    } and it does {
        create a particle in position<box>::action</b>::position<run>.
        destroy the particle in position<box>::action</b>::position<run>.
    }
}
