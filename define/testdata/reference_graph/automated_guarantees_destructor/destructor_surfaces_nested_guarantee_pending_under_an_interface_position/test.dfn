# A destructor must surface a transitive implied-position guarantee after the
# direct caller moves its callee's interface particle to an implied position.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</a>.
    it also assigns the position</saved>.
    it happens when {
        this particle is being destroyed.
    } and it does {
        create a particle in action</a>::position<box>.
        move the particle in action</a>::position<box> to position</saved>.
    }
}
