# The Guarantee of action</b> is pending on the particle the Destructor leaves
# in position</saved>, so the particle it creates below is not reported.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</a>.
    it also assigns the position</saved>.
    it happens when {
        this particle is being destroyed.
    } and it does {
        create a particle in action</a>::position<box>.
        move the particle in action</a>::position<box> to position</saved>.
    }
}
