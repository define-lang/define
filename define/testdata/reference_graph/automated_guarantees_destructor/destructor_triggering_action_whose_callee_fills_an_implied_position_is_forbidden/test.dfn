# The Guarantee of action</b> is still pending on the Destructor's parent
# particle when the Destructor ends.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</a>.
    it happens when {
        this particle is being destroyed.
    } and it does {
        create a particle in action</a>::position<run>.
    }
}
