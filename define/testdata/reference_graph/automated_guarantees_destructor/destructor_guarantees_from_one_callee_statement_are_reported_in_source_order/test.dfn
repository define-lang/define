# The Destructor triggers action</emptier> on position<second_box> and then
# on position<first_box>. Both Empty Guarantees come from the same statement in
# action</emptier>, so they are reported in the order the Destructor triggers
# action</emptier>.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<second_box> {
        it may only contain particles where {
            it has the action</emptier>.
        }
    }
    define the position<first_box> {
        it may only contain particles where {
            it has the action</emptier>.
        }
    }
    it happens when {
        this particle is being destroyed.
    } and it does {
        create a particle in position<second_box>::action</emptier>::position<trigger_pos>.
        create a particle in position<first_box>::action</emptier>::position<trigger_pos>.
    }
}
