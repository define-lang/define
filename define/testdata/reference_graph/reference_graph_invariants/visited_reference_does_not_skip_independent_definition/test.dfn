# The position reference is visited before an independent action in this same file.
define the potential position<mv:define-lang.org:reference_graph_postorder:/test> {
    it may only contain particles where {
        it has the position</b>.
    }
}
define the potential action<mv:define-lang.org:reference_graph_postorder:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<work>.
        create a particle in position<work>.
        create a particle in position<work>.
    }
}
