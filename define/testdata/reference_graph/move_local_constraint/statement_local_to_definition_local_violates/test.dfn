define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    define the position<def_pos> {
        it may only contain particles where {
            it has the position</y>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<stmt_pos> {
            it may only contain particles where {
                it has the position</x>.
            }
        }
        create a particle in position<stmt_pos>.
        move the particle in position<stmt_pos> to position<def_pos>.
        create a particle in position<stmt_pos>.
        create a particle in position<stmt_pos>::position</x>.
        create a particle in position<def_pos>::position</y>.
    }
}
