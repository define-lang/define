define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<a> {
            it may only contain particles where {
                it has the position</b>.
                it has the position</c>.
                it has the position</d>.
            }
        }
        define the position<b> {
            it may only contain particles where {
                it has the position</b>.
                it has the position</c>.
            }
        }
        create a particle in position<a>.
        move the particle in position<a> to position<b>.
        move the particle in position<b> to position<a>.
        create a particle in position<a>::position</b>.
        create a particle in position<a>::position</c>.
        create a particle in position<a>::position</d>.
        create a particle in position<b>.
        create a particle in position<b>::position</b>.
        create a particle in position<b>::position</c>.
    }
}
