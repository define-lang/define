define the potential action<my.domain.com:my_lib:/test> {
    define the position<start>.
    it happens when {
        the position<start> has a particle.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</consumer>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</consumer>::position<run>.
    }
}
