define the potential action<my.domain.com:my_lib:/destroyer> {
    define the position<run>.
    define the position<holder> {
        it may only contain particles where {
            it has the position</box>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<holder>::position</box>.
        destroy the particle in position<holder>.
        destroy the particle in position<run>.
    }
}
