# action</mid> triggers action</make_a>, which creates a particle, and then
# action</move_a>, which moves that particle. action</mid>'s result is still
# pending when position<holder> is destroyed, and no result creates a particle
# with a Destructor, so the destruction drops it unapplied.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</fill_1>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</fill_1>::position<run>.
    }
}
