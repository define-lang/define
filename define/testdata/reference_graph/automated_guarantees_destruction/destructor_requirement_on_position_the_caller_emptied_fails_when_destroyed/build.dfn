define the potential action<my.domain.com:my_lib:/build> {
    it also assigns the position</box>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<run>.
        create a particle in position</box>.
        create a particle in position</box>::action</make>::position<run>.
        destroy the particle in position</box>::position</child>::position</inner>::position</value>.
    }
}
