# action</make> leaves position</child>::position</inner> in error. The child's
# Destructor reads below it, which is unknowable rather than failing, so
# action</build> still runs the Destructor for its callers.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</build>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</build>::position<run>.
    }
}
