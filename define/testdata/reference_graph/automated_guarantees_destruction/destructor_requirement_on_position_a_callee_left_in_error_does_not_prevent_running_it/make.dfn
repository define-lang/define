define the potential action<my.domain.com:my_lib:/make> {
    it also assigns the position</child>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<run>.
        create a particle in position</child>.
        create a particle in position</child>::position</inner>.
        define the position<spare>.
        create a particle in position<spare>.
        move the particle in position<spare> to position</child>::position</inner>.
    }
}
