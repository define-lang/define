# action</destroyer> destroys a particle from its caller, whose Destruction Contract
# may need the state of position</child_2>, so it is destroyed individually.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</destroyer>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in action</destroyer>::position<holder>.
        create a particle in action</destroyer>::position<run>.
    }
}
