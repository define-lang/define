# action</destroyer> destroys a particle from this action while
# action</fill_2> is still pending below it. Checking action</cleanup>, which
# only this action knows the particle has, applies that pending Guarantee, and
# action</cleanup> then finds position</child_2> already empty.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</destroyer>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<mine> {
            it may only contain particles where {
                it has the action</fill_1>.
                it has the action</cleanup>.
            }
        }
        create a particle in position<mine>.
        move the particle in position<mine> to action</destroyer>::position<holder>.
        create a particle in action</destroyer>::position<run>.
    }
}
