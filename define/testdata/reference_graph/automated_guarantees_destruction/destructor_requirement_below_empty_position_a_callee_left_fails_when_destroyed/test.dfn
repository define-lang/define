# action</make> leaves position</child>::position</inner> without a particle in
# its position</value>, so destroying position<holder> reports the empty
# position the child's Destructor reads.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</build>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</build>::position<run>.
    }
}
