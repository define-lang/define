define the potential action<my.domain.com:my_lib:/make> {
    it also assigns the position</box>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<run>.
        create a particle in position</box>.
        create a particle in position</box>::position</child>.
        create a particle in position</box>::position</child>::position</value>.
        set the value of position</box>::position</child>::position</value> to literal<standard:/number>"1".
        create a particle in position</box>::position</child>::position</other_value>.
        set the value of position</box>::position</child>::position</other_value> to literal<standard:/number>"2".
    }
}
