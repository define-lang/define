# action</build> leaves position</box>::position</child>::position</inner> in
# error, which is unknowable rather than failing, so action</build> still runs
# the child's Destructor for its callers.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</build>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</build>::position<run>.
    }
}
