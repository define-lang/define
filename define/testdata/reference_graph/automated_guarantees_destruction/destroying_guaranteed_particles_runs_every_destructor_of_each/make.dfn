define the potential action<my.domain.com:my_lib:/make> {
    it also assigns the position</inner>.
    it also assigns the position</spare>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<run>.
        create a particle in position</inner>.
        create a particle in position</spare>.
    }
}
