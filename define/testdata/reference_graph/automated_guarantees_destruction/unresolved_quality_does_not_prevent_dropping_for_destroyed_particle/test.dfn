# The particle that action</fill_2> creates has a quality whose file is missing.
# That is reported once and is not treated as a destructor, so destroying
# position<holder> still does not destroy that particle individually.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</fill_1>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</fill_1>::position<run>.
    }
}
