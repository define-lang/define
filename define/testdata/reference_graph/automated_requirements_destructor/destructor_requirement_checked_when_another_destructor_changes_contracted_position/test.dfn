# Both destructors require position</p> occupied, and /test left it empty. first_destructor also changes position</p>, which breaks DLP 41, but second_destructor's requirement is still validated against the state at the moment of destruction.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<thing> {
            it may only contain particles where {
                it has the action</first_destructor>.
                it has the action</second_destructor>.
            }
        }
        create a particle in position<thing>.
        destroy the particle in position<thing>.
    }
}
