# first_destructor changes its contracted position</p>, which breaks DLP 41. second_destructor requires position</p> empty, and /test filled it, so second_destructor's requirement is still violated at the moment of destruction.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<thing> {
            it may only contain particles where {
                it has the action</first_destructor>.
                it has the action</second_destructor>.
                it has the position</p>.
            }
        }
        create a particle in position<thing>.
        create a particle in position<thing>::position</p>.
        destroy the particle in position<thing>.
    }
}
