# The worker fills position</box>::position</shared> from /middle's perspective,
# so its guarantee cannot satisfy /middle's requirement that position</shared>
# be occupied.
define the potential action<my.domain.com:my_lib:/middle> {
    it also assigns the position</box>.
    it also assigns the position</shared>.
    define the position<trigger_pos>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position</box>.
        create a particle in position</box>::action</worker>::position<trigger_pos>.
        move the particle in position</shared> to position</box>::position</destination>.
    }
}
