define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<sink>.
        define the position<box> {
            it may only contain particles where {
                it has the action</implier>.
                it has the action</implied_action>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</implied_action>::position<trigger_pos>.
        move the particle in position<box>::action</implied_action>::position<output> to position<sink>.
        create a particle in position<box>::action</implier>::position<run>.
    }
}
