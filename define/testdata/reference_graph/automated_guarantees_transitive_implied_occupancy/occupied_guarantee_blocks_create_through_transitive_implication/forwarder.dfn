define the potential action<my.domain.com:my_lib:/forwarder> {
    it also assigns the action</implied_action>.
    it also assigns the position</output>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in action</implied_action>::position<trigger_pos>.
        move the particle in action</implied_action>::position<output> to position</output>.
        destroy the particle in position<run>.
    }
}
