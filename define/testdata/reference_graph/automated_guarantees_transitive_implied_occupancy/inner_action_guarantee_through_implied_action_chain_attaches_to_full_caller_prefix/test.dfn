# An implied action's child guarantee must remain attached to its particle when
# its direct caller moves that particle to a child of an implied position.
#
# When a caller reaches that action through a long chained name, the guarantee
# must appear at the full chained name from the caller's perspective.
#
# Filling the same fully-qualified position from the caller after the
# trigger should fail with a CreateInOccupied diagnostic.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<host> {
            it may only contain particles where {
                it has the position</mid>.
            }
        }
        create a particle in position<host>.
        create a particle in position<host>::position</mid>.
        create a particle in position<host>::position</mid>::action</inner>::position<trigger_pos>.
        create a particle in position<host>::position</mid>::position</result>::position</x>.
    }
}
