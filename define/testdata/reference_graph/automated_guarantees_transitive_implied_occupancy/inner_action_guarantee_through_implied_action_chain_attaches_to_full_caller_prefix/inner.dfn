define the potential action<my.domain.com:my_lib:/inner> {
    it also assigns the action</nested>.
    it also assigns the position</result>.
    define the position<trigger_pos>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in action</nested>::position<iface>.
        create a particle in action</nested>::position<trigger_pos>.
        create a particle in position</result>.
        move the particle in action</nested>::position<iface>::position</x> to position</result>::position</x>.
        destroy the particle in action</nested>::position<iface>.
        destroy the particle in position<trigger_pos>.
    }
}
