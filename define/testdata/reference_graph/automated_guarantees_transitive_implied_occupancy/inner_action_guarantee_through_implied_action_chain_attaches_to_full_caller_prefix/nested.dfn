define the potential action<my.domain.com:my_lib:/nested> {
    define the position<iface> {
        it may only contain particles where {
            it has the position</x>.
        }
    }
    define the position<trigger_pos>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<iface>.
        create a particle in position<iface>::position</x>.
        destroy the particle in position<iface>.
    }
}
