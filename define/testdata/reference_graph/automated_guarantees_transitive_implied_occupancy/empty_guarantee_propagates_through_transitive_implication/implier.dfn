define the potential action<my.domain.com:my_lib:/implier> {
    it also assigns the action</forwarder>.
    define the position<run>.
    define the position<input>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        move the particle in position<input> to action</forwarder>::position<input>.
        create a particle in action</forwarder>::position<run>.
        destroy the particle in position<run>.
    }
}
