define the potential action<mv:define-lang.org:parent:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<src> {
            it may only contain particles where {
                it has the position<mv:define-lang.org:child:/x>.
            }
        }
        define the position<dest> {
            it may only contain particles where {
                it has the position<mv:define-lang.org:child:/y>.
            }
        }
        create a particle in position<src>.
        create a particle in position<src>::position<mv:define-lang.org:child:/x>.
        move the particle in position<src>::position<mv:define-lang.org:child:/x> to position<dest>.
        create a particle in position<dest>::position<mv:define-lang.org:child:/y>.
    }
}
