define the potential action<mv:define-lang.org:parent:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<src> {
            it may only contain particles where {
                it has the action<mv:define-lang.org:child:/act>.
            }
        }
        define the position<dest> {
            it may only contain particles where {
                it has the position<mv:define-lang.org:child:/quality>.
            }
        }
        create a particle in position<src>.
        create a particle in position<src>::action<mv:define-lang.org:child:/act>::position<trigger>.
        move the particle in position<src>::action<mv:define-lang.org:child:/act>::position<no_such> to position<dest>.
        create a particle in position<dest>.
        create a particle in position<dest>::position<mv:define-lang.org:child:/quality>.
    }
}
