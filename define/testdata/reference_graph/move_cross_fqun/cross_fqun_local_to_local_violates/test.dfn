define the potential action<mv:define-lang.org:parent:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<from_pos> {
            it may only contain particles where {
                it has the position<mv:define-lang.org:child:/x>.
            }
        }
        define the position<to_pos> {
            it may only contain particles where {
                it has the position<mv:define-lang.org:child:/y>.
            }
        }
        create a particle in position<from_pos>.
        move the particle in position<from_pos> to position<to_pos>.
        create a particle in position<to_pos>::position<mv:define-lang.org:child:/y>.
        create a particle in position<from_pos>.
        create a particle in position<from_pos>::position<mv:define-lang.org:child:/x>.
    }
}
