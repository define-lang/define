define the potential action<mv:define-lang.org:parent:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<src> {
            it may only contain particles where {
                it has the position<mv:define-lang.org:child:/quality>.
            }
        }
        define the position<gateway> {
            it may only contain particles where {
                it has the action<mv:define-lang.org:child:/act>.
            }
        }
        create a particle in position<src>.
        create a particle in position<src>::position<mv:define-lang.org:child:/quality>.
        destroy the particle in position<src>::position<mv:define-lang.org:child:/quality>.
        create a particle in position<gateway>.
        move the particle in position<src> to position<gateway>::action<mv:define-lang.org:child:/act>::position<local_dest>.
        create a particle in position<gateway>::action<mv:define-lang.org:child:/act>::position<trigger>.
        destroy the particle in position<gateway>::action<mv:define-lang.org:child:/act>::position<local_dest>.
    }
}
