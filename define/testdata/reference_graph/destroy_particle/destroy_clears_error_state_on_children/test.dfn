define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<parent> {
            it may only contain particles where {
                it has the position</child_pos>.
            }
        }
        define the position<dest>.
        create a particle in position<parent>.
        create a particle in position<parent>::position</child_pos>.
        create a particle in position<dest>.
        move the particle in position<parent>::position</child_pos> to position<dest>.
        destroy the particle in position<parent>.
        create a particle in position<parent>::position</child_pos>.
    }
}
