# Snapshotting two automatically destroyed particles must not include the pending
# Guarantee for a third particle. The caller still needs that Guarantee afterward.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</middle>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<saved> {
            it may only contain particles where {
                it has the position</marker>.
            }
        }
        create a particle in action</middle>::position<second>.
        create a particle in action</middle>::position<unrelated>.
        create a particle in action</middle>::position<first>.
        move the particle in action</middle>::position<unrelated> to position<saved>.
        destroy the particle in position<saved>::position</marker>.
        destroy the particle in position<saved>.
    }
}
