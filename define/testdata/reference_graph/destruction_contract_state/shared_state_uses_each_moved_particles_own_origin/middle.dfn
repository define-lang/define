define the potential action<my.domain.com:my_lib:/middle> {
    it also assigns the action</destroyer>.
    define the position<incoming>.
    define the position<run> {
        it may only contain particles where {
            it has the position</child>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        move the particle in position<incoming> to action</destroyer>::position<incoming>.
        move the particle in position<run> to action</destroyer>::position<run>.
    }
}
