define the potential action<my.domain.com:my_lib:/middle> {
    it also assigns the action</destroyer>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<parent> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        create a particle in position<parent>.
        move the particle in position<run> to position<parent>::position</child>.
        move the particle in position<parent> to action</destroyer>::position<run>.
    }
}
