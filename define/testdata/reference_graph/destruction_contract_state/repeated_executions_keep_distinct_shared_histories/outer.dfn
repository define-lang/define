define the potential action<my.domain.com:my_lib:/outer> {
    it also assigns the action</middle>.
    define the position<second>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        move the particle in position<second> to action</middle>::position<second>.
        move the particle in position<run> to action</middle>::position<run>.
    }
}
