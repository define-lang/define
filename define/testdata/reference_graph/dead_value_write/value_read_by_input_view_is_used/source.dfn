# An input view reads position<number>, and this action guarantees the output.
define the operation<my.domain.com:my_lib:/copy_value> {
    define the view<source> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    define the view<target> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
define the potential position<my.domain.com:my_lib:/copy> {
    it may only contain particles where {
        it has the value<standard:/number/rational>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</copy>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<number> {
            it may only contain particles where {
                it has the value<standard:/number/rational>.
            }
        }
        create a particle in position<number>.
        set the value of position<number> to literal<standard:/number>"5".
        create a particle in position</copy>.
        execute the operation</copy_value> {
            with view<source> looking at position<number>.
            with view<target> looking at position</copy>.
        }
    }
}
