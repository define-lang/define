# action</make> leaves position</shell> with a particle in position</item>
# below it. action</test> writes the value below that particle, then passes
# position<box> to action</close>, which destroys it without knowing about
# action</cleanup>. action</test> verifies action</cleanup> through the
# Destruction Contract, which uses the value, so the write is not dead.
define the potential position<my.domain.com:my_lib:/value> {
    it may only contain particles where {
        it has the value<standard:/number/rational>.
    }
}
define the potential position<my.domain.com:my_lib:/kept> {
    it may only contain particles where {
        it has the value<standard:/number/rational>.
    }
}
define the potential action<my.domain.com:my_lib:/keep> {
    it also assigns the position</kept>.
    define the position<run>.
    define the position<input> {
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position</kept>.
        set the value of position</kept> to position<input>.
        destroy the particle in position<input>.
        destroy the particle in position<run>.
    }
}
define the potential action<my.domain.com:my_lib:/cleanup> {
    it also assigns the position</value>.
    it happens when {
        this particle is being destroyed.
    } and it does {
        define the position<reader> {
            it may only contain particles where {
                it has the action</keep>.
            }
        }
        create a particle in position<reader>.
        create a particle in position<reader>::action</keep>::position<input>.
        set the value of position<reader>::action</keep>::position<input> to position</value>.
        create a particle in position<reader>::action</keep>::position<run>.
    }
}
define the potential position<my.domain.com:my_lib:/item> {
    it may only contain particles where {
        it has the action</cleanup>.
        it has the position</value>.
    }
}
define the potential position<my.domain.com:my_lib:/shell> {
    it may only contain particles where {
        it has the position</item>.
    }
}
define the potential action<my.domain.com:my_lib:/make> {
    it also assigns the position</shell>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<run>.
        create a particle in position</shell>.
        create a particle in position</shell>::position</item>.
    }
}
define the potential action<my.domain.com:my_lib:/close> {
    define the position<run>.
    define the position<input>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<input>.
        destroy the particle in position<run>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<worker> {
            it may only contain particles where {
                it has the action</close>.
            }
        }
        define the position<box> {
            it may only contain particles where {
                it has the action</make>.
                it has the position</shell>.
            }
        }
        create a particle in position<worker>.
        create a particle in position<box>.
        create a particle in position<box>::action</make>::position<run>.
        create a particle in position<box>::position</shell>::position</item>::position</value>.
        set the value of position<box>::position</shell>::position</item>::position</value> to literal<standard:/number>"5".
        move the particle in position<box> to position<worker>::action</close>::position<input>.
        create a particle in position<worker>::action</close>::position<run>.
    }
}
