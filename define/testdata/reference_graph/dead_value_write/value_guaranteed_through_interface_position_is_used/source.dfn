# action</fill> writes its interface position<output>, which it guarantees to its caller.
define the potential position<my.domain.com:my_lib:/copy> {
    it may only contain particles where {
        it has the value<standard:/number/rational>.
    }
}
define the potential action<my.domain.com:my_lib:/fill> {
    define the position<run>.
    define the position<output> {
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<output>.
        set the value of position<output> to literal<standard:/number>"5".
        destroy the particle in position<run>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</copy>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</fill>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</fill>::position<run>.
        create a particle in position</copy>.
        set the value of position</copy> to position<box>::action</fill>::position<output>.
        destroy the particle in position<box>.
    }
}
