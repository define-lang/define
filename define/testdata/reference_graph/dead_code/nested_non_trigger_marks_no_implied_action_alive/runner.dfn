define the potential action<my.domain.com:my_lib:/runner> {
    define the position<run>.
    define the position<iface> {
        it may only contain particles where {
            it has the action</worker>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<iface>::action</worker>::position<run>.
        destroy the particle in position<iface>::action</worker>::position<non_trigger>.
        destroy the particle in position<run>.
    }
}
