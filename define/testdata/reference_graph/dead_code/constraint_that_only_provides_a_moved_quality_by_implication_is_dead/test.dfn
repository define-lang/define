define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box1> {
            it may only contain particles where {
                it has the action</construct>.
            }
        }
        define the position<box2> {
            it may only contain particles where {
                it has the action</construct>.
            }
        }
        define the position<dest> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        create a particle in position<box1>.
        move the particle in position<box1> to position<box2>.
        move the particle in position<box2> to position<dest>.
        destroy the particle in position<dest>::position</child>.
    }
}
