define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</init>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</init>.
            }
        }
        create a particle in position<box>.
        destroy the particle in position<box>::action</init>::position<result>.
        destroy the particle in position<box>.
        create a particle in action</init>::position<result>.
        destroy the particle in action</init>::position<result>.
    }
}
