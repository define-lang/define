# An implied position before an implied action must not stop the implied
# action from being checked for a trigger.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</thing>.
    it also assigns the action</worker>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</thing>.
        create a particle in action</worker>::position<input>.
    }
}
