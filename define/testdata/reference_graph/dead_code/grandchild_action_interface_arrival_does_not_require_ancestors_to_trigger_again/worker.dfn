define the potential action<my.domain.com:my_lib:/worker> {
    define the position<child_iface> {
        it may only contain particles where {
            it has the action</grandchild>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<held>.
        move the particle in position<child_iface> to position<held>.
        move the particle in position<held> to position<child_iface>.
        destroy the particle in position<run>.
    }
}
