define the potential action<my.domain.com:my_lib:/consumer> {
    define the position<input> {
        it may only contain particles where {
            it has the position</thing>.
        }
    }
    it happens when {
        the position<input> has a particle.
    } and it does {
        create a particle in position<input>::position</thing>.
        destroy the particle in position<input>.
    }
}
