define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    define the position<box> {
        it may only contain particles where {
            it has the action</worker>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<first_destination>.
        define the position<second_destination>.
        create a particle in position<box>.
        create a particle in position<box>::action</worker>::position<input>.
        create a particle in position<box>::action</worker>::position<run>.
        move the particle in position<box>::action</worker>::position<input> to position<first_destination>.
        create a particle in position<box>::action</worker>::position<input>.
        move the particle in position<box>::action</worker>::position<input> to position<second_destination>.
        create a particle in position<box>::action</worker>::position<input>.
        create a particle in position<box>::action</worker>::position<run>.
        destroy the particle in position<box>::action</worker>::position<input>.
    }
}
