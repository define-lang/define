define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</runner>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in action</runner>::position<iface>.
        create a particle in action</runner>::position<iface>::action</worker>::position<run>.
        destroy the particle in action</runner>::position<iface>::action</worker>::position<non_trigger>.
        destroy the particle in action</runner>::position<iface>.
    }
}
