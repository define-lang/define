define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    define the position<box> {
        it may only contain particles where {
            it has the action</worker>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<feeder>.
        define the position<sink>.
        create a particle in position<box>.
        create a particle in position<box>::action</worker>::position<input>.
        create a particle in position<feeder>.
        move the particle in position<feeder> to position<box>::action</worker>::position<input>::position</child>.
        move the particle in position<box>::action</worker>::position<input>::position</child> to position<sink>.
        create a particle in position<box>::action</worker>::position<run>.
    }
}
