# Referencing one local position's child must not hide another local position's
# use of the same child name, including a local position defined after both uses.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<first> {
            it may only contain particles where {
                it has the position</thing>.
            }
        }
        define the position<second> {
            it may only contain particles where {
                it has the position</thing>.
            }
        }
        create a particle in position<first>.
        create a particle in position<first>::position</thing>.
        create a particle in position<second>.
        create a particle in position<second>::position</thing>.
        define the position<later> {
            it may only contain particles where {
                it has the position</thing>.
            }
        }
        create a particle in position<later>.
        create a particle in position<later>::position</thing>.
    }
}
