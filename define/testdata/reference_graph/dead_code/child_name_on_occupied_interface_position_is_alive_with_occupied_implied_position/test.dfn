# This confirms that the code path that handles liveness for constraonts on
# interface positions does not die when it also sees an implied position.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</implied>.
    define the position<occupied> {
        it may only contain particles where {
            it has the position</thing>.
        }
    }
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position<occupied>.
        create a particle in position</implied>.
    }
}
