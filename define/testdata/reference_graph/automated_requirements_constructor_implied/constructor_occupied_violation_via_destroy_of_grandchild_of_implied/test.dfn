# The first constructor creates both ancestors so the second constructor
# specifically requires the grandchild it destroys.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</create_ancestors>.
                it has the action</destroy_grandchild>.
            }
        }
        create a particle in position<box>.
    }
}
