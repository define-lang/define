# The first constructor creates the parents of the interface position. The
# second constructor therefore specifically requires the interface particle.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</create_action_parent>.
                it has the action</destroy_interface_particle>.
            }
        }
        create a particle in position<box>.
    }
}
