# One constructor creates the implied parent positions. Another requires their
# child position to be occupied.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</create_action_parent>.
                it has the action</destroy_interface_child>.
            }
        }
        create a particle in position<box>.
    }
}
