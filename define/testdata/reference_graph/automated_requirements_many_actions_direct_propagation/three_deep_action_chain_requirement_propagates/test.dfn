# Three levels of nesting: /test triggers /outer, /outer triggers /middle, /middle triggers /inner.
#
# /inner requires position<item> to be empty. Each intermediate has a non-trigger
# interface position with the inner action as a constraint. /test supplies
# position<mid_iface>, satisfying /middle's OCCUPIED requirement. The EMPTY
# requirement on position<item> propagates through /middle and /outer to /test,
# which pre-fills it.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</outer>::position<out_iface>.
        create a particle in position<box>::action</outer>::position<out_iface>::action</middle>::position<mid_iface>.
        create a particle in position<box>::action</outer>::position<out_iface>::action</middle>::position<mid_iface>::action</inner>::position<item>.
        create a particle in position<box>::action</outer>::position<trigger_pos>.
    }
}
