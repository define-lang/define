# The pending occupied guarantees include parent and child names on the left
# chain and another guarantee on the right chain. The consumer requires all
# three positions empty, so one requirement batch reports all three conflicts.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</consume_combined>.
            }
        }
        create a particle in position<box>.
        define the position<left_source> {
            it may only contain particles where {
                it has the position</prepared_input>.
            }
        }
        define the position<right_source> {
            it may only contain particles where {
                it has the position</fillable>.
            }
        }
        create a particle in position<left_source>.
        create a particle in position<left_source>::position</prepared_input>.
        create a particle in position<left_source>::position</prepared_input>::position</child>.
        create a particle in position<left_source>::position</prepared_input>::position</child>::action</call_child>::position<trigger_pos>.
        create a particle in position<left_source>::position</prepared_input>::action</call_parent>::position<trigger_pos>.
        create a particle in position<right_source>.
        create a particle in position<right_source>::position</fillable>.
        move the particle in position<left_source> to position<box>::action</consume_combined>::position<left>.
        move the particle in position<right_source> to position<box>::action</consume_combined>::position<right>.
        create a particle in position<box>::action</consume_combined>::position<trigger_pos>.
    }
}
