define the potential action<my.domain.com:my_lib:/consume_combined> {
    define the position<trigger_pos>.
    define the position<left> {
        it may only contain particles where {
            it has the position</prepared_input>.
        }
    }
    define the position<right> {
        it may only contain particles where {
            it has the position</fillable>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<left>::position</prepared_input>::position</parent_marker>.
        create a particle in position<left>::position</prepared_input>::position</child>::position</child_marker>.
        create a particle in position<right>::position</fillable>::position</item>.
        destroy the particle in position<left>::position</prepared_input>::position</parent_marker>.
        destroy the particle in position<left>::position</prepared_input>::position</child>::position</child_marker>.
        destroy the particle in position<right>::position</fillable>::position</item>.
        destroy the particle in position<left>.
        destroy the particle in position<right>.
        destroy the particle in position<trigger_pos>.
    }
}
