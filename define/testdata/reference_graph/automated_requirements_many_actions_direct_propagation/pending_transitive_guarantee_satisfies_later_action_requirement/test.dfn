# An earlier transitive callee guarantee must be applied before checking a later
# callee's requirements.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<box> {
        it may only contain particles where {
            it has the action</consume_item>.
        }
    }
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position<box>.
        create a particle in position<box>::action</consume_item>::position<input>.
        # fill_item's pending occupied guarantee satisfies consume_item's requirement.
        create a particle in position<box>::action</consume_item>::position<trigger_pos>.
    }
}
