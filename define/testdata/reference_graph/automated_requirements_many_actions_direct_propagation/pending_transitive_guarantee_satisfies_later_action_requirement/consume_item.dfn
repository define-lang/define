define the potential action<my.domain.com:my_lib:/consume_item> {
    define the position<trigger_pos>.
    define the position<input> {
        it may only contain particles where {
            it has the action</call_fill>.
            it has the position</item>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        destroy the particle in position<input>::position</item>.
        destroy the particle in position<input>.
        create a particle in position<input>.
    }
}
