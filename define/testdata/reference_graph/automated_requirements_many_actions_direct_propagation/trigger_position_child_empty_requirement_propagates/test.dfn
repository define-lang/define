# A requirement on a child of the trigger position propagates through the chain.
#
# /inner has a trigger position constrained with position</x>, and creates in
# position<trigger_pos>::position</x>, requiring that child to be empty. /outer
# moves its caller-provided position<source> particle into /inner's trigger
# position. The EMPTY requirement on the trigger position's child therefore maps
# back to position<source>::position</x> in /outer's contract. /test pre-fills
# that child before triggering /outer. When /inner runs, its create finds the
# child already occupied.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</outer>::position<iface>.
        create a particle in position<box>::action</outer>::position<source>.
        create a particle in position<box>::action</outer>::position<source>::position</x>.
        create a particle in position<box>::action</outer>::position<trigger_pos>.
    }
}
