define the potential action<my.domain.com:my_lib:/b> {
    define the position<trigger_pos>.
    define the position<input> {
        it may only contain particles where {
            it has the position</item>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        define the position<c_holder> {
            it may only contain particles where {
                it has the action</c>.
            }
        }
        create a particle in position<c_holder>.
        move the particle in position<input> to position<c_holder>::action</c>::position<input>.
        create a particle in position<c_holder>::action</c>::position<trigger_pos>.
    }
}
