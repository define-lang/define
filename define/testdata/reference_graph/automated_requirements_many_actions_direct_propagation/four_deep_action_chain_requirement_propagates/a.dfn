define the potential action<my.domain.com:my_lib:/a> {
    define the position<trigger_pos>.
    define the position<a_iface> {
        it may only contain particles where {
            it has the action</b>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<a_iface>::action</b>::position<trigger_pos>.
    }
}
