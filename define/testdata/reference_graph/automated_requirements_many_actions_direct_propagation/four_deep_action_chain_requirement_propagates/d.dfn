define the potential action<my.domain.com:my_lib:/d> {
    define the position<trigger_pos>.
    define the position<input> {
        it may only contain particles where {
            it has the position</item>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<input>::position</item>.
    }
}
