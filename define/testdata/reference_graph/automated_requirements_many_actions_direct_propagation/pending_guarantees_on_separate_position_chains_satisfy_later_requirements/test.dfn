# The two fill_item calls leave pending occupied guarantees on separate position
# chains. consume_branches applies both guarantees in one requirement batch.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<box> {
        it may only contain particles where {
            it has the action</consume_branches>.
        }
    }
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position<box>.
        define the position<left_source> {
            it may only contain particles where {
                it has the position</fillable>.
            }
        }
        define the position<right_source> {
            it may only contain particles where {
                it has the position</fillable>.
            }
        }
        create a particle in position<left_source>.
        create a particle in position<left_source>::position</fillable>.
        create a particle in position<right_source>.
        create a particle in position<right_source>::position</fillable>.
        move the particle in position<left_source> to position<box>::action</consume_branches>::position<left>.
        move the particle in position<right_source> to position<box>::action</consume_branches>::position<right>.
        create a particle in position<box>::action</consume_branches>::position<trigger_pos>.
    }
}
