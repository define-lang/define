define the potential action<my.domain.com:my_lib:/inner> {
    define the position<trigger_pos>.
    define the position<input> {
        it may only contain particles where {
            it has the position</src>.
            it has the position</dest>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        move the particle in position<input>::position</src> to position<input>::position</dest>.
    }
}
