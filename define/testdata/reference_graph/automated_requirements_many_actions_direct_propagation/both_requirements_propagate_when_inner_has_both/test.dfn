# /inner requires the input particle's position</src> child occupied and its
# position</dest> child empty.
#
# /test fills both children before /outer passes the particle to /inner, satisfying
# the occupied requirement while violating the empty requirement.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the position</src>.
                it has the position</dest>.
            }
        }
        define the position<outer_holder> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</src>.
        create a particle in position<box>::position</dest>.
        create a particle in position<outer_holder>.
        move the particle in position<box> to position<outer_holder>::action</outer>::position<input>.
        create a particle in position<outer_holder>::action</outer>::position<trigger_pos>.
    }
}
