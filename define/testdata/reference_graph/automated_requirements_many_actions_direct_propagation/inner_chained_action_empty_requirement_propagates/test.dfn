# An inner action requires a child position</item> on its input particle to be empty.
#
# The test action pre-fills that child before moving the particle to /outer. /outer
# passes the particle to /inner, so /inner's empty requirement reaches /test.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the position</item>.
            }
        }
        define the position<outer_holder> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</item>.
        create a particle in position<outer_holder>.
        move the particle in position<box> to position<outer_holder>::action</outer>::position<input>.
        create a particle in position<outer_holder>::action</outer>::position<trigger_pos>.
    }
}
