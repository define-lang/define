# view<amount> has a value quality that the standard library does not define.
define the logical_operation<my.domain.com:my_lib:/negate> {
    define the view<value> {
        it is read.
    }
    define the view<result> {
        it is written.
    }
}
define the potential value<my.domain.com:my_lib:/number> {
    it supports the logical_operation</negate> {
        it may be read.
        it may be written.
    }
}
define the operation<my.domain.com:my_lib:/test> {
    define the view<amount> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/missing>.
        }
    }
    define the view<negated> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }

    it does {
        execute the logical_operation</negate> {
            with view<value> looking at view<amount>.
            with view<result> looking at view<negated>.
        }
    }
}
