# maker is triggered twice: its trigger position is filled, emptied, and
# refilled, so both invocations are inlined. Each invocation's EMPTY
# requirement on <out> resolves within its own window, bounded by its own
# trigger: invocation 1's create(out) falls back to its trigger fill (the
# caller never touched <out> before it), while invocation 2's create(out)
# waits on the caller's drain of invocation 1's output -- the most recent op
# on <out> before the second trigger -- and not on the stale first window or
# on its own trigger. Without that edge, invocation 2 could race the drain
# and put two particles in <out>.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<first_result>.
    define the position<second_result>.
    define the position<gw> {
        it may only contain particles where {
            it has the action</maker>.
        }
    }
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position<gw>.
        create a particle in position<gw>::action</maker>::position<trigger_pos>.
        move the particle in position<gw>::action</maker>::position<out> to position<first_result>.
        destroy the particle in position<gw>::action</maker>::position<trigger_pos>.
        create a particle in position<gw>::action</maker>::position<trigger_pos>.
        move the particle in position<gw>::action</maker>::position<out> to position<second_result>.
        destroy the particle in position<gw>::action</maker>::position<trigger_pos>.
    }
}
