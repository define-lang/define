# view<extra> is not an interface view of operation</show>, so the value
# written to position<first> is not also reported as a dead write.
define the operation<my.domain.com:my_lib:/show> {
    define the view<value> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<first> {
            it may only contain particles where {
                it has the value<standard:/number/natural>.
            }
        }
        define the position<second> {
            it may only contain particles where {
                it has the value<standard:/number/natural>.
            }
        }
        create a particle in position<first>.
        create a particle in position<second>.
        set the value of position<first> from literal<standard:/number>"1".
        set the value of position<second> from literal<standard:/number>"2".
        execute the operation</show> {
            with view<value> looking at position<second>.
            with view<extra> looking at position<first>.
        }
    }
}
