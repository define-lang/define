# A view that looks at a particle without a value quality must not stop the
# later views of the same statement from writing their positions.
define the potential position<my.domain.com:my_lib:/result> {
    it may only contain particles where {
        it has the value<standard:/number/natural>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</result>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<first> {
            it may only contain particles where {
                it has the value<standard:/number/natural>.
            }
        }
        define the position<plain>.
        define the position<sum> {
            it may only contain particles where {
                it has the value<standard:/number/natural>.
            }
        }
        create a particle in position<first>.
        set the value of position<first> from literal<standard:/number>"1".
        create a particle in position<plain>.
        create a particle in position<sum>.
        execute the operation<standard:/number/natural/add> {
            with view<a> looking at position<plain>.
            with view<b> looking at position<first>.
            with view<result> looking at position<sum>.
        }
        create a particle in position</result>.
        execute the operation<standard:/number/natural/add> {
            with view<a> looking at position<sum>.
            with view<b> looking at literal<standard:/number>"1".
            with view<result> looking at position</result>.
        }
    }
}
