# After a view looks at an unset value, later reads of that particle do not report it again.
define the operation<my.domain.com:my_lib:/compare> {
    define the view<left> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    define the view<right> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
define the potential position<my.domain.com:my_lib:/first> {
    it may only contain particles where {
        it has the value<standard:/number/rational>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</first>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<second> {
            it may only contain particles where {
                it has the value<standard:/number/rational>.
            }
        }
        create a particle in position</first>.
        create a particle in position<second>.
        set the value of position</first> to literal<standard:/number>"1".
        execute the operation</compare> {
            with view<left> looking at position</first>.
            with view<right> looking at position<second>.
        }
        set the value of position</first> to position<second>.
    }
}
