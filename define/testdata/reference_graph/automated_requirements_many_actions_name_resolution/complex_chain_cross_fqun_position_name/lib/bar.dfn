define the potential action<mv:define-lang.org:dep_lib:/bar> {
    define the position<trigger_pos>.
    define the position<item> {
        it may only contain particles where {
            it has the position</x>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<item>::position</x>.
    }
}
