# Same structure as the same-FQUN complex chain, but /bar lives in a different FQUN.
#
# /bar is in dep_lib and requires position<item>::position</x> to be empty.
# /foo and /middle transfer ordinary position children until /middle supplies
# /bar's position<item>. The propagated position name should render position</x>
# with its canonical FQUN name.
define the potential action<mv:define-lang.org:main_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<local> {
            it may only contain particles where {
                it has the position</x>.
            }
        }
        create a particle in position<local>.
        create a particle in position<local>::position</x>.
        create a particle in position<local>::position</x>::action</foo>::position<iface>.
        create a particle in position<local>::position</x>::action</foo>::position<iface>::position</middle_position>.
        create a particle in position<local>::position</x>::action</foo>::position<iface>::position</middle_position>::position</bar_position>.
        create a particle in position<local>::position</x>::action</foo>::position<iface>::position</middle_position>::position</bar_position>::position<mv:define-lang.org:dep_lib:/x>.
        create a particle in position<local>::position</x>::action</foo>::position<trigger_pos>.
    }
}
