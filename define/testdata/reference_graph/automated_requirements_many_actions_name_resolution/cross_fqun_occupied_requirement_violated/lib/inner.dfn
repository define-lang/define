define the potential action<mv:define-lang.org:dep_lib:/inner> {
    define the position<trigger_pos>.
    define the position<item> {
        it may only contain particles where {
            it has the position</x>.
        }
    }
    define the position<dest>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        move the particle in position<item>::position</x> to position<dest>.
    }
}
