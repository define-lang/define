# Cross-FQUN OCCUPIED violation: /inner is in _DEP_FQUN with position</x>.
#
# /inner moves from position<item>::position</x>, creating OCCUPIED requirements
# on position<item>::position</x>. /outer transfers its occupied position<iface>
# into position<item>, but /test does not fill position<iface>::position</x>.
define the potential action<mv:define-lang.org:main_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</outer>::position<iface>.
        create a particle in position<box>::action</outer>::position<trigger_pos>.
    }
}
