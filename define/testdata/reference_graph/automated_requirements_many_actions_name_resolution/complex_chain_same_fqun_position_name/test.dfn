# A deeply-chained trigger path through actions in the same FQUN.
#
# /test triggers /foo through position<local>::position</x>::action</foo>::position<trigger_pos>.
# /foo transfers position</middle_position> to /middle, which transfers
# position</bar_position> to /bar. /bar requires position</leaf> to be empty.
# The propagated position name should preserve the complete position-child path.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<local> {
            it may only contain particles where {
                it has the position</x>.
            }
        }
        create a particle in position<local>.
        create a particle in position<local>::position</x>.
        create a particle in position<local>::position</x>::action</foo>::position<iface>.
        create a particle in position<local>::position</x>::action</foo>::position<iface>::position</middle_position>.
        create a particle in position<local>::position</x>::action</foo>::position<iface>::position</middle_position>::position</bar_position>.
        create a particle in position<local>::position</x>::action</foo>::position<iface>::position</middle_position>::position</bar_position>::position</leaf>.
        create a particle in position<local>::position</x>::action</foo>::position<trigger_pos>.
    }
}
