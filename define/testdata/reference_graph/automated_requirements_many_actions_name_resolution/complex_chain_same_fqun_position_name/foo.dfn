define the potential action<my.domain.com:my_lib:/foo> {
    define the position<trigger_pos>.
    define the position<iface> {
        it may only contain particles where {
            it has the position</middle_position>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        define the position<middle_holder> {
            it may only contain particles where {
                it has the action</middle>.
            }
        }
        create a particle in position<middle_holder>.
        move the particle in position<iface>::position</middle_position> to position<middle_holder>::action</middle>::position<mid_iface>.
        create a particle in position<middle_holder>::action</middle>::position<trigger_pos>.
    }
}
