# action</mid> is the knower of the Destructor on the particle it receives, but no action below /test knows position</file>.
# action</mid> gains the Destructor's requirement that position</file> is occupied,
# and /test violates it where it triggers action</mid>, like any other
# requirement action</mid> has of its caller.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<outer_box> {
            it may only contain particles where {
                it has the action</mid>.
            }
        }
        define the position<my_file> {
            it may only contain particles where {
                it has the action</destructor>.
            }
        }
        create a particle in position<outer_box>.
        create a particle in position<my_file>.
        move the particle in position<my_file> to position<outer_box>::action</mid>::position<incoming>.
        create a particle in position<outer_box>::action</mid>::position<run>.
    }
}
