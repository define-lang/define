# Destroying a child (the particle in target's plain position</c>) before the parent means the child's caller-attached destructor is verified once through the child's own destruction; the parent cascade finds position</c> recorded empty and does not run that destructor a second time.
# Exactly one diagnostic: the child's destructor is verified through the
# explicit destruction of target's position</c>, not a second time through
# the parent's cascade (which skips the now-empty position</c>).
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</close_file>.
            }
        }
        define the position<staging> {
            it may only contain particles where {
                it has the action</d>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</close_file>::position<target>.
        create a particle in position<staging>.
        move the particle in position<staging> to position<box>::action</close_file>::position<target>::position</c>.
        create a particle in position<box>::action</close_file>::position<run>.
    }
}
