# A constructor attaches a destructor to a carrier particle and hands it to close_file; the constructor verifies the caller-attached destructor through the Destruction Contract, reporting its unmet requirement.
# The constructor action</test> is the attacher (it created the carrier).
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</carrier>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</close_file>.
            }
        }
        create a particle in position<box>.
        create a particle in position</carrier>.
        move the particle in position</carrier> to position<box>::action</close_file>::position<target>.
        create a particle in position<box>::action</close_file>::position<run>.
    }
}
