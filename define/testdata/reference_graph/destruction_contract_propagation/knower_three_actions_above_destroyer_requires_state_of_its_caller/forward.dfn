define the potential action<my.domain.com:my_lib:/forward> {
    define the position<incoming>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</relay>.
            }
        }
        create a particle in position<box>.
        move the particle in position<incoming> to position<box>::action</relay>::position<incoming>.
        create a particle in position<box>::action</relay>::position<run>.
    }
}
