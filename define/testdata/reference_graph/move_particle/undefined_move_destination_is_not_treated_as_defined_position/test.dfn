define the potential action<my.domain.com:my_lib:/test> {
    define the position<from_pos>.
    define the position<other_position> {
        it may only contain particles where {
            it has the position</thing>.
        }
    }
    it happens when {
        the position<from_pos> has a particle.
    } and it does {
        create a particle in position<other_position>.
        move the particle in position<from_pos> to position<no_such_pos>.
    }
}
