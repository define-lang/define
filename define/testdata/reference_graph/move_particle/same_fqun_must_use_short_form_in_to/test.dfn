define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<from_pos>.
        define the position<gateway> {
            it may only contain particles where {
                it has the position</other>.
            }
        }
        create a particle in position<from_pos>.
        create a particle in position<gateway>.
        move the particle in position<from_pos> to position<gateway>::position<my.domain.com:my_lib:/other>.
    }
}
