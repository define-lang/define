define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<to_pos>.
        define the position<gateway> {
            it may only contain particles where {
                it has the position</other>.
            }
        }
        create a particle in position<gateway>.
        create a particle in position<gateway>::position</other>.
        move the particle in position<gateway>::position<my.domain.com:my_lib:/other> to position<to_pos>.
    }
}
