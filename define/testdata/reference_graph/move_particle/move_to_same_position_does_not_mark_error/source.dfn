define the potential action<mv:define-lang.org:test_files:/invalid/particles/move/move_to_same_position> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<pos>.
        create a particle in position<pos>.
        move the particle in position<pos> to position<pos>.
    }
}
