define the potential action<my.domain.com:my_lib:/work> {
    define the position<run>.
    define the position<source> {
        it may only contain particles where {
            it has the position</shared>.
        }
    }
    define the position<dest> {
        it may only contain particles where {
            it has the position</shared>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<source>.
        create a particle in position<source>::position</shared>.
        move the particle in position<source> to position<dest>.
        destroy the particle in position<dest>::position</shared>.
        destroy the particle in position<dest>.
        destroy the particle in position<run>.
    }
}
