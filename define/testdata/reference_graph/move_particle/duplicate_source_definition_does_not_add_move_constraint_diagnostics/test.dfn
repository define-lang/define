define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<_noop>.
        create a particle in position<_noop>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    define the position<from_pos>.
    define the position<gateway> {
        it may only contain particles where {
            it has the position</dest>.
        }
    }
    it happens when {
        the position<from_pos> has a particle.
    } and it does {
        move the particle in position<from_pos> to position<gateway>::position</dest>.
    }
}
