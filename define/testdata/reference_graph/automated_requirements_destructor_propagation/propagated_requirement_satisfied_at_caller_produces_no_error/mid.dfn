define the potential action<my.domain.com:my_lib:/mid> {
    define the position<incoming> {
        it may only contain particles where {
            it has the action</destructor>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<incoming>.
    }
}
