define the potential action<my.domain.com:my_lib:/check> {
    it also assigns the position</marker>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<_holder>.
        destroy the particle in position<run>.
        move the particle in position</marker> to position<_holder>.
        move the particle in position<_holder> to position</marker>.
    }
}
