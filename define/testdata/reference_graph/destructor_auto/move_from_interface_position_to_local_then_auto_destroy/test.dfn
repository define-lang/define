# A caller-passed particle moved from an interface position into a local fires its destructor at end of block.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<incoming> {
        it may only contain particles where {
            it has the action</destructor>.
        }
    }
    it happens when {
        this particle is created.
    } and it does {
        define the position<local>.
        move the particle in position<incoming> to position<local>.
    }
}
