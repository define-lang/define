# A destructor's requirement on a caller-passed particle propagates to its caller's caller.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</inner>.
            }
        }
        define the position<my_file> {
            it may only contain particles where {
                it has the action</destructor_empty>.
                it has the position</item>.
            }
        }
        create a particle in position<box>.
        create a particle in position<my_file>.
        create a particle in position<my_file>::position</item>.
        move the particle in position<my_file> to position<box>::action</inner>::position<incoming>.
        create a particle in position<box>::action</inner>::position<run>.
    }
}
