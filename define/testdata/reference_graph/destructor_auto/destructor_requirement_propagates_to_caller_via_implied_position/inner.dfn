define the potential action<my.domain.com:my_lib:/inner> {
    define the position<incoming> {
        it may only contain particles where {
            it has the action</destructor>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<local> {
            it may only contain particles where {
                it has the action</destructor>.
            }
        }
        move the particle in position<incoming> to position<local>.
    }
}
