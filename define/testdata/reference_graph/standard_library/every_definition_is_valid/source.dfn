define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</bits>.
    it also assigns the position</masked>.
    it also assigns the position</combined>.
    it also assigns the position</differing>.
    it also assigns the position</bits_match>.
    it also assigns the position</flag>.
    it also assigns the position</both>.
    it also assigns the position</either>.
    it also assigns the position</exactly_one>.
    it also assigns the position</count>.
    it also assigns the position</offset>.
    it also assigns the position</natural_sum>.
    it also assigns the position</natural_product>.
    it also assigns the position</natural_difference>.
    it also assigns the position</natural_saturated_difference>.
    it also assigns the position</natural_smaller>.
    it also assigns the position</natural_larger>.
    it also assigns the position</natural_equal>.
    it also assigns the position</natural_below>.
    it also assigns the position</natural_at_most>.
    it also assigns the position</integer_sum>.
    it also assigns the position</integer_product>.
    it also assigns the position</integer_difference>.
    it also assigns the position</integer_smaller>.
    it also assigns the position</integer_larger>.
    it also assigns the position</integer_equal>.
    it also assigns the position</integer_below>.
    it also assigns the position</integer_at_most>.
    it also assigns the position</integer_magnitude>.
    it also assigns the position</letter>.
    it also assigns the position</letter_equal>.
    it also assigns the position</letter_below>.
    it also assigns the position</letter_at_most>.
    it also assigns the position</letter_at_least>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</bits>.
        set the value of position</bits> to literal<standard:/binary>"1011".
        create a particle in position</masked>.
        create a particle in position</combined>.
        create a particle in position</differing>.
        create a particle in position</bits_match>.
        execute the operation<standard:/binary/and> {
            with view<a> looking at position</bits>.
            with view<b> looking at literal<standard:/binary>"110".
            with view<result> looking at position</masked>.
        }
        execute the operation<standard:/binary/or> {
            with view<a> looking at position</bits>.
            with view<b> looking at literal<standard:/binary>"110".
            with view<result> looking at position</combined>.
        }
        execute the operation<standard:/binary/exclusive_or> {
            with view<a> looking at position</bits>.
            with view<b> looking at literal<standard:/binary>"110".
            with view<result> looking at position</differing>.
        }
        execute the operation<standard:/binary/equal> {
            with view<a> looking at position</bits>.
            with view<b> looking at literal<standard:/binary>"1011".
            with view<result> looking at position</bits_match>.
        }
        create a particle in position</flag>.
        create a particle in position</both>.
        create a particle in position</either>.
        create a particle in position</exactly_one>.
        set the value of position</flag> to literal<standard:/boolean>"true".
        execute the operation<standard:/boolean/not> {
            with view<value> looking at position</flag>.
        }
        execute the operation<standard:/boolean/and> {
            with view<a> looking at position</flag>.
            with view<b> looking at literal<standard:/boolean>"false".
            with view<result> looking at position</both>.
        }
        execute the operation<standard:/boolean/or> {
            with view<a> looking at position</flag>.
            with view<b> looking at literal<standard:/boolean>"false".
            with view<result> looking at position</either>.
        }
        execute the operation<standard:/boolean/exclusive_or> {
            with view<a> looking at position</flag>.
            with view<b> looking at literal<standard:/boolean>"false".
            with view<result> looking at position</exactly_one>.
        }
        create a particle in position</count>.
        create a particle in position</offset>.
        set the value of position</count> to literal<standard:/number>"3".
        set the value of position</offset> to literal<standard:/number>"-3".
        create a particle in position</natural_sum>.
        create a particle in position</natural_product>.
        create a particle in position</natural_difference>.
        create a particle in position</natural_saturated_difference>.
        create a particle in position</natural_smaller>.
        create a particle in position</natural_larger>.
        create a particle in position</natural_equal>.
        create a particle in position</natural_below>.
        create a particle in position</natural_at_most>.
        create a particle in position</integer_sum>.
        create a particle in position</integer_product>.
        create a particle in position</integer_difference>.
        create a particle in position</integer_smaller>.
        create a particle in position</integer_larger>.
        create a particle in position</integer_equal>.
        create a particle in position</integer_below>.
        create a particle in position</integer_at_most>.
        create a particle in position</integer_magnitude>.
        execute the operation<standard:/number/natural/add> {
            with view<a> looking at position</count>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</natural_sum>.
        }
        execute the operation<standard:/number/natural/multiply> {
            with view<a> looking at position</count>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</natural_product>.
        }
        execute the operation<standard:/number/natural/subtract> {
            with view<a> looking at position</count>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</natural_difference>.
        }
        execute the operation<standard:/number/natural/subtract_saturating> {
            with view<a> looking at position</count>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</natural_saturated_difference>.
        }
        execute the operation<standard:/number/natural/minimum> {
            with view<a> looking at position</count>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</natural_smaller>.
        }
        execute the operation<standard:/number/natural/maximum> {
            with view<a> looking at position</count>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</natural_larger>.
        }
        execute the operation<standard:/number/natural/equal> {
            with view<a> looking at position</count>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</natural_equal>.
        }
        execute the operation<standard:/number/natural/less_than> {
            with view<a> looking at position</count>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</natural_below>.
        }
        execute the operation<standard:/number/natural/less_than_or_equal> {
            with view<a> looking at position</count>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</natural_at_most>.
        }
        execute the operation<standard:/number/natural/increment> {
            with view<value> looking at position</count>.
        }
        execute the operation<standard:/number/natural/decrement_saturating> {
            with view<value> looking at position</count>.
        }
        execute the operation<standard:/number/integer/add> {
            with view<a> looking at position</offset>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</integer_sum>.
        }
        execute the operation<standard:/number/integer/multiply> {
            with view<a> looking at position</offset>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</integer_product>.
        }
        execute the operation<standard:/number/integer/subtract> {
            with view<a> looking at position</offset>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</integer_difference>.
        }
        execute the operation<standard:/number/integer/minimum> {
            with view<a> looking at position</offset>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</integer_smaller>.
        }
        execute the operation<standard:/number/integer/maximum> {
            with view<a> looking at position</offset>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</integer_larger>.
        }
        execute the operation<standard:/number/integer/equal> {
            with view<a> looking at position</offset>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</integer_equal>.
        }
        execute the operation<standard:/number/integer/less_than> {
            with view<a> looking at position</offset>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</integer_below>.
        }
        execute the operation<standard:/number/integer/less_than_or_equal> {
            with view<a> looking at position</offset>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</integer_at_most>.
        }
        execute the operation<standard:/number/integer/absolute_value> {
            with view<value> looking at position</offset>.
            with view<result> looking at position</integer_magnitude>.
        }
        execute the operation<standard:/number/integer/increment> {
            with view<value> looking at position</offset>.
        }
        execute the operation<standard:/number/integer/decrement> {
            with view<value> looking at position</offset>.
        }
        execute the operation<standard:/number/integer/negate> {
            with view<value> looking at position</offset>.
        }
        create a particle in position</letter>.
        create a particle in position</letter_equal>.
        create a particle in position</letter_below>.
        create a particle in position</letter_at_most>.
        create a particle in position</letter_at_least>.
        set the value of position</letter> to literal<standard:/text>"q".
        execute the operation<standard:/text/unicode/scalar/equal> {
            with view<a> looking at position</letter>.
            with view<b> looking at literal<standard:/text>"r".
            with view<result> looking at position</letter_equal>.
        }
        execute the operation<standard:/text/unicode/scalar/less_than> {
            with view<a> looking at position</letter>.
            with view<b> looking at literal<standard:/text>"r".
            with view<result> looking at position</letter_below>.
        }
        execute the operation<standard:/text/unicode/scalar/less_than_or_equal> {
            with view<a> looking at position</letter>.
            with view<b> looking at literal<standard:/text>"r".
            with view<result> looking at position</letter_at_most>.
        }
        execute the operation<standard:/text/unicode/scalar/greater_than_or_equal> {
            with view<a> looking at position</letter>.
            with view<b> looking at literal<standard:/text>"r".
            with view<result> looking at position</letter_at_least>.
        }
    }
}
