define the operation<my.domain.com:my_lib:/add_and_negate_in_place> {
    define the view<value> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }

    it does {
        define the view<sum> {
            it may only contain particles where {
                it has the value<standard:/number/integer>.
            }
        }
        execute the logical_operation<standard:/number/add> {
            with view<a> looking at view<value>.
            with view<b> looking at view<number>.
            with view<result> looking at view<sum>.
        }
        define the view<negated> {
            it may only contain particles where {
                it has the value<standard:/number/integer>.
            }
        }
        execute the logical_operation<standard:/number/negate> {
            with view<a> looking at view<sum>.
            with view<result> looking at view<negated>.
        }
        set the value of view<value> from view<negated>.
    }
}
