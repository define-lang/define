# A View Setting Statement may not write a read/write interface view that an earlier statement wrote.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</negate_in_place_value>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</negate_in_place_value>.
        set the value of position</negate_in_place_value> from literal<standard:/number>"1".
        execute the operation</negate_in_place> {
            with view<value> looking at position</negate_in_place_value>.
        }
    }
}
