# A View Setting Statement reads the output-only interface view<result> before
# a statement writes it, and no statement ever writes it. The read is reported,
# and view<result> is not also reported as unwritten.
# The execution after the View Setting Statement does not look at
# view<result>, which structural validation reports. An execution that looked
# at view<result> would also decide whether view<result> is reported as
# unwritten.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</negate_result>.
    it also assigns the position</negate_negated>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</negate_result>.
        create a particle in position</negate_negated>.
        execute the operation</negate> {
            with view<result> looking at position</negate_result>.
            with view<negated> looking at position</negate_negated>.
        }
    }
}
