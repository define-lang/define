# A View Setting Statement whose target is a read/write interface view and whose source is not a local view is reported only by structural validation.
define the logical_operation<my.domain.com:my_lib:/negate> {
    define the view<value> {
        it is read.
    }
    define the view<result> {
        it is written.
    }
}
define the potential value<my.domain.com:my_lib:/number> {
    it supports the logical_operation</negate> {
        it may be read.
        it may be written.
    }
}
define the operation<my.domain.com:my_lib:/copy_in_place> {
    define the view<value> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value</number>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }

    it does {
        execute the logical_operation</negate> {
            with view<value> looking at view<value>.
            with view<result> looking at view<result>.
        }
        set the value of view<value> from view<number>.
    }
}
