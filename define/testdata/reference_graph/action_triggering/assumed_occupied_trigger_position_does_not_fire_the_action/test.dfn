# position<box>::action</inner>::position<run> is only assumed occupied,
# as a requirement of the deep create, never filled by a body operation.
# An assumed occupancy does not fire a trigger, so /inner never runs.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<start>.
    define the position<box> {
        it may only contain particles where {
            it has the action</inner>.
        }
    }
    it happens when {
        the position<start> has a particle.
    } and it does {
        create a particle in position<box>::action</inner>::position<run>::position</a>.
    }
}
