define the potential action<my.domain.com:my_lib:/act_c> {
    define the position<pp>.
    define the position<gateway> {
        it may only contain particles where {
            it has the action</shared>.
        }
    }
    it happens when {
        the position<pp> has a particle.
    } and it does {
        create a particle in position<gateway>.
        create a particle in position<gateway>::action</shared>::position<trigger_pos>.
        destroy the particle in position<gateway>.
        destroy the particle in position<pp>.
    }
}
