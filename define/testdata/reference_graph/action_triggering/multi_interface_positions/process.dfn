define the potential action<my.domain.com:my_lib:/process> {
    define the position<input>.
    define the position<config>.
    define the position<trigger>.
    it happens when {
        the position<trigger> has a particle.
    } and it does {
        define the position<result>.
        create a particle in position<result>.
        destroy the particle in position<input>.
        create a particle in position<config>.
        destroy the particle in position<config>.
        destroy the particle in position<trigger>.
    }
}
