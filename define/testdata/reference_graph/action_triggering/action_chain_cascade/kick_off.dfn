define the potential action<my.domain.com:my_lib:/kick_off> {
    define the position<trigger>.
    define the position<output> {
        it may only contain particles where {
            it has the action</react_a>.
            it has the action</react_b>.
        }
    }
    it happens when {
        the position<trigger> has a particle.
    } and it does {
        create a particle in position<output>.
        create a particle in position<output>::action</react_a>::position<trigger>.
        create a particle in position<output>::action</react_b>::position<trigger>.
        destroy the particle in position<output>.
        destroy the particle in position<trigger>.
    }
}
