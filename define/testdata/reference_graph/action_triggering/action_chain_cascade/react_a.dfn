define the potential action<my.domain.com:my_lib:/react_a> {
    define the position<trigger>.
    define the position<result> {
        it may only contain particles where {
            it has the action</final>.
        }
    }
    it happens when {
        the position<trigger> has a particle.
    } and it does {
        create a particle in position<result>.
        create a particle in position<result>::action</final>::position<trigger>.
        destroy the particle in position<result>.
        destroy the particle in position<trigger>.
    }
}
