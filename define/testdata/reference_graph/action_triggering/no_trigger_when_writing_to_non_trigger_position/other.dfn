define the potential action<my.domain.com:my_lib:/other> {
    define the position<non_trigger>.
    define the position<actual_trigger>.
    it happens when {
        the position<actual_trigger> has a particle.
    } and it does {
        define the position<_noop>.
        create a particle in position<_noop>.
        create a particle in position<non_trigger>.
    }
}
