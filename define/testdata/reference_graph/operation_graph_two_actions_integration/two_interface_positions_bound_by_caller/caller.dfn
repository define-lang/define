define the potential action<my.domain.com:my_lib:/caller> {
    define the position<run>.
    define the position<first_gateway> {
        it may only contain particles where {
            it has the action</worker>.
        }
    }
    define the position<second_gateway> {
        it may only contain particles where {
            it has the action</worker>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<first_gateway>.
        create a particle in position<first_gateway>::action</worker>::position<second>.
        create a particle in position<first_gateway>::action</worker>::position<third>.
        create a particle in position<first_gateway>::action</worker>::position<first>.
        destroy the particle in position<first_gateway>::action</worker>::position<first>.
        create a particle in position<second_gateway>.
        create a particle in position<second_gateway>::action</worker>::position<second>.
        create a particle in position<second_gateway>::action</worker>::position<third>.
        create a particle in position<second_gateway>::action</worker>::position<first>.
        destroy the particle in position<second_gateway>::action</worker>::position<first>.
        destroy the particle in position<first_gateway>.
        destroy the particle in position<second_gateway>.
        destroy the particle in position<run>.
    }
}
