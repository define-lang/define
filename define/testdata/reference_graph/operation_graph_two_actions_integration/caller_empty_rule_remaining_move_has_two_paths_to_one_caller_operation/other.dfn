define the potential action<my.domain.com:my_lib:/other> {
    it also assigns the position</input>.
    define the position<holder_a>.
    define the position<holder_b>.
    define the position<holder_c>.
    define the position<trigger_pos>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        move the particle in position</input>::position</a> to position<holder_a>.
        move the particle in position<holder_a> to position<holder_b>.
        create a particle in position</input>::position</a>.
        destroy the particle in position</input>::position</a>.
        move the particle in position<holder_b> to position</input>::position</a>.
        move the particle in position</input>::position</a> to position<holder_c>.
        destroy the particle in position</input>.
        destroy the particle in position<holder_c>.
    }
}
