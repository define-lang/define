# The callee fills a grandchild-depth contracted position, so its EMPTY
# requirement resolves to the caller empty of that same grandchild.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    define the position<gateway> {
        it may only contain particles where {
            it has the action</other>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<gateway>.
        create a particle in position<gateway>::action</other>::position<box>.
        create a particle in position<gateway>::action</other>::position<box>::position</child>.
        create a particle in position<gateway>::action</other>::position<box>::position</child>::position</grandchild>.
        destroy the particle in position<gateway>::action</other>::position<box>::position</child>::position</grandchild>.
        create a particle in position<gateway>::action</other>::position<trigger_pos>.
    }
}
