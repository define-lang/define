define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<gateway> {
            it may only contain particles where {
                it has the action</other>.
            }
        }
        define the position<box> {
            it may only contain particles where {
                it has the position</item>.
            }
        }
        define the position<destination>.
        create a particle in position<gateway>.
        create a particle in position<box>.
        move the particle in position<box> to position<destination>.
        move the particle in position<destination> to position<gateway>::action</other>::position<box>.
        destroy the particle in position<gateway>::action</other>::position<destination>.
    }
}
