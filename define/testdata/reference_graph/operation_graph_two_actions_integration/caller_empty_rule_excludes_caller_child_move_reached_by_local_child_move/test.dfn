# The callee's final child Move depends on the caller Move that emptied origin.
# Their operated positions are disjoint, so resolving the caller dependency must
# still exclude the caller Move from the callee Destroy's direct dependencies.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</input>.
    it also assigns the action</other>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</input>.
        create a particle in position</input>::position</origin>.
        move the particle in position</input>::position</origin> to position</input>::position</start>.
        create a particle in action</other>::position<trigger_pos>.
    }
}
