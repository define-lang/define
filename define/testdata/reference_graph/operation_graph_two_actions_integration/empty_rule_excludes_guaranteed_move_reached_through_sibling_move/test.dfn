define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</holder>.
    it also assigns the position</input>.
    it also assigns the action</producer>.
    it also assigns the position</source>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</input>.
        create a particle in position</input>::position</a>.
        create a particle in action</producer>::position<trigger_pos>.
        move the particle in position</holder> to position</source>.
        move the particle in position</source> to position</input>::position</b>.
        destroy the particle in position</input>.
    }
}
