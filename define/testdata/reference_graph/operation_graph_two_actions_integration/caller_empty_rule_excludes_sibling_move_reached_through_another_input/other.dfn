define the potential action<my.domain.com:my_lib:/other> {
    it also assigns the position</input>.
    it also assigns the position</source>.
    define the position<sink>.
    define the position<trigger_pos>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        move the particle in position</source> to position</input>::position</b>.
        move the particle in position</input>::position</b> to position<sink>.
        destroy the particle in position</input>.
        destroy the particle in position<sink>.
    }
}
