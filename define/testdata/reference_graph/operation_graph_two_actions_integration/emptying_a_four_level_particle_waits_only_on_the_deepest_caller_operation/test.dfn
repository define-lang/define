# Each deeper caller fill waits on the shallower fill before it. Emptying
# <parent> therefore needs only the deepest caller operation.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</parent>.
    it also assigns the action</other>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</parent>.
        create a particle in position</parent>::position</child>.
        create a particle in position</parent>::position</child>::position</grandchild>.
        create a particle in position</parent>::position</child>::position</grandchild>::position</greatgrandchild>.
        create a particle in action</other>::position<trigger_pos>.
        destroy the particle in action</other>::position<out>.
        destroy the particle in action</other>::position<trigger_pos>.
    }
}
