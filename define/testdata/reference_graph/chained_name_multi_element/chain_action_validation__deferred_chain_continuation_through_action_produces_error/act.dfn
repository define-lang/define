define the potential action<my.domain.com:my_lib:/act> {
    define the position<inner> {
        it may only contain particles where {
            it has the position</target>.
        }
    }
    it happens when {
        the position<inner> has a particle.
    } and it does {
        create a particle in position<inner>::position</target>.
        destroy the particle in position<inner>::position</target>.
        destroy the particle in position<inner>.
    }
}
