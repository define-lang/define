define the potential action<my.domain.com:my_lib:/implied_action> {
    it also assigns the position</implied_a>.
    define the position<trigger_pos>.
    define the position<out>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        move the particle in position</implied_a> to position<out>.
        destroy the particle in position<trigger_pos>.
    }
}
