define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    define the position<box_a> {
        it may only contain particles where {
            it has the action</worker>.
        }
    }
    define the position<box_b> {
        it may only contain particles where {
            it has the action</worker>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<box_a>.
        create a particle in position<box_a>::action</worker>::position<input>.
        create a particle in position<box_b>.
        create a particle in position<box_b>::action</worker>::position<input>.
        destroy the particle in position<box_a>::action</worker>::position<result>.
    }
}
