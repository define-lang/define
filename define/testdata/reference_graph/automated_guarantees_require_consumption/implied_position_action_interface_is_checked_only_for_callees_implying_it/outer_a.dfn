define the potential action<my.domain.com:my_lib:/outer_a> {
    it also assigns the position</first>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position</first>::action</inner>::position<run>.
        destroy the particle in position</first>::action</inner>::position<item>.
        destroy the particle in position<run>.
    }
}
