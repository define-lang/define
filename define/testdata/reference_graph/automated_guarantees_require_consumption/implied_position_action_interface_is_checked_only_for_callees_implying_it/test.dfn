define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</outer_a>.
                it has the action</outer_b>.
                it has the position</first>.
                it has the position</second>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</first>.
        create a particle in position<box>::position</second>.
        create a particle in position<box>::position</second>::action</inner>::position<run>.
        create a particle in position<box>::action</outer_a>::position<run>.
        create a particle in position<box>::action</outer_b>::position<run>.
        destroy the particle in position<box>.
    }
}
