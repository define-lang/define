define the potential action<my.domain.com:my_lib:/child> {
    define the position<run>.
    define the position<result>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<temporary>.
        move the particle in position<result> to position<temporary>.
        move the particle in position<temporary> to position<result>.
        destroy the particle in position<run>.
    }
}
