define the potential action<my.domain.com:my_lib:/child> {
    define the position<run>.
    define the position<holder> {
        it may only contain particles where {
            it has the action</worker>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<holder>::action</worker>::position<run>.
        destroy the particle in position<holder>::action</worker>::position<result>.
        destroy the particle in position<run>.
    }
}
