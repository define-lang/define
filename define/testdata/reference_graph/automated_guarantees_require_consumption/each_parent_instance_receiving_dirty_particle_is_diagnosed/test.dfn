define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box_a> {
            it may only contain particles where {
                it has the action</parent>.
            }
        }
        define the position<box_b> {
            it may only contain particles where {
                it has the action</parent>.
            }
        }
        create a particle in position<box_a>.
        create a particle in position<box_a>::action</parent>::position<iface>.
        create a particle in position<box_a>::action</parent>::position<iface>::action</child>::position<result>.
        create a particle in position<box_a>::action</parent>::position<iface>::action</child>::position<run>.
        create a particle in position<box_a>::action</parent>::position<run>.
        create a particle in position<box_b>.
        create a particle in position<box_b>::action</parent>::position<iface>.
        create a particle in position<box_b>::action</parent>::position<iface>::action</child>::position<result>.
        create a particle in position<box_b>::action</parent>::position<iface>::action</child>::position<run>.
        create a particle in position<box_b>::action</parent>::position<run>.
    }
}
