define the potential action<my.domain.com:my_lib:/middle> {
    it also assigns the position</slot>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<run>.
        create a particle in position</slot>.
        create a particle in position</slot>::action</worker>::position<run>.
    }
}
