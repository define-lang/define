define the potential action<my.domain.com:my_lib:/helper> {
    it also assigns the position</implied>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position</implied>::action</inner>::position<run>.
        destroy the particle in position</implied>::action</inner>::position<item>.
        destroy the particle in position<run>.
    }
}
