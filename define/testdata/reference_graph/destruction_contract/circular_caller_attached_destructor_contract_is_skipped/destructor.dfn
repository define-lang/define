define the potential action<my.domain.com:my_lib:/destructor> {
    define the position<dependency> {
        it may only contain particles where {
            it has the action</caller>.
        }
    }
    it happens when {
        this particle is being destroyed.
    } and it does {
        define the position<_holder>.
        move the particle in position<dependency> to position<_holder>.
        move the particle in position<_holder> to position<dependency>.
    }
}
