# A caller-attached destructor requires position</file>::position</detail> occupied only because destroying the file particle runs that particle's own destructor. /test left position</detail> empty, so validating the caller-attached destructor fails, and the assignment of the file particle's destructor appears once in the chain.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</close_file>.
            }
        }
        define the position<my_file> {
            it may only contain particles where {
                it has the action</delete_file_destructor>.
                it has the position</file>.
            }
        }
        create a particle in position<box>.
        create a particle in position<my_file>.
        create a particle in position<my_file>::position</file>.
        move the particle in position<my_file> to position<box>::action</close_file>::position<target>.
        create a particle in position<box>::action</close_file>::position<run>.
    }
}
