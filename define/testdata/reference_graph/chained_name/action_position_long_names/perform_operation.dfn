define the potential action<my.domain.com:my_library_collection:/perform_operation> {
    define the position<operation_trigger> {
        it may only contain particles where {
            it has the position</inner_position>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<result>.
        create a particle in position<result>.
        destroy the particle in position<operation_trigger>::position</inner_position>.
    }
}
