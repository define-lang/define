define the potential action<mv:define-lang.org:test_move_bad_action:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<pos_a> {
            it may only contain particles where {
                it has the action</act_b>.
            }
        }
        define the position<dest>.
        create a particle in position<pos_a>.
        create a particle in position<pos_a>::action</act_b>::position<inner>.
        move the particle in position<pos_a>::action</act_b>::position<no_such> to position<dest>.
    }
}
