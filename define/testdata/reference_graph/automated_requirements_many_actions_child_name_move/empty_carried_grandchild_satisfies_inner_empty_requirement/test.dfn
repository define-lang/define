# Inner creates into input::/b::/c two levels below the moved iface, so leaving iface::/b::/c empty in the caller satisfies it.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<mw> {
            it may only contain particles where {
                it has the action</middle>.
            }
        }
        create a particle in position<mw>.
        create a particle in position<mw>::action</middle>::position<iface>.
        create a particle in position<mw>::action</middle>::position<iface>::position</b>.
        create a particle in position<mw>::action</middle>::position<run>.
    }
}
