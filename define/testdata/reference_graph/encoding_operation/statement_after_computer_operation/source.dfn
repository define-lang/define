# Statements after the computer operation may read what it wrote.
define the encoding_operation<my.domain.com:my_lib:/copy> {
    define the view<source> {
        it is read.
        it may only contain particles where {
            it has the encoding<standard:/number/decimal/ascii>.
        }
    }
    define the view<target> {
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/decimal/ascii>.
        }
    }

    it does {
        execute the computer operation.
    }
}
define the encoding_operation<my.domain.com:my_lib:/copy_twice> {
    define the view<source> {
        it is read.
        it may only contain particles where {
            it has the encoding<standard:/number/decimal/ascii>.
        }
    }
    define the view<middle> {
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/decimal/ascii>.
        }
    }
    define the view<target> {
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/decimal/ascii>.
        }
    }

    it does {
        execute the computer operation.
        execute the encoding_operation</copy> {
            with view<source> looking at view<middle>.
            with view<target> looking at view<target>.
        }
    }
}
