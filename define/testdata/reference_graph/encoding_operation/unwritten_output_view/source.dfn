# view<number> says it is written, but nothing writes to it.
define the encoding_operation<my.domain.com:my_lib:/inspect> {
    define the view<value> {
        it is read.
        it may only contain particles where {
            it has the encoding<standard:/number/decimal/ascii>.
        }
    }

    it does {
        execute the computer operation.
    }
}
define the encoding_operation<my.domain.com:my_lib:/check> {
    define the view<number> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/decimal/ascii>.
        }
    }

    it does {
        execute the encoding_operation</inspect> {
            with view<value> looking at view<number>.
        }
    }
}
