# 'abc' cannot be translated into the decimal ASCII encoding.
define the encoding_operation<my.domain.com:my_lib:/copy> {
    define the view<source> {
        it is read.
        it may only contain particles where {
            it has the encoding<standard:/number/decimal/ascii>.
        }
    }
    define the view<target> {
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/decimal/ascii>.
        }
    }

    it does {
        execute the computer operation.
    }
}
define the encoding_operation<my.domain.com:my_lib:/reset> {
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/decimal/ascii>.
        }
    }

    it does {
        execute the encoding_operation</copy> {
            with view<source> looking at literal<standard:/number>"abc".
            with view<target> looking at view<result>.
        }
    }
}
