define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</inner>.
                it has the position</implied>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</inner>::position<item>.
        create a particle in position<box>::action</inner>::position<trigger_pos>.
        create a particle in position<box>::action</inner>::position<item>.
        create a particle in position<box>::position</implied>.
    }
}
