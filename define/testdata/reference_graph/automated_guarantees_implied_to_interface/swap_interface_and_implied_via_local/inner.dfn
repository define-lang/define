define the potential action<my.domain.com:my_lib:/inner> {
    it also assigns the position</implied>.
    define the position<trigger_pos>.
    define the position<item>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        define the position<_tmp>.
        create a particle in position</implied>.
        move the particle in position<item> to position<_tmp>.
        move the particle in position</implied> to position<item>.
        move the particle in position<_tmp> to position</implied>.
    }
}
