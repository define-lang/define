# The two fill_item calls leave pending occupied guarantees on separate position
# chains. consume_branches applies both guarantees in one requirement batch.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<box> {
        it may only contain particles where {
            it has the action</consume_branches>.
        }
    }
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position<box>.
        create a particle in position<box>::action</consume_branches>::position<left>.
        create a particle in position<box>::action</consume_branches>::position<left>::position</fillable>.
        create a particle in position<box>::action</consume_branches>::position<right>.
        create a particle in position<box>::action</consume_branches>::position<right>::position</fillable>.
        create a particle in position<box>::action</consume_branches>::position<trigger_pos>.
    }
}
