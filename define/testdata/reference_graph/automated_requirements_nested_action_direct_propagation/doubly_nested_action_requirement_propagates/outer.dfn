define the potential action<my.domain.com:my_lib:/outer> {
    define the position<trigger_pos>.
    define the position<out_iface> {
        it may only contain particles where {
            it has the action</middle>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<out_iface>::action</middle>::position<mid_iface>.
        create a particle in position<out_iface>::action</middle>::position<trigger_pos>.
    }
}
