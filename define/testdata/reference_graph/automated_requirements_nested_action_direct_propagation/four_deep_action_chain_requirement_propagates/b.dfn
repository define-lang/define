define the potential action<my.domain.com:my_lib:/b> {
    define the position<trigger_pos>.
    define the position<b_iface> {
        it may only contain particles where {
            it has the action</c>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<b_iface>::action</c>::position<trigger_pos>.
    }
}
