define the potential action<my.domain.com:my_lib:/c> {
    define the position<trigger_pos>.
    define the position<c_iface> {
        it may only contain particles where {
            it has the action</d>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<c_iface>::action</d>::position<trigger_pos>.
    }
}
