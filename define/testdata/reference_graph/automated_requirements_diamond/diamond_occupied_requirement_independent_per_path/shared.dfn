define the potential action<my.domain.com:my_lib:/shared> {
    define the position<trigger_pos>.
    define the position<item> {
        it may only contain particles where {
            it has the position</value>.
        }
    }
    define the position<dest>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        move the particle in position<item>::position</value> to position<dest>.
    }
}
