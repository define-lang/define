define the potential action<my.domain.com:my_lib:/act_b> {
    define the position<pp>.
    define the position<gateway> {
        it may only contain particles where {
            it has the position</value>.
        }
    }
    it happens when {
        the position<pp> has a particle.
    } and it does {
        define the position<shared_holder> {
            it may only contain particles where {
                it has the action</shared>.
            }
        }
        create a particle in position<shared_holder>.
        move the particle in position<gateway> to position<shared_holder>::action</shared>::position<item>.
        create a particle in position<shared_holder>::action</shared>::position<trigger_pos>.
        destroy the particle in position<pp>.
    }
}
