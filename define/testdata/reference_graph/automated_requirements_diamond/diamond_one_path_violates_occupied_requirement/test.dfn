# /shared requires position<item>::position</value> occupied.
#
# /test fills position<gateway>::position</value> for /act_b's path but not for /act_c's path.
# One requirement-violation diagnostic for the /act_c path at /test.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    define the position<box_b> {
        it may only contain particles where {
            it has the action</act_b>.
        }
    }
    define the position<box_c> {
        it may only contain particles where {
            it has the action</act_c>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<box_b>.
        create a particle in position<box_b>::action</act_b>::position<gateway>.
        create a particle in position<box_b>::action</act_b>::position<gateway>::position</value>.
        create a particle in position<box_b>::action</act_b>::position<pp>.
        create a particle in position<box_c>.
        create a particle in position<box_c>::action</act_c>::position<gateway>.
        create a particle in position<box_c>::action</act_c>::position<pp>.
    }
}
