# A malformed view name in an action is reported only by structural validation.
define the potential position<my.domain.com:my_lib:/first> {
    it may only contain particles where {
        it has the value<standard:/number/rational>.
    }
}
define the potential position<my.domain.com:my_lib:/second> {
    it may only contain particles where {
        it has the value<standard:/number/rational>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</first>.
    it also assigns the position</second>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</first>.
        create a particle in position</second>.
        set the value of position</first> to literal<standard:/number>"1".
        execute the operation<standard:/number/rational/add> {
            with view<a> looking at position</first>.
            with view<B> looking at literal<standard:/number>"3".
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</second>.
        }
    }
}
