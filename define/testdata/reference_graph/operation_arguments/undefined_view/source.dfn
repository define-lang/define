# view<extra> is not an interface view of operation</sum>.
define the operation<my.domain.com:my_lib:/sum> {
    define the view<first> {
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    define the view<second> {
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    define the view<result> {
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
define the operation<my.domain.com:my_lib:/total> {
    define the view<result> {
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }

    it does {
        execute the operation</sum> {
            with view<first> looking at literal<standard:/number>"1".
            with view<second> looking at literal<standard:/number>"2".
            with view<result> looking at view<result>.
            with view<extra> looking at literal<standard:/number>"3".
        }
    }
}
