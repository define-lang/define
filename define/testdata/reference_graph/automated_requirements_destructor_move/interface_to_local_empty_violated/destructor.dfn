define the potential action<my.domain.com:my_lib:/destructor> {
    define the position<source> {
        it may only contain particles where {
            it has the position</child>.
        }
    }
    it happens when {
        this particle is being destroyed.
    } and it does {
        define the position<tmp> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        move the particle in position<source> to position<tmp>.
        create a particle in position<tmp>::position</child>.
        destroy the particle in position<tmp>::position</child>.
        move the particle in position<tmp> to position<source>.
    }
}
