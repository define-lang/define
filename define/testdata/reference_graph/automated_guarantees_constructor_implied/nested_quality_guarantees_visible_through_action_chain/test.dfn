# /a requires /dep. Constructors fill each implied position. /inner creates a particle requiring /a. /outer sees the full chain.
# /inner created a particle in position<item> requiring /a.
# /a's constructor filled position</a>. /a requires /dep.
# /dep's constructor filled position</dep>.
# So the full chain ...::position</a>::position</dep> is occupied.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</inner>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</inner>::position<trigger_pos>.
        create a particle in position<box>::action</inner>::position<item>::position</a>::position</dep>.
    }
}
