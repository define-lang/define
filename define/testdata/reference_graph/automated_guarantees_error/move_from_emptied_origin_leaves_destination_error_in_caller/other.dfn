define the potential action<my.domain.com:my_lib:/other> {
    define the position<trigger_pos> {
        it may only contain particles where {
            it has the position</src>.
            it has the position</dst>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        move the particle in position<trigger_pos>::position</src> to position<trigger_pos>::position</dst>.
    }
}
