# action</make> leaves error state below the particle it creates in
# position</box>. Destroying the particle in position</box>::position</inner>
# afterward reports nothing more, instead of reporting an empty position.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</make>.
                it has the position</box>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</make>::position<run>.
        destroy the particle in position<holder>::position</box>::position</inner>.
    }
}
