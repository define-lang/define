# The Move to position<holder>::position</q>::position</r> reports that
# position<holder>::position</q> holds no particle. Nothing is known about
# whether position<holder>::position</q> is occupied. action</fill> then puts
# a particle in position<holder>::position</q>::position</s>, which gives
# position<holder>::position</q> error state. Destroying the particle in
# position<holder>::position</q> afterward reports nothing.
define the potential position<my.domain.com:my_lib:/r>.
define the potential position<my.domain.com:my_lib:/s>.
define the potential position<my.domain.com:my_lib:/q> {
    it may only contain particles where {
        it has the position</r>.
        it has the position</s>.
    }
}
define the potential action<my.domain.com:my_lib:/fill> {
    it also assigns the position</q>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<run>.
        create a particle in position</q>::position</s>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</fill>.
                it has the position</q>.
            }
        }
        define the position<x>.
        create a particle in position<holder>.
        create a particle in position<x>.
        move the particle in position<x> to position<holder>::position</q>::position</r>.
        create a particle in position<holder>::action</fill>::position<run>.
        destroy the particle in position<holder>::position</q>.
    }
}
