define the potential action<my.domain.com:my_lib:/other> {
    define the position<trigger_pos>.
    define the position<item>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        define the position<local>.
        define the position<sink>.
        create a particle in position<local>.
        move the particle in position<local> to position<sink>.
        move the particle in position<local> to position<item>.
    }
}
