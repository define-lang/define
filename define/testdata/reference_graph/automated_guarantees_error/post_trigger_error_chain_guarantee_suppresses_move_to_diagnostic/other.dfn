define the potential action<my.domain.com:my_lib:/other> {
    define the position<trigger_pos> {
        it may only contain particles where {
            it has the position</x>.
        }
    }
    define the position<sink>.
    define the position<sink2>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<trigger_pos>::position</x>.
        move the particle in position<trigger_pos>::position</x> to position<sink>.
        move the particle in position<trigger_pos>::position</x> to position<sink2>.
    }
}
