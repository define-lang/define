# When a callee moves a particle out of a child of an implied action's interface position that the caller never filled, only that interface position becomes error, so the implied action's other interface positions are still checked.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</other>.
                it has the action</impl>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</other>::position<trigger_pos>.
        destroy the particle in position<box>::action</impl>::position<trigger_pos>.
    }
}
