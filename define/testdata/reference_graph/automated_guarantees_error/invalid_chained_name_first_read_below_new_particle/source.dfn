# action</make> leaves a particle in position</p>::position</c>. The invalid
# chained name below that particle is the first thing in action</test> that
# reads below position</p>. The particle in position</p>::position</c> is still
# there afterward, so moving it reports nothing.
define the potential position<my.domain.com:my_lib:/zz>.
define the potential position<my.domain.com:my_lib:/c>.
define the potential position<my.domain.com:my_lib:/p> {
    it may only contain particles where {
        it has the position</c>.
    }
}
define the potential action<my.domain.com:my_lib:/make> {
    it also assigns the position</p>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<run>.
        create a particle in position</p>.
        create a particle in position</p>::position</c>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</make>.
                it has the position</p>.
            }
        }
        define the position<d>.
        create a particle in position<holder>.
        create a particle in position<holder>::action</make>::position<run>.
        create a particle in position<holder>::position</p>::position</c>::position</zz>.
        move the particle in position<holder>::position</p>::position</c> to position<d>.
    }
}
