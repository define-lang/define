# Destroying a particle in close_file's own implied position</slot> (not an interface position); with the required child filled, the caller-attached destructor verifies satisfied.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the position</slot>.
                it has the action</close_file>.
            }
        }
        define the position<my_file> {
            it may only contain particles where {
                it has the position</file>.
                it has the action</delete_destructor>.
            }
        }
        create a particle in position<box>.
        create a particle in position<my_file>.
        create a particle in position<my_file>::position</file>.
        move the particle in position<my_file> to position<box>::position</slot>.
        create a particle in position<box>::action</close_file>::position<run>.
    }
}
