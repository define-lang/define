# When both destroyed particles have their caller-attached destructor's required position filled, neither destruction produces a diagnostic.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</close_two>.
            }
        }
        define the position<one> {
            it may only contain particles where {
                it has the position</file>.
                it has the action</destructor>.
            }
        }
        define the position<two> {
            it may only contain particles where {
                it has the position</file>.
                it has the action</destructor>.
            }
        }
        create a particle in position<box>.
        create a particle in position<one>.
        create a particle in position<one>::position</file>.
        create a particle in position<two>.
        create a particle in position<two>::position</file>.
        move the particle in position<one> to position<box>::action</close_two>::position<target1>.
        move the particle in position<two> to position<box>::action</close_two>::position<target2>.
        create a particle in position<box>::action</close_two>::position<run>.
    }
}
