define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</implied_action>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<tmp>.
        create a particle in position<tmp>.
        move the particle in position<tmp> to action</implied_action>::position<trigger_pos>.
    }
}
