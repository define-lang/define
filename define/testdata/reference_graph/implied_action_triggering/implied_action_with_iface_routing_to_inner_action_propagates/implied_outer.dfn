define the potential action<my.domain.com:my_lib:/implied_outer> {
    define the position<run>.
    define the position<iface>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<temporary>.
        move the particle in position<iface> to position<temporary>.
        move the particle in position<temporary> to position<iface>.
        destroy the particle in position<run>.
    }
}
