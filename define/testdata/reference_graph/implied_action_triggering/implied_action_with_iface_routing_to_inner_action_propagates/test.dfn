# A particle routed through a triggered implied action before reaching an inner
# action still carries the inner action's requirements back to the caller.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</middle>.
            }
        }
        define the position<payload> {
            it may only contain particles where {
                it has the position</extra>.
            }
        }
        create a particle in position<box>.
        create a particle in position<payload>.
        move the particle in position<payload> to position<box>::action</middle>::position<input>.
        create a particle in position<box>::action</middle>::position<run>.
    }
}
