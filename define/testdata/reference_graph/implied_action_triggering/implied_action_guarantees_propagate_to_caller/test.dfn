define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</implied_action>.
    define the position<run>.
    define the position<sink>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in action</implied_action>::position<trigger_pos>.
        move the particle in action</implied_action>::position<output> to position<sink>.
    }
}
