define the potential action<my.domain.com:my_lib:/middle> {
    it also assigns the action</implied_outer>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in action</implied_outer>::position<iface>::action</inner>::position<trigger_pos>.
        destroy the particle in action</implied_outer>::position<iface>.
        create a particle in action</implied_outer>::position<run>.
    }
}
