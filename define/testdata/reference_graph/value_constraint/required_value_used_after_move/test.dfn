# Required particles keep their origin constraints alive after moving to unconstrained positions.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<input> {
        it may only contain particles where {
            it has the value</number>.
        }
    }
    it happens when {
        the position<input> has a particle.
    } and it does {
        define the position<moved>.
        define the position<copy> {
            it may only contain particles where {
                it has the value</number>.
            }
        }
        create a particle in position<copy>.
        move the particle in position<input> to position<moved>.
        set the value of position<copy> to position<moved>.
    }
}
