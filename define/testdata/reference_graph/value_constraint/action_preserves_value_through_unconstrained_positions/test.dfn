# A particle retains its value type after an action moves it through unconstrained interface positions.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<worker> {
            it may only contain particles where {
                it has the action</consume>.
            }
        }
        define the position<source> {
            it may only contain particles where {
                it has the value<standard:/number/rational>.
            }
        }
        define the position<target> {
            it may only contain particles where {
                it has the value<standard:/number/rational>.
            }
        }
        create a particle in position<worker>.
        create a particle in position<source>.
        create a particle in position<target>.
        set the value of position<source> to literal<standard:/number>"5".
        set the value of position<target> to position<source>.
        destroy the particle in position<target>.
        move the particle in position<source> to position<worker>::action</consume>::position<input>.
        move the particle in position<worker>::action</consume>::position<result> to position<target>.
        destroy the particle in position<target>.
        destroy the particle in position<worker>.
    }
}
