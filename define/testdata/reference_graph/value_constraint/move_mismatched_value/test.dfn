# Moving a particle must satisfy the destination value constraint.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</text_copy>.
    it also assigns the position</number_copy>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<source> {
            it may only contain particles where {
                it has the value<standard:/number/rational>.
            }
        }
        define the position<target> {
            it may only contain particles where {
                it has the value</text>.
            }
        }
        create a particle in position<source>.
        create a particle in position</number_copy>.
        set the value of position<source> to literal<standard:/number>"5".
        set the value of position</number_copy> to position<source>.
        create a particle in position<target>.
        create a particle in position</text_copy>.
        set the value of position<target> to literal<standard:/number>"5".
        set the value of position</text_copy> to position<target>.
        destroy the particle in position<target>.
        move the particle in position<source> to position<target>.
        destroy the particle in position<target>.
    }
}
