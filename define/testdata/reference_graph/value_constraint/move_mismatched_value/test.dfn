# Moving a particle must satisfy the destination value constraint.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<source> {
            it may only contain particles where {
                it has the value</number>.
            }
        }
        define the position<target> {
            it may only contain particles where {
                it has the value</text>.
            }
        }
        create a particle in position<source>.
        define the position<number_copy> {
            it may only contain particles where {
                it has the value</number>.
            }
        }
        create a particle in position<number_copy>.
        set the value of position<source> to literal</decimal>"5".
        set the value of position<number_copy> to position<source>.
        destroy the particle in position<number_copy>.
        create a particle in position<target>.
        define the position<copy> {
            it may only contain particles where {
                it has the value</text>.
            }
        }
        create a particle in position<copy>.
        set the value of position<target> to literal</decimal>"5".
        set the value of position<copy> to position<target>.
        destroy the particle in position<copy>.
        destroy the particle in position<target>.
        move the particle in position<source> to position<target>.
        destroy the particle in position<target>.
    }
}
