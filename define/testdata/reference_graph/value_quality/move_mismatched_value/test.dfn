# Moving a particle must satisfy the destination value quality.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</integer_copy>.
    it also assigns the position</number_copy>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<source> {
            it may only contain particles where {
                it has the value<standard:/number/natural>.
            }
        }
        define the position<target> {
            it may only contain particles where {
                it has the value<standard:/number/integer>.
            }
        }
        create a particle in position<source>.
        create a particle in position</number_copy>.
        set the value of position<source> from literal<standard:/number>"5".
        set the value of position</number_copy> from position<source>.
        create a particle in position<target>.
        create a particle in position</integer_copy>.
        set the value of position<target> from literal<standard:/number>"5".
        set the value of position</integer_copy> from position<target>.
        destroy the particle in position<target>.
        move the particle in position<source> to position<target>.
        destroy the particle in position<target>.
    }
}
