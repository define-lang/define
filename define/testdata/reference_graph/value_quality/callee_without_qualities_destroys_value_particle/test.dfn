# An action can destroy a caller's particle with a value quality through an interface position without quality assignments.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</copy>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<worker> {
            it may only contain particles where {
                it has the action</consume>.
            }
        }
        define the position<source> {
            it may only contain particles where {
                it has the value<standard:/number/natural>.
            }
        }
        create a particle in position<worker>.
        create a particle in position<source>.
        create a particle in position</copy>.
        set the value of position<source> to literal<standard:/number>"5".
        set the value of position</copy> to position<source>.
        move the particle in position<source> to position<worker>::action</consume>::position<input>.
        destroy the particle in position<worker>.
    }
}
