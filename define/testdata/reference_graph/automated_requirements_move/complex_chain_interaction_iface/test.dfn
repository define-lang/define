define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</outer>::position<iface>.
        create a particle in position<box>::action</outer>::position<iface>::position</child>.
        create a particle in position<box>::action</outer>::position<iface>::position</child>::position</grand>.
        create a particle in position<box>::action</outer>::position<iface>::position</child>::position</grand>::position</great>.
        create a particle in position<box>::action</outer>::position<iface>::position</child>::position</grand>::position</great>::position</double>.
        create a particle in position<box>::action</outer>::position<iface>::position</child>::position</grand>::position</great>::position</double>::position</item>.
        create a particle in position<box>::action</outer>::position<trigger_pos>.
    }
}
