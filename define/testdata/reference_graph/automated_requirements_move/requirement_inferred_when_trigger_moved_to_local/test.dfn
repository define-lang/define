# /outer moves its trigger position to a local, then creates in a child via local.
#
# A requirement inferred after the trigger particle moves to a local position
# must still apply to that particle from the caller's perspective.
#
# /inner does not use its position<extra>, so the requirement can come only
# from /outer's own reference to the child of its moved trigger particle.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        define the position<spare> {
            it may only contain particles where {
                it has the position</extra_quality>.
            }
        }
        create a particle in position<box>.
        create a particle in position<spare>.
        create a particle in position<spare>::position</extra_quality>.
        move the particle in position<spare> to position<box>::action</outer>::position<trigger_pos>.
    }
}
