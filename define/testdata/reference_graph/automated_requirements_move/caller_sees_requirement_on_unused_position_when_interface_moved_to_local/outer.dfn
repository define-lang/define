define the potential action<my.domain.com:my_lib:/outer> {
    define the position<trigger_pos>.
    define the position<iface> {
        it may only contain particles where {
            it has the position</extra>.
        }
    }
    define the position<result> {
        it may only contain particles where {
            it has the position</extra>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        define the position<inner_holder> {
            it may only contain particles where {
                it has the action</inner>.
            }
        }
        move the particle in position<iface> to position<result>.
        create a particle in position<result>::position</extra>.
        create a particle in position<inner_holder>.
        create a particle in position<inner_holder>::action</inner>::position<trigger_pos>.
    }
}
