# /outer moves its input particle to a guarantee and creates its position</extra>
# child, while also triggering /inner.
#
# /inner's own position<extra> remains unreferenced. The empty requirement comes
# from /outer's create and follows the moved particle back to /outer's input.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the position</extra>.
            }
        }
        define the position<outer_holder> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</extra>.
        create a particle in position<outer_holder>.
        move the particle in position<box> to position<outer_holder>::action</outer>::position<iface>.
        create a particle in position<outer_holder>::action</outer>::position<trigger_pos>.
    }
}
