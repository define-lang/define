define the potential action<my.domain.com:my_lib:/inner> {
    define the position<trigger_pos> {
        it may only contain particles where {
            it has the position</item>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<trigger_pos>::position</item>.
        define the position<_sink>.
        move the particle in position<trigger_pos> to position<_sink>.
    }
}
