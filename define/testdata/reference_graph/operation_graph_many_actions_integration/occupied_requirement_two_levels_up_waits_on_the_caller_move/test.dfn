# A move that lands the particle two call levels up satisfies the propagated
# requirement, so inner.destroy(slot) must wait on that move rather than on
# /middle's trigger of /inner.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<source>.
    define the position<box> {
        it may only contain particles where {
            it has the action</middle>.
        }
    }
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position<source>.
        create a particle in position<box>.
        create a particle in position<box>::action</middle>::position<gw>.
        move the particle in position<source> to position<box>::action</middle>::position<gw>::position</value>.
        create a particle in position<box>::action</middle>::position<trigger_pos>.
        destroy the particle in position<box>::action</middle>::position<trigger_pos>.
    }
}
