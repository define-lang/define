define the potential action<my.domain.com:my_lib:/worker> {
    define the position<trigger_pos>.
    define the position<source>.
    define the position<target>.
    define the position<occupied>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        destroy the particle in position<occupied>.
        move the particle in position<source> to position<target>.
    }
}
