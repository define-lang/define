define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</destination>.
    it also assigns the position</slot>.
    it also assigns the action</mover>.
    define the position<temp>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</destination>.
        move the particle in position</destination> to position<temp>.
        move the particle in position<temp> to position</slot>.
        create a particle in action</mover>::position<trigger_pos>.
    }
}
