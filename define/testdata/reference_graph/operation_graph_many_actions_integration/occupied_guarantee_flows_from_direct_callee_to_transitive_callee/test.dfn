# /test receives /fill_item's occupied Guarantee without operating on /item,
# then /empty_item uses it through the /outer and /middle Action Executions.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</fill_item>.
    it also assigns the action</outer>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in action</fill_item>::position<trigger_pos>.
        create a particle in action</outer>::position<trigger_pos>.
    }
}
