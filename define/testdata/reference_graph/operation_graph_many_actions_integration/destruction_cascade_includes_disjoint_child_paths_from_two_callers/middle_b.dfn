define the potential action<my.domain.com:my_lib:/middle_b> {
    it also assigns the action</destroyer>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the position</b>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</b>.
        move the particle in position<box> to action</destroyer>::position<run>.
    }
}
