define the potential action<my.domain.com:my_lib:/middle> {
    define the position<trigger_pos>.
    define the position<source> {
        it may only contain particles where {
            it has the position</item>.
        }
    }
    define the position<holder>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        define the position<inner_holder> {
            it may only contain particles where {
                it has the action</inner>.
            }
        }
        move the particle in position<source> to position<holder>.
        create a particle in position<source>.
        create a particle in position<inner_holder>.
        move the particle in position<holder> to position<inner_holder>::action</inner>::position<input>.
        create a particle in position<inner_holder>::action</inner>::position<trigger_pos>.
        create a particle in position<source>::position</item>.
        destroy the particle in position<source>::position</item>.
        destroy the particle in position<source>.
    }
}
