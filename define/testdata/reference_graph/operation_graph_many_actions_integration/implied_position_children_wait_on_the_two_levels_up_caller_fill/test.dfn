# /parent is a shared global implied position: /test fills it, then triggers
# /middle, which triggers /inner, which fills its children. Each child fill
# needs only /parent present, so it should wait on /test's fill of /parent --
# two call levels up -- not on /middle's trigger of /inner.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</parent>.
    it also assigns the action</middle>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position</parent>.
        create a particle in action</middle>::position<trigger_pos>.
    }
}
