define the potential action<my.domain.com:my_lib:/outer> {
    define the position<trigger_pos>.
    define the position<gw> {
        it may only contain particles where {
            it has the action</middle>.
            it has the position</out_value>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<gw>::action</middle>::position<igw>.
        create a particle in position<gw>::action</middle>::position<trigger_pos>.
        move the particle in position<gw>::action</middle>::position<igw>::position</out_value> to position<gw>::position</out_value>.
    }
}
