define the potential action<my.domain.com:my_lib:/call_empty> {
    it also assigns the action</empty_item>.
    define the position<trigger_pos>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in action</empty_item>::position<trigger_pos>.
        destroy the particle in action</empty_item>::position<trigger_pos>.
    }
}
