define the potential action<my.domain.com:my_lib:/run_both> {
    it also assigns the action</call_fill>.
    it also assigns the action</call_empty>.
    define the position<trigger_pos>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in action</call_fill>::position<trigger_pos>.
        create a particle in action</call_empty>::position<trigger_pos>.
    }
}
