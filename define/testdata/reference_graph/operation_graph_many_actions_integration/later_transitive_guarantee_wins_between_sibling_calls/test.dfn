# /call_fill and /call_empty do not operate on /item themselves. Their
# callees produce opposite guarantees, and the later empty guarantee must win.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</item>.
    it also assigns the action</run_both>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in action</run_both>::position<trigger_pos>.
        create a particle in position</item>.
    }
}
