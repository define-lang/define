# /middle's grandchild destroy reaches /test's operations on the same path,
# so /inner's parent destroy needs only /middle's operation for that path.
# /test's sibling fill is on an independent path and remains a dependency.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</parent>.
    it also assigns the action</middle>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</parent>.
        create a particle in position</parent>::position</child>.
        create a particle in position</parent>::position</child>::position</grandchild>.
        create a particle in position</parent>::position</child>::position</grandchild>::position</greatgrandchild>.
        create a particle in position</parent>::position</sibling>.
        create a particle in action</middle>::position<trigger_pos>.
        destroy the particle in action</middle>::position<trigger_pos>.
    }
}
