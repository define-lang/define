# /mover's Empty Rule receives /test's direct child Create and /filler's
# independent Guarantee after the Binding Hole passes through /middle.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</parent>.
    it also assigns the action</filler>.
    it also assigns the action</middle>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</parent>.
        create a particle in position</parent>::position</direct_child>.
        create a particle in action</filler>::position<trigger_pos>.
        create a particle in action</middle>::position<trigger_pos>.
        destroy the particle in action</filler>::position<trigger_pos>.
        destroy the particle in action</middle>::position<trigger_pos>.
    }
}
