define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</input>.
    it also assigns the action</producer>.
    it also assigns the action</consumer>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</input>.
        create a particle in action</producer>::position<trigger_pos>.
        create a particle in action</consumer>::position<trigger_pos>.
        destroy the particle in action</producer>::position<trigger_pos>.
        destroy the particle in action</consumer>::position<trigger_pos>.
    }
}
