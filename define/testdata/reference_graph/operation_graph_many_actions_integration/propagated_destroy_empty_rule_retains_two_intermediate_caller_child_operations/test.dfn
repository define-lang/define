# /middle contributes two independent child Particle Operations while
# /destroyer's Empty Rule still awaits /test's particle in /parent.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</parent>.
    it also assigns the action</middle>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</parent>.
        create a particle in action</middle>::position<trigger_pos>.
        destroy the particle in action</middle>::position<trigger_pos>.
    }
}
