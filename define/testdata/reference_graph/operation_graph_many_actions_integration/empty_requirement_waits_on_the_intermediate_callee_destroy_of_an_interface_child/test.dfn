# The emptied position is a child of /inner's interface position <holder>, not
# an interface position itself. /test fills an ordinary holder and its child,
# /middle shuttles the holder to /inner and destroys the child, so
# inner.create(holder::/a) waits on that destroy rather than on the /test fill
# it superseded.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<box> {
        it may only contain particles where {
            it has the action</middle>.
        }
    }
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position<box>.
        create a particle in position<box>::action</middle>::position<gw>.
        create a particle in position<box>::action</middle>::position<gw>::position</holder>.
        create a particle in position<box>::action</middle>::position<gw>::position</holder>::position</a>.
        create a particle in position<box>::action</middle>::position<trigger_pos>.
    }
}
