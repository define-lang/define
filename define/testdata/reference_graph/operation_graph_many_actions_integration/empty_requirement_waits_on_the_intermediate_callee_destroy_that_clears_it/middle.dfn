define the potential action<my.domain.com:my_lib:/middle> {
    define the position<trigger_pos>.
    define the position<gw> {
        it may only contain particles where {
            it has the action</inner>.
            it has the position</value>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        move the particle in position<gw>::position</value> to position<gw>::action</inner>::position<slot>.
        destroy the particle in position<gw>::action</inner>::position<slot>.
        create a particle in position<gw>::action</inner>::position<trigger_pos>.
    }
}
