# /test triggers /left before /right. Their child actions operate on the same
# implied position, so /right_child's destroy follows /left_child's fill.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</left>.
    it also assigns the action</right>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in action</left>::position<trigger_pos>.
        create a particle in action</right>::position<trigger_pos>.
        destroy the particle in action</left>::position<trigger_pos>.
        destroy the particle in action</right>::position<trigger_pos>.
    }
}
