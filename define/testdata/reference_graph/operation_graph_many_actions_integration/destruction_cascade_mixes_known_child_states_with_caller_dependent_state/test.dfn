define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</destroyer>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<source> {
            it may only contain particles where {
                it has the position</known_empty>.
                it has the position</known_occupied>.
                it has the position</maybe_child>.
            }
        }
        create a particle in position<source>.
        create a particle in position<source>::position</known_empty>.
        create a particle in position<source>::position</known_occupied>.
        destroy the particle in position<source>::position</known_occupied>.
        create a particle in position<source>::position</maybe_child>.
        move the particle in position<source> to action</destroyer>::position<run>.
    }
}
