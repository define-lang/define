define the potential action<my.domain.com:my_lib:/middle> {
    it also assigns the position</parent>.
    it also assigns the action</mover>.
    define the position<trigger_pos>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position</parent>::position</first>.
        create a particle in position</parent>::position</second>.
        create a particle in action</mover>::position<trigger_pos>.
        destroy the particle in action</mover>::position<destination>.
        destroy the particle in action</mover>::position<trigger_pos>.
    }
}
