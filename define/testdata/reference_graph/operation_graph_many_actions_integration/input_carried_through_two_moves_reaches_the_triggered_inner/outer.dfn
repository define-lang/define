define the potential action<my.domain.com:my_lib:/outer> {
    define the position<input> {
        it may only contain particles where {
            it has the action</inner>.
        }
    }
    define the position<middle_holder> {
        it may only contain particles where {
            it has the action</middle>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<middle_holder>.
        move the particle in position<input> to position<middle_holder>::action</middle>::position<input>.
        create a particle in position<middle_holder>::action</middle>::position<run>.
    }
}
