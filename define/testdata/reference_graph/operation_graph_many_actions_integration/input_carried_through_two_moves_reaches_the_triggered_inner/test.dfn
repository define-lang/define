# /test fills a child of box, then box is carried by two moves (into /outer then
# /middle) before /middle shuttles it to /inner and fills the trigger. Each
# callee operation resolves to the move that most recently carried the particle,
# not to a trigger.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<box> {
        it may only contain particles where {
            it has the position</child>.
        }
    }
    define the position<outer_holder> {
        it may only contain particles where {
            it has the action</outer>.
        }
    }
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position<box>.
        create a particle in position<box>::position</child>.
        create a particle in position<outer_holder>.
        move the particle in position<box> to position<outer_holder>::action</outer>::position<input>.
        create a particle in position<outer_holder>::action</outer>::position<run>.
        destroy the particle in position<outer_holder>::action</outer>::position<middle_holder>.
        destroy the particle in position<outer_holder>::action</outer>::position<run>.
    }
}
