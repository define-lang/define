define the potential action<my.domain.com:my_lib:/outer> {
    define the position<trigger_pos>.
    define the position<mw> {
        it may only contain particles where {
            it has the action</middle>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        destroy the particle in position<mw>::action</middle>::position<gw>::action</inner>::position<holder>::position</a>.
        create a particle in position<mw>::action</middle>::position<trigger_pos>.
    }
}
