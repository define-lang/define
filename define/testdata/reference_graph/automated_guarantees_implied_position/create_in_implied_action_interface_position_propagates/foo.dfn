define the potential action<my.domain.com:my_lib:/foo> {
    define the position<iface>.
    define the position<trigger_pos>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<iface>.
        destroy the particle in position<iface>.
        destroy the particle in position<trigger_pos>.
    }
}
