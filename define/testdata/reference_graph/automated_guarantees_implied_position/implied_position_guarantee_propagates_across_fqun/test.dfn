# Inner in child FQUN creates in /implied (in child FQUN). Parent-FQUN test sees position<box>::position<child:/implied> filled.
define the potential action<my.domain.com:parent_lib:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action<my.domain.com:child_lib:/inner>.
                it has the position<my.domain.com:child_lib:/implied>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action<my.domain.com:child_lib:/inner>::position<trigger_pos>.
        create a particle in position<box>::position<my.domain.com:child_lib:/implied>.
    }
}
