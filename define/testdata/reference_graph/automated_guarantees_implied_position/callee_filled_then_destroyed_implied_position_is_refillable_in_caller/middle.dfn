define the potential action<my.domain.com:my_lib:/middle> {
    it also assigns the action</filler>.
    it also assigns the position</implied>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in action</filler>::position<trigger_pos>.
        destroy the particle in position</implied>.
    }
}
