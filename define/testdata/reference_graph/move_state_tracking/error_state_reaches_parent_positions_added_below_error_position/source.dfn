# The Move to an occupied position gives position<a> error state, and
# position<a> keeps its particle. The invalid chained name below position<a>
# gets error state too. Every position between position<a> and that chained
# name is then below a position with error state, so the Moves from those
# positions report nothing.
define the potential position<my.domain.com:my_lib:/zz>.
define the potential position<my.domain.com:my_lib:/c>.
define the potential position<my.domain.com:my_lib:/b> {
    it may only contain particles where {
        it has the position</c>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<a> {
            it may only contain particles where {
                it has the position</b>.
            }
        }
        define the position<h>.
        define the position<d>.
        define the position<e>.
        create a particle in position<a>.
        create a particle in position<h>.
        move the particle in position<a> to position<h>.
        create a particle in position<a>::position</b>::position</c>::position</zz>.
        move the particle in position<a>::position</b>::position</c> to position<d>.
        move the particle in position<a>::position</b> to position<e>.
    }
}
