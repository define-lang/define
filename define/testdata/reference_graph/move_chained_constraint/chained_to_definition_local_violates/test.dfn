define the potential action<my.domain.com:my_lib:/test> {
    define the position<dest> {
        it may only contain particles where {
            it has the position</y>.
        }
    }
    it happens when {
        this particle is created.
    } and it does {
        define the position<a> {
            it may only contain particles where {
                it has the position</x>.
            }
        }
        define the position<b> {
            it may only contain particles where {
                it has the position</x>.
            }
        }
        create a particle in position<a>.
        create a particle in position<b>.
        move the particle in position<a> to position<b>::position</x>.
        move the particle in position<b>::position</x> to position<dest>.
        create a particle in position<a>.
        create a particle in position<a>::position</x>.
        create a particle in position<dest>::position</y>.
    }
}
