define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<from_pos> {
            it may only contain particles where {
                it has the position</x>.
            }
        }
        define the position<dest> {
            it may only contain particles where {
                it has the position</y>.
            }
        }
        create a particle in position<from_pos>.
        create a particle in position<from_pos>::position</x>.
        destroy the particle in position<from_pos>::position</x>.
        create a particle in position<dest>.
        move the particle in position<from_pos> to position<dest>::position</y>.
    }
}
