define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<src> {
            it may only contain particles where {
                it has the position</x>.
            }
        }
        define the position<a> {
            it may only contain particles where {
                it has the position</z>.
            }
        }
        create a particle in position<src>.
        create a particle in position<src>::position</x>.
        create a particle in position<src>::position</x>::position</y>.
        move the particle in position<src>::position</x>::position</y> to position<a>.
        create a particle in position<a>::position</z>.
    }
}
