define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</implied>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<local>.
        create a particle in position</implied>.
        move the particle in position</implied> to position<local>.
        destroy the particle in position</implied>.
    }
}
