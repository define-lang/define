define the potential action<my.domain.com:my_lib:/p> {
    it also assigns the position</q>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<local> {
            it may only contain particles where {
                it has the position</q_child>.
            }
        }
        move the particle in position</q> to position<local>.
        destroy the particle in position<local>::position</q_child>.
    }
}
