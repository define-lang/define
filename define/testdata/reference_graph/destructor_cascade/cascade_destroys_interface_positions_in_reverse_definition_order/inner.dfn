define the potential action<my.domain.com:my_lib:/inner> {
    define the position<slot_a> {
        it may only contain particles where {
            it has the action</destructor_a>.
        }
    }
    define the position<slot_b> {
        it may only contain particles where {
            it has the action</destructor_b>.
        }
    }
    define the position<slot_c> {
        it may only contain particles where {
            it has the action</destructor_c>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<slot_a>.
        create a particle in position<slot_b>.
        create a particle in position<slot_c>.
    }
}
