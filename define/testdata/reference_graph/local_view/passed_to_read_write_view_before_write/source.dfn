# Executing an operation that has a read/write view, with a local view before it is written, is reported only once. Later statements may still read the local view.
define the logical_operation<my.domain.com:my_lib:/negate> {
    define the view<value> {
        it is read.
    }
    define the view<result> {
        it is written.
    }
}
define the potential value<my.domain.com:my_lib:/number> {
    it supports the logical_operation</negate> {
        it may be read.
        it may be written.
    }
}
define the operation<my.domain.com:my_lib:/negate_number> {
    define the view<value> {
        it is read.
        it may only contain particles where {
            it has the value</number>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }

    it does {
        execute the logical_operation</negate> {
            with view<value> looking at view<value>.
            with view<result> looking at view<result>.
        }
    }
}
define the operation<my.domain.com:my_lib:/negate_in_place> {
    define the view<value> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
define the operation<my.domain.com:my_lib:/test> {
    define the view<negated_in_place> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }

    it does {
        define the view<unwritten> {
            it may only contain particles where {
                it has the value</number>.
            }
        }
        execute the operation</negate_in_place> {
            with view<value> looking at view<unwritten>.
        }
        execute the operation</negate_number> {
            with view<value> looking at view<unwritten>.
            with view<result> looking at view<negated_in_place>.
        }
    }
}
