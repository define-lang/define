# Executing the encoding operation reads and writes every interface view, but not a local view, which the logical operations still write and read.
define the logical_operation<my.domain.com:my_lib:/negate> {
    define the view<value> {
        it is read.
    }
    define the view<result> {
        it is written.
    }
}
define the potential value<my.domain.com:my_lib:/number> {
    it supports the logical_operation</negate> {
        it may be read.
        it may be written.
    }
}
define the potential value<my.domain.com:my_lib:/read_only_number> {
    it supports the logical_operation</negate> {
        it may be read.
    }
}
define the operation<my.domain.com:my_lib:/negate_number> {
    define the view<value> {
        it is read.
        it may only contain particles where {
            it has the value</number>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }

    it does {
        execute the logical_operation</negate> {
            with view<value> looking at view<value>.
            with view<result> looking at view<result>.
        }
    }
}
define the operation<my.domain.com:my_lib:/test> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value</number>.
        }
    }
    define the view<twice_negated> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }

    it does {
        define the view<negated> {
            it may only contain particles where {
                it has the value</number>.
            }
        }
        execute the logical_operation</negate> {
            with view<value> looking at view<number>.
            with view<result> looking at view<negated>.
        }
        execute the logical_operation</negate> {
            with view<value> looking at view<negated>.
            with view<result> looking at view<twice_negated>.
        }
        execute the encoding operation.
    }
}
