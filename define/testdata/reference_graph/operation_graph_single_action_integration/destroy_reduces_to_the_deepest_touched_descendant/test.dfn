# The Child Rule drops a touched descendant that a deeper touched one
# supersedes: the grandchild reaches the child and the box through its own
# ancestor chain, so the destroy needs only the grandchild.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</child>.
        create a particle in position<box>::position</child>::position</grandchild>.
        destroy the particle in position<box>.
    }
}
