# Each Destroy must retain both child Moves even though those Moves have the same
# preceding Move chain and operate on different child position paths.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<source> {
            it may only contain particles where {
                it has the position</box_a>.
                it has the position</box_b>.
            }
        }
        define the position<stage_a>.
        define the position<stage_b>.
        define the position<workspace> {
            it may only contain particles where {
                it has the position</box_a>.
                it has the position</box_b>.
            }
        }
        define the position<moved_marker>.
        define the position<left_a_holder>.
        define the position<right_a_holder>.
        define the position<left_b_holder>.
        define the position<right_b_holder>.
        create a particle in position<source>.
        move the particle in position<source> to position<stage_a>.
        move the particle in position<stage_a> to position<stage_b>.
        move the particle in position<stage_b> to position<workspace>.
        move the particle in position<workspace> to position<moved_marker>.
        create a particle in position<workspace>.
        create a particle in position<workspace>::position</box_a>.
        create a particle in position<workspace>::position</box_a>::position</left>.
        create a particle in position<workspace>::position</box_a>::position</right>.
        move the particle in position<workspace>::position</box_a>::position</left> to position<left_a_holder>.
        move the particle in position<workspace>::position</box_a>::position</right> to position<right_a_holder>.
        destroy the particle in position<workspace>::position</box_a>.
        destroy the particle in position<left_a_holder>.
        destroy the particle in position<right_a_holder>.
        create a particle in position<workspace>::position</box_b>.
        create a particle in position<workspace>::position</box_b>::position</left>.
        create a particle in position<workspace>::position</box_b>::position</right>.
        move the particle in position<workspace>::position</box_b>::position</left> to position<left_b_holder>.
        move the particle in position<workspace>::position</box_b>::position</right> to position<right_b_holder>.
        destroy the particle in position<workspace>::position</box_b>.
        destroy the particle in position<left_b_holder>.
        destroy the particle in position<right_b_holder>.
        destroy the particle in position<workspace>.
        destroy the particle in position<moved_marker>.
    }
}
