define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the position</origin>.
                it has the position</destination>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</origin>.
        create a particle in position<box>::position</origin>::position</child>.
        move the particle in position<box>::position</origin> to position<box>::position</destination>.
    }
}
