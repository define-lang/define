# The caller cannot determine a child of the particle created by
# action</create_parent>, so the grandchild requirement must fail locally.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</create_parent>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</create_parent>::position<run>.
    }
}
