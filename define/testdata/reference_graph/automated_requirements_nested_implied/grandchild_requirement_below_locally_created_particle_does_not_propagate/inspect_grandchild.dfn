define the potential action<my.domain.com:my_lib:/inspect_grandchild> {
    define the position<child> {
        it may only contain particles where {
            it has the position</grandchild>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<_holder>.
        move the particle in position<child>::position</grandchild> to position<_holder>.
        destroy the particle in position<child>.
        destroy the particle in position<run>.
    }
}
