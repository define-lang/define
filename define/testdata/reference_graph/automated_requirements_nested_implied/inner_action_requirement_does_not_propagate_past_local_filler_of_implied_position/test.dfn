# When the current action fills an implied position before triggering an inner action through it, the inner action's requirement is checked at the trigger site but does not propagate further up to the caller.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</middle>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</middle>::position<run>.
    }
}
