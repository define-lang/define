define the potential action<my.domain.com:my_lib:/middle> {
    it also assigns the position</x>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position</x>.
        create a particle in position</x>::action</inner>::position<trigger_pos>.
        destroy the particle in position<run>.
    }
}
