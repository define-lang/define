# The constructor fills position<box>::position</color>, so the caller's own
# create there conflicts with the constructor's guarantee.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</construct>.
                it has the position</color>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</color>.
    }
}
