# The constructor assigns and fills an implied position, so creating a particle
# that bears it guarantees the implied position ends up occupied. The caller can
# destroy that particle only because the constructor's guarantee makes it occupied.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</construct>.
                it has the position</color>.
            }
        }
        create a particle in position<box>.
        destroy the particle in position<box>::position</color>.
    }
}
