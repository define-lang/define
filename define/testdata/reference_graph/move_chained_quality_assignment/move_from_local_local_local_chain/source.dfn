define the potential action<my.domain.com:my_lib:/test> {
    define the position<a>.
    define the position<b>.
    define the position<c>.
    define the position<d>.
    it happens when {
        the position<a> has a particle.
    } and it does {
        create a particle in position<b>.
        create a particle in position<c>.
        move the particle in position<a>::position<b>::position<c> to position<d>.
    }
}
