define the potential action<mv:define-lang.org:main_lib:/outer> {
    define the position<trigger_pos>.
    define the position<iface> {
        it may only contain particles where {
            it has the action<mv:define-lang.org:dep_lib:/inner>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<iface>::action<mv:define-lang.org:dep_lib:/inner>::position<item>.
        create a particle in position<iface>::action<mv:define-lang.org:dep_lib:/inner>::position<trigger_pos>.
    }
}
