# Same structure as the same-FQUN complex chain, but /bar lives in a different FQUN.
#
# /bar is in dep_lib and has an interface position with a constraint on position</x>,
# requiring position<item>::position</x> to be empty. /middle fills /bar's
# position<item> to satisfy the occupied requirement. The propagated position_name
# should render /bar and its positions with canonical FQUN names:
# position<local>::position</x>::action</foo>::position<iface>::action</middle>::position<mid_iface>::action<dep_fqun:/bar>::position<item>::position<dep_fqun:/x>
define the potential action<mv:define-lang.org:main_lib:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<local> {
            it may only contain particles where {
                it has the position</x>.
            }
        }
        create a particle in position<local>.
        create a particle in position<local>::position</x>.
        create a particle in position<local>::position</x>::action</foo>::position<iface>.
        create a particle in position<local>::position</x>::action</foo>::position<iface>::action</middle>::position<mid_iface>.
        create a particle in position<local>::position</x>::action</foo>::position<iface>::action</middle>::position<mid_iface>::action<mv:define-lang.org:dep_lib:/bar>::position<item>.
        create a particle in position<local>::position</x>::action</foo>::position<iface>::action</middle>::position<mid_iface>::action<mv:define-lang.org:dep_lib:/bar>::position<item>::position<mv:define-lang.org:dep_lib:/x>.
        create a particle in position<local>::position</x>::action</foo>::position<trigger_pos>.
    }
}
