define the potential action<mv:define-lang.org:main_lib:/middle> {
    define the position<trigger_pos>.
    define the position<mid_iface> {
        it may only contain particles where {
            it has the action<mv:define-lang.org:dep_lib:/bar>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<mid_iface>::action<mv:define-lang.org:dep_lib:/bar>::position<item>.
        create a particle in position<mid_iface>::action<mv:define-lang.org:dep_lib:/bar>::position<trigger_pos>.
    }
}
