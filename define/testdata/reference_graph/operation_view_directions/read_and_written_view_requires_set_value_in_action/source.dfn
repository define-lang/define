# A view that is read and written reads the particle it looks at, so its value must be set.
define the operation<my.domain.com:my_lib:/increment_by> {
    define the view<total> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    define the view<amount> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<total> {
            it may only contain particles where {
                it has the value<standard:/number/rational>.
            }
        }
        create a particle in position<total>.
        execute the operation</increment_by> {
            with view<total> looking at position<total>.
            with view<amount> looking at literal<standard:/number>"1".
        }
    }
}
