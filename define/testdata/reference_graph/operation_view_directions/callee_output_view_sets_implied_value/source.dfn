# After an action writes to its implied position through an output view, its caller can read that position's value.
define the operation<my.domain.com:my_lib:/copy> {
    define the view<source> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    define the view<target> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
define the potential position<my.domain.com:my_lib:/value> {
    it may only contain particles where {
        it has the value<standard:/number/rational>.
    }
}
define the potential action<my.domain.com:my_lib:/fill> {
    it also assigns the position</value>.
    define the position<trigger>.
    it happens when {
        the position<trigger> has a particle.
    } and it does {
        create a particle in position</value>.
        execute the operation</copy> {
            with view<source> looking at literal<standard:/number>"1".
            with view<target> looking at position</value>.
        }
        destroy the particle in position<trigger>.
    }
}
define the potential position<my.domain.com:my_lib:/copy> {
    it may only contain particles where {
        it has the value<standard:/number/rational>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</copy>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</fill>.
                it has the position</value>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</fill>::position<trigger>.
        create a particle in position</copy>.
        set the value of position</copy> to position<box>::position</value>.
    }
}
