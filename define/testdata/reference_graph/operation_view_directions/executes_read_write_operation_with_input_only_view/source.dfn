# view<total> writes to view<number>, which is only read.
define the operation<my.domain.com:my_lib:/increment_by> {
    define the view<total> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }
    define the view<amount> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }

    it does {
        define the view<new_total> {
            it may only contain particles where {
                it has the value<standard:/number/natural>.
            }
        }
        execute the operation<standard:/number/natural/add> {
            with view<a> looking at view<total>.
            with view<b> looking at view<amount>.
            with view<result> looking at view<new_total>.
        }
        set the value of view<total> from view<new_total>.
    }
}
define the operation<my.domain.com:my_lib:/bump> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }

    it does {
        execute the operation</increment_by> {
            with view<total> looking at view<number>.
            with view<amount> looking at literal<standard:/number>"1".
        }
    }
}
