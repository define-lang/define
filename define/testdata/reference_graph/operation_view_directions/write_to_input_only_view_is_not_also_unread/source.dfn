# view<result> only writes view<number>, which is only read.
define the operation<my.domain.com:my_lib:/store> {
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
define the operation<my.domain.com:my_lib:/bump> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }

    it does {
        execute the operation</store> {
            with view<result> looking at view<number>.
        }
    }
}
