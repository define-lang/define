# Only one statement may write an output view.
define the operation<my.domain.com:my_lib:/copy> {
    define the view<source> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }
    define the view<target> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }

    it does {
        execute the operation<standard:/number/natural/add> {
            with view<a> looking at view<source>.
            with view<b> looking at literal<standard:/number>"0".
            with view<result> looking at view<target>.
        }
    }
}
define the operation<my.domain.com:my_lib:/increment> {
    define the view<value> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }

    it does {
        define the view<new_value> {
            it may only contain particles where {
                it has the value<standard:/number/natural>.
            }
        }
        execute the operation<standard:/number/natural/add> {
            with view<a> looking at view<value>.
            with view<b> looking at literal<standard:/number>"0".
            with view<result> looking at view<new_value>.
        }
        set the value of view<value> from view<new_value>.
    }
}
define the operation<my.domain.com:my_lib:/inspect> {
    define the view<value> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }

    it does {
        execute the operation<standard:/number/natural/add> {
            with view<a> looking at view<value>.
            with view<b> looking at literal<standard:/number>"0".
            with view<result> looking at view<result>.
        }
    }
}
define the operation<my.domain.com:my_lib:/test> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }

    it does {
        execute the operation</copy> {
            with view<source> looking at view<number>.
            with view<target> looking at view<result>.
        }
        execute the operation</copy> {
            with view<source> looking at view<number>.
            with view<target> looking at view<result>.
        }
    }
}
