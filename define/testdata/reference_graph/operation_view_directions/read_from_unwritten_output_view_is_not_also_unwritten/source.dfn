# view<input> only reads view<number>, which is only written and never written to.
define the operation<my.domain.com:my_lib:/show> {
    define the view<input> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }

    it does {
        execute the operation<standard:/number/natural/add> {
            with view<a> looking at view<input>.
            with view<b> looking at literal<standard:/number>"0".
            with view<result> looking at view<result>.
        }
    }
}
define the operation<my.domain.com:my_lib:/bump> {
    define the view<number> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }
    define the view<inspected> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }

    it does {
        execute the operation</show> {
            with view<input> looking at view<number>.
            with view<result> looking at view<inspected>.
        }
    }
}
