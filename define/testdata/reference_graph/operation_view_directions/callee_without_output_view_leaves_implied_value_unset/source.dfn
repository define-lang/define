# When an action creates its implied position's particle without writing to it, its caller cannot read that position's value.
define the potential position<my.domain.com:my_lib:/value> {
    it may only contain particles where {
        it has the value<standard:/number/rational>.
    }
}
define the potential action<my.domain.com:my_lib:/fill> {
    it also assigns the position</value>.
    define the position<trigger>.
    it happens when {
        the position<trigger> has a particle.
    } and it does {
        create a particle in position</value>.
        destroy the particle in position<trigger>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</fill>.
                it has the position</value>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</fill>::position<trigger>.
        define the position<copy> {
            it may only contain particles where {
                it has the value<standard:/number/rational>.
            }
        }
        create a particle in position<copy>.
        set the value of position<copy> to position<box>::position</value>.
    }
}
