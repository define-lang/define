# Output views are written before they are read, and every view is used as it declares.
define the operation<my.domain.com:my_lib:/copy> {
    define the view<source> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    define the view<target> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
define the operation<my.domain.com:my_lib:/increment_by> {
    define the view<total> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    define the view<amount> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
define the operation<my.domain.com:my_lib:/copy_and_increment> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }

    it does {
        execute the operation</copy> {
            with view<source> looking at view<number>.
            with view<target> looking at view<result>.
        }
        execute the operation</increment_by> {
            with view<total> looking at view<result>.
            with view<amount> looking at literal<standard:/number>"1".
        }
    }
}
