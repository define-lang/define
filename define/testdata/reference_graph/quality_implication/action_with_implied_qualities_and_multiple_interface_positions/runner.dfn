define the potential action<my.domain.com:my_lib:/runner> {
    it also assigns the position</marker>.
    define the position<run>.
    define the position<input_a> {
        it may only contain particles where {
            it has the position</quality_a>.
        }
    }
    define the position<input_b> {
        it may only contain particles where {
            it has the position</quality_b>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position</marker>.
        create a particle in position<input_a>::position</quality_a>.
        create a particle in position<input_b>::position</quality_b>.
        destroy the particle in position<input_a>.
        destroy the particle in position<input_b>.
        destroy the particle in position<run>.
    }
}
