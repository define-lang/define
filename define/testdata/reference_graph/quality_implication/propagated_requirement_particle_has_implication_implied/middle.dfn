define the potential action<my.domain.com:my_lib:/middle> {
    define the position<run>.
    define the position<box> {
        it may only contain particles where {
            it has the action</inner>.
        }
    }
    define the position<final> {
        it may only contain particles where {
            it has the position</implied>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<box>::action</inner>::position<run>.
        move the particle in position<box>::action</inner>::position<output> to position<final>.
        destroy the particle in position<final>::position</implied>.
        destroy the particle in position<final>.
        destroy the particle in position<box>.
        destroy the particle in position<run>.
    }
}
