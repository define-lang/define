# action</cleanup> is a constructor that destroys the particle action</initialize>
# puts in position</left>, without knowing its Destructor. This action validates
# the Destructor, whose requirement the particle violates, and the propagation
# chain shows that this action constructed action</cleanup> rather than
# triggering it.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<item> {
            it may only contain particles where {
                it has the action</initialize>.
                it has the action</cleanup>.
            }
        }
        create a particle in position<item>.
    }
}
