# action</middle> is the knower of the Destructor: it resolves position</p2>, which it fills, and reports that violation itself.
# position</p1> comes from action</outer>, so action</middle> requires it to be occupied,
# and action</outer>, which empties it, violates that requirement where it triggers action</middle>.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        define the position<my_file> {
            it may only contain particles where {
                it has the action</destructor>.
            }
        }
        create a particle in position<box>.
        create a particle in position<my_file>.
        move the particle in position<my_file> to position<box>::action</outer>::position<incoming>.
        create a particle in position<box>::action</outer>::position<run>.
    }
}
