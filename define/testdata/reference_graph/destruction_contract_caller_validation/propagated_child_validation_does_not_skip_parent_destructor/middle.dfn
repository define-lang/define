define the potential action<my.domain.com:my_lib:/middle> {
    it also assigns the action</destroyer>.
    define the position<run> {
        it may only contain particles where {
            it has the position</child>.
            it has the position</other_child>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<run>::position</child>.
        create a particle in position<run>::position</child>::position</item>.
        destroy the particle in position<run>::position</child>::position</item>.
        create a particle in position<run>::position</other_child>.
        create a particle in position<run>::position</other_child>::position</item>.
        destroy the particle in position<run>::position</other_child>::position</item>.
        move the particle in position<run> to action</destroyer>::position<run>.
    }
}
