define the potential action<my.domain.com:my_lib:/producer> {
    define the position<result> {
        it may only contain particles where {
            it has the action</destructor>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<created> {
            it may only contain particles where {
                it has the action</destructor>.
            }
        }
        create a particle in position<created>.
        move the particle in position<created> to position<result>.
    }
}
