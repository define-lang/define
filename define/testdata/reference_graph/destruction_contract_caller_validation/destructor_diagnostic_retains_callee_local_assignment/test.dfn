# The propagation chain includes the callee-local destructor assignment.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</producer>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</producer>::position<run>.
        destroy the particle in position<box>::action</producer>::position<result>.
    }
}
