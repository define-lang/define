# Using a particle in a Value Setting Statement keeps its encoding constraint alive.
define the potential position<my.domain.com:my_lib:/copy> {
    it may only contain particles where {
        it has the value<standard:/number/rational>.
    }
}
define the potential action<my.domain.com:my_lib:/consume> {
    it also assigns the position</copy>.
    define the position<input> {
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    it happens when {
        the position<input> has a particle.
    } and it does {
        create a particle in position</copy>.
        set the value of position</copy> to position<input>.
        destroy the particle in position<input>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<worker> {
            it may only contain particles where {
                it has the action</consume>.
            }
        }
        define the position<number> {
            it may only contain particles where {
                it has the value<standard:/number/rational>.
                it has the encoding<standard:/number/decimal/ascii>.
            }
        }
        create a particle in position<worker>.
        create a particle in position<number>.
        set the value of position<number> to literal<standard:/number>"1".
        move the particle in position<number> to position<worker>::action</consume>::position<input>.
    }
}
