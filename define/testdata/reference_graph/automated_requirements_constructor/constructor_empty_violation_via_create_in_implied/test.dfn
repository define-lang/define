# An earlier constructor fills the implied position, so the later
# constructor's empty requirement on it can never hold.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</filler>.
                it has the action</p>.
            }
        }
        create a particle in position<box>.
    }
}
