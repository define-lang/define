define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</outer>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the position</data>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</data>.
        move the particle in position<box> to action</outer>::position<input>.
        create a particle in action</outer>::position<run>.
    }
}
