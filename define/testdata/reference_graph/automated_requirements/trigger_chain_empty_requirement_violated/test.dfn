# A trigger chain's child empty requirement is violated when the caller fills it before triggering.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</other>.
            }
        }
        define the position<spare> {
            it may only contain particles where {
                it has the position</x>.
            }
        }
        create a particle in position<box>.
        create a particle in position<spare>.
        create a particle in position<spare>::position</x>.
        move the particle in position<spare> to position<box>::action</other>::position<trigger_pos>.
    }
}
