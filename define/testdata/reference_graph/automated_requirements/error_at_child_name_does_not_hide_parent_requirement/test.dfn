# An error at position</parent>::position</leaf> must not make the parent-name
# state error. The absent parent still violates parent_destructor's occupied
# requirement when close_file's Destruction Contract reaches the caller.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</close_file>.
            }
        }
        define the position<my_file> {
            it may only contain particles where {
                it has the position</parent>.
                it has the action</parent_destructor>.
            }
        }
        create a particle in position<box>.
        create a particle in position<my_file>.
        move the particle in position<my_file> to position<box>::action</close_file>::position<target>.
        create a particle in position<box>::action</close_file>::position<run>.
    }
}
