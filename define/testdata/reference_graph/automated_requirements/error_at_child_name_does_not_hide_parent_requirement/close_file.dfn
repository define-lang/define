define the potential action<my.domain.com:my_lib:/close_file> {
    define the position<target> {
        it may only contain particles where {
            it has the position</parent>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<spare>.
        move the particle in position<spare> to position<target>::position</parent>::position</leaf>.
        destroy the particle in position<target>.
    }
}
