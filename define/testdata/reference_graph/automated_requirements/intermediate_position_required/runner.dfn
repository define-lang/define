define the potential action<my.domain.com:my_lib:/runner> {
    define the position<run>.
    define the position<wrap> {
        it may only contain particles where {
            it has the position</mid>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<wrap>::position</mid>::position</leaf>.
        destroy the particle in position<wrap>.
        destroy the particle in position<run>.
    }
}
