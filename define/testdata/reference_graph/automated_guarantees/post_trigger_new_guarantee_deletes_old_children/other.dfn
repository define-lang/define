define the potential action<my.domain.com:my_lib:/other> {
    define the position<trigger_pos>.
    define the position<iface> {
        it may only contain particles where {
            it has the position</a>.
        }
    }
    define the position<_sink>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        move the particle in position<iface> to position<_sink>.
        create a particle in position<iface>.
    }
}
