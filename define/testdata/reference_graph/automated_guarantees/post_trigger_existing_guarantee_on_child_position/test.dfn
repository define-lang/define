# After trigger, a child position filled by the action's move is guaranteed occupied.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</other>.
            }
        }
        define the position<spare> {
            it may only contain particles where {
                it has the position</child_q>.
            }
        }
        define the position<spare2>.
        create a particle in position<box>.
        create a particle in position<spare>.
        create a particle in position<spare2>.
        move the particle in position<spare> to position<box>::action</other>::position<item>.
        move the particle in position<spare2> to position<box>::action</other>::position<item>::position</child_q>.
        create a particle in position<box>::action</other>::position<trigger_pos>.
        create a particle in position<box>::action</other>::position<dest>::position</child_q>.
    }
}
