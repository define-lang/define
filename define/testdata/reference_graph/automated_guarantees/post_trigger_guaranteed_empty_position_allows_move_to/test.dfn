# After trigger, a position guaranteed empty by the action allows move-to.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</other>.
            }
        }
        define the position<spare>.
        define the position<result> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        create a particle in position<box>.
        create a particle in position<spare>.
        create a particle in position<box>::action</other>::position<trigger_pos>.
        move the particle in position<box>::action</other>::position<item> to position<result>.
        move the particle in position<spare> to position<result>::position</child>.
    }
}
