# A callee consumes its own callee's Interface Position before returning.
# Applying its nested Guarantees must reject destroying that particle again.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</outer>::position<iface>.
        create a particle in position<box>::action</outer>::position<trigger_pos>.
        destroy the particle in position<box>::action</outer>::position<iface>::action</inner>::position<output>.
        destroy the particle in position<box>::action</outer>::position<iface>.
    }
}
