# The particle a view looks at must have the view's value, not another value.
define the potential value<my.domain.com:my_lib:/text>.
define the operation<my.domain.com:my_lib:/copy> {
    define the view<source> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    define the view<target> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
define the potential action<my.domain.com:my_lib:/run> {
    define the position<first> {
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    define the position<second> {
        it may only contain particles where {
            it has the value</text>.
        }
    }
    define the position<trigger>.
    it happens when {
        the position<trigger> has a particle.
    } and it does {
        execute the operation</copy> {
            with view<source> looking at position<first>.
            with view<target> looking at position<second>.
        }
    }
}
