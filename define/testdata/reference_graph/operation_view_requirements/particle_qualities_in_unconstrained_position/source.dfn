# A view checks the qualities of the particle it looks at, not the constraints of the position holding it.
define the operation<my.domain.com:my_lib:/copy> {
    define the view<source> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
            it has the encoding<standard:/number/decimal/ascii>.
        }
    }
    define the view<target> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
define the potential position<my.domain.com:my_lib:/second> {
    it may only contain particles where {
        it has the value<standard:/number/rational>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</second>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<first> {
            it may only contain particles where {
                it has the value<standard:/number/rational>.
                it has the encoding<standard:/number/decimal/ascii>.
            }
        }
        define the position<holder>.
        create a particle in position<first>.
        create a particle in position</second>.
        set the value of position<first> to literal<standard:/number>"1".
        move the particle in position<first> to position<holder>.
        execute the operation</copy> {
            with view<source> looking at position<holder>.
            with view<target> looking at position</second>.
        }
    }
}
