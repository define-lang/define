define the operation<my.domain.com:my_lib:/copy> {
    define the view<source> {
        it is read.
        it may only contain particles where {
            it has the value</count>.
        }
    }
    define the view<target> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }

    it does {
        execute the logical_operation<standard:/number/absolute_value> {
            with view<a> looking at view<source>.
            with view<result> looking at view<target>.
        }
    }
}
