# An association must list the Interface Views of its logical operation, which its Encoding Operation must have. The project associates /number/integer/ascii/add with /negate, and lists its views, including view<b>, which /negate does not have.
define the operation<my.domain.com:my_lib:/test> {
    define the view<amount> {
        it is read.
        it may only contain particles where {
            it has the value</number>.
        }
    }
    define the view<negated> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }

    it does {
        execute the logical_operation</negate> {
            with view<a> looking at view<amount>.
            with view<result> looking at view<negated>.
        }
    }
}
