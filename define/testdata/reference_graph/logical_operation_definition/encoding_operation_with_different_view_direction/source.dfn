# An Encoding Operation associated with a logical operation must have views with the same directions. The test associates /number/integer/ascii/negate, whose view<a> is read, with /negate.
define the logical_operation<my.domain.com:my_lib:/negate> {
    define the view<a> {
        it is written.
    }
    define the view<result> {
        it is written.
    }
}
define the potential value<my.domain.com:my_lib:/number> {
    it supports the logical_operation</negate> {
        it may be read.
        it may be written.
    }
}
define the operation<my.domain.com:my_lib:/test> {
    define the view<first> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }
    define the view<second> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }

    it does {
        execute the logical_operation</negate> {
            with view<a> looking at view<first>.
            with view<result> looking at view<second>.
        }
    }
}
