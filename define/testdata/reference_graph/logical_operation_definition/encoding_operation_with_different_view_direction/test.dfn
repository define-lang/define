# An Encoding Operation associated with a logical operation must have views with the same directions. The project associates /number/integer/ascii/negate, whose view<a> is read, with /negate.
define the operation<my.domain.com:my_lib:/test> {
    define the view<first> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }
    define the view<second> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }

    it does {
        execute the logical_operation</negate> {
            with view<a> looking at view<first>.
            with view<result> looking at view<second>.
        }
    }
}
