encoding_operations: {
  operation_encodings: [
    {
      logical_operation: "/combine"
      encoding_operation: {
        name: "/combine/integer"
        views: [
          {
            view: "a"
            encoding: "standard:/number/integer/ascii"
          },
          {
            view: "b"
            encoding: "standard:/number/integer/ascii"
          },
          {
            view: "result"
            encoding: "standard:/number/integer/ascii"
          }
        ]
      }
    }
  ]
}
