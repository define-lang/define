# An association must list its logical operation's Interface Views in their order, which its Encoding Operation must have. The project associates /number/integer/ascii/negate with /negate, and lists view<a> first, where /negate's first view is view<result>.
define the operation<my.domain.com:my_lib:/test> {
    define the view<first> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }
    define the view<second> {
        it is read.
        it may only contain particles where {
            it has the value</number>.
        }
    }

    it does {
        execute the logical_operation</negate> {
            with view<result> looking at view<first>.
            with view<a> looking at view<second>.
        }
    }
}
