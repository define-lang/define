# An association must list the encoding of each of its Encoding Operation's Interface Views. The action's execution of /test chooses the project's association of /number/integer/ascii/add with /combine, which says view<b> has the natural encoding.
define the operation<my.domain.com:my_lib:/test> {
    define the view<first> {
        it is read.
        it may only contain particles where {
            it has the value</number>.
        }
    }
    define the view<second> {
        it is read.
        it may only contain particles where {
            it has the value</count>.
        }
    }
    define the view<combined> {
        it is written.
        it may only contain particles where {
            it has the value</number>.
        }
    }

    it does {
        execute the logical_operation</combine> {
            with view<a> looking at view<first>.
            with view<b> looking at view<second>.
            with view<result> looking at view<combined>.
        }
    }
}

define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</combined>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<first> {
            it may only contain particles where {
                it has the value</number>.
            }
        }
        define the position<second> {
            it may only contain particles where {
                it has the value</count>.
            }
        }
        create a particle in position<first>.
        set the value of position<first> from literal<standard:/number>"1".
        create a particle in position<second>.
        set the value of position<second> from literal<standard:/number>"1".
        create a particle in position</combined>.
        execute the operation</test> {
            with view<first> looking at position<first>.
            with view<second> looking at position<second>.
            with view<combined> looking at position</combined>.
        }
    }
}
