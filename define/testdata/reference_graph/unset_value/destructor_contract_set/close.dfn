define the potential action<my.domain.com:my_lib:/close> {
    define the position<input> {
        it may only contain particles where {
            it has the position</value>.
        }
    }
    it happens when {
        the position<input> has a particle.
    } and it does {
        define the position<temporary>.
        move the particle in position<input>::position</value> to position<temporary>.
        move the particle in position<temporary> to position<input>::position</value>.
        destroy the particle in position<input>.
    }
}
