# Implied value guarantees propagate through an intermediate action.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</copy>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<worker> {
            it may only contain particles where {
                it has the action</relay>.
                it has the position</value>.
            }
        }
        create a particle in position<worker>.
        create a particle in position<worker>::action</relay>::position<trigger>.
        create a particle in position</copy>.
        set the value of position</copy> to position<worker>::position</value>.
    }
}
