define the potential action<my.domain.com:my_lib:/relay> {
    define the position<input> {
        it may only contain particles where {
            it has the action</other_cleanup>.
            it has the action</cleanup>.
            it has the position</value>.
        }
    }
    it happens when {
        the position<input> has a particle.
    } and it does {
        define the position<worker> {
            it may only contain particles where {
                it has the action</close>.
            }
        }
        create a particle in position<worker>.
        move the particle in position<input> to position<worker>::action</close>::position<input>.
    }
}
