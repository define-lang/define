# An action interface must receive its value from its direct caller.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<input> {
        it may only contain particles where {
            it has the action</consume>.
        }
    }
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position<input>::action</consume>::position<trigger>.
    }
}
