# The first read after a move requires the original contracted position value.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<source> {
            it may only contain particles where {
                it has the value<standard:/number/rational>.
            }
        }
        create a particle in position<source>.
        set the value of position<source> to literal<standard:/number>"5".
        define the position<worker> {
            it may only contain particles where {
                it has the action</consume>.
            }
        }
        create a particle in position<worker>.
        move the particle in position<source> to position<worker>::action</consume>::position<input>.
    }
}
