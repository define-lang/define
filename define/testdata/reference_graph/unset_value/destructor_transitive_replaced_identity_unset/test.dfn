# Destructors read the value state immediately before destruction.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</cleanup>.
                it has the position</value>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</value>.
        set the value of position<box>::position</value> to literal<standard:/number>"5".
        define the position<worker> {
            it may only contain particles where {
                it has the action</relay>.
            }
        }
        create a particle in position<worker>.
        define the position<replacement> {
            it may only contain particles where {
                it has the value<standard:/number/rational>.
            }
        }
        create a particle in position<replacement>.
        move the particle in position<replacement> to position<worker>::action</relay>::position<replacement>.
        move the particle in position<box> to position<worker>::action</relay>::position<input>.
    }
}
