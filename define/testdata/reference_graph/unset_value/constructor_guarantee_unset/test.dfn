# Constructor completion determines the initial observable value state.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<worker> {
            it may only contain particles where {
                it has the action</initialize>.
                it has the position</value>.
            }
        }
        create a particle in position<worker>.
        define the position<copy> {
            it may only contain particles where {
                it has the value</number>.
            }
        }
        create a particle in position<copy>.
        set the value of position<copy> to position<worker>::position</value>.
    }
}
