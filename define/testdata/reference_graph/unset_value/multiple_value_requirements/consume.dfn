define the potential action<my.domain.com:my_lib:/consume> {
    it also assigns the position</copy>.
    it also assigns the position</other_copy>.
    define the position<input> {
        it may only contain particles where {
            it has the value</number>.
        }
    }
    define the position<other> {
        it may only contain particles where {
            it has the value</number>.
        }
    }
    it happens when {
        the position<input> has a particle.
    } and it does {
        create a particle in position</copy>.
        create a particle in position</other_copy>.
        set the value of position</copy> to position<input>.
        set the value of position</other_copy> to position<other>.
        destroy the particle in position<other>.
        destroy the particle in position<input>.
    }
}
