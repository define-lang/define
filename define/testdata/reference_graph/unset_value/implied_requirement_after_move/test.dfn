# Reading after a move still requires a set value at the original implied position.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<worker> {
            it may only contain particles where {
                it has the action</read>.
                it has the position</value>.
            }
        }
        create a particle in position<worker>.
        create a particle in position<worker>::position</value>.
        create a particle in position<worker>::action</read>::position<trigger>.
    }
}
