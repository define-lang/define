define the potential action<my.domain.com:my_lib:/provide> {
    define the position<trigger>.
    define the position<item> {
        it may only contain particles where {
            it has the value</number>.
        }
    }
    it happens when {
        the position<trigger> has a particle.
    } and it does {
        create a particle in position<item>.
        set the value of position<item> to literal<standard:/number>"5".
        destroy the particle in position<trigger>.
    }
}
