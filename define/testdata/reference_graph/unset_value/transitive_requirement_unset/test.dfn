# Set-value requirements propagate through calls after a move.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<source> {
            it may only contain particles where {
                it has the value</number>.
            }
        }
        create a particle in position<source>.
        define the position<worker> {
            it may only contain particles where {
                it has the action</relay>.
            }
        }
        create a particle in position<worker>.
        move the particle in position<source> to position<worker>::action</relay>::position<input>.
    }
}
