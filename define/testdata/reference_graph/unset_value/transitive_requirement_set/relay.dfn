define the potential action<my.domain.com:my_lib:/relay> {
    define the position<input> {
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    it happens when {
        the position<input> has a particle.
    } and it does {
        define the position<moved> {
            it may only contain particles where {
                it has the action</consume>.
            }
        }
        create a particle in position<moved>.
        move the particle in position<input> to position<moved>::action</consume>::position<input>.
    }
}
