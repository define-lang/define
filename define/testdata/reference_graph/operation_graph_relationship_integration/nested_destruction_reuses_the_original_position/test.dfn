# The parent remains alive while its destructor reuses /temporary. Destroying
# either temporary particle does not select that parent, so the second Create
# still waits for the first temporary particle to vacate the same position.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<parent> {
            it may only contain particles where {
                it has the action</destroy_parent>.
            }
        }
        create a particle in position<parent>.
    }
}
