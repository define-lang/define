# Both destructors need the original child occupancy. Finishing only one
# does not let the parent Move reverse that relationship.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<parent> {
            it may only contain particles where {
                it has the position</child>.
                it has the action</destroy_parent>.
                it has the action</other_destructor>.
            }
        }
        define the position<detached> {
            it may only contain particles where {
                it has the position</return>.
            }
        }
        create a particle in position<parent>.
        create a particle in position<parent>::position</child>.
        create a particle in position<parent>::position</child>::position</leaf>.
        move the particle in position<parent>::position</child>::position</leaf> to position<detached>.
        # This cannot happen while /child and /leaf still connect the parent
        # particle to the particle that defines /return.
        move the particle in position<parent> to position<detached>::position</return>.
    }
}
