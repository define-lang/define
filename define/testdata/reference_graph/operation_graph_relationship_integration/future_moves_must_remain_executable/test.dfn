# Moving parent early would block visitor from entering parent's /landing.
# The later Move that could release parent needs other to move into visitor,
# which itself needs visitor to leave. The graph must prevent that deadlock.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<parent> {
            it may only contain particles where {
                it has the position</landing>.
                it has the position</inner>.
            }
        }
        define the position<other> {
            it may only contain particles where {
                it has the position</landing>.
                it has the position</inner>.
            }
        }
        define the position<visitor> {
            it may only contain particles where {
                it has the position</landing>.
                it has the position</inner>.
            }
        }
        create a particle in position<parent>.
        create a particle in position<other>.
        create a particle in position<visitor>.
        create a particle in position<parent>::position</inner>.
        destroy the particle in position<parent>::position</inner>.
        create a particle in position<other>::position</inner>.
        destroy the particle in position<other>::position</inner>.
        create a particle in position<visitor>::position</landing>.
        destroy the particle in position<visitor>::position</landing>.
        move the particle in position<visitor> to position<parent>::position</landing>.
        move the particle in position<parent>::position</landing> to position<other>::position</landing>.
        # This Move must wait for visitor to finish its visit to parent's /landing.
        # Executing it first is acyclic but leaves no way to complete that visit.
        move the particle in position<parent> to position<other>::position</landing>::position</inner>.
        move the particle in position<other> to position<visitor>.
        move the particle in position<visitor>::position</landing>::position</inner> to position<other>.
    }
}
