# Any two reverse visits may begin before the forward visits finish.
# All three may not: each reverse departure then needs a forward visit blocked
# by another reverse visit. Pairwise exclusions would lose valid concurrency.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<first> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        define the position<second> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        define the position<third> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        define the position<fourth> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        define the position<fifth> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        define the position<sixth> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        define the position<handoff_one>.
        define the position<handoff_two>.
        define the position<handoff_three>.
        create a particle in position<first>.
        create a particle in position<second>.
        create a particle in position<third>.
        create a particle in position<fourth>.
        create a particle in position<fifth>.
        create a particle in position<sixth>.
        move the particle in position<first> to position<second>::position</child>.
        move the particle in position<second>::position</child> to position<handoff_one>.
        move the particle in position<handoff_one> to position<first>.
        move the particle in position<third> to position<fourth>::position</child>.
        move the particle in position<fourth>::position</child> to position<handoff_two>.
        move the particle in position<handoff_two> to position<third>.
        move the particle in position<fifth> to position<sixth>::position</child>.
        move the particle in position<sixth>::position</child> to position<handoff_three>.
        move the particle in position<handoff_three> to position<fifth>.
        # This reverse entry shares the three-way restriction, not a fixed order.
        move the particle in position<second> to position<first>::position</child>.
        move the particle in position<first>::position</child> to position<handoff_two>.
        # This reverse entry shares the three-way restriction, not a fixed order.
        move the particle in position<fourth> to position<third>::position</child>.
        move the particle in position<third>::position</child> to position<handoff_three>.
        # This reverse entry shares the three-way restriction, not a fixed order.
        move the particle in position<sixth> to position<fifth>::position</child>.
        move the particle in position<fifth>::position</child> to position<handoff_one>.
        destroy the particle in position<first>.
        destroy the particle in position<handoff_one>.
        destroy the particle in position<third>.
        destroy the particle in position<handoff_two>.
        destroy the particle in position<fifth>.
        destroy the particle in position<handoff_three>.
    }
}
