# Either particle can make its temporary visit to the other's /child first,
# but the visits cannot overlap. Both particles must leave parent's positions
# before parent vanishes. One must therefore reach helper first, regardless of
# which visit occurs first. This forces create(helper) before vanish(parent)
# through alternative paths rather than one fixed intervening operation.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<parent> {
            it may only contain particles where {
                it has the position</p>.
                it has the position</q>.
            }
        }
        define the position<helper> {
            it may only contain particles where {
                it has the position</left>.
                it has the position</right>.
            }
        }
        create a particle in position<parent>.
        create a particle in position<parent>::position</p>.
        create a particle in position<parent>::position</q>.
        move the particle in position<parent>::position</p> to position<parent>::position</q>::position</child>.
        create a particle in position<helper>.
        move the particle in position<parent>::position</q>::position</child> to position<helper>::position</left>.
        move the particle in position<parent>::position</q> to position<helper>::position</left>::position</child>.
        move the particle in position<helper>::position</left>::position</child> to position<helper>::position</right>.
        destroy the particle in position<parent>.
    }
}
