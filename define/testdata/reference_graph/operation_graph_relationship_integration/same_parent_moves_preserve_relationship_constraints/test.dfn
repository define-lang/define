# Moving between /left and /right does not change the parent particle.
# Later relationship changes must still account for that continuous relationship.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<seed> {
            it may only contain particles where {
                it has the position</branch>.
                it has the position</companion_home>.
            }
        }
        define the position<parent> {
            it may only contain particles where {
                it has the position</companion_home>.
            }
        }
        define the position<other> {
            it may only contain particles where {
                it has the position</visit>.
                it has the position</parent_home>.
                it has the position</companion_home>.
            }
        }
        define the position<detached> {
            it may only contain particles where {
                it has the position</left>.
                it has the position</right>.
            }
        }
        create a particle in position<seed>.
        create a particle in position<seed>::position</companion_home>.
        destroy the particle in position<seed>::position</companion_home>.
        create a particle in position<seed>::position</branch>.
        create a particle in position<seed>::position</branch>::position</left>.
        create a particle in position<other>.
        create a particle in position<other>::position</parent_home>.
        destroy the particle in position<other>::position</parent_home>.
        create a particle in position<other>::position</companion_home>.
        destroy the particle in position<other>::position</companion_home>.
        move the particle in position<seed>::position</branch>::position</left> to position<seed>::position</branch>::position</right>.
        move the particle in position<seed>::position</branch> to position<other>::position</visit>.
        move the particle in position<seed> to position<parent>.
        move the particle in position<other>::position</visit> to position<detached>.
        create a particle in position<detached>::position</left>.
        destroy the particle in position<detached>::position</left>.
        move the particle in position<parent> to position<detached>::position</right>::position</parent_home>.
        move the particle in position<detached>::position</right> to position<parent>.
        # Executing this Move early can leave the relationships acyclic but block
        # both the visit to /visit and the Moves that would release the conflict.
        # The Move between /left and /right does not release that conflict.
        move the particle in position<other> to position<parent>::position</companion_home>.
        move the particle in position<parent>::position</companion_home> to position<detached>::position</right>.
    }
}
