# Either Move-and-return pair can run first, but their temporary parent
# relationships cannot coexist. Each actual position keeps its source-ordered
# occupants: first::/child and second::/child are different positions.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<first> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        define the position<second> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        create a particle in position<first>.
        create a particle in position<second>.
        move the particle in position<first> to position<second>::position</child>.
        move the particle in position<second>::position</child> to position<first>.
        # This pair can run before the preceding pair, but cannot begin while
        # first's particle still occupies second's /child: that would cycle.
        move the particle in position<second> to position<first>::position</child>.
        move the particle in position<first>::position</child> to position<second>.
    }
}
