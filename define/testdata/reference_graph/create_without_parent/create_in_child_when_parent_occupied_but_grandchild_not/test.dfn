define the potential action<my.domain.com:my_lib:/test> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<local> {
            it may only contain particles where {
                it has the position</x>.
            }
        }
        create a particle in position<local>.
        create a particle in position<local>::position</x>::position</y>.
    }
}
