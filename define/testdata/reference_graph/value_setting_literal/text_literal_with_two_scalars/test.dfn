# A text literal cannot set a scalar to e followed by a combining acute accent, because that is two scalars.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<target> {
            it may only contain particles where {
                it has the value<standard:/text/unicode/scalar>.
            }
        }
        create a particle in position<target>.
        set the value of position<target> to literal<standard:/text>"é".
        destroy the particle in position<target>.
    }
}
