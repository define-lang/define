# A Potential Literal whose encoding has no Literal Parser cannot set a value.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<target> {
            it may only contain particles where {
                it has the value</number>.
            }
        }
        create a particle in position<target>.
        set the value of position<target> to literal</text>"5".
        destroy the particle in position<target>.
    }
}
