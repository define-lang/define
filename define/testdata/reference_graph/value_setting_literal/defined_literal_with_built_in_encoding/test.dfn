# A defined Potential Literal can use the built-in decimal encoding.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</target>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</target>.
        set the value of position</target> to literal</decimal>"-12.5".
    }
}
