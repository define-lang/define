# Same-position rejection still validates chained names and tracks constraint use.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<parent> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        create a particle in position<parent>.
        set the value of position<parent>::position</child> to position<parent>::position</child>.
    }
}
