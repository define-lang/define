# A child value cannot be accessed without its parent particle.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<parent> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        define the position<source> {
            it may only contain particles where {
                it has the value</number>.
            }
        }
        create a particle in position<source>.
        set the value of position<source> to literal</decimal>"5".
        set the value of position<parent>::position</child> to position<source>.
    }
}
