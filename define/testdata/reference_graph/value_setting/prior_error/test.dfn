# A failed move suppresses further errors about that particle.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<target> {
            it may only contain particles where {
                it has the value</number>.
            }
        }
        define the position<source> {
            it may only contain particles where {
                it has the value</number>.
            }
        }
        define the position<empty>.
        create a particle in position<source>.
        create a particle in position<target>.
        set the value of position<target> to position<source>.
        destroy the particle in position<target>.
        move the particle in position<empty> to position<target>.
        set the value of position<target> to position<source>.
    }
}
