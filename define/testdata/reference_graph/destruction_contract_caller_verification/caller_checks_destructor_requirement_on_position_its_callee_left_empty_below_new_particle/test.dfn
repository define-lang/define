# action</fill_1> leaves a particle in position</child_1> with a Destructor
# whose requirement on position</needed> nothing meets: what action</fill_1> left
# below the particle has nothing there. action</test> passes the particle above
# it to action</destroyer>, which destroys it, so action</test> checks the
# Destructor against what action</fill_1> left.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</destroyer>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</fill_1>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</fill_1>::position<run>.
        move the particle in position<holder> to action</destroyer>::position<target>.
        create a particle in action</destroyer>::position<run>.
    }
}
