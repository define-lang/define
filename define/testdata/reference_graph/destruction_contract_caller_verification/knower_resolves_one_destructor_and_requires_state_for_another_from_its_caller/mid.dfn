define the potential action<my.domain.com:my_lib:/mid> {
    define the position<incoming> {
        it may only contain particles where {
            it has the action</d1>.
            it has the action</d2>.
            it has the position</item1>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</close_file>.
            }
        }
        create a particle in position<box>.
        create a particle in position<incoming>::position</item1>.
        move the particle in position<incoming> to position<box>::action</close_file>::position<target>.
        create a particle in position<box>::action</close_file>::position<run>.
    }
}
