# action</fill_1> leaves a particle in position</child_2> with a Destructor
# whose requirement on position</needed> nothing meets. action</test> never
# expands it and passes the particle above it to action</destroyer>, which
# destroys it. action</test> still has to check the Destructor.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</destroyer>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</fill_1>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</fill_1>::position<run>.
        move the particle in position<holder> to action</destroyer>::position<target>.
        create a particle in action</destroyer>::position<run>.
    }
}
