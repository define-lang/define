# action</mid> is the knower of the Destructor on the particle it passes to action</inner>, and no action below it knows position</reading>.
# action</mid> gains the Destructor's requirement that position</reading> has a set value, which /test violates where it triggers action</mid>.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<outer_box> {
            it may only contain particles where {
                it has the action</mid>.
            }
        }
        define the position<my_item> {
            it may only contain particles where {
                it has the action</destructor>.
                it has the position</reading>.
            }
        }
        create a particle in position<outer_box>.
        create a particle in position<my_item>.
        create a particle in position<my_item>::position</reading>.
        move the particle in position<my_item> to position<outer_box>::action</mid>::position<incoming>.
        create a particle in position<outer_box>::action</mid>::position<run>.
    }
}
