# Making the occupied-required implied position known-empty in outer and filling the empty-required one in middle means neither alone knows both states, so the destructor is checked once at outer and reports both violations there.
# p2 was filled by middle; outer never touched it, so the fill site is the
# one the contract carried up from middle.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        define the position<my_file> {
            it may only contain particles where {
                it has the action</destructor>.
            }
        }
        create a particle in position<box>.
        create a particle in position<my_file>.
        move the particle in position<my_file> to position<box>::action</outer>::position<incoming>.
        create a particle in position<box>::action</outer>::position<run>.
    }
}
