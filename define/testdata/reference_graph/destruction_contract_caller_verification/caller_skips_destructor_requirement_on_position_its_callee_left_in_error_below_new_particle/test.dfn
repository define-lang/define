# action</fill_1> reports an error that leaves position</needed> in error below
# the particle it creates in position</child_1>. action</test> passes the
# particle above it to action</destroyer>, which destroys it, and checks the
# Destructor of position</child_1> against what action</fill_1> left: nothing
# more is reported about position</needed> or the position below it.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</destroyer>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</fill_1>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</fill_1>::position<run>.
        move the particle in position<holder> to action</destroyer>::position<target>.
        create a particle in action</destroyer>::position<run>.
    }
}
