define the potential action<my.domain.com:my_lib:/destroyer> {
    define the position<run>.
    define the position<target> {
        it may only contain particles where {
            it has the action</make_child>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<target>::action</make_child>::position<run>.
        destroy the particle in position<target>.
        destroy the particle in position<run>.
    }
}
