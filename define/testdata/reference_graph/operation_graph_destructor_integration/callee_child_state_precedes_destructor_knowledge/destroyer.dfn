define the potential action<my.domain.com:my_lib:/destroyer> {
    define the position<target> {
        it may only contain particles where {
            it has the position</occupied>.
            it has the position</empty>.
        }
    }
    define the position<trigger>.
    it happens when {
        the position<trigger> has a particle.
    } and it does {
        create a particle in position<target>::position</occupied>.
        create a particle in position<target>::position</empty>.
        destroy the particle in position<target>::position</empty>.
        destroy the particle in position<target>.
        destroy the particle in position<trigger>.
    }
}
