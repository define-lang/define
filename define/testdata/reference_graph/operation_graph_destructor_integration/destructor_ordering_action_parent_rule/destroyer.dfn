define the potential action<my.domain.com:my_lib:/destroyer> {
    define the position<trigger_pos>.
    define the position<target> {
        it may only contain particles where {
            it has the action</known_destructor>.
            it has the position</marker>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        define the position<holder>.
        move the particle in position<target> to position<holder>.
        move the particle in position<holder> to position<target>.
        destroy the particle in position<target>.
    }
}
