define the potential action<my.domain.com:my_lib:/inner> {
    it also assigns the action</destroyer>.
    define the position<run> {
        it may only contain particles where {
            it has the action</known_destructor>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        move the particle in position<run> to action</destroyer>::position<target>.
        create a particle in action</destroyer>::position<trigger_pos>.
        destroy the particle in action</destroyer>::position<trigger_pos>.
    }
}
