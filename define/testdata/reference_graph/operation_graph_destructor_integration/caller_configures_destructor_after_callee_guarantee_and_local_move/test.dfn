# Consumer configuration follows a callee Guarantee and a subsequent local Move.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</outer>.
    it also assigns the action</seeder>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<source> {
            it may only contain particles where {
                it has the action</middle>.
                it has the position</payload>.
            }
        }
        define the position<payload_source> {
            it may only contain particles where {
                it has the action</extra_destructor>.
                it has the action</known_destructor>.
            }
        }
        create a particle in position<source>.
        create a particle in action</seeder>::position<run>.
        destroy the particle in action</seeder>::position<run>.
        create a particle in position<payload_source>.
        move the particle in position<payload_source> to position<source>::position</payload>.
        move the particle in position<source> to action</outer>::position<run>.
    }
}
