define the potential action<my.domain.com:my_lib:/destructor> {
    define the position<occupied_first> {
        it may only contain particles where {
            it has the position</transitive>.
        }
    }
    define the position<empty>.
    define the position<occupied_last>.
    it happens when {
        this particle is being destroyed.
    } and it does {
        define the position<first_holder>.
        define the position<transitive_holder>.
        define the position<last_holder>.
        move the particle in position<occupied_first> to position<first_holder>.
        move the particle in position<first_holder> to position<occupied_first>.
        move the particle in position<occupied_first>::position</transitive> to position<transitive_holder>.
        move the particle in position<transitive_holder> to position<occupied_first>::position</transitive>.
        create a particle in position<empty>.
        destroy the particle in position<empty>.
        move the particle in position<occupied_last> to position<last_holder>.
        move the particle in position<last_holder> to position<occupied_last>.
    }
}
