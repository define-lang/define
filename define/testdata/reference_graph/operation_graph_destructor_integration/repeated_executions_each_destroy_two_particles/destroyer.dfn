define the potential action<my.domain.com:my_lib:/destroyer> {
    define the position<first>.
    define the position<second>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<used_run>.
        move the particle in position<run> to position<used_run>.
        destroy the particle in position<first>.
        destroy the particle in position<second>.
    }
}
