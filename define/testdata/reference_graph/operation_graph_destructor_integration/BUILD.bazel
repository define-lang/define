load("//tools/bzl:pyright.bzl", "pyright_test")

_TRACING_TESTDATA_EXCLUDES = [
    "**/expected_trace/**",
    "**/operation_trace.json",
]

_CODEGEN_TESTDATA_EXCLUDES = [
    "caller_contributed_child_destructor_depends_on_callee_guarantee/**",
    "diamond_callers_serialize_added_destructor_around_known_destructor/**",
    "destructor_known_only_two_callers_up/**",
    "destructor_on_particle_from_callee_guarantee/**",
    "destructor_with_children_known_only_two_callers_up/**",
]

filegroup(
    name = "codegen_testdata",
    testonly = True,
    srcs = glob(
        ["**"],
        exclude = _CODEGEN_TESTDATA_EXCLUDES + _TRACING_TESTDATA_EXCLUDES,
    ),
    visibility = [
        "//define/compiler/codegen:__pkg__",
        "//define/testdata/codegen:__pkg__",
    ],
)

filegroup(
    name = "operation_graph_destructor_integration",
    testonly = True,
    srcs = glob(
        ["**"],
        exclude = [
            "**/expected/**",
            "**/occupied_positions.txt",
        ] + _TRACING_TESTDATA_EXCLUDES,
    ),
    visibility = [
        "//define/compiler/validator/reference_graph/reference_graph_validator_tests:__pkg__",
        "//define/testdata:__pkg__",
    ],
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    srcs = glob(["**/*.py"]),
    deps = [
        "//define/runtime:literal",
        "//define/runtime:tracing",
    ],
)
