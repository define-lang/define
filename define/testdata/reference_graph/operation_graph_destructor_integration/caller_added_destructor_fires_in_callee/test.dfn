# action</callee>'s Destroy fires the caller-added Destructor on the particle it
# destroys, including the Destructor's operations in the Operation Graph.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</callee>.
            }
        }
        define the position<carrier> {
            it may only contain particles where {
                it has the action</destructor>.
            }
        }
        create a particle in position<box>.
        create a particle in position<carrier>.
        move the particle in position<carrier> to position<box>::action</callee>::position<target>.
        create a particle in position<box>::action</callee>::position<run>.
    }
}
