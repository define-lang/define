# The Destroy vertices represent vacancy, not the end of particle existence.
# The original implied-position particles remain available through the two
# independent destructor chains; their vacancies need not wait for those Moves.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the position</marker_a>.
                it has the position</marker_b>.
                it has the action</destruct>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</marker_a>.
        create a particle in position<box>::position</marker_b>.
        destroy the particle in position<box>.
    }
}
