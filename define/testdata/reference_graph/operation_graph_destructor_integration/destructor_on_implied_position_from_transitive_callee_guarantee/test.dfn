# /inner's guarantee propagates the destructor on its implied position through
# /middle to /test.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</middle>.
                it has the position</child>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</middle>::position<run>.
        destroy the particle in position<box>::position</child>.
    }
}
