# The two caller-only Destructors have independent requirements, while the
# caller-contributed child of /required is destroyed after its parent particle's
# Destructor, so the Empty Rule retains only that later child Destroy before the
# Destroy of /required.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</destroyer>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<source> {
            it may only contain particles where {
                it has the action</destruct_required>.
                it has the action</destruct_sibling>.
                it has the position</required>.
                it has the position</sibling>.
            }
        }
        create a particle in position<source>.
        create a particle in position<source>::position</required>.
        create a particle in position<source>::position</required>::position</extra>.
        create a particle in position<source>::position</sibling>.
        move the particle in position<source> to action</destroyer>::position<parent>.
        create a particle in action</destroyer>::position<trigger_pos>.
    }
}
