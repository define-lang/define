define the potential action<my.domain.com:my_lib:/destroyer> {
    it also assigns the action</mover>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        move the particle in position<run> to action</mover>::position<run>.
        destroy the particle in action</mover>::position<result>.
    }
}
