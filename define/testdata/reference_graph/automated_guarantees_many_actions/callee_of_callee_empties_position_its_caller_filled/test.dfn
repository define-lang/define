# action</outer> fills position</item> itself and then triggers
# action</clear_box>, whose callee action</empty_item> empties it again. That
# Guarantee is still pending when action</outer> publishes its own, so
# position</item> is empty and destroying it is an error.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</outer>.
                it has the position</box>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</outer>::position<run>.
        destroy the particle in position<holder>::position</box>::position</item>.
    }
}
