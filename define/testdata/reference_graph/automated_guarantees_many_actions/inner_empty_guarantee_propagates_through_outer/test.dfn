# /inner moves from position<item>, guaranteeing it empty.
#
# /outer fills position</item> and transfers its particle through /inner, which
# empties it. /test triggers /outer, then creates in position</item> — which should
# succeed because /inner's empty guarantee propagates through /outer.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        define the position<result> {
            it may only contain particles where {
                it has the position</item>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</outer>::position<trigger_pos>.
        move the particle in position<box>::action</outer>::position<iface> to position<result>.
        create a particle in position<result>::position</item>.
    }
}
