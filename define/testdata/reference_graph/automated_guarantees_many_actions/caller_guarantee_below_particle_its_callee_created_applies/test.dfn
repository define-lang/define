# The Guarantee of action</middle> for position</box>::position</child> is
# about the particle that the Guarantee of action</inner> puts in position</box>.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</middle>.
                it has the position</box>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</middle>::position<run>.
        create a particle in position<holder>::position</box>::position</child>.
    }
}
