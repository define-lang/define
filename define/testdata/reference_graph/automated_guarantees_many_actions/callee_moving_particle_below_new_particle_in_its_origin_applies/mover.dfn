define the potential action<my.domain.com:my_lib:/mover> {
    it also assigns the position</slot>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<tmp>.
        destroy the particle in position<run>.
        move the particle in position</slot> to position<tmp>.
        create a particle in position</slot>.
        move the particle in position<tmp> to position</slot>::position</inner>.
    }
}
