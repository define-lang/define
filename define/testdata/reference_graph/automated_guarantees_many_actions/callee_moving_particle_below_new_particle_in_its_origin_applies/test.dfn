# action</mover> puts a new particle in position</slot> and moves the particle
# that was there to position</inner> below the new one.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</mover>.
                it has the position</slot>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::position</slot>.
        create a particle in position<holder>::action</mover>::position<run>.
        create a particle in position<holder>::position</slot>::position</inner>.
    }
}
