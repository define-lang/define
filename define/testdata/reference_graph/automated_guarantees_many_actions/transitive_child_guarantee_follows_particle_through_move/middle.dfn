define the potential action<my.domain.com:my_lib:/middle> {
    define the position<trigger_pos>.
    define the position<inner_parent> {
        it may only contain particles where {
            it has the position</result>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        define the position<inner_holder> {
            it may only contain particles where {
                it has the action</inner>.
            }
        }
        define the position<result_holder>.
        create a particle in position<inner_holder>.
        move the particle in position<inner_parent> to position<inner_holder>::action</inner>::position<input>.
        create a particle in position<inner_holder>::action</inner>::position<trigger_pos>.
        move the particle in position<inner_holder>::action</inner>::position<input>::position</result> to position<result_holder>.
        move the particle in position<inner_holder>::action</inner>::position<input> to position<inner_parent>.
        move the particle in position<result_holder> to position<inner_parent>::position</result>.
    }
}
