# action</mover> moves the particle in position</box>::position</part> and then
# the particle in position</box>, each to its own position. The particle in
# position</part> does not go along with the one in position</box>, so only
# position</moved_part> is occupied.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</mover>.
                it has the position</box>.
                it has the position</moved_box>.
                it has the position</moved_part>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::position</box>.
        create a particle in position<holder>::position</box>::position</part>.
        create a particle in position<holder>::action</mover>::position<run>.
        create a particle in position<holder>::position</moved_part>.
        create a particle in position<holder>::position</moved_box>::position</part>.
    }
}
