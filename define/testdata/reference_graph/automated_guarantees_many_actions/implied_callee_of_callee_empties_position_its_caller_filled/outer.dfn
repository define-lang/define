define the potential action<my.domain.com:my_lib:/outer> {
    it also assigns the position</box>.
    it also assigns the action</mid>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<run>.
        create a particle in position</box>.
        create a particle in position</box>::position</item>.
        create a particle in action</mid>::position<run>.
    }
}
