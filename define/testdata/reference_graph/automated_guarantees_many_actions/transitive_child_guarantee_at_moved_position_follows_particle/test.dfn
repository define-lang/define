# The inner guarantee is pending at exactly the position that the middle action moves.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<gateway> {
            it may only contain particles where {
                it has the action</middle>.
            }
        }
        create a particle in position<gateway>.
        create a particle in position<gateway>::action</middle>::position<item>.
        create a particle in position<gateway>::action</middle>::position<trigger_pos>.
        create a particle in position<gateway>::action</middle>::position<destination>::position</result>.
    }
}
