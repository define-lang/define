# action</mover> moves the particle out of position</a> before action</refill>
# puts a new one there, so position</b> holds the first particle.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</mover>.
                it has the action</refill>.
                it has the position</a>.
                it has the position</b>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::position</a>.
        create a particle in position<holder>::action</mover>::position<run>.
        create a particle in position<holder>::action</refill>::position<run>.
        destroy the particle in position<holder>::position</a>.
        create a particle in position<holder>::position</b>.
    }
}
