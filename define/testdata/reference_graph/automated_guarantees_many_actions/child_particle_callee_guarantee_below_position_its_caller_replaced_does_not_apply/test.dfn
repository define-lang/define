# action</inner> ran on the particle in position</box>, which action</middle>
# received, and filled position</leaf> below the particle in position</child>.
# action</middle> then replaced the particle in position</child>.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</middle>.
                it has the position</box>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::position</box>.
        create a particle in position<holder>::position</box>::position</child>.
        create a particle in position<holder>::action</middle>::position<run>.
        create a particle in position<holder>::position</box>::position</child>::position</leaf>.
        create a particle in position<holder>::position</box>::position</child>::position</leaf>.
    }
}
