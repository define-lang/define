# A replacement particle's children must not satisfy requirements on the particle
# that previously occupied the same position.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</outer>::position<iface>.
        # Triggering /outer here violates the propagated occupied requirement.
        create a particle in position<box>::action</outer>::position<run>.
    }
}
