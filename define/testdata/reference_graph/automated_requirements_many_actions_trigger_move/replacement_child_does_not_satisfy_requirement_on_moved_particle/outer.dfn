define the potential action<my.domain.com:my_lib:/outer> {
    define the position<run>.
    define the position<iface> {
        it may only contain particles where {
            it has the position</item>.
        }
    }
    define the position<holder>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        move the particle in position<iface> to position<holder>.
        create a particle in position<iface>.
        create a particle in position<iface>::position</item>.
        define the position<inner_holder> {
            it may only contain particles where {
                it has the action</inner>.
            }
        }
        create a particle in position<inner_holder>.
        move the particle in position<holder> to position<inner_holder>::action</inner>::position<trigger_pos>.
    }
}
