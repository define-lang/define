# Inner requires a child of a particle that it moves. Middle does not create the
# child, so the occupied requirement must propagate through Middle to Test.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<box> {
        it may only contain particles where {
            it has the action</middle>.
        }
    }
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position<box>.
        create a particle in position<box>::action</middle>::position<gateway>.
        create a particle in position<box>::action</middle>::position<gateway>::action</inner>::position<source>.
        # Triggering /middle here violates Inner's propagated occupied requirement.
        create a particle in position<box>::action</middle>::position<trigger_pos>.
    }
}
