# /inner requires a child of a particle that it moves. /middle passes the
# particle without filling its child, so the occupied requirement reaches /test.
define the potential action<my.domain.com:my_lib:/test> {
    define the position<box> {
        it may only contain particles where {
            it has the action</middle>.
        }
    }
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position<box>.
        create a particle in position<box>::action</middle>::position<gateway>.
        # Triggering /middle here violates /inner's propagated occupied requirement.
        create a particle in position<box>::action</middle>::position<trigger_pos>.
    }
}
