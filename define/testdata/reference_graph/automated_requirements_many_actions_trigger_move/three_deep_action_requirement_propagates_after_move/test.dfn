# Three Action Executions where /middle moves its interface particle locally before triggering /inner.
#
# /middle moves the particle from position<mid_iface> to position<local>, then into
# /inner's input. /inner's empty requirement on the particle's child should
# propagate through /middle and /outer to /test.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::action</outer>::position<out_iface>.
        create a particle in position<box>::action</outer>::position<out_iface>::position</child>.
        create a particle in position<box>::action</outer>::position<trigger_pos>.
    }
}
