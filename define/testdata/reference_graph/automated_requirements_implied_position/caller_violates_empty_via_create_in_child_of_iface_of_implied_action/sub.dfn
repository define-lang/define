define the potential action<my.domain.com:my_lib:/sub> {
    define the position<iface> {
        it may only contain particles where {
            it has the position</child>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<_holder>.
        move the particle in position<iface>::position</child> to position<_holder>.
        move the particle in position<_holder> to position<iface>::position</child>.
        destroy the particle in position<run>.
    }
}
