# action</make> leaves two particles with Destructors, one of them with two,
# below the particle it creates in position</box>, and action</test> never
# expands them. action</test> passes the particle in position</box> to
# action</destroyer>, which destroys it. The Destruction Contract makes
# action</test> run every one of those Destructors through action</make>.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</destroyer>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</make>.
                it has the position</box>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</make>::position<run>.
        move the particle in position<holder>::position</box> to action</destroyer>::position<target>.
        create a particle in action</destroyer>::position<run>.
    }
}
