define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</destroyer>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<source> {
            it may only contain particles where {
                it has the action</destructor>.
                it has the position</occupied_first>.
                it has the position</occupied_last>.
            }
        }
        create a particle in position<source>.
        create a particle in position<source>::position</occupied_first>.
        create a particle in position<source>::position</occupied_first>::position</transitive>.
        create a particle in position<source>::position</occupied_last>.
        move the particle in position<source> to action</destroyer>::position<target>.
    }
}
