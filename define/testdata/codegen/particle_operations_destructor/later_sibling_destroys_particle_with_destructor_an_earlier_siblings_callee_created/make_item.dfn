define the potential action<my.domain.com:my_lib:/make_item> {
    it also assigns the position</box>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<run>.
        create a particle in position</box>::action</fill_spare>::position<run>.
        create a particle in position</box>::action</fill_item>::position<run>.
    }
}
