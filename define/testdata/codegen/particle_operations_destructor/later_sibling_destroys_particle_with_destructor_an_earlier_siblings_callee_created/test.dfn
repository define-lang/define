# action</outer> creates position</box> and triggers action</make_item>, whose
# callees action</fill_spare> and action</fill_item> create position</spare> and
# position</item> with action</cleanup>, and then action</clear_item>, whose
# callee action</empty_item> destroys position</item>. Only a callee of
# action</make_item> guarantees position</item>, but the final state of
# action</outer> already shows it destroyed, so the destruction of
# position<holder> drops both without running action</cleanup> a second time.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</outer>::position<run>.
    }
}
