define the potential action<my.domain.com:my_lib:/middle> {
    define the position<result> {
        it may only contain particles where {
            it has the action</destructor>.
            it has the position</marker>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the action</inner>.
            }
        }
        define the position<held_marker>.
        create a particle in position<box>.
        create a particle in position<box>::action</inner>::position<run>.
        move the particle in position<box>::action</inner>::position<result>::position</marker> to position<held_marker>.
        move the particle in position<box>::action</inner>::position<result> to position<result>.
        move the particle in position<held_marker> to position<result>::position</marker>.
        destroy the particle in position<box>::action</inner>::position<run>.
    }
}
