define the potential action<my.domain.com:my_lib:/maker> {
    define the position<target> {
        it may only contain particles where {
            it has the position</q>.
        }
    }
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<target>::position</q>.
        create a particle in position<target>::position</q>::position</c>.
        create a particle in position<target>::position</q>::position</c>::position</b>.
        destroy the particle in position<run>.
    }
}
