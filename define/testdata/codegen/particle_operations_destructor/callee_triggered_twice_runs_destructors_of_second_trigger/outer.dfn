define the potential action<my.domain.com:my_lib:/outer> {
    it also assigns the position</part>.
    it also assigns the action</make_part>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<run>.
        create a particle in action</make_part>::position<run>.
        destroy the particle in position</part>.
        create a particle in action</make_part>::position<run>.
    }
}
