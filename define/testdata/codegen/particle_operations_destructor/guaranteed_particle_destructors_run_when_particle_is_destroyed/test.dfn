# This action never expands what action</fill_2> and action</fill_3> left below
# the particles action</fill_1> created. Destroying position<holder> runs the
# run_guaranteed_particle_destructors methods for them instead, so every
# action</cleanup> still runs exactly once.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</fill_1>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</fill_1>::position<run>.
    }
}
