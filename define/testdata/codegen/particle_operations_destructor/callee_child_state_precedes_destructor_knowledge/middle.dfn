define the potential action<my.domain.com:my_lib:/middle> {
    it also assigns the action</destroyer>.
    define the position<target> {
        it may only contain particles where {
            it has the position</occupied>.
            it has the position</empty>.
            it has the action</destructor>.
        }
    }
    define the position<trigger>.
    it happens when {
        the position<trigger> has a particle.
    } and it does {
        move the particle in position<target> to action</destroyer>::position<target>.
        create a particle in action</destroyer>::position<trigger>.
        destroy the particle in position<trigger>.
    }
}
