define the potential action<my.domain.com:my_lib:/outer> {
    it also assigns the action</make_box>.
    it also assigns the action</clear_box>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<run>.
        create a particle in action</make_box>::position<run>.
        create a particle in action</clear_box>::position<run>.
    }
}
