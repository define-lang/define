define the potential action<my.domain.com:my_lib:/middle> {
    it also assigns the position</parent>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        move the particle in position<run> to position</parent>::action</destroyer>::position<target>.
        create a particle in position</parent>::action</destroyer>::position<trigger_pos>.
        destroy the particle in position</parent>::action</destroyer>::position<trigger_pos>.
        destroy the particle in position</parent>.
    }
}
