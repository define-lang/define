define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</destroyer>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<source> {
            it may only contain particles where {
                it has the position</known>.
            }
        }
        create a particle in position<source>.
        create a particle in position<source>::position</known>.
        create a particle in position<source>::position</known>::position</extra>.
        move the particle in position<source> to action</destroyer>::position<run>.
    }
}
