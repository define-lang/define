define the potential action<my.domain.com:my_lib:/filler> {
    it also assigns the position</result>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<scratch>.
        create a particle in position<scratch>.
        destroy the particle in position<scratch>.
        move the particle in position</result> to position<scratch>.
    }
}
