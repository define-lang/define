define the potential action<my.domain.com:my_lib:/left> {
    it also assigns the action</left_child>.
    define the position<trigger_pos>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in action</left_child>::position<trigger_pos>.
        destroy the particle in action</left_child>::position<trigger_pos>.
    }
}
