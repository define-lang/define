define the potential action<my.domain.com:my_lib:/right> {
    it also assigns the action</right_child>.
    define the position<trigger_pos>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in action</right_child>::position<trigger_pos>.
        destroy the particle in action</right_child>::position<trigger_pos>.
    }
}
