# action</test> creates a particle in position</item> with a child particle,
# and action</mover> moves it to position</slot>. action</test> never names
# position</slot>, and passes the particle above both to action</destroyer>,
# which destroys it. The Destruction Contract makes action</test> find its
# particles where action</mover> put them and run their Destructors.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</destroyer>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</mover>.
                it has the position</item>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::position</item>.
        create a particle in position<holder>::position</item>::position</kept>.
        create a particle in position<holder>::action</mover>::position<run>.
        move the particle in position<holder> to action</destroyer>::position<target>.
        create a particle in action</destroyer>::position<run>.
    }
}
