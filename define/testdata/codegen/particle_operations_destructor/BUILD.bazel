load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:pyright.bzl", "pyright_test")

filegroup(
    name = "codegen_testdata",
    testonly = True,
    srcs = glob(
        ["**"],
        exclude = [
            "**/expected_trace/**",
            "**/operation_trace.txt",
        ],
    ),
    visibility = [
        "//define/compiler/codegen:__pkg__",
        "//define/testdata/codegen:__pkg__",
    ],
)

filegroup(
    name = "tracing_testdata",
    testonly = True,
    srcs = glob(
        ["**"],
        exclude = [
            "**/expected/**",
        ],
    ),
    visibility = ["//define/testdata/codegen:__pkg__"],
)

# --- Type-checking ---

# This package has too many generated files for basedpyright to enumerate within
# its 10-second limit on a loaded machine, and it reports exceeding that limit
# as a configuration error.
pyright_test(
    name = "pyright_test",
    srcs = glob(["**/*.py"]),
    tags = ["manual"],
    deps = [
        "//define/runtime:literal",
    ],
)

check_build_file()
