# action</outer> triggers action</make_a> and then action</make_b>, which each
# create a particle with action</cleanup> in their own position. Both are still
# pending when position<holder> is destroyed, and neither touches what the other
# created, so the destruction drops both and runs their
# run_guaranteed_particle_destructors methods.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</outer>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</outer>::position<run>.
    }
}
