# action</make> leaves particles with Destructors below the particle it creates in
# position</shapes/box>. action</test> passes that particle to
# action</destroyer>, which destroys it, so action</test> runs those Destructors
# through action</make>. The method names of action</make> that run the
# Destructors must contain every segment of the path /shapes/box.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</destroyer>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder> {
            it may only contain particles where {
                it has the action</make>.
                it has the position</shapes/box>.
            }
        }
        create a particle in position<holder>.
        create a particle in position<holder>::action</make>::position<run>.
        move the particle in position<holder>::position</shapes/box> to action</destroyer>::position<target>.
        create a particle in action</destroyer>::position<run>.
    }
}
