define the potential action<my.domain.com:my_lib:/make> {
    it also assigns the position</shapes/box>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<run>.
        create a particle in position</shapes/box>.
        create a particle in position</shapes/box>::position</inner>.
        create a particle in position</shapes/box>::position</spare>.
    }
}
