# Particles move between positions that require the same value type.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<item> {
            it may only contain particles where {
                it has the value<standard:/number/rational>.
            }
        }
        define the position<worker> {
            it may only contain particles where {
                it has the action</provide>.
            }
        }
        create a particle in position<item>.
        create a particle in position<worker>.
        move the particle in position<item> to position<worker>::action</provide>::position<input>.
        move the particle in position<worker>::action</provide>::position<result> to position<item>.
        destroy the particle in position<item>.
        destroy the particle in position<worker>.
    }
}
