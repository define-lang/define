define the potential action<my.domain.com:my_lib:/outer> {
    it also assigns the position</implied>.
    it also assigns the action</caller>.
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in action</caller>::position<run>.
        create a particle in position</implied>.
    }
}
