define the potential action<a.b.c:the_lib:/test> {
    it also assigns the action</do_thing>.
    it also assigns the action<a-b.c:the_lib:/do_thing>.
    it also assigns the action<mv:a.b.c:the_lib:/do_thing>.
    it also assigns the action<a.b/c:the_lib:/do_thing>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in action</do_thing>::position<trigger_pos>.
        create a particle in action<a-b.c:the_lib:/do_thing>::position<trigger_pos>.
        create a particle in action<mv:a.b.c:the_lib:/do_thing>::position<trigger_pos>.
        create a particle in action<a.b/c:the_lib:/do_thing>::position<trigger_pos>.
    }
}
