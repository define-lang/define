# A literal sets a value in its encoding, with no conversion at runtime.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</price>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</price>.
        set the value of position</price> to literal<standard:/number>"12.5".
    }
}
