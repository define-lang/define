define the potential action<my.domain.com:my_lib:/inner> {
    define the position<trigger>.
    define the position<value> {
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }
    define the position<copy> {
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }
    it happens when {
        the position<trigger> has a particle.
    } and it does {
        set the value of position<copy> from position<value>.
        destroy the particle in position<trigger>.
    }
}
