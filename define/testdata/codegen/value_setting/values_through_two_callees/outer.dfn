define the potential action<my.domain.com:my_lib:/outer> {
    define the position<trigger>.
    define the position<callee> {
        it may only contain particles where {
            it has the action</inner>.
        }
    }
    it happens when {
        the position<trigger> has a particle.
    } and it does {
        create a particle in position<callee>.
        destroy the particle in position<trigger>.
    }
}
