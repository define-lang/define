# This is the source form of the Comparison simultaneity proof witness. The
# recreated child must participate in Comparison even though a later operation
# excludes it from the final dependency set.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<parent> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        create a particle in position<parent>.
        create a particle in position<parent>::position</child>.
        create a particle in position<parent>::position</child>::position</grandchild_x>.
        destroy the particle in position<parent>::position</child>::position</grandchild_x>.
        destroy the particle in position<parent>::position</child>.
        create a particle in position<parent>::position</child>.
        create a particle in position<parent>::position</child>::position</grandchild_y>.
        destroy the particle in position<parent>::position</child>::position</grandchild_y>.
        destroy the particle in position<parent>::position</child>.
    }
}
