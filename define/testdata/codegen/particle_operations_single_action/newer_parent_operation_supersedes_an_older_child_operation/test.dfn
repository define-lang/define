define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder>.
        define the position<box> {
            it may only contain particles where {
                it has the position</origin>.
                it has the position</target>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</origin>.
        create a particle in position<box>::position</origin>::position</deep>.
        move the particle in position<box>::position</origin> to position<box>::position</target>.
        move the particle in position<box> to position<holder>.
        destroy the particle in position<holder>.
    }
}
