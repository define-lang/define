define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<holder_a>.
        define the position<holder_b>.
        define the position<box> {
            it may only contain particles where {
                it has the position</item>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</item>.
        destroy the particle in position<box>::position</item>.
        move the particle in position<box> to position<holder_a>.
        move the particle in position<holder_a> to position<holder_b>.
        destroy the particle in position<holder_b>.
    }
}
