# The move refills box::/child without operating on that key directly, so it
# is the most recent operation on that position's ancestor chain. The
# second destroy of box::/child waits on the move and cannot run before the
# particle the move placed there arrives; the stale earlier destroy is not
# repeated, since the move already reaches it.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<box> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        define the position<source> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        create a particle in position<box>.
        create a particle in position<box>::position</child>.
        destroy the particle in position<box>::position</child>.
        destroy the particle in position<box>.
        create a particle in position<source>.
        create a particle in position<source>::position</child>.
        move the particle in position<source> to position<box>.
        destroy the particle in position<box>::position</child>.
        destroy the particle in position<box>.
    }
}
