# An Encoding Operation whose statements each write a different interface view returns every written view.
define the encoding_operation<my.domain.com:my_lib:/successors> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the encoding<standard:/number/natural/ascii>.
        }
    }
    define the view<plus_one> {
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/natural/ascii>.
        }
    }
    define the view<plus_two> {
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/natural/ascii>.
        }
    }

    it does {
        execute the encoding_operation<standard:/number/natural/ascii/add> {
            with view<a> looking at view<number>.
            with view<b> looking at literal<standard:/number>"1".
            with view<result> looking at view<plus_one>.
        }
        execute the encoding_operation<standard:/number/natural/ascii/add> {
            with view<a> looking at view<number>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at view<plus_two>.
        }
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<output>.
        create a particle in position<output>.
    }
}
