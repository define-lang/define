# An Encoding Operation's function goes in the module of its parent path, which also holds the class of a position definition, so the function follows the class.
define the potential position<my.domain.com:my_lib:/thing>.
define the encoding_operation<my.domain.com:my_lib:/thing/increment> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the encoding<standard:/number/natural/ascii>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/natural/ascii>.
        }
    }

    it does {
        execute the encoding_operation<standard:/number/natural/ascii/add> {
            with view<a> looking at view<number>.
            with view<b> looking at literal<standard:/number>"1".
            with view<result> looking at view<result>.
        }
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</thing>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</thing>.
    }
}
