# A constructor is the entry point even when a position with the same path assigns it.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<output>.
        create a particle in position<output>.
    }
}
define the potential position<my.domain.com:my_lib:/test> {
    it may only contain particles where {
        it has the action</test>.
    }
}
