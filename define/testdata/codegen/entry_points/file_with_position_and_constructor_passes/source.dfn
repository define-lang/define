# A source with a position before the constructor that shares its path compiles with the constructor as its entry point.
define the potential position<my.domain.com:my_lib:/test>.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<output>.
        create a particle in position<output>.
    }
}
