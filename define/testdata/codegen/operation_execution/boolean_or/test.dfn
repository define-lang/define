# Either of two positions' values is true with the built-in boolean or.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</final_result>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<unlocked> {
            it may only contain particles where {
                it has the value<standard:/boolean>.
            }
        }
        define the position<powered> {
            it may only contain particles where {
                it has the value<standard:/boolean>.
            }
        }
        create a particle in position<powered>.
        create a particle in position<unlocked>.
        create a particle in position</final_result>.
        set the value of position<powered> from literal<standard:/boolean>"true".
        set the value of position<unlocked> from literal<standard:/boolean>"false".
        execute the operation<standard:/boolean/or> {
            with view<a> looking at position<powered>.
            with view<b> looking at position<unlocked>.
            with view<result> looking at position</final_result>.
        }
    }
}
