# An action checks whether a position's value is at most a literal with the built-in rational less than or equal.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</reading>.
    it also assigns the position</at_most>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</reading>.
        create a particle in position</at_most>.
        set the value of position</reading> to literal<standard:/number>"1.5".
        execute the operation<standard:/number/rational/less_than_or_equal> {
            with view<a> looking at position</reading>.
            with view<b> looking at literal<standard:/number>"1.5".
            with view<result> looking at position</at_most>.
        }
    }
}
