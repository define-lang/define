# An action checks whether one position's scalar comes before or is the same as another's with the built-in scalar less than or equal.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</reading>.
    it also assigns the position</at_most>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</reading>.
        create a particle in position</at_most>.
        set the value of position</reading> from literal<standard:/text>"h".
        execute the operation<standard:/text/unicode/scalar/less_than_or_equal> {
            with view<a> looking at position</reading>.
            with view<b> looking at literal<standard:/text>"h".
            with view<result> looking at position</at_most>.
        }
    }
}
