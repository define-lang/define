# An action multiplies a position's value by a literal with the built-in rational multiplication.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</factor>.
    it also assigns the position</product>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</factor>.
        create a particle in position</product>.
        set the value of position</factor> to literal<standard:/number>"1.5".
        execute the operation<standard:/number/rational/multiply> {
            with view<a> looking at position</factor>.
            with view<b> looking at literal<standard:/number>"4".
            with view<result> looking at position</product>.
        }
    }
}
