# An action finds the larger of a position's value and a literal with the built-in integer maximum.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</final_result>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<reading> {
            it may only contain particles where {
                it has the value<standard:/number/integer>.
            }
        }
        create a particle in position<reading>.
        create a particle in position</final_result>.
        set the value of position<reading> from literal<standard:/number>"-3".
        execute the operation<standard:/number/integer/maximum> {
            with view<a> looking at position<reading>.
            with view<b> looking at literal<standard:/number>"4".
            with view<result> looking at position</final_result>.
        }
    }
}
