# An action subtracts a literal from a position's value with the built-in natural subtraction.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</final_result>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<balance> {
            it may only contain particles where {
                it has the value<standard:/number/natural>.
            }
        }
        create a particle in position<balance>.
        create a particle in position</final_result>.
        set the value of position<balance> from literal<standard:/number>"5".
        execute the operation<standard:/number/natural/subtract> {
            with view<a> looking at position<balance>.
            with view<b> looking at literal<standard:/number>"2".
            with view<result> looking at position</final_result>.
        }
    }
}
