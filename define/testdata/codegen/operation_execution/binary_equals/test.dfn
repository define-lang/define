# An action checks whether a position's value equals a literal with the built-in binary equal.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</final_result>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<flags> {
            it may only contain particles where {
                it has the value<standard:/binary>.
            }
        }
        create a particle in position<flags>.
        create a particle in position</final_result>.
        set the value of position<flags> from literal<standard:/binary>"1100".
        execute the operation<standard:/binary/equals> {
            with view<a> looking at position<flags>.
            with view<b> looking at literal<standard:/binary>"1100".
            with view<result> looking at position</final_result>.
        }
    }
}
