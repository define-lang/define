# An action rounds a position's value down with the built-in rational floor.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</level>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</level>.
        set the value of position</level> to literal<standard:/number>"2.5".
        execute the operation<standard:/number/rational/floor> {
            with view<value> looking at position</level>.
        }
    }
}
