# An action inverts a position's value with the built-in boolean not.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</enabled>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</enabled>.
        set the value of position</enabled> to literal<standard:/boolean>"true".
        execute the operation<standard:/boolean/not> {
            with view<value> looking at position</enabled>.
        }
    }
}
