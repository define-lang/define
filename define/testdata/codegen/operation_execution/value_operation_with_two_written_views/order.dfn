define the operation<my.domain.com:my_lib:/order> {
    define the view<a> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }
    define the view<b> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }
    define the view<smaller> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }
    define the view<larger> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }

    it does {
        execute the operation<standard:/number/integer/minimum> {
            with view<a> looking at view<a>.
            with view<b> looking at view<b>.
            with view<result> looking at view<smaller>.
        }
        execute the operation<standard:/number/integer/maximum> {
            with view<a> looking at view<a>.
            with view<b> looking at view<b>.
            with view<result> looking at view<larger>.
        }
    }
}
