# Local names must remain distinct when they collide with a reserved Python name
# and the underscore names that would otherwise resolve that collision.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<self_>.
        define the position<self__>.
        define the position<self>.
        create a particle in position<self_>.
        create a particle in position<self__>.
        create a particle in position<self>.
    }
}
