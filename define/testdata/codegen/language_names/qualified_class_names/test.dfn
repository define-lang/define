# Both action names produce ClassVarDestructionContracts, so caller contributions
# must receive distinct class names without inheriting the ClassVar underscore.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</class__var>.
    it also assigns the action</class_var>.
    it also assigns the action</class_var_>.
    it also assigns the action</type_error>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in position</class__var>.
        create a particle in position</class__var>::position</child>.
        destroy the particle in position</class__var>.
        create a particle in action</class_var>::position<trigger_pos>.
        create a particle in action</class_var_>::position<trigger_pos>.
        define the position<source> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        create a particle in position<source>.
        create a particle in position<source>::position</child>.
        move the particle in position<source> to action</class_var>::position<trigger_pos>.
        create a particle in position<source>.
        create a particle in position<source>::position</child>.
        move the particle in position<source> to action</class_var_>::position<trigger_pos>.
        create a particle in action</type_error>::position<pp>.
    }
}
