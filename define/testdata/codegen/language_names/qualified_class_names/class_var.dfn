define the potential action<my.domain.com:my_lib:/class_var> {
    define the position<trigger_pos>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        define the position<self>.
        define the position<self_>.
        define the position<literal>.
        define the position<super>.
        define the position<type>.
        define the position<typing>.
        create a particle in position<self>.
        create a particle in position<self_>.
        create a particle in position<literal>.
        create a particle in position<super>.
        create a particle in position<type>.
        create a particle in position<typing>.
        destroy the particle in position<trigger_pos>.
    }
}
