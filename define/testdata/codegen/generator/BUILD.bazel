load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:pyright.bzl", "pyright_test")

filegroup(
    name = "generator",
    testonly = True,
    srcs = glob(
        ["**"],
        exclude = [
            "**/expected_trace/**",
            "**/operation_trace.txt",
        ],
    ),
    visibility = [
        "//define/compiler/codegen:__pkg__",
        "//define/testdata:__pkg__",
    ],
)

filegroup(
    name = "tracing_testdata",
    testonly = True,
    srcs = glob(
        ["**"],
        exclude = [
            "**/expected/**",
        ],
    ),
    visibility = ["//define/testdata/codegen:__pkg__"],
)

pyright_test(
    name = "pyright_test",
    srcs = glob(["**/*.py"]),
    deps = ["//define/runtime:literal"],
)

check_build_file()
