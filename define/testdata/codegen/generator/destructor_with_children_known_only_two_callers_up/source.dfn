define the potential position<my.domain.com:my_lib:/marker_a>.
define the potential position<my.domain.com:my_lib:/marker_b>.
define the potential action<my.domain.com:my_lib:/destruct> {
    it happens when {
        this particle is being destroyed.
    } and it does {
        define the position<work>.
        create a particle in position<work>.
    }
}
define the potential action<my.domain.com:my_lib:/child_destruct> {
    it also assigns the position</marker_a>.
    it also assigns the position</marker_b>.
    it happens when {
        this particle is being destroyed.
    } and it does {
        define the position<holder_a>.
        define the position<holder_b>.
        move the particle in position</marker_a> to position<holder_a>.
        move the particle in position<holder_a> to position</marker_a>.
        move the particle in position</marker_b> to position<holder_b>.
        move the particle in position<holder_b> to position</marker_b>.
    }
}
define the potential position<my.domain.com:my_lib:/extra> {
    it may only contain particles where {
        it has the position</marker_a>.
        it has the position</marker_b>.
        it has the action</child_destruct>.
    }
}
define the potential action<my.domain.com:my_lib:/destroyer> {
    define the position<run> {
        it may only contain particles where {
            it has the action</destruct>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        destroy the particle in position<run>.
    }
}
define the potential action<my.domain.com:my_lib:/middle> {
    it also assigns the action</destroyer>.
    define the position<run> {
        it may only contain particles where {
            it has the action</destruct>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        move the particle in position<run> to action</destroyer>::position<run>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</middle>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<source> {
            it may only contain particles where {
                it has the position</extra>.
                it has the action</destruct>.
            }
        }
        create a particle in position<source>.
        create a particle in position<source>::position</extra>.
        create a particle in position<source>::position</extra>::position</marker_a>.
        create a particle in position<source>::position</extra>::position</marker_b>.
        move the particle in position<source> to action</middle>::position<run>.
    }
}
