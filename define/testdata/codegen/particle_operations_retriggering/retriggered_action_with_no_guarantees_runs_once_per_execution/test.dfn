# worker guarantees nothing, so each of its two triggers leaves no
# GuaranteeNode -- only the two distinct trigger fills. Each invocation's
# operations wait on their own fill.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<gw> {
            it may only contain particles where {
                it has the action</worker>.
            }
        }
        create a particle in position<gw>.
        create a particle in position<gw>::action</worker>::position<trigger_pos>.
        destroy the particle in position<gw>::action</worker>::position<trigger_pos>.
        create a particle in position<gw>::action</worker>::position<trigger_pos>.
        destroy the particle in position<gw>::action</worker>::position<trigger_pos>.
    }
}
