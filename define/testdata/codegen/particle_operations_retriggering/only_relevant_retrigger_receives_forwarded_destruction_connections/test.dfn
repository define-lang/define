# Only the first Action Execution passes a caller-supplied particle to /destroyer.
# The second invocation must not receive the first invocation's destruction connection.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</middle>.
    it happens when {
        this particle is created.
    } and it does {
        define the position<source> {
            it may only contain particles where {
                it has the position</child>.
            }
        }
        create a particle in position<source>.
        create a particle in position<source>::position</child>.
        move the particle in position<source> to action</middle>::position<run>.
    }
}
