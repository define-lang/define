define the potential action<my.domain.com:my_lib:/mover> {
    it also assigns the position</destination>.
    it also assigns the position</out>.
    it also assigns the action</helper>.
    define the position<trigger_pos>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in action</helper>::position<trigger_pos>.
        move the particle in position</out> to position</destination>.
        destroy the particle in action</helper>::position<trigger_pos>.
    }
}
