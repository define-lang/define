# Child's local operation depends on the occupied Action Parent, while Middle's
# move needs the Empty Rule dependencies for that same <source> position. Child
# also guarantees implied position </result>, which Middle waits for before
# moving the parent and which Test consumes through the parent's new name.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<result>.
        define the position<gateway> {
            it may only contain particles where {
                it has the action</middle>.
            }
        }
        create a particle in position<gateway>.
        create a particle in position<gateway>::action</middle>::position<source>.
        create a particle in position<gateway>::action</middle>::position<source>::position</marker>.
        create a particle in position<gateway>::action</middle>::position<trigger_pos>.
        move the particle in position<gateway>::action</middle>::position<holder>::position</result> to position<result>.
        destroy the particle in position<gateway>::action</middle>::position<holder>.
        destroy the particle in position<gateway>::action</middle>::position<trigger_pos>.
    }
}
