define the potential action<my.domain.com:my_lib:/middle> {
    define the position<trigger_pos>.
    define the position<gateway> {
        it may only contain particles where {
            it has the action</inner>.
            it has the position</source_particle>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        move the particle in position<gateway>::position</source_particle> to position<gateway>::action</inner>::position<source>.
        create a particle in position<gateway>::action</inner>::position<source>::position</child>.
        create a particle in position<gateway>::action</inner>::position<trigger_pos>.
        destroy the particle in position<gateway>::action</inner>::position<destination>.
        destroy the particle in position<gateway>::action</inner>::position<trigger_pos>.
        destroy the particle in position<gateway>.
    }
}
