define the potential action<my.domain.com:my_lib:/middle> {
    define the position<trigger_pos>.
    define the position<igw> {
        it may only contain particles where {
            it has the action</inner>.
            it has the position</inner_result>.
        }
    }
    define the position<out>.
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        create a particle in position<igw>::action</inner>::position<trigger_pos>.
        move the particle in position<igw>::position</inner_result> to position<out>.
        destroy the particle in position<igw>::action</inner>::position<trigger_pos>.
        destroy the particle in position<igw>.
    }
}
