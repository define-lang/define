# The caller's Destroy must remain the last operation on the implied action's
# child position when the earlier callee's metadata is applied later.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the action</outer>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in action</outer>::position<trigger_pos>.
        destroy the particle in action</outer>::position<trigger_pos>.
    }
}
