define the potential action<my.domain.com:my_lib:/worker> {
    define the position<source>.
    define the position<state> {
        it may only contain particles where {
            it has the position</occupied>.
            it has the position</target>.
        }
    }
    it happens when {
        the position<state> has a particle.
    } and it does {
        destroy the particle in position<state>::position</occupied>.
        move the particle in position<source> to position<state>::position</target>.
    }
}
