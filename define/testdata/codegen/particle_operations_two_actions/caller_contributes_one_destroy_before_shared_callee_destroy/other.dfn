define the potential action<my.domain.com:my_lib:/other> {
    define the position<trigger_pos>.
    define the position<parent> {
        it may only contain particles where {
            it has the position</child>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        destroy the particle in position<parent>::position</child>::position</grandchild>.
        destroy the particle in position<parent>.
    }
}
