define the potential action<my.domain.com:my_lib:/destroyer> {
    define the position<trigger_pos>.
    define the position<parent> {
        it may only contain particles where {
            it has the position</child>.
        }
    }
    it happens when {
        the position<trigger_pos> has a particle.
    } and it does {
        define the position<keeper>.
        move the particle in position<parent>::position</child> to position<keeper>.
        move the particle in position<keeper> to position<parent>::position</child>.
        destroy the particle in position<parent>.
    }
}
