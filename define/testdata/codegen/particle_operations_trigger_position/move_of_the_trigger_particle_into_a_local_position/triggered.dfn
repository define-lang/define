# The trigger particle ends the block in a position the block defined, so the
# block end destroys it.
define the potential action<my.domain.com:my_lib:/triggered> {
    define the position<run>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        define the position<local>.
        move the particle in position<run> to position<local>.
    }
}
