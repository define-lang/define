define the potential position<mv:define-lang.org:test_walk_wrong_type:/test> {
    it may only contain particles where {
        it has the position</target>.
    }
}
define the potential action<mv:define-lang.org:test_walk_wrong_type:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<local> {
            it may only contain particles where {
                it has the position</target>.
            }
        }
        create a particle in position<local>.
        define the position<_noop>.
        create a particle in position<_noop>.
    }
}
