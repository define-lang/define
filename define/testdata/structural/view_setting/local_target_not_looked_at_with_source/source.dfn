# The statement after a View Setting Statement with a local view target must look at its source, too.
define the logical_operation<my.domain.com:my_lib:/negate> {
    define the view<value> {
        it is read.
    }
    define the view<result> {
        it is written.
    }
}
define the operation<my.domain.com:my_lib:/copy_and_negate> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }
    define the view<negated> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }

    it does {
        define the view<copy> {
            it may only contain particles where {
                it has the value<standard:/number/integer>.
            }
        }
        set the value of view<copy> from view<number>.
        execute the logical_operation</negate> {
            with view<value> looking at view<copy>.
            with view<result> looking at view<negated>.
        }
    }
}
