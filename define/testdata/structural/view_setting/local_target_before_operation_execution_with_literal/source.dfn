# An Operation Execution Statement after a View Setting Statement with a local view target may also look at a literal.
define the operation<my.domain.com:my_lib:/add_three> {
    define the view<a> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }
    define the view<b> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }
    define the view<c> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
define the operation<my.domain.com:my_lib:/double_plus_one> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }
    define the view<result> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }

    it does {
        define the view<copy> {
            it may only contain particles where {
                it has the value<standard:/number/integer>.
            }
        }
        set the value of view<copy> from view<number>.
        execute the operation</add_three> {
            with view<a> looking at view<number>.
            with view<b> looking at view<copy>.
            with view<c> looking at literal<standard:/number>"1".
            with view<result> looking at view<result>.
        }
    }
}
