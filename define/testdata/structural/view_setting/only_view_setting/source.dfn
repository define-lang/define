# A View Setting Statement references its views but is not an execution statement.
define the operation<my.domain.com:my_lib:/copy> {
    define the view<result> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }

    it does {
        define the view<copy> {
            it may only contain particles where {
                it has the value<standard:/number/integer>.
            }
        }
        set the value of view<result> from view<copy>.
    }
}
