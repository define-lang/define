# Each View Setting Statement before an execution is checked, after one whose source and target the execution looks at.
define the logical_operation<my.domain.com:my_lib:/add> {
    define the view<first> {
        it is read.
    }
    define the view<second> {
        it is read.
    }
    define the view<result> {
        it is written.
    }
}
define the operation<my.domain.com:my_lib:/copy_and_add> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }
    define the view<sum> {
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }

    it does {
        define the view<copy> {
            it may only contain particles where {
                it has the value<standard:/number/integer>.
            }
        }
        define the view<other_copy> {
            it may only contain particles where {
                it has the value<standard:/number/integer>.
            }
        }
        set the value of view<copy> from view<number>.
        set the value of view<other_copy> from view<number>.
        execute the logical_operation</add> {
            with view<first> looking at view<copy>.
            with view<second> looking at view<number>.
            with view<result> looking at view<sum>.
        }
    }
}
