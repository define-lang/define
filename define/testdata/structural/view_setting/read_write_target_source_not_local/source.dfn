# The source of a View Setting Statement whose target is a read/write interface view must be a local view.
define the logical_operation<my.domain.com:my_lib:/negate> {
    define the view<value> {
        it is read.
    }
    define the view<result> {
        it is written.
    }
}
define the operation<my.domain.com:my_lib:/copy_in_place> {
    define the view<value> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }

    it does {
        define the view<negated> {
            it may only contain particles where {
                it has the value<standard:/number/integer>.
            }
        }
        execute the logical_operation</negate> {
            with view<value> looking at view<value>.
            with view<result> looking at view<negated>.
        }
        set the value of view<value> from view<number>.
    }
}
