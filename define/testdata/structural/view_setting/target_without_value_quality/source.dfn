# A View Setting Statement whose target has no value quality is reported only where the target is defined.
define the logical_operation<my.domain.com:my_lib:/negate> {
    define the view<value> {
        it is read.
    }
    define the view<result> {
        it is written.
    }
}
define the operation<my.domain.com:my_lib:/negate_in_place> {
    define the view<value> {
        it is read.
        it is written.
        it may only contain particles where {
            it has the encoding<standard:/number/decimal/ascii>.
        }
    }
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }

    it does {
        define the view<negated> {
            it may only contain particles where {
                it has the value<standard:/number/integer>.
            }
        }
        execute the logical_operation</negate> {
            with view<value> looking at view<number>.
            with view<result> looking at view<negated>.
        }
        set the value of view<value> from view<negated>.
    }
}
