define the potential action<my.domain.com:my_lib:/foo> {
    define the position<x>.
    it happens when {
        the position<x> has a particle.
    } and it does {
        define the position<_noop>.
        create a particle in position<_noop>.
    }
}
define the potential action<my.domain.com:my_lib:/root> {
    it also assigns the action</foo>.
    it happens when {
        this particle is created.
    } and it does {
        create a particle in action</foo>::position<x>.
    }
}
