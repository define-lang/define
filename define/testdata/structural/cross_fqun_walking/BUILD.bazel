load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:pyright.bzl", "pyright_test")

filegroup(
    name = "cross_fqun_walking",
    testonly = True,
    srcs = glob(
        ["**"],
        exclude = [
            "**/expected/**",
        ],
    ),
    visibility = [
        "//define/compiler/validator/structural/program_validator_tests:__pkg__",
        "//define/testdata:__pkg__",
    ],
)

pyright_test(
    name = "pyright_test",
    srcs = glob(["**/*.py"]),
    deps = ["//define/runtime:literal"],
)

check_build_file()
