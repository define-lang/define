# Views in an action may look at local, interface, implied, and chained positions, and at literals.
define the operation<my.domain.com:my_lib:/copy> {
    define the view<source> {
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }
    define the view<target> {
        it may only contain particles where {
            it has the value<standard:/number/rational>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
define the potential position<my.domain.com:my_lib:/box>.
define the potential position<my.domain.com:my_lib:/child>.
define the potential action<my.domain.com:my_lib:/test> {
    it also assigns the position</box>.
    define the position<trigger>.
    it happens when {
        the position<trigger> has a particle.
    } and it does {
        define the position<number>.
        execute the operation</copy> {
            with view<source> looking at position<number>.
            with view<target> looking at position<trigger>.
        }
        execute the operation</copy> {
            with view<source> looking at position</box>::position</child>.
            with view<target> looking at literal<standard:/number>"2".
        }
    }
}
