# A standard universe definition's own references load the files that define them.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<total> {
            it may only contain particles where {
                it has the value<standard:/number/rational>.
            }
        }
        create a particle in position<total>.
        set the value of position<total> to literal<standard:/number>"1".
        destroy the particle in position<total>.
    }
}
