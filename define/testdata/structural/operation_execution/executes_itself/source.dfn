# An operation may not execute itself.
define the operation<my.domain.com:my_lib:/double> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
        }
    }

    it does {
        execute the operation</double> {
            with view<number> looking at view<number>.
        }
    }
}
