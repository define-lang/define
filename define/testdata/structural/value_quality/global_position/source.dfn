# Value qualities and positions may both be assigned to a position.
define the potential value<my.domain.com:my_lib:/number>.
define the potential position<my.domain.com:my_lib:/other>.
define the potential position<my.domain.com:my_lib:/test> {
    it may only contain particles where {
        it has the position</other>.
        it has the value</number>.
    }
}
