# Each additional distinct value quality conflicts with the first.
define the potential value<my.domain.com:my_lib:/number> {
    it supports the logical_operation<standard:/number/add> {
        it may be read.
        it may be written.
    }
}
define the potential value<my.domain.com:my_lib:/text> {
    it supports the logical_operation<standard:/text/equality> {
        it may be read.
    }
}
define the potential value<my.domain.com:my_lib:/boolean> {
    it supports the logical_operation<standard:/boolean/and> {
        it may be read.
        it may be written.
    }
}
define the potential position<my.domain.com:my_lib:/test> {
    it may only contain particles where {
        it has the value</number>.
        it has the value</text>.
        it has the value</boolean>.
    }
}
