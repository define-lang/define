# Each position may specify its own value quality.
define the potential value<my.domain.com:my_lib:/number> {
    it supports the logical_operation<standard:/number/add> {
        it may be read.
        it may be written.
    }
}
define the potential value<my.domain.com:my_lib:/text> {
    it supports the logical_operation<standard:/text/equality> {
        it may be read.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    define the position<input> {
        it may only contain particles where {
            it has the value</number>.
        }
    }
    it happens when {
        the position<input> has a particle.
    } and it does {
        define the position<item> {
            it may only contain particles where {
                it has the value</text>.
            }
        }
        create a particle in position<item>.
        destroy the particle in position<item>.
    }
}
