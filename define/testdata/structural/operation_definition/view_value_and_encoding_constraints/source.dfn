# Interface views of a value operation may not have encoding constraints.
define the operation<my.domain.com:my_lib:/copy> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/rational>.
            it has the encoding<standard:/number/decimal/ascii>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
