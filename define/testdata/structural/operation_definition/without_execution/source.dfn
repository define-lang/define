# A value operation must execute at least one logical operation or value
# operation.
define the operation<my.domain.com:my_lib:/test> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/integer>.
        }
    }

    it does {
        define the view<unused> {
            it may only contain particles where {
                it has the value<standard:/number/integer>.
            }
        }
    }
}
