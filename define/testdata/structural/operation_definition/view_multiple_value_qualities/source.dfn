# A view may have only one value quality.
define the potential value<my.domain.com:my_lib:/integer> {
    it supports the logical_operation<standard:/number/add> {
        it may be read.
        it may be written.
    }
}
define the operation<my.domain.com:my_lib:/copy> {
    define the view<number> {
        it is read.
        it may only contain particles where {
            it has the value<standard:/number/natural>.
            it has the value</integer>.
        }
    }

    it does {
        execute the encoding operation.
    }
}
