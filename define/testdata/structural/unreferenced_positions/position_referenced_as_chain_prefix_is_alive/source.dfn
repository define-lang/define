define the potential action<my.domain.com:my_lib:/inner> {
    define the position<run>.
    define the position<slot>.
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<slot>.
    }
}
define the potential action<my.domain.com:my_lib:/act> {
    define the position<run>.
    define the position<holder> {
        it may only contain particles where {
            it has the action</inner>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<holder>::action</inner>::position<slot>.
    }
}
