# Value setting allows references between parent and child positions in either direction.
define the potential position<my.domain.com:my_lib:/child>.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<item>.
        set the value of position<item>::position</child> to position<item>.
        set the value of position<item> to position<item>::position</child>.
    }
}
