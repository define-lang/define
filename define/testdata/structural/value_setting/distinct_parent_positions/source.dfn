# Matching child names refer to different positions when their parent names differ.
define the potential position<my.domain.com:my_lib:/child>.
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<first>.
        define the position<second>.
        set the value of position<first>::position</child> to position<second>::position</child>.
    }
}
