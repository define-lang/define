define the potential position<my.domain.com:my_lib:/test> {
    it may only contain particles where {
        it has the position</missing>.
    }
}
define the potential action<my.domain.com:my_lib:/test> {
    it happens when {
        this particle is created.
    } and it does {
        define the position<local> {
            it may only contain particles where {
                it has the position</missing>.
            }
        }
        create a particle in position<local>.
        define the position<_noop>.
        create a particle in position<_noop>.
    }
}
