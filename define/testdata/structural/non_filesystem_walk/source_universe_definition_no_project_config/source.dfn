# The reference writes a universe that the supplied source defines, so a
# missing project config means its definition cannot be loaded, not that the
# universe is unknown.
define the potential position<my.domain.com:other_lib:/helper>.
define the potential position<my.domain.com:my_lib:/test> {
    it may only contain particles where {
        it has the position<my.domain.com:other_lib:/missing>.
    }
}
