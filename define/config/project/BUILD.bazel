load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_py//py:defs.bzl", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")

proto_library(
    name = "config_proto",
    srcs = ["config.proto"],
    deps = [
        "//defcl/schema/core:boolean_proto",
        "@protovalidate//proto/protovalidate/buf/validate:validate_proto",
    ],
)

py_proto_library(
    name = "config_proto_py",
    visibility = ["//define/compiler/config:__pkg__"],
    deps = [":config_proto"],
)

py_library(
    name = "project",
    srcs = ["__init__.py"],
    visibility = ["//define/config:__pkg__"],
    deps = ["//define/config"],
)

check_build_file()
