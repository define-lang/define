load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//tools/lint:format.bzl", "format_test")

proto_library(
    name = "config_proto",
    srcs = ["config.proto"],
    deps = ["@protovalidate//proto/protovalidate/buf/validate:validate_proto"],
)

py_proto_library(
    name = "config_proto_py",
    visibility = ["//define/compiler:__pkg__"],
    deps = [":config_proto"],
)

py_library(
    name = "project",
    srcs = ["__init__.py"],
    visibility = ["//define/config:__pkg__"],
    deps = ["//define/config"],
)

# --- Format checking ---

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@aspect_rules_lint//format:ruff",
)
