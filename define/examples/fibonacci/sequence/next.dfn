define the potential action<define-lang.org:fibonacci:/sequence/next> {
    it also assigns the position</sequence/current>.
    it also assigns the position</sequence/previous>.

    define the position<run> {
        it may only be destroyed by this action.
    }

    it happens when {
        the position<run> has a particle.
    } and it does {
        # Store the current value temporarily
        define the position<temp> {
            it may only contain particles where {
                it has the value<standard:/number/rational>.
                it has the constraint</non_negative>.
            }
        }
        create a particle in position<temp>.
        set the value of position<temp> to position</sequence/current>.

        # new current = current + previous (the next Fibonacci number)
        execute the operation<standard:/number/rational/add> {
            with view<a> looking at position<temp>.
            with view<b> looking at position</sequence/previous>.
            with view<result> looking at position</sequence/current>.
        }

        # previous becomes the old current
        set the value of position</sequence/previous> to position<temp>.

        destroy the particle in position<run>.
    }
}
