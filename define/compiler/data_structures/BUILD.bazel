load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//tools/bzl:format.bzl", "format_test")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_library(
    name = "data_structures",
    srcs = ["__init__.py"],
    visibility = ["//define/compiler:__subpackages__"],
)

py_library(
    name = "trie",
    srcs = ["trie.py"],
    visibility = ["//define/compiler:__subpackages__"],
)

py_test(
    name = "trie_test",
    size = "small",
    srcs = ["trie_test.py"],
    deps = [
        ":trie",
        "@pypi//pytest",
    ],
)

# --- Format checking ---

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@multitool//tools/ruff",
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    deps = [
        ":data_structures",
        ":trie",
        ":trie_test",
    ],
)
