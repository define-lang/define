%import common.LF -> NEWLINE

# Terminals
PATH_SEGMENT: /[^:<>\/{}\s]+/
MULTIVERSE_NAME.2: /[^:<>\/{}\s]+(?=:[^:>]*:[^:>]*:\/)/
AUTHORITY_DOMAIN.1: /[^:<>\/{}\s]+(?=[^:>]*:[^:>]*:\/)/
AUTHORITY_PATH_SEGMENT: /[^:<>\/{}\s]+/
UNIVERSE_NAME: /[^:<>\/{}\s]+(?=:(?![^:>]*:)[^:>]*\/)/
DEFINE_THE_POSITION: "define the position"
LOCAL_NAME: /[^:<>{}\s]+/

# General

# Ignore leading whitespace (indentation) on lines inside blocks.
# The lookbehind ensures we only match after a newline, and the
# lookahead ensures we don't consume trailing whitespace on blank lines.
%ignore /(?<=\n) +(?=\S)/

# Allow only visible characters in comments.
# TODO: Disallow invisible Unicode characters per spec.
COMMENT: / *#(?:[^\x00-\x1F\x7F]*[^\x00-\x1F\x7F ])?/
%ignore COMMENT

terminator: "." NEWLINE
# TODO: Enforce that leading whitespace before "}" matches the opening
# statement's leading whitespace, per spec.
_block_open: " {" NEWLINE
_block_close: "}" NEWLINE

# Global Name Syntax

NAME_TYPE: "position" | "action"

authority_path: ("/" AUTHORITY_PATH_SEGMENT)+
authority: AUTHORITY_DOMAIN authority_path?

fqun: MULTIVERSE_NAME ":" authority ":" UNIVERSE_NAME ":"
    | authority ":" UNIVERSE_NAME ":"
    | UNIVERSE_NAME ":"

global_name_path: ("/" PATH_SEGMENT)+
global_name: fqun global_name_path
global_name_reference: fqun? global_name_path
typed_global_name_reference: NAME_TYPE "<" global_name_reference ">"

# Position Constraint Block Syntax

_position_constraint_intro: "it may only contain dimension points where"
position_requirement_statement: "it has the" " " typed_global_name_reference terminator
_position_constraint_requirement_tail: (NEWLINE* position_requirement_statement)*
_position_constraint_requirements: NEWLINE* position_requirement_statement _position_constraint_requirement_tail NEWLINE*
position_constraint_block: _position_constraint_intro _block_open _position_constraint_requirements _block_close

# Local Position Definition Syntax

local_position_definition_block: _block_open NEWLINE* position_constraint_block NEWLINE* _block_close
position_definition_terminator_or_block: terminator | local_position_definition_block

# Potential Position Definition Syntax

position_definition: "define the potential position" "<" global_name ">" position_definition_terminator_or_block

# Action Definition Syntax

action_definition: "define the potential action" "<" global_name ">" (terminator | action_definition_block)

local_position_definition: DEFINE_THE_POSITION "<" LOCAL_NAME ">" position_definition_terminator_or_block
trigger_conditions_block: "it happens when" _block_open NEWLINE* "}"
action_statements_block: " and it does" _block_open (NEWLINE | local_position_definition)* _block_close
_trigger_and_action: trigger_conditions_block action_statements_block
action_definition_block: _block_open (NEWLINE | local_position_definition)* _trigger_and_action NEWLINE* _block_close

# Root Syntax

definition: position_definition | action_definition
start: NEWLINE* definition (NEWLINE* definition)* NEWLINE*
