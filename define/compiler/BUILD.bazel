load("@aspect_rules_lint//format:defs.bzl", "format_test")
load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/lint:pyright.bzl", "pyright_test")

exports_files(["pyproject.toml"])

py_library(
    name = "ast",
    srcs = ["ast.py"],
    deps = [
        ":compiler",
        "@pypi//lark",
    ],
)

py_test(
    name = "ast_test",
    size = "small",
    srcs = ["ast_test.py"],
    pytest_main = True,
    deps = [
        ":ast",
        "@pypi//pytest",
    ],
)

py_library(
    name = "compiler",
    srcs = ["__init__.py"],
    deps = ["//define"],
)

py_library(
    name = "driver",
    srcs = ["driver.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":parser",
        ":transformer",
        ":validator",
        "//defcl/python:parser",
        "//define/config/project:config_proto_py",
    ],
)

py_test(
    name = "driver_test",
    size = "small",
    srcs = ["driver_test.py"],
    pytest_main = True,
    deps = [
        ":driver",
        ":validator",
        "@pypi//lark",
        "@pypi//pytest",
    ],
)

py_binary(
    name = "main",
    srcs = ["main.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":driver",
        "@pypi//lark",
    ],
)

py_library(
    name = "parser",
    srcs = ["parser.py"],
    data = ["grammar.lark"],
    deps = [
        ":compiler",
        "@pypi//lark",
    ],
)

py_test(
    name = "parser_test",
    size = "small",
    srcs = ["parser_test.py"],
    pytest_main = True,
    deps = [
        ":parser",
        "@pypi//lark",
        "@pypi//pytest",
    ],
)

py_library(
    name = "transformer",
    srcs = ["transformer.py"],
    deps = [
        ":ast",
        "@pypi//lark",
    ],
)

py_test(
    name = "transformer_test",
    size = "small",
    srcs = ["transformer_test.py"],
    pytest_main = True,
    deps = [
        ":parser",
        ":transformer",
        "@pypi//pytest",
    ],
)

py_library(
    name = "validator",
    srcs = ["validator.py"],
    data = ["//define/spec:reserved_words"],
    deps = [":ast"],
)

py_test(
    name = "validator_test",
    size = "small",
    srcs = ["validator_test.py"],
    pytest_main = True,
    deps = [
        ":parser",
        ":transformer",
        ":validator",
        "@pypi//pytest",
    ],
)

# --- Format checking ---

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@aspect_rules_lint//format:ruff",
)

# --- Type-checking ---

# IMPORTANT: When adding a new py_library, py_binary, or py_test target to this
# package or any of its sub-packages, you must also add it to the deps list below.
pyright_test(
    name = "pyright_test",
    pyproject = "//define/compiler:pyproject.toml",
    deps = [
        ":ast",
        ":ast_test",
        ":compiler",
        ":driver",
        ":driver_test",
        ":main",
        ":parser",
        ":parser_test",
        ":transformer",
        ":transformer_test",
        ":validator",
        ":validator_test",
    ],
)
