load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/lint:format.bzl", "format_test")
load("//tools/lint:pyright.bzl", "pyright_test")

py_library(
    name = "ast",
    srcs = ["ast.py"],
    visibility = ["//define/compiler:__subpackages__"],
    deps = [
        ":compiler",
        ":constants",
        "@pypi//lark",
    ],
)

