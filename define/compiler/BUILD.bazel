py_test(
    name = "memory_integration_test",
    size = "small",
    srcs = ["memory_integration_test.py"],
    data = [
        ":main",
        ":memory_limit_runner",
        "//define/testdata/compiler_memory",
        "//define/testdata/compiler_memory:deep_requirements",
        "//define/testdata/compiler_memory:destruction_fragments",
        "//define/testdata/compiler_memory:fragment_fanout_joins",
        "//define/testdata/compiler_memory:guarantee_expansion",
        "//define/testdata/compiler_memory:large_operation_volume",
        "//define/testdata/compiler_memory:many_substantial_actions",
        "//define/testdata/compiler_memory:operation_dependencies",
        "//define/testdata/compiler_memory:reference_graph_project",
        "//define/testdata/compiler_memory:reference_graph_project_entry",
    ],
    env = {
        "MAIN_BINARY": "$(rlocationpath :main)",
        "MEMORY_TEST_DEEP_REQUIREMENTS": "$(rlocationpath //define/testdata/compiler_memory:deep_requirements)",
        "MEMORY_TEST_DESTRUCTION_FRAGMENTS": "$(rlocationpath //define/testdata/compiler_memory:destruction_fragments)",
        "MEMORY_TEST_FRAGMENT_FANOUT_JOINS": "$(rlocationpath //define/testdata/compiler_memory:fragment_fanout_joins)",
        "MEMORY_TEST_GUARANTEE_EXPANSION": "$(rlocationpath //define/testdata/compiler_memory:guarantee_expansion)",
        "MEMORY_TEST_LARGE_OPERATION_VOLUME": "$(rlocationpath //define/testdata/compiler_memory:large_operation_volume)",
        "MEMORY_TEST_MANY_SUBSTANTIAL_ACTIONS": "$(rlocationpath //define/testdata/compiler_memory:many_substantial_actions)",
        "MEMORY_TEST_OPERATION_DEPENDENCIES": "$(rlocationpath //define/testdata/compiler_memory:operation_dependencies)",
        "MEMORY_TEST_REFERENCE_GRAPH_PROJECT": "$(rlocationpath //define/testdata/compiler_memory:reference_graph_project_entry)",
        "MEMORY_LIMIT_RUNNER": "$(rlocationpath :memory_limit_runner)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":test_runfiles",
        "@pypi//pytest",
    ],
)

