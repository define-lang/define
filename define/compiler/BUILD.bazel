load("@rules_py//py:defs.bzl", "py_binary", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_library(
    name = "ast",
    srcs = ["ast.py"],
    visibility = [
        ":__subpackages__",
        "//tools:__subpackages__",
    ],
    deps = [
        ":chained_name",
        ":constants",
        ":name_types",
        "//crates/source_rendering/python:rendering",
        "//define/compiler/data_structures:define_path",
        "@pypi//msgspec",
    ],
)

py_test(
    name = "ast_test",
    size = "small",
    srcs = ["ast_test.py"],
    deps = [
        ":ast",
        ":chained_name",
        ":name_types",
        "//crates/source_rendering/python:rendering",
        "//define/compiler/data_structures:define_path",
        "//define/compiler/parsing:test_helpers",
        "@pypi//pytest",
    ],
)

py_library(
    name = "chained_name",
    srcs = ["chained_name.py"],
    visibility = [":__subpackages__"],
    deps = [":name_types"],
)

py_test(
    name = "chained_name_test",
    size = "small",
    srcs = ["chained_name_test.py"],
    deps = [":chained_name"],
)

py_library(
    name = "compiler",
    srcs = ["__init__.py"],
    deps = ["//define"],
)

py_library(
    name = "constants",
    srcs = ["constants.py"],
    data = ["//define/standard"],
    visibility = [":__subpackages__"],
    deps = ["//define/compiler/data_structures:define_path"],
)

py_library(
    name = "definition_pipeline",
    srcs = ["definition_pipeline.py"],
    deps = [
        ":ast",
        ":work_pool",
        "//define/compiler/association_resolution:association_resolver",
        "//define/compiler/errors:diagnostics",
        "//define/compiler/graphs:reference_graph_order",
        "//define/compiler/validator/reference_graph:abstract_program",
        "//define/compiler/validator/reference_graph:reference_graph_validator",
    ],
)

py_test(
    name = "definition_pipeline_test",
    size = "small",
    srcs = ["definition_pipeline_test.py"],
    deps = [
        ":ast",
        ":definition_pipeline",
        ":work_pool",
        "//define/compiler/association_resolution:association_resolver",
        "//define/compiler/errors:diagnostics",
        "//define/compiler/validator:test_helpers",
        "//define/compiler/validator/reference_graph:abstract_program",
        "//define/compiler/validator/reference_graph:action_definition_validator",
        "//define/compiler/validator/reference_graph:reference_graph_validator",
        "//define/compiler/validator/structural:program_validator",
        "@pypi//pytest",
    ],
)

py_library(
    name = "driver",
    srcs = ["driver.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":constants",
        ":validation_pipeline",
        "//define/compiler/codegen:generator",
        "//define/compiler/errors:diagnostics",
        "//define/compiler/validator/structural:program_validator",
        "@pypi//msgspec",
    ],
)

py_test(
    name = "driver_fuzz_test",
    size = "small",
    srcs = ["driver_fuzz_test.py"],
    shard_count = 8,
    # This test finds cases that the other tests miss, which those tests must
    # then cover, so its own coverage must not count.
    tags = ["no-coverage"],
    deps = [
        ":driver",
        "//crates/source_rendering/python:rendering",
        "//define/compiler/validator:validation_result",
        "@pypi//hypothesis",
        "@pypi//msgspec",
        "@pypi//pytest",
    ],
)

py_test(
    name = "driver_run_test",
    size = "small",
    srcs = ["driver_run_test.py"],
    data = ["//define/testdata/driver/driver_run"],
    deps = [
        ":constants",
        ":driver",
        "//define/compiler/test_fixtures:testdata",
        "@pypi//pytest",
    ],
)

py_test(
    name = "driver_test",
    size = "small",
    srcs = ["driver_test.py"],
    deps = [
        ":driver",
        ":validation_pipeline",
        "//define/compiler/data_structures:define_path",
        "//define/compiler/errors:diagnostics",
        "//define/compiler/errors:structural_diagnostics",
        "//define/compiler/validator:test_helpers",
        "//define/compiler/validator/structural:program_validator",
        "@pypi//pytest",
    ],
)

filegroup(
    name = "driver_test_sources",
    testonly = True,
    srcs = ["driver_run_test.py"],
    visibility = ["//define/testdata:__pkg__"],
)

py_library(
    name = "literal_parsers",
    srcs = ["literal_parsers.py"],
    visibility = [":__subpackages__"],
    deps = [":standard_encodings"],
)

py_test(
    name = "literal_parsers_test",
    size = "small",
    srcs = ["literal_parsers_test.py"],
    deps = [
        ":literal_parsers",
        ":standard_encodings",
        "@pypi//pytest",
    ],
)

py_binary(
    name = "main",
    srcs = ["main.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":constants",
        ":driver",
        "@pypi//click",
    ],
)

py_test(
    name = "main_integration_test",
    size = "small",
    srcs = ["main_integration_test.py"],
    data = [":main"],
    env = {"MAIN_BINARY": "$(rlocationpath :main)"},
    # The compiler runs in a subprocess, so this test's own process executes no
    # instrumented code and the coverage reporter fails on an empty data set.
    tags = ["no-coverage"],
    deps = ["//tools:runfiles"],
)

py_test(
    name = "main_test",
    size = "small",
    srcs = ["main_test.py"],
    deps = [
        ":constants",
        ":driver",
        ":main",
        "@pypi//click",
    ],
)

py_library(
    name = "name_types",
    srcs = ["name_types.py"],
    visibility = [":__subpackages__"],
)

py_library(
    name = "standard_encodings",
    srcs = ["standard_encodings.py"],
    visibility = [":__subpackages__"],
    deps = [":constants"],
)

py_library(
    name = "validation_pipeline",
    srcs = ["validation_pipeline.py"],
    visibility = ["//define/compiler/test_fixtures:__pkg__"],
    deps = [
        ":definition_pipeline",
        ":work_pool",
        "//define/compiler/association_resolution:association_resolver",
        "//define/compiler/association_resolution:concrete_program",
        "//define/compiler/validator:validation_result",
        "//define/compiler/validator/reference_graph:reference_graph_validator",
        "//define/compiler/validator/structural:program_validator",
        "@pypi//msgspec",
    ],
)

py_library(
    name = "work_pool",
    srcs = ["work_pool.py"],
    visibility = [":__subpackages__"],
)

py_test(
    name = "work_pool_test",
    size = "small",
    srcs = ["work_pool_test.py"],
    deps = [
        ":work_pool",
        "@pypi//pytest",
    ],
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    deps = [
        ":ast",
        ":ast_test",
        ":chained_name",
        ":chained_name_test",
        ":compiler",
        ":constants",
        ":definition_pipeline",
        ":definition_pipeline_test",
        ":driver",
        ":driver_fuzz_test",
        ":driver_run_test",
        ":driver_test",
        ":literal_parsers",
        ":literal_parsers_test",
        ":main",
        ":main_integration_test",
        ":main_test",
        ":name_types",
        ":standard_encodings",
        ":validation_pipeline",
        ":work_pool",
        ":work_pool_test",
    ],
)

check_build_file()
