    name = "main",
    srcs = ["main.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":constants",
        ":driver",
        ":overall_stats",
        "@pypi//click",
    ],
)

py_test(
    name = "main_integration_test",
    size = "small",
    srcs = ["main_integration_test.py"],
    data = [":main"],
    env = {"MAIN_BINARY": "$(rlocationpath :main)"},
    # The compiler runs in a subprocess, so this test's own process executes no
    # instrumented code and the coverage reporter fails on an empty data set.
    tags = ["no-coverage"],
    deps = [
        ":test_runfiles",
    ],
)

