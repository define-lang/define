load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@crates//:defs.bzl", "lint_config")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rust_library", "rust_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyo3.bzl", "pyo3_extension")
load("//tools/bzl:pyright.bzl", "pyright_test")

exports_files(["grammar.lark"])

genrule(
    name = "ast",
    outs = ["ast.rs"],
    cmd = "$(execpath //define/compiler/parsing/rust_generators:generate_ast_nodes) $@ && $(execpath @rules_rust//rust/toolchain:current_rustfmt_toolchain) --edition 2024 $@",
    tools = [
        "//define/compiler/parsing/rust_generators:generate_ast_nodes",
        "@rules_rust//rust/toolchain:current_rustfmt_toolchain",
    ],
    visibility = ["//tools:__pkg__"],
)

py_library(
    name = "indentation_validator",
    srcs = ["indentation_validator.py"],
    visibility = ["//define/compiler:__subpackages__"],
    deps = [
        "//define/compiler:ast",
        "//define/compiler/errors:diagnostics",
    ],
)

py_test(
    name = "indentation_validator_test",
    size = "small",
    srcs = ["indentation_validator_test.py"],
    deps = [
        ":indentation_validator",
        "//define/compiler/errors:diagnostics",
        "@pypi//pytest",
    ],
)

py_library(
    name = "invisible_characters",
    srcs = ["invisible_characters.py"],
    deps = [
        ":invisible_characters_data",
        ":parser_error_classification",
        "//define/compiler:ast",
        "//define/compiler/errors:parser_exceptions",
    ],
)

py_library(
    name = "invisible_characters_data",
    srcs = ["invisible_characters_data.py"],
    visibility = ["//tools:__pkg__"],
)

py_test(
    name = "invisible_characters_test",
    size = "small",
    srcs = ["invisible_characters_test.py"],
    deps = [
        ":invisible_characters",
        "@pypi//pytest",
    ],
)

py_library(
    name = "name_parser",
    srcs = ["name_parser.py"],
    visibility = ["//define/compiler:__subpackages__"],
    deps = [
        "//define/compiler:ast",
        "//define/compiler/errors:parser_exceptions",
        "@pypi//lark_cython",
        "@pypi//msgspec",
    ],
)

py_test(
    name = "name_parser_test",
    size = "small",
    srcs = ["name_parser_test.py"],
    deps = [
        ":name_parser",
        "//define/compiler:ast",
        "//define/compiler/errors:parser_exceptions",
        "@pypi//lark_cython",
        "@pypi//pytest",
    ],
)

py_library(
    name = "native_parser",
    srcs = ["native_parser.pyi"],
    deps = [
        ":parser_extension",  # keep: supplies the native implementation of this stub
        "//define/compiler:ast",
    ],
)

py_library(
    name = "parser",
    srcs = ["parser.py"],
    visibility = [
        "//define/compiler:__subpackages__",
        "//tools:__subpackages__",
    ],
    deps = [
        ":indentation_validator",
        ":invisible_characters",
        ":parser_error_classification",
        ":transformer",
        "//define/compiler:ast",
        "//define/compiler/errors:diagnostics",
        "//define/compiler/errors:parser_exceptions",
        "//define/compiler/parsing/lark:lark_standalone",
        "@pypi//lark_cython",
        "@pypi//msgspec",
    ],
)

py_library(
    name = "parser_comparison",
    testonly = True,
    srcs = ["parser_comparison.py"],
    visibility = ["//define/compiler/parsing:__subpackages__"],
    deps = [
        ":invisible_characters",
        ":native_parser",
        ":parser",
        "//define/compiler:ast",
        "//define/compiler/errors:parser_exceptions",
        "@pypi//msgspec",
    ],
)

py_library(
    name = "parser_error_classification",
    srcs = ["parser_error_classification.py"],
    visibility = ["//define/compiler:__subpackages__"],
    deps = [
        "//define/compiler:ast",
        "//define/compiler/errors:parser_exceptions",
        "//define/compiler/parsing/lark:lark_standalone",
        "@pypi//lark_cython",
    ],
)

pyo3_extension(
    name = "parser_extension",
    srcs = [
        "ast_builder.rs",
        "lines.rs",
        "parse_error.rs",
        "parser.rs",
        "scanner.rs",
        ":ast",
        ":syntax_errors",
    ],
    crate_root = "parser.rs",
    lint_config = lint_config(),
    module_name = "native_parser",
    stubs = False,
    visibility = ["//tools:__pkg__"],
    deps = [
        ":vector_scan",
        "@crates//:rustc-hash",
    ],
)

py_library(
    name = "parsing",
    srcs = ["__init__.py"],
)

genrule(
    name = "syntax_errors",
    outs = ["syntax_errors.rs"],
    cmd = "$(execpath //define/compiler/parsing/rust_generators:generate_syntax_errors) $@ && $(execpath @rules_rust//rust/toolchain:current_rustfmt_toolchain) --edition 2024 $@",
    tools = [
        "//define/compiler/parsing/rust_generators:generate_syntax_errors",
        "@rules_rust//rust/toolchain:current_rustfmt_toolchain",
    ],
    visibility = ["//tools:__pkg__"],
)

py_library(
    name = "test_helpers",
    testonly = True,
    srcs = ["test_helpers.py"],
    visibility = ["//define/compiler:__subpackages__"],
    deps = [
        ":parser",
        ":parser_comparison",
        "//define/compiler:ast",
    ],
)

py_library(
    name = "transformer",
    srcs = ["transformer.py"],
    visibility = [
        "//define/compiler:__subpackages__",
        "//tools:__subpackages__",
    ],
    deps = [
        ":name_parser",
        "//define/compiler:ast",
        "//define/compiler:name_types",
        "//define/compiler/parsing/lark:lark_standalone",
        "@pypi//lark_cython",
        "@pypi//msgspec",
    ],
)

py_test(
    name = "transformer_test",
    size = "small",
    srcs = ["transformer_test.py"],
    deps = [
        ":parser",
        ":test_helpers",
        "//define/compiler:ast",
        "//define/compiler:name_types",
        "//define/compiler/errors:parser_exceptions",
    ],
)

# The parser's vector code is a separate crate so that it stays apart from the
# code people read to work on the parser, and so that a rust_test can link it.
# A rust_test cannot link the PyO3 extension, which does not link libpython.
rust_library(
    name = "vector_scan",
    srcs = ["vector_scan.rs"],
    lint_config = lint_config(),
    deps = ["@crates//:wide"],
)

rust_test(
    name = "vector_scan_test",
    size = "small",
    crate = ":vector_scan",
    lint_config = lint_config(),
    deps = ["@crates//:googletest"],
)

# --- Linting ---

rust_clippy_test(
    name = "clippy_test",
    size = "small",
    tags = ["precommit"],
    targets = [
        ":parser_extension_shared",
        ":vector_scan",
        ":vector_scan_test",
    ],
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    deps = [
        ":indentation_validator",
        ":indentation_validator_test",
        ":invisible_characters",
        ":invisible_characters_data",
        ":invisible_characters_test",
        ":name_parser",
        ":name_parser_test",
        ":native_parser",
        ":parser",
        ":parser_comparison",
        ":parser_error_classification",
        ":parsing",
        ":test_helpers",
        ":transformer",
        ":transformer_test",
    ],
)

check_build_file()
