load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:format.bzl", "format_test")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

exports_files(["grammar.lark"])

py_library(
    name = "indentation_validator",
    srcs = ["indentation_validator.py"],
    visibility = ["//define/compiler:__subpackages__"],
    deps = [
        "//define/compiler:ast",
        "//define/compiler/errors:diagnostics",
    ],
)

py_test(
    name = "indentation_validator_test",
    size = "small",
    srcs = ["indentation_validator_test.py"],
    deps = [
        ":indentation_validator",
        "//define/compiler/errors:diagnostics",
        "@pypi//pytest",
    ],
)

py_library(
    name = "name_parser",
    srcs = ["name_parser.py"],
    visibility = ["//define/compiler:__subpackages__"],
    deps = [
        "//define/compiler:ast",
        "//define/compiler/errors:parser_exceptions",
        "@pypi//lark_cython",
        "@pypi//msgspec",
    ],
)

py_test(
    name = "name_parser_test",
    size = "small",
    srcs = ["name_parser_test.py"],
    deps = [
        ":name_parser",
        "//define/compiler:ast",
        "//define/compiler/errors:parser_exceptions",
        "@pypi//lark_cython",
        "@pypi//pytest",
    ],
)

py_library(
    name = "parser",
    srcs = ["parser.py"],
    visibility = [
        "//define/compiler:__subpackages__",
        "//tools:__subpackages__",
    ],
    deps = [
        ":indentation_validator",
        ":parser_error_classification",
        ":transformer",
        "//define/compiler:ast",
        "//define/compiler/errors:diagnostics",
        "//define/compiler/errors:parser_exceptions",
        "//define/compiler/parsing/lark:lark_standalone",
        "@pypi//lark_cython",
        "@pypi//msgspec",
    ],
)

py_library(
    name = "parser_error_classification",
    srcs = ["parser_error_classification.py"],
    visibility = ["//define/compiler:__subpackages__"],
    deps = [
        "//define/compiler:ast",
        "//define/compiler/errors:parser_exceptions",
        "//define/compiler/parsing/lark:lark_standalone",
        "@pypi//lark_cython",
    ],
)

py_library(
    name = "parsing",
    srcs = ["__init__.py"],
)

py_library(
    name = "test_helpers",
    testonly = True,
    srcs = ["test_helpers.py"],
    visibility = ["//define/compiler:__subpackages__"],
    deps = [
        ":parser",
        "//define/compiler:ast",
    ],
)

py_library(
    name = "transformer",
    srcs = ["transformer.py"],
    visibility = [
        "//define/compiler:__subpackages__",
        "//tools:__subpackages__",
    ],
    deps = [
        ":name_parser",
        "//define/compiler:ast",
        "//define/compiler:name_types",
        "//define/compiler/parsing/lark:lark_standalone",
        "@pypi//lark_cython",
        "@pypi//msgspec",
    ],
)

py_test(
    name = "transformer_test",
    size = "small",
    srcs = ["transformer_test.py"],
    deps = [
        ":parser",
        ":test_helpers",
        "//define/compiler:ast",
        "//define/compiler:name_types",
        "//define/compiler/errors:parser_exceptions",
    ],
)

# --- Format checking ---

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@multitool//tools/ruff",
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    deps = [
        ":indentation_validator",
        ":indentation_validator_test",
        ":name_parser",
        ":name_parser_test",
        ":parser",
        ":parser_error_classification",
        ":parsing",
        ":test_helpers",
        ":transformer",
        ":transformer_test",
    ],
)

check_build_file()
