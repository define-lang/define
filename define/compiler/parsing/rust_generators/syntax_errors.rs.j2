/// Creates the syntax errors of one parse, as instances of classes from
/// `{{ module_name }}`.
pub struct SyntaxErrors<'py> {
    py: Python<'py>,
    file_path: Option<Bound<'py, PyString>>,
}

impl<'py> SyntaxErrors<'py> {
    pub const fn new(py: Python<'py>, file_path: Option<Bound<'py, PyString>>) -> Self {
        Self { py, file_path }
    }

    /// Returns the location from `start` through `end`, the position of its last
    /// character.
    fn location(&self, start: Position, end: Position) -> PyResult<SourceLocation<'py>> {
        SourceLocation::new(
            self.py,
            source_rendering::SourceLocation { start, end },
            self.file_path.as_ref(),
        )
    }

    /// Returns the class `name` in `{{ module_name }}`. A parse ends in at most
    /// one syntax error, so its class is looked up only when it is created.
    fn class(&self, name: &str) -> PyResult<Bound<'py, PyAny>> {
        self.py.import("{{ module_name }}")?.getattr(name)
    }

    /// Returns `error` as a syntax error, or the exception that Python raised
    /// while creating it.
    fn syntax_error(error: PyResult<Bound<'py, PyAny>>) -> ParseError {
        match error {
            Ok(error) => ParseError::Syntax(error.unbind()),
            Err(error) => ParseError::Python(error),
        }
    }
