/// Creates the load failures of one parse, such as its syntax errors, as
/// instances of classes from `{{ module_name }}`.
pub struct LoadFailures<'py> {
    py: Python<'py>,
    file_path: Option<Bound<'py, PyString>>,
}

impl<'py> LoadFailures<'py> {
    pub const fn new(py: Python<'py>, file_path: Option<Bound<'py, PyString>>) -> Self {
        Self { py, file_path }
    }

    /// Returns the location from `start` through `end`, the position of its last
    /// character.
    fn location(&self, start: Position, end: Position) -> PyResult<SourceLocation<'py>> {
        SourceLocation::new(
            self.py,
            source_rendering::SourceLocation { start, end },
            self.file_path.as_ref(),
        )
    }

    /// Returns the class `name` in `{{ module_name }}`. A parse ends in at most
    /// one load failure, so its class is looked up only when it is created.
    fn class(&self, name: &str) -> PyResult<Bound<'py, PyAny>> {
        self.py.import("{{ module_name }}")?.getattr(name)
    }

    /// Returns `failure` as a load failure, or the exception that Python
    /// raised while creating it.
    fn load_failure(failure: PyResult<Bound<'py, PyAny>>) -> ParseError {
        match failure {
            Ok(failure) => ParseError::LoadFailure(failure.unbind()),
            Err(error) => ParseError::Python(error),
        }
    }
