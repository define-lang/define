load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("@crates//:defs.bzl", "lint_config")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:pyo3.bzl", "pyo3_extension")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_binary(
    name = "generate_ast_nodes",
    srcs = ["generate_ast_nodes.py"],
    visibility = ["//define/compiler/parsing:__pkg__"],
    deps = [
        ":renderer_extension",
        ":rust_names",
        "//define/compiler:ast",
        "@pypi//msgspec",
    ],
)

py_binary(
    name = "generate_parser_diagnostics",
    srcs = ["generate_parser_diagnostics.py"],
    visibility = ["//define/compiler/parsing:__pkg__"],
    deps = [
        ":renderer_extension",
        ":rust_names",
        "//define/compiler/errors:diagnostics",
    ],
)

py_binary(
    name = "generate_syntax_errors",
    srcs = ["generate_syntax_errors.py"],
    visibility = ["//define/compiler/parsing:__pkg__"],
    deps = [
        ":renderer_extension",
        ":rust_names",
        "//define/compiler/errors:parser_exceptions",
    ],
)

pyo3_extension(
    name = "renderer_extension",
    srcs = ["rust_renderer.rs"],
    compile_data = [
        "askama.toml",
        "ast_nodes.rs.j2",
        "parser_diagnostics.rs.j2",
        "syntax_errors.rs.j2",
    ],
    crate_root = "rust_renderer.rs",
    lint_config = lint_config(),
    module_name = "rust_renderer",
    stubs = True,
    deps = ["@crates//:askama"],
)

py_library(
    name = "rust_generators",
    srcs = ["__init__.py"],
)

py_library(
    name = "rust_names",
    srcs = ["rust_names.py"],
)

# --- Linting ---

rust_clippy_test(
    name = "clippy_test",
    size = "small",
    tags = ["precommit"],
    targets = [":renderer_extension_shared"],
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    deps = [
        ":generate_ast_nodes",
        ":generate_parser_diagnostics",
        ":generate_syntax_errors",
        ":rust_generators",
        ":rust_names",
    ],
)

check_build_file()
