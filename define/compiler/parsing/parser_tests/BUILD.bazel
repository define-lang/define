load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//define/compiler:ast",
        "//define/compiler/parsing:parser",
        "//define/compiler/parsing:parser_comparison",
        "//define/compiler/parsing:test_helpers",
        "//define/compiler/parsing/lark:lark_standalone",
        "@pypi//lark_cython",
        "@pypi//pytest",
    ],
)

py_library(
    name = "init_py",
    srcs = ["__init__.py"],
)

# These test files each run in a fraction of a second, so a separate pytest
# process for each one spent most of its time starting up. Running them in one
# py_test is an exception to the one-rule-per-source-file convention.
py_test(
    name = "parser_tests",
    size = "small",
    srcs = [
        "action_definition_test.py",
        "action_operation_execution_test.py",
        "blocks_test.py",
        "comments_test.py",
        "constructor_condition_test.py",
        "destroy_particle_test.py",
        "destructor_condition_test.py",
        "encoding_definition_test.py",
        "encoding_operation_definition_test.py",
        "error_messages_test.py",
        "extra_whitespace_test.py",
        "file_encoding_test.py",
        "incomplete_statements_test.py",
        "local_name_format_test.py",
        "move_particle_test.py",
        "multiple_definitions_test.py",
        "operation_definition_test.py",
        "operation_execution_test.py",
        "position_definition_test.py",
        "potential_literal_definition_test.py",
        "quality_implication_test.py",
        "statement_terminators_test.py",
        "trigger_conditions_test.py",
        "typed_name_references_test.py",
        "value_constraint_test.py",
        "value_definition_test.py",
        "value_setting_literal_test.py",
        "value_setting_test.py",
        "view_definition_test.py",
    ],
    data = [
    ],
    deps = [
        ":conftest",
        ":test_helpers",
        "//define/compiler:ast",
        "//define/compiler/errors:diagnostics",
        "//define/compiler/errors:parser_exceptions",
        "//define/compiler/errors:source_map",
        "//define/compiler/parsing:parser",
        "@pypi//pytest",
    ],
)

py_library(
    name = "test_helpers",
    srcs = ["test_helpers.py"],
    deps = [
        "//define/compiler/parsing/lark:lark_standalone",
        "@pypi//lark_cython",
    ],
)

filegroup(
    name = "test_sources",
    testonly = True,
    srcs = glob(["*_test.py"]),
    visibility = ["//define/testdata:__pkg__"],
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    deps = [
        ":conftest",
        ":init_py",
        ":parser_tests",
        ":test_helpers",
    ],
)

check_build_file()
