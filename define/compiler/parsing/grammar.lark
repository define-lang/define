%import common.LF -> NEWLINE

# Name Terminals

# Both GLOBAL_NAME_CONTENT and LOCAL_NAME_CONTENT have negative priority
# so that keyword string terminals (priority 0) always win over them. This
# creates much better parser error messages and error classification.
# Otherwise, the parser thinks that every invalid state matches one
# of these two terminals, greatly reducing the accuracy of parser error
# states.

# Name and literal content terminals exclude the direction marks
# (U+061C, U+200E, U+200F), which the spec allows only in comments.
GLOBAL_NAME_CONTENT.-1: /([^> \n\u061c\u200e\u200f]+:){0,3}\/[^>\n\u061c\u200e\u200f]+/
# We have to make LOCAL_NAME_CONTENT exclude : and / in order to
# successfully differentiate it in circumstances where both local
# and global names are accepted.
#
# We also exclude space because it produces clearer error messages
# most of the time and I'm concerned about the code-generation security
# implications of allowing spaces in names (because the languages we
# transpile down to could do something unsafe with names with spaces in them).
LOCAL_NAME_CONTENT.-2: /[^:\/> \n\u061c\u200e\u200f]+/

# Syntax Terminals
DEFINE_THE_POSITION: "define the position"
DEFINE_THE_POTENTIAL_POSITION: "define the potential position"
DEFINE_THE_POTENTIAL_ACTION: "define the potential action"
DEFINE_THE_POTENTIAL_VALUE: "define the potential value"
DEFINE_THE_POTENTIAL_LITERAL: "define the potential literal"
DEFINE_THE_ENCODING: "define the encoding"
DEFINE_THE_OPERATION: "define the operation"
DEFINE_THE_ENCODING_OPERATION: "define the encoding_operation"
DEFINE_THE_VIEW: "define the view"
ENCODING: "encoding"
POSITION_OR_ACTION: "position" | "action"
VALUE: "value"
LITERAL: "literal"
OPERATION: "operation"
ENCODING_OPERATION: "encoding_operation"
VIEW: "view"
IT_MAY_ONLY_CONTAIN_PARTICLES_WHERE: "it may only contain particles where"
IT_HAS_THE: "it has the"
IT_HAPPENS_WHEN: "it happens when"
AND_IT_DOES: "and it does"
CREATE_A_PARTICLE_IN: "create a particle in"
MOVE_THE_PARTICLE_IN: "move the particle in"
SET_THE_VALUE_OF: "set the value of"
DESTROY_THE_PARTICLE_IN: "destroy the particle in"
THE: "the"
HAS_A_PARTICLE: "has a particle"
CONSTRUCTOR_STATEMENT: "this particle is created"
DESTRUCTOR_STATEMENT: "this particle is being destroyed"
TO: "to"
CHAIN_SEPARATOR: "::"
IT_ALSO_ASSIGNS_THE: "it also assigns the"
IT_DOES: "it does"
EXECUTE_THE: "execute the"
EXECUTE_THE_ENCODING_OPERATION: "execute the encoding operation"
EXECUTE_THE_COMPUTER_OPERATION: "execute the computer operation"
WITH: "with"
LOOKING_AT: "looking at"
IT_IS_READ: "it is read"
IT_IS_WRITTEN: "it is written"

# General

# Ignore leading whitespace (indentation) on lines inside blocks.
# The lookbehind ensures we only match after a newline, and the
# lookahead ensures we don't consume trailing whitespace on blank lines.
%ignore /(?<=\n) +(?=\S)/

# Comments exclude control characters here; the parser rejects every other
# invisible character except the direction marks before lexing, per the
# spec's Invisible Characters rule.
# Literal content must win over a comment when both can match.
COMMENT.-4: / *#(?:[^\x00-\x1F\x7F]*[^\x00-\x1F\x7F ])?/
%ignore COMMENT

terminator: "." NEWLINE
SPACE_AND_OPEN_BRACE: " {"
CLOSE_BRACE: "}"
# TODO: Stop allowing blank lines (NEWLINE*) at the start and end of blocks
# throughout the grammar. Blank lines should only be allowed between the
# statements of a block.
_block_open: SPACE_AND_OPEN_BRACE NEWLINE
_block_close: CLOSE_BRACE NEWLINE

# Name Syntax

global_name_definition_content: "<" GLOBAL_NAME_CONTENT ">"
global_name_reference_content: "<" GLOBAL_NAME_CONTENT ">"
local_name_content: "<" LOCAL_NAME_CONTENT ">"
typed_global_name_reference: POSITION_OR_ACTION global_name_reference_content
typed_value_name_reference: VALUE global_name_reference_content -> typed_global_name_reference
typed_encoding_name_reference: ENCODING global_name_reference_content -> typed_global_name_reference
typed_operation_name_reference: OPERATION global_name_reference_content -> typed_global_name_reference
typed_encoding_operation_name_reference: ENCODING_OPERATION global_name_reference_content -> typed_global_name_reference
typed_local_name_reference: POSITION_OR_ACTION local_name_content
typed_view_name_reference: VIEW local_name_content -> typed_local_name_reference
?typed_name_reference: typed_local_name_reference | typed_global_name_reference

# Position Constraint Block Syntax

?constraint_name_reference: typed_global_name_reference | typed_value_name_reference | typed_encoding_name_reference
position_requirement_statement: IT_HAS_THE " " constraint_name_reference terminator
_position_constraint_requirements: NEWLINE* (position_requirement_statement NEWLINE*)+
position_constraint_block: IT_MAY_ONLY_CONTAIN_PARTICLES_WHERE _block_open _position_constraint_requirements _block_close

# Quality Implication Statement Syntax

quality_implication_statement: IT_ALSO_ASSIGNS_THE " " typed_global_name_reference terminator
_quality_implications: (quality_implication_statement NEWLINE*)*

# Local Position Definition Syntax

local_position_definition_block: _block_open NEWLINE* position_constraint_block NEWLINE* _block_close
?position_definition_terminator_or_block: terminator | local_position_definition_block

# Potential Position Definition Syntax

_action_statements: (NEWLINE
    | local_position_definition
    | create_particle_statement
    | move_particle_statement
    | destroy_particle_statement
    | value_setting_statement
    | operation_execution_statement)*
potential_position_definition_block: _block_open NEWLINE* _quality_implications position_constraint_block NEWLINE* _block_close
position_definition: DEFINE_THE_POTENTIAL_POSITION global_name_definition_content (terminator | potential_position_definition_block)

# Particle Statement Syntax

position_reference: typed_name_reference (CHAIN_SEPARATOR typed_name_reference)*
create_particle_statement: CREATE_A_PARTICLE_IN " " position_reference terminator
move_particle_statement: MOVE_THE_PARTICLE_IN " " position_reference " " TO " " position_reference terminator
destroy_particle_statement: DESTROY_THE_PARTICLE_IN " " position_reference terminator

LITERAL_CONTENT.-3: /(?:[^"\\\n\u061c\u200e\u200f]|\\[^\n\u061c\u200e\u200f])+/
literal: LITERAL global_name_reference_content "\"" LITERAL_CONTENT? "\""

value_setting_statement: SET_THE_VALUE_OF " " position_reference " " TO " " (position_reference | literal) terminator

# Action Definition Syntax

action_definition: DEFINE_THE_POTENTIAL_ACTION global_name_definition_content action_definition_block

local_position_definition: DEFINE_THE_POSITION local_name_content position_definition_terminator_or_block
position_presence_statement: THE " " typed_local_name_reference " " HAS_A_PARTICLE terminator
constructor_condition_statement: CONSTRUCTOR_STATEMENT terminator
destructor_condition_statement: DESTRUCTOR_STATEMENT terminator
?trigger_condition_statement: position_presence_statement | constructor_condition_statement | destructor_condition_statement
trigger_conditions_block: IT_HAPPENS_WHEN _block_open NEWLINE* trigger_condition_statement NEWLINE* CLOSE_BRACE
action_statements_block: " " AND_IT_DOES _block_open _action_statements _block_close
_trigger_and_action: trigger_conditions_block action_statements_block
_action_local_position_definitions: (local_position_definition NEWLINE*)*
action_definition_block: _block_open NEWLINE* _quality_implications _action_local_position_definitions _trigger_and_action NEWLINE* _block_close

# Value Operation Definition Syntax

_view_direction_statements: IT_IS_READ terminator NEWLINE* (IT_IS_WRITTEN terminator NEWLINE*)?
    | IT_IS_WRITTEN terminator NEWLINE*
view_definition_block: _block_open NEWLINE* _view_direction_statements position_constraint_block NEWLINE* _block_close
view_definition: DEFINE_THE_VIEW local_name_content view_definition_block

operation_argument_statement: WITH " " typed_view_name_reference " " LOOKING_AT " " (position_reference | typed_view_name_reference | literal) terminator
operation_arguments_block: _block_open NEWLINE* (operation_argument_statement NEWLINE*)+ _block_close
operation_execution_statement: EXECUTE_THE " " typed_operation_name_reference (terminator | operation_arguments_block)
encoding_operation_execution_statement: EXECUTE_THE_ENCODING_OPERATION terminator
_operation_statements: NEWLINE* ((operation_execution_statement | encoding_operation_execution_statement) NEWLINE*)+
operation_statements_block: IT_DOES _block_open _operation_statements _block_close
_view_definitions: (view_definition NEWLINE*)*
operation_definition_block: _block_open NEWLINE* _view_definitions operation_statements_block NEWLINE* _block_close
operation_definition: DEFINE_THE_OPERATION global_name_definition_content operation_definition_block

# Encoding Operation Definition Syntax

# Encoding Operations share the AST of Value Operations for everything except
# their definition and "execute the computer operation.", so their other rules
# are aliases of the Value Operation rules.
operation_execution_in_encoding_operation: EXECUTE_THE " " typed_encoding_operation_name_reference (terminator | operation_arguments_block) -> operation_execution_statement
computer_operation_execution_statement: EXECUTE_THE_COMPUTER_OPERATION terminator
_encoding_operation_statements: NEWLINE* ((operation_execution_in_encoding_operation | computer_operation_execution_statement) NEWLINE*)+
encoding_operation_statements_block: IT_DOES _block_open _encoding_operation_statements _block_close -> operation_statements_block
encoding_operation_definition_block: _block_open NEWLINE* _view_definitions encoding_operation_statements_block NEWLINE* _block_close -> operation_definition_block
encoding_operation_definition: DEFINE_THE_ENCODING_OPERATION global_name_definition_content encoding_operation_definition_block

# Root Syntax

value_definition: DEFINE_THE_POTENTIAL_VALUE global_name_definition_content terminator
encoding_definition: DEFINE_THE_ENCODING global_name_definition_content terminator
encoding_constraint: IT_HAS_THE " " typed_encoding_name_reference terminator
potential_literal_definition_block: _block_open NEWLINE* encoding_constraint NEWLINE* _block_close
potential_literal_definition: DEFINE_THE_POTENTIAL_LITERAL global_name_definition_content potential_literal_definition_block

definition: position_definition
    | action_definition
    | value_definition
    | encoding_definition
    | potential_literal_definition
    | operation_definition
    | encoding_operation_definition
start: NEWLINE* definition (NEWLINE* definition)* NEWLINE*
