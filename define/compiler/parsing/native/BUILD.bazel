load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@crates//:defs.bzl", "lint_config")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rust_library", "rust_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:pyo3.bzl", "pyo3_extension")
load("//tools/bzl:pyright.bzl", "pyright_test")

exports_files(["characters/invisible_ranges.rs"])

genrule(
    name = "ast",
    outs = ["ast.rs"],
    cmd = "$(execpath //define/compiler/parsing/native/rust_generators:generate_ast_nodes) $@ && $(execpath @rules_rust//tools/upstream_wrapper:rustfmt) --edition 2024 $@",
    tools = [
        "//define/compiler/parsing/native/rust_generators:generate_ast_nodes",
        "@rules_rust//tools/upstream_wrapper:rustfmt",
    ],
    visibility = ["//tools:__pkg__"],
)

py_library(
    name = "native",
    srcs = ["__init__.py"],
)

py_library(
    name = "native_parser",
    srcs = ["native_parser.pyi"],
    visibility = ["//define/compiler/parsing:__subpackages__"],
    deps = [
        ":parser_extension",  # keep: supplies the native implementation of this stub
        "//define/compiler:ast",
        "//define/compiler/errors:diagnostics",
        "//define/compiler/errors:parser_exceptions",
    ],
)

genrule(
    name = "parser_diagnostics",
    outs = ["parser_diagnostics.rs"],
    cmd = "$(execpath //define/compiler/parsing/native/rust_generators:generate_parser_diagnostics) $@ && $(execpath @rules_rust//tools/upstream_wrapper:rustfmt) --edition 2024 $@",
    tools = [
        "//define/compiler/parsing/native/rust_generators:generate_parser_diagnostics",
        "@rules_rust//tools/upstream_wrapper:rustfmt",
    ],
    visibility = ["//tools:__pkg__"],
)

pyo3_extension(
    name = "parser_extension",
    srcs = [
        "ast_builder.rs",
        "characters.rs",
        "characters/invisible_ranges.rs",
        "lines.rs",
        "parse_error.rs",
        "parser.rs",
        "scanner.rs",
        ":ast",
        ":parser_diagnostics",
        ":syntax_errors",
    ],
    crate_root = "parser.rs",
    lint_config = lint_config(),
    module_name = "native_parser",
    stubs = False,
    visibility = ["//tools:__pkg__"],
    deps = [
        ":vector_scan",
        "@crates//:rustc-hash",
    ],
)

genrule(
    name = "syntax_errors",
    outs = ["syntax_errors.rs"],
    cmd = "$(execpath //define/compiler/parsing/native/rust_generators:generate_syntax_errors) $@ && $(execpath @rules_rust//tools/upstream_wrapper:rustfmt) --edition 2024 $@",
    tools = [
        "//define/compiler/parsing/native/rust_generators:generate_syntax_errors",
        "@rules_rust//tools/upstream_wrapper:rustfmt",
    ],
    visibility = ["//tools:__pkg__"],
)

# The parser's vector code is a separate crate so that it stays apart from the
# code people read to work on the parser, and so that a rust_test can link it.
# A rust_test cannot link the PyO3 extension, which does not link libpython.
rust_library(
    name = "vector_scan",
    srcs = ["vector_scan.rs"],
    lint_config = lint_config(),
    deps = ["@crates//:wide"],
)

rust_test(
    name = "vector_scan_test",
    size = "small",
    crate = ":vector_scan",
    lint_config = lint_config(),
    deps = ["@crates//:googletest"],
)

# --- Linting ---

rust_clippy_test(
    name = "clippy_test",
    size = "small",
    tags = ["precommit"],
    targets = [
        ":parser_extension_shared",
        ":vector_scan",
        ":vector_scan_test",
    ],
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    deps = [
        ":native",
        ":native_parser",
    ],
)

check_build_file()
