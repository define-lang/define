{% from "action_statements.j2" import action_statements %}
{% macro action_execution_init(action_class_name, execution) %}
{% set destruction_connection_class = "tracing.DestructionConnection" if execution.trace_operations else "literal.DestructionConnection" %}
    def __init__(
        self,
    {% if execution.needs_action %}
        action: {{ action_class_name }},
    {% endif %}
        scheduler: literal.Scheduler,
    {% if execution.trace_operations %}
        caller_execution: object | None,
        action_name: str,
    {% endif %}
    {% if execution.needs_guarantees %}
        guarantees: {{ execution.guarantees.class_name }},
    {% endif %}
    {% if execution.accepts_destruction_connections %}
        *,
        destruction_connections: literal.DestructionConnections | None = None,
    {% endif %}
    ):
    {% if execution.needs_action %}
        self.action = action
    {% endif %}
        self.scheduler = scheduler
    {% if execution.trace_operations %}
        self.trace_execution = scheduler.execution_created(
            caller_execution,
            action_name,
        )
    {% endif %}
    {% if execution.needs_guarantees %}
        self.guarantees = guarantees
    {% endif %}
    {% if execution.accepts_destruction_connections %}
        self.destruction_connections = destruction_connections
    {% endif %}
    {% if execution.local_position_statements %}
{{ action_statements(execution.local_position_statements) -}}
    {% endif %}
    {% if execution.needs_guarantees %}
        {% for registration in execution.guarantees.registrations %}
        guarantees
        {%- for child_guarantees_name in registration.child_guarantees_names -%}
.{{ child_guarantees_name }}
        {%- endfor -%}
.{{ registration.guarantee_name }}.append(
            self.{{ registration.method_name }}
        )
        {% endfor %}
    {% endif %}
    {% for action_execution in execution.action_executions %}
        self.{{ action_execution.execution_name }}: {{ action_execution.execution_class.module_name }}.{{ action_execution.execution_class.class_name }}
        {% for connection in action_execution.created_destruction_connections %}
        self.{{ connection.member_name }}: {{ destruction_connection_class }}
        {% endfor %}
        {% if action_execution.created_destruction_connections %}
        self.{{ action_execution.destruction_connections_member_name }}: literal.DestructionConnections
        {% endif %}
    {% endfor %}
    {% for triggered_input in execution.triggered_action_inputs %}
        {% for destruction_position in triggered_input.destruction_positions %}
        self.{{ destruction_position.member_name }}: literal.Position
        {% endfor %}
    {% endfor %}
    {% for fragment in execution.fragments %}
        {% if fragment.dependency_count > 1 %}
        self.join_for_{{ fragment.method_name }} = literal.Join({{ fragment.dependency_count }})
        {% endif %}
    {% endfor %}
    {% for triggered_input in execution.triggered_action_inputs %}
        {% if triggered_input.dependency_count > 1 %}
        self.join_for_{{ triggered_input.method_name }} = literal.Join({{ triggered_input.dependency_count }})
        {% endif %}
    {% endfor %}
{% endmacro %}
