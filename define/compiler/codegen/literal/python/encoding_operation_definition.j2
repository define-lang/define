{% macro expression(statement, module_name) -%}
    {%- match statement -%}
        {%- when EncodingOperationStatement::BinaryOperation { operator, left, right, .. } -%}
{{ left }} {% match operator.get() -%}
            {%- when BinaryOperator::Add {} -%}
+
            {%- when BinaryOperator::Subtract {} -%}
-
            {%- when BinaryOperator::Multiply {} -%}
*
            {%- when BinaryOperator::And {} -%}
and
            {%- when BinaryOperator::Or {} -%}
or
            {%- when BinaryOperator::ExclusiveOr {} -%}
^
            {%- when BinaryOperator::BitwiseAnd {} -%}
&
            {%- when BinaryOperator::BitwiseOr {} -%}
|
            {%- when BinaryOperator::Equal {} -%}
==
            {%- when BinaryOperator::LessThan {} -%}
<
            {%- when BinaryOperator::LessThanOrEqual {} -%}
<=
            {%- when BinaryOperator::GreaterThanOrEqual {} -%}
>=
            {%- endmatch %} {{ right }}
        {%- when EncodingOperationStatement::PrefixOperation { operator, operand, .. } -%}
            {%- match operator.get() -%}
                {%- when PrefixOperator::Negate {} -%}
-
                {%- when PrefixOperator::Not {} -%}
not{{ " " }}
            {%- endmatch -%}
{{ operand }}
        {%- when EncodingOperationStatement::ExpressionOperation { operator, operands, .. } -%}
            {%- match operator.get() -%}
                {%- when ExpressionOperator::SaturatingSubtract {} -%}
{{ operands[0] }} - {{ operands[1] }} if {{ operands[0] }} > {{ operands[1] }} else 0
                {%- when ExpressionOperator::SaturatingDecrement {} -%}
{{ operands[0] }} - 1 if {{ operands[0] }} > 0 else 0
            {%- endmatch -%}
        {%- when EncodingOperationStatement::Call { function, arguments, .. } -%}
{{ function.get().name_in_module(module_name) }}({{ arguments|join(", ") }})
    {%- endmatch -%}
{%- endmacro -%}
def {{ self.function_name }}(
{%- for parameter in self.parameters -%}
    {{ parameter.get().name }}: {{ parameter.get().python_type }}{% if !loop.last %}, {% endif %}
{%- endfor -%}
) -> {% if self.results.is_empty() -%}
    None
{%- else if self.results.len() == 1 -%}
    {{ self.results[0].get().python_type }}
{%- else -%}
    tuple[
    {%- for result in self.results -%}
        {{ result.get().python_type }}{% if !loop.last %}, {% endif %}
    {%- endfor -%}
    ]
{%- endif %}:
{%- for statement in self.statements %}
    {%- let statement = statement.get() %}
    {%- if loop.last && self.return_last_statement %}
    return {{ expression(statement, module_name) }}
    {%- else %}
        {%- match statement %}
            {%- when EncodingOperationStatement::BinaryOperation { result, .. }
                | EncodingOperationStatement::PrefixOperation { result, .. }
                | EncodingOperationStatement::ExpressionOperation { result, .. } %}
    {{ result }} = {{ expression(statement, module_name) }}
            {%- when EncodingOperationStatement::Call { results, .. } %}
    {% if !results.is_empty() %}{{ results|join(", ") }} = {% endif -%}
    {{ expression(statement, module_name) }}
        {%- endmatch %}
    {%- endif %}
{%- endfor %}
{%- if !self.results.is_empty() && !self.return_last_statement %}
    return {% for result in self.results %}{{ result.get().name }}{% if !loop.last %}, {% endif %}{% endfor %}
{%- endif %}{{ "\n" }}
