# package, you must also add it to the deps list below.
pyright_test(
    name = "pyright_test",
    deps = [
        ":action_context",
        ":action_definition",
        ":action_statements",
        ":destruction_contracts",
        ":generator",
        ":naming",
        ":naming_test",
        ":operation_labels",
        ":position_definition",
        ":position_expression",
        ":python",
        ":template_context",
        ":template_env",
        ":template_env_test",
    ],
