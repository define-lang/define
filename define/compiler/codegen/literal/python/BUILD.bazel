load("@aspect_rules_py//py:defs.bzl", "py_library", "py_test")
load("//tools/bzl:format.bzl", "format_test")
load("//tools/bzl:jinja2.bzl", "jinja_templates")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_library(
    name = "action_definition",
    srcs = ["action_definition.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":action_statements",
        ":naming",
        ":template_context",
        "//define/compiler:ast",
    ],
)

py_library(
    name = "action_statements",
    srcs = ["action_statements.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":naming",
        ":template_context",
        "//define/compiler:ast",
    ],
)

py_library(
    name = "generator",
    srcs = ["generator.py"],
    data = [":templates"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":action_definition",
        ":naming",
        ":position_definition",
        ":template_context",
        ":template_env",
        "//define/compiler:ast",
        "//define/compiler/graphs:reference_graph",
        "@pypi//jinja2",
    ],
)

py_library(
    name = "naming",
    srcs = ["naming.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        "//define/compiler:ast",
        "//define/compiler:constants",
        "//define/compiler/data_structures:define_path",
    ],
)

py_test(
    name = "naming_test",
    size = "small",
    srcs = ["naming_test.py"],
    deps = [
        ":naming",
        "//define/compiler/data_structures:define_path",
    ],
)

py_library(
    name = "position_definition",
    srcs = ["position_definition.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":naming",
        ":template_context",
        "//define/compiler:ast",
    ],
)

py_library(
    name = "python",
    srcs = ["__init__.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
)

py_library(
    name = "template_context",
    srcs = ["template_context.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":naming",
    ],
)

py_library(
    name = "template_env",
    srcs = ["template_env.py"],
    visibility = [
        "//define/compiler/codegen:__subpackages__",
        "//tools:__pkg__",
    ],
    deps = ["@pypi//jinja2"],
)

jinja_templates(
    name = "templates",
    srcs = glob(["*.j2"]),
)

# --- Format checking ---

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@multitool//tools/ruff",
)

# --- Type-checking ---

# IMPORTANT: When adding a new py_library, py_binary, or py_test target to this
# package, you must also add it to the deps list below.
pyright_test(
    name = "pyright_test",
    deps = [
        ":action_definition",
        ":action_statements",
        ":generator",
        ":naming",
        ":naming_test",
        ":position_definition",
        ":python",
        ":template_context",
        ":template_env",
    ],
)
