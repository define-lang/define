load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@crates//:defs.bzl", "lint_config")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("@rules_rust_pyo3//:defs.bzl", "pyo3_extension")
load("//tools/bzl:format.bzl", "format_test")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_library(
    name = "_templates",
    srcs = ["_templates.pyi"],
    deps = [
        ":action_context",
        ":naming",
        ":renderer",  # keep: supplies the native implementation of this stub
        ":template_context",
    ],
)

py_library(
    name = "action_context",
    srcs = ["action_context.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":naming",
        ":template_context",
        "@pypi//msgspec",
    ],
)

py_library(
    name = "action_definition",
    srcs = ["action_definition.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":action_context",
        ":action_statements",
        ":naming",
        ":template_context",
        "//define/compiler/validator:codegen_input",
    ],
)

py_library(
    name = "action_statements",
    srcs = ["action_statements.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":destruction_contracts",
        ":naming",
        ":operation_labels",
        ":position_expression",
        ":template_context",
        "//define/compiler:ast",
        "//define/compiler/validator:codegen_input",
        "//define/compiler/validator/reference_graph:destruction_contract",
        "@pypi//msgspec",
    ],
)

py_library(
    name = "destruction_contracts",
    srcs = ["destruction_contracts.py"],
    deps = [
        ":naming",
        ":operation_labels",
        ":position_expression",
        ":template_context",
        "//define/compiler:ast",
        "//define/compiler/validator:codegen_input",
        "//define/compiler/validator/reference_graph:destruction_contract",
    ],
)

py_library(
    name = "generator",
    srcs = ["generator.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":_templates",
        ":action_context",
        ":action_definition",
        ":naming",
        ":position_definition",
        ":template_context",
        "//define/compiler:ast",
        "//define/compiler/graphs:reference_graph_executor",
        "//define/compiler/validator:codegen_input",
    ],
)

py_library(
    name = "naming",
    srcs = ["naming.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        "//define/compiler:ast",
        "//define/compiler:constants",
        "//define/compiler/data_structures:define_path",
        "//define/compiler/validator/reference_graph:destruction_contract",
        "@pypi//msgspec",
    ],
)

py_test(
    name = "naming_test",
    size = "small",
    srcs = ["naming_test.py"],
    deps = [
        ":naming",
        "//define/compiler:ast",
        "//define/compiler/data_structures:define_path",
    ],
)

py_library(
    name = "operation_labels",
    srcs = ["operation_labels.py"],
    deps = [
        ":template_context",
        "//define/compiler:ast",
    ],
)

py_library(
    name = "position_definition",
    srcs = ["position_definition.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":naming",
        ":template_context",
        "//define/compiler:ast",
    ],
)

py_library(
    name = "position_expression",
    srcs = ["position_expression.py"],
    deps = [
        ":naming",
        ":template_context",
        "//define/compiler:ast",
    ],
)

py_library(
    name = "python",
    srcs = ["__init__.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
)

pyo3_extension(
    name = "renderer",
    srcs = ["renderer.rs"],
    compile_data = glob(["*.j2"]) + ["askama.toml"],
    crate_root = "renderer.rs",
    lint_config = lint_config(),
    module_name = "_templates",
    rustc_flags = ["-Clink-arg=-Qunused-arguments"],
    stubs = False,
    visibility = ["//tools:__pkg__"],
    deps = ["@crates//:askama"],
)

py_library(
    name = "template_context",
    srcs = ["template_context.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":naming",
        "//define/compiler:ast",
        "@pypi//msgspec",
    ],
)

# --- Format checking ---

rustfmt_test(
    name = "rustfmt_test",
    size = "small",
    targets = [":renderer_shared"],
)

rust_clippy_test(
    name = "clippy_test",
    size = "small",
    targets = [":renderer_shared"],
)

format_test(
    name = "format_test",
    srcs = glob([
        "*.py",
        "*.pyi",
    ]),
    python = "@multitool//tools/ruff",
)

# --- Type-checking ---

# IMPORTANT: When adding a new py_library, py_binary, or py_test target to this
# package, you must also add it to the deps list below.
pyright_test(
    name = "pyright_test",
    deps = [
        ":_templates",
        ":action_context",
        ":action_definition",
        ":action_statements",
        ":destruction_contracts",
        ":generator",
        ":naming",
        ":naming_test",
        ":operation_labels",
        ":position_definition",
        ":position_expression",
        ":python",
        ":template_context",
    ],
)
