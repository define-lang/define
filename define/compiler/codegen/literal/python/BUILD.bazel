load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//tools/bzl:format.bzl", "format_test")
load("//tools/bzl:jinja2.bzl", "jinja_templates")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_library(
    name = "action_context",
    srcs = ["action_context.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":naming",
        ":template_context",
    ],
)

py_library(
    name = "action_definition",
    srcs = ["action_definition.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":action_context",
        ":action_statements",
        ":naming",
        ":template_context",
        "//define/compiler:ast",
        "//define/compiler/validator:validation_result",
    ],
)

py_library(
    name = "action_statements",
    srcs = ["action_statements.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":destruction_contracts",
        ":naming",
        ":operation_labels",
        ":position_expression",
        ":template_context",
        "//define/compiler:ast",
        "//define/compiler/validator:validation_result",
    ],
)

py_library(
    name = "destruction_contracts",
    srcs = ["destruction_contracts.py"],
    deps = [
        ":naming",
        ":operation_labels",
        ":position_expression",
        ":template_context",
        "//define/compiler:ast",
        "//define/compiler/validator:validation_result",
        "//define/compiler/validator/reference_graph:destruction_contract",
    ],
)

py_library(
    name = "generator",
    srcs = ["generator.py"],
    data = [":templates"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":action_context",
        ":action_definition",
        ":naming",
        ":position_definition",
        ":template_context",
        ":template_env",
        "//define/compiler:ast",
        "//define/compiler/graphs:reference_graph_executor",
        "//define/compiler/validator:validation_result",
        "@pypi//jinja2",
    ],
)

py_library(
    name = "naming",
    srcs = ["naming.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        "//define/compiler:ast",
        "//define/compiler:constants",
        "//define/compiler/data_structures:define_path",
        "//define/compiler/validator/reference_graph:destruction_contract",
    ],
)

py_test(
    name = "naming_test",
    size = "small",
    srcs = ["naming_test.py"],
    deps = [
        ":naming",
        "//define/compiler:ast",
        "//define/compiler/data_structures:define_path",
    ],
)

py_library(
    name = "operation_labels",
    srcs = ["operation_labels.py"],
    deps = [
        ":template_context",
        "//define/compiler:ast",
    ],
)

py_library(
    name = "position_definition",
    srcs = ["position_definition.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":naming",
        ":template_context",
        "//define/compiler:ast",
    ],
)

py_library(
    name = "position_expression",
    srcs = ["position_expression.py"],
    deps = [
        ":naming",
        ":template_context",
        "//define/compiler:ast",
    ],
)

py_library(
    name = "python",
    srcs = ["__init__.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
)

py_library(
    name = "template_context",
    srcs = ["template_context.py"],
    visibility = ["//define/compiler/codegen:__subpackages__"],
    deps = [
        ":naming",
        "//define/compiler:ast",
    ],
)

py_library(
    name = "template_env",
    srcs = ["template_env.py"],
    visibility = [
        "//define/compiler/codegen:__subpackages__",
        "//tools:__pkg__",
    ],
    deps = ["@pypi//jinja2"],
)

py_test(
    name = "template_env_test",
    size = "small",
    srcs = ["template_env_test.py"],
    data = [":templates"],
    deps = [":template_env"],
)

jinja_templates(
    name = "templates",
    srcs = glob(["*.j2"]),
)

# --- Format checking ---

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@multitool//tools/ruff",
)

# --- Type-checking ---

