{% macro position_expression(expr, extra_indent, module_name) -%}
    {% if expr.from_contract_particle -%}
particle
    {%- else if let Some(name) = expr.local_position_name -%}
{{ name }}
    {%- else -%}
self
    {%- endif -%}
    {% for element in expr.chain_elements -%}
        {% match element.get() -%}
            {% when ChainElement::PositionFromPosition { class_reference } -%}
.particle.get_position(
{{ extra_indent }}            {{ class_reference.get().name_in_module(module_name) }}
{{ extra_indent }}        )
            {%- when ChainElement::ActionFromPosition { class_reference } -%}
.particle.get_action(
{{ extra_indent }}            {{ class_reference.get().name_in_module(module_name) }}
{{ extra_indent }}        )
            {%- when ChainElement::PositionFromAction { typed_name, value_type } -%}
.get_interface_position(
{{ extra_indent }}            "{{ typed_name }}"{% if let Some(value_type) = value_type %}, {{ value_type }}{% endif %}
{{ extra_indent }}        )
            {%- when ChainElement::ImpliedAction { class_reference } -%}
{% if !expr.from_contract_particle %}.on_particle{% endif %}.get_action(
{{ extra_indent }}            {{ class_reference.get().name_in_module(module_name) }}
{{ extra_indent }}        )
            {%- when ChainElement::ImpliedPosition { class_reference } -%}
{% if !expr.from_contract_particle %}.on_particle{% endif %}.get_position(
{{ extra_indent }}            {{ class_reference.get().name_in_module(module_name) }}
{{ extra_indent }}        )
        {%- endmatch -%}
    {% endfor -%}
{% endmacro %}
