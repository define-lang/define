{% import "position_expression.j2" as expressions -%}
{% macro action_statements(statements) -%}
    {%- for statement in statements.iter() %}
        {%- match statement.kind %}
            {%- when StatementKind::LocalPosition with (statement) %}
        {{ statement.name }} = literal.LocalPosition(
            "{{ statement.local_typed_name }}",
                {%- if !statement.constraints.is_empty() %}
            constraints=(
                    {%- for constraint in statement.constraints %}
                {{ constraint.module_name }}.{{ constraint.class_name }},
                    {%- endfor %}
            ),
                {%- endif %}
        )
            {%- when StatementKind::CreateParticle with (statement) %}
        {{ expressions::position_expression(statement.position, "") }}.create_particle()
            {%- when StatementKind::MoveParticle with (statement) %}
        {{ expressions::position_expression(statement.position, "") }}.move_particle_to(
            {{ expressions::position_expression(statement.to_position, "    ") }}
        )
            {%- when StatementKind::DestroyParticle with (statement) %}
        {{ expressions::position_expression(statement.position, "") }}.destroy_particle()
            {%- when StatementKind::SetValue with (statement) %}
        {{ expressions::position_expression(statement.position, "") }}.set_value({{ statement.value }})
            {%- when StatementKind::SetValueFrom with (statement) %}
        {{ expressions::position_expression(statement.position, "") }}.set_value_from(
            {{ expressions::position_expression(statement.source_position, "    ") }}
        )
            {%- when StatementKind::RunAction with (statement) %}
                {%- if let Some(contract) = statement.destruction_contract %}
                    {%- if !contract.forwarded_methods.is_empty() %}
        {{ expressions::position_expression(statement.position, "") }}.run(
            {{ contract.class_name }}(
                        {%- for method in contract.forwarded_methods %}
                destruction_contracts.{{ method }},
                        {%- endfor %}
            ),
        )
                    {%- else %}
        {{ expressions::position_expression(statement.position, "") }}.run({{ contract.class_name }}())
                    {%- endif %}
                {%- else %}
        {{ expressions::position_expression(statement.position, "") }}.run()
                {%- endif %}
            {%- when StatementKind::ContractContribution with (statement) %}
        destruction_contracts.{{ statement.contract_method }}(
            {{ expressions::position_expression(statement.position, "    ") }}.particle
        )
        {%- endmatch %}
        {%- if let Some(label) = statement.operation_label %}
        literal.record_operation("{{ label }}")
        {%- endif %}
    {%- endfor %}
{% endmacro %}
