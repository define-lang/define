{% from "position_expression.j2" import position_expression %}
{% macro action_statements(statements) %}
    {% for stmt in statements %}
        {% if stmt.kind == StatementKind.LOCAL_POSITION %}
            {% if stmt.constraints %}
        self.{{ stmt.local_position_member_name }} = literal.LocalPosition(
            "{{ stmt.local_typed_name }}",
            constraints=(
                {% for class_reference in stmt.constraints %}
                {{ class_reference.module_name }}.{{ class_reference.class_name }},
                {% endfor %}
            ),
            scheduler=self.scheduler,
        )
            {% else %}
        self.{{ stmt.local_position_member_name }} = literal.LocalPosition(
            "{{ stmt.local_typed_name }}",
            scheduler=self.scheduler,
        )
            {% endif %}
        {% elif stmt.kind == StatementKind.CREATE_PARTICLE %}
        {{ position_expression(stmt.position) }}.create_particle()
            {% if stmt.operation_label is not none %}
        self.scheduler.create_completed(
            self.trace_execution,
            "{{ stmt.operation_label.target }}",
            {{ stmt.operation_label.occurrence }},
        )
            {% endif %}
        {% elif stmt.kind == StatementKind.DESTROY_PARTICLE %}
            {% if stmt.destroy_if_occupied %}
        {{ position_expression(stmt.position) }}.destroy_particle_if_occupied()
            {% else %}
        {{ position_expression(stmt.position) }}.destroy_particle()
            {% endif %}
            {% if stmt.operation_label is not none %}
                {% if stmt.destroy_if_occupied %}
                    {# TODO: Trace this operation only when it actually destroys a particle. #}
        self.scheduler.destroy_if_occupied_completed(
                {% else %}
        self.scheduler.destroy_completed(
                {% endif %}
            self.trace_execution,
            "{{ stmt.operation_label.target }}",
            {{ stmt.operation_label.occurrence }},
        )
            {% endif %}
        {% elif stmt.kind == StatementKind.MOVE_PARTICLE %}
            {% if stmt.to_position.chain_elements %}
        {{ position_expression(stmt.position) }}.move_particle_to(
            {{ position_expression(stmt.to_position, "    ") }}
        )
            {% else %}
        {{ position_expression(stmt.position) }}.move_particle_to({{ position_expression(stmt.to_position) }})
            {% endif %}
            {% if stmt.operation_label is not none %}
        self.scheduler.move_completed(
            self.trace_execution,
            "{{ stmt.operation_label.source }}",
            "{{ stmt.operation_label.target }}",
            {{ stmt.operation_label.occurrence }},
        )
            {% endif %}
        {% endif %}
    {% endfor %}
{%- endmacro %}
