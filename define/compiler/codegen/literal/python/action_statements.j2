{% import "position_expression.j2" as expressions -%}
{% macro operation_call(statement, extra_indent, argument_indent, module_name) -%}
{{ statement.function.name_in_module(module_name) }}(
    {%- for argument in statement.arguments %}
        {%- match argument %}
            {%- when OperationArgument::Position with (position) %}
{{ extra_indent }}            {{ expressions::position_expression(position, argument_indent, module_name) }}.particle.value,
            {%- when OperationArgument::Literal with (value) %}
{{ extra_indent }}            {{ value }},
        {%- endmatch %}
    {%- endfor %}
{{ extra_indent }}        )
{%- endmacro %}
{% macro action_statements(statements, module_name) -%}
    {%- for statement in statements.iter() %}
        {%- match statement.kind %}
            {%- when StatementKind::LocalPosition with (statement) %}
        {{ statement.name }} = literal.LocalPosition[{{ statement.value_type }}](
            "{{ statement.local_typed_name }}",
                {%- if !statement.constraints.is_empty() %}
            constraints=(
                    {%- for constraint in statement.constraints %}
                {{ constraint.name_in_module(module_name) }},
                    {%- endfor %}
            ),
                {%- endif %}
        )
            {%- when StatementKind::CreateParticle with (statement) %}
        {{ expressions::position_expression(statement.position, "", module_name) }}.create_particle()
            {%- when StatementKind::MoveParticle with (statement) %}
        {{ expressions::position_expression(statement.position, "", module_name) }}.move_particle_to(
            {{ expressions::position_expression(statement.to_position, "    ", module_name) }}
        )
            {%- when StatementKind::DestroyParticle with (statement) %}
        {{ expressions::position_expression(statement.position, "", module_name) }}.destroy_particle()
            {%- when StatementKind::SetValue with (statement) %}
        {{ expressions::position_expression(statement.position, "", module_name) }}.particle.value = {{ statement.value }}
            {%- when StatementKind::SetValueFrom with (statement) %}
        {{ expressions::position_expression(statement.position, "", module_name) }}.particle.value = (
            {{ expressions::position_expression(statement.source_position, "    ", module_name) }}.particle.value
        )
            {%- when StatementKind::RunAction with (statement) %}
                {%- if let Some(contract) = statement.destruction_contract %}
                    {%- if !contract.forwarded_methods.is_empty() %}
        {{ expressions::position_expression(statement.position, "", module_name) }}.run(
            {{ contract.class_name }}(
                        {%- for method in contract.forwarded_methods %}
                destruction_contracts.{{ method }},
                        {%- endfor %}
            ),
        )
                    {%- else %}
        {{ expressions::position_expression(statement.position, "", module_name) }}.run({{ contract.class_name }}())
                    {%- endif %}
                {%- else %}
        {{ expressions::position_expression(statement.position, "", module_name) }}.run()
                {%- endif %}
            {%- when StatementKind::ContractContribution with (statement) %}
        destruction_contracts.{{ statement.contract_method }}(
            {{ expressions::position_expression(statement.position, "    ", module_name) }}.particle
        )
            {%- when StatementKind::ExecuteOperation with (statement) %}
                {%- if statement.outputs.len() == 1 %}
        {{ expressions::position_expression(statement.outputs[0], "", module_name) }}.particle.value = {{ operation_call(statement, "", "    ", module_name) }}
                {%- else if statement.outputs.is_empty() %}
        {{ operation_call(statement, "", "    ", module_name) }}
                {%- else %}
        {{ statement.result_names|join(", ") }} = {{ operation_call(statement, "", "    ", module_name) }}
                    {%- for (output, result_name) in statement.outputs.iter().zip(statement.result_names.iter()) %}
        {{ expressions::position_expression(output, "", module_name) }}.particle.value = {{ result_name }}
                    {%- endfor %}
                {%- endif %}
        {%- endmatch %}
        {%- if let Some(label) = statement.operation_label %}
        literal.record_operation("{{ label }}")
        {%- endif %}
    {%- endfor %}
{% endmacro %}
