{% from "action_statements.j2" import action_statements %}
{% from "position_expression.j2" import position_expression %}
{% from "method_invocation.j2" import invoke_method %}
{% from "triggered_action_execution.j2" import run_inits %}
{% from "callee_binding_plans.j2" import callee_binding_plan_body %}
{% macro action_fragment_body(fragment) %}
    {% if fragment.guarantee_dependent_destroy_position is not none %}
        {% set destruction_position = fragment.guarantee_dependent_destroy_position %}
        self.{{ destruction_position.member_name }} = {{ position_expression(destruction_position.position) }}
    {% endif %}
{{ action_statements(fragment.statements) -}}
{{ run_inits(fragment.inits) -}}
    {% for callee_binding_plan in fragment.inline_callee_binding_plans %}
{{ callee_binding_plan_body(callee_binding_plan) -}}
    {% endfor %}
    {% if fragment.guarantee_name is not none %}
        self.guarantees.{{ fragment.guarantee_name }}.publish(
            self.scheduler,
        {% for method_name in fragment.fanout_continuation_method_names %}
            self.{{ method_name }},
        {% endfor %}
        )
    {% else %}
        {% for method_name in fragment.fanout_continuation_method_names %}
        {{ invoke_method(method_name, submit=not loop.last) }}
        {% endfor %}
    {% endif %}
{% endmacro %}
{% macro action_fragment_methods(fragments) %}
    {% for fragment in fragments %}

    def {{ fragment.method_name }}(self):
        {% if fragment.requires_join_check %}
        if not self.{{ fragment.join_member_name }}.arrive():
            return
        {% endif %}
        {% if fragment.continue_destroy_method_name %}
        literal.continue_destruction(self.{{ fragment.continue_destroy_method_name }})
        {% else %}
{{ action_fragment_body(fragment) -}}
        {% endif %}
        {% if fragment.continue_destroy_method_name %}

    def {{ fragment.continue_destroy_method_name }}(self):
{{ action_fragment_body(fragment) -}}
        {% endif %}
    {% endfor %}
{% endmacro %}
