{% import "action_statements.j2" as statements -%}
{% import "position_expression.j2" as expressions -%}
{% if let Some(contract_class_name) = self.contract_class_name -%}
class {{ contract_class_name }}:
    {%- for name in self.contract_methods %}
    def {{ name }}(self, _particle: literal.Particle):
        pass
    {%~ endfor %}

_DEFAULT_DESTRUCTION_CONTRACTS = {{ contract_class_name }}()


{% endif -%}
class {{ self.class_name }}(literal.Action):
{%- if !self.implied_qualities.is_empty() %}
    implied_qualities: ClassVar[tuple[type[literal.Quality], ...]] = (
    {%- for class_reference in self.implied_qualities %}
        {{ class_reference.name_in_module(module_name) }},
    {%- endfor %}
    )
{%- endif %}
{% if !self.interface_positions.is_empty() %}
    def __init__(self, on_particle: literal.Particle):
        super().__init__(
            on_particle,
            interface_positions=[
    {%- for iface in self.interface_positions %}
        {%- if !iface.constraints.is_empty() %}
                literal.LocalPosition[{{ iface.value_type }}](
                    "{{ iface.typed_name }}",
                    constraints=(
            {%- for class_reference in iface.constraints %}
                        {{ class_reference.name_in_module(module_name) }},
            {%- endfor %}
                    ),
                ),
        {%- else %}
                literal.LocalPosition[{{ iface.value_type }}]("{{ iface.typed_name }}"),
        {%- endif %}
    {%- endfor %}
            ],
        )
{% endif %}
    @override
{%- if let Some(contract_class_name) = self.contract_class_name %}
    def run(self, destruction_contracts: {{ contract_class_name }} = _DEFAULT_DESTRUCTION_CONTRACTS):
{%- else %}
    def run(self):
{%- endif %}
{{- statements::action_statements(self.statements, module_name) -}}

{% for contract in self.contract_definitions -%}
{{ "\n\n" }}class {{ contract.class_name }}({{ contract.base.name_in_module(module_name) }}):
    {%- if !contract.forwarded_methods.is_empty() %}
    def __init__(
        self,
        {%- for method in contract.forwarded_methods %}
        {{ method }}: literal.DestructionContribution,
        {%- endfor %}
    ):
        {%- for method in contract.forwarded_methods %}
        self._{{ method }}: literal.DestructionContribution = {{ method }}
        {%- endfor %}
    {%- endif %}
    {%~ for method in contract.methods %}
    @override
    def {{ method.name }}(self, particle: literal.Particle):
        {%- for forwarded in method.forwarded %}
        self._{{ forwarded.method_name }}(
            {%- if let Some(position) = forwarded.position %}
            {{ expressions::position_expression(position, "    ", module_name) }}.particle
            {%- else %}
            particle
            {%- endif %}
        )
        {%- endfor %}
{{- statements::action_statements(method.statements, module_name) -}}
    {%- endfor %}
{%- endfor %}
