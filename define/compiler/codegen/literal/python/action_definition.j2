{% from "action_execution.j2" import action_execution %}
{% from "action_guarantees.j2" import action_guarantees %}
{% from "file_header.j2" import file_header %}
{% macro action_base_class(role) -%}
    {%- if role == ActionRole.ENTRY_POINT -%}
literal.EntryPoint
    {%- else -%}
literal.Action
    {%- endif -%}
{%- endmacro %}
{{ file_header(definition, needs_final=true, needs_override=definition.role.has_execute_method) }}

class {{ definition.class_name }}({{ action_base_class(definition.role) }}):
    {% if definition.implied_qualities %}
    implied_qualities: ClassVar[tuple[type[literal.Quality], ...]] = (
        {% for class_reference in definition.implied_qualities %}
        {{ class_reference.module_name }}.{{ class_reference.class_name }},
        {% endfor %}
    )
    {% endif %}
    {% if definition.interface_positions %}

    def __init__(self, on_particle: literal.Particle):
        super().__init__(
            on_particle,
            interface_positions=[
        {% for iface in definition.interface_positions %}
            {% if iface.constraints %}
                literal.LocalPosition(
                    "{{ iface.typed_name }}",
                    constraints=(
                {% for class_reference in iface.constraints %}
                        {{ class_reference.module_name }}.{{ class_reference.class_name }},
                {% endfor %}
                    ),
                    scheduler=on_particle.scheduler,
                ),
            {% else %}
                literal.LocalPosition(
                    "{{ iface.typed_name }}",
                    scheduler=on_particle.scheduler,
                ),
            {% endif %}
        {% endfor %}
            ],
        )
    {% endif %}
    {% if definition.role.has_execute_method %}

    @override
    def execute(self, scheduler: literal.Scheduler):
        execution = {{ definition.execution.execution_class_name }}(
        {% if definition.execution.needs_action %}
            self,
        {% endif %}
            scheduler,
        {% if definition.trace_operations %}
            None,
            "{{ definition.trace_action_name }}",
        {% endif %}
        {% if definition.execution.needs_guarantees %}
            {{ definition.execution.guarantees.class_name }}(),
        {% endif %}
        )
        {% for fragment_method_name in definition.execute_method_names %}
            {% if loop.last %}
        execution.{{ fragment_method_name }}()
            {% else %}
        execution.scheduler.submit(execution.{{ fragment_method_name }})
            {% endif %}
        {% endfor %}
    {% endif %}
    {% if not definition.role.has_execute_method and not definition.interface_positions and not definition.needs_classvar %}
    pass
    {% endif %}
{{ action_guarantees(definition.execution.guarantees) }}
{{ action_execution(definition.class_name, definition.execution) -}}
