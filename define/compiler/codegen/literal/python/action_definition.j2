{% from "file_header.j2" import file_header %}
{% from "action_statements.j2" import action_statements %}
{% from "position_expression.j2" import position_expression %}
{{ file_header(definition, needs_override=true) }}

{% if definition.contract_class_name %}
class {{ definition.contract_class_name }}:
    {% for name in definition.contract_methods %}
    def {{ name }}(self, _particle: literal.Particle):
        pass

    {% endfor %}

_DEFAULT_DESTRUCTION_CONTRACTS = {{ definition.contract_class_name }}()


{% endif %}
class {{ definition.class_name }}(literal.Action):
{% if definition.implied_qualities %}
    implied_qualities: ClassVar[tuple[type[literal.Quality], ...]] = (
    {% for class_reference in definition.implied_qualities %}
        {{ class_reference.module_name }}.{{ class_reference.class_name }},
    {% endfor %}
    )
{% endif %}
{% if definition.interface_positions %}

    def __init__(self, on_particle: literal.Particle):
        super().__init__(
            on_particle,
            interface_positions=[
    {% for iface in definition.interface_positions %}
        {% if iface.constraints %}
                literal.LocalPosition(
                    "{{ iface.typed_name }}",
                    constraints=(
            {% for class_reference in iface.constraints %}
                        {{ class_reference.module_name }}.{{ class_reference.class_name }},
            {% endfor %}
                    ),
                ),
        {% else %}
                literal.LocalPosition("{{ iface.typed_name }}"),
        {% endif %}
    {% endfor %}
            ],
        )
{% endif %}

    @override
{% if definition.contract_class_name %}
    def run(self, destruction_contracts: {{ definition.contract_class_name }} = _DEFAULT_DESTRUCTION_CONTRACTS):
{% else %}
    def run(self):
{% endif %}
{{ action_statements(definition.statements) -}}


{% for contract in definition.contract_definitions %}
{{ "\n\n" -}}
class {{ contract.class_name }}({{ contract.base.module_name }}.{{ contract.base.class_name }}):
    {% if contract.forwarded_methods %}
    def __init__(
        self,
        {% for method in contract.forwarded_methods %}
        {{ method }}: literal.DestructionContribution,
        {% endfor %}
    ):
        {% for method in contract.forwarded_methods %}
        self._{{ method }}: literal.DestructionContribution = {{ method }}
        {% endfor %}
    {% endif %}
    {% for method in contract.methods %}

    @override
    def {{ method.name }}(self, particle: literal.Particle):
        {% for forwarded in method.forwarded %}
        self._{{ forwarded.method_name }}(
            {% if forwarded.position is not none %}
            {{ position_expression(forwarded.position, "    ") }}.particle
            {% else %}
            particle
            {% endif %}
        )
        {% endfor %}
{{ action_statements(method.statements) -}}
    {% endfor %}
{% endfor %}
