class {{ action.class_name }}(literal.Action):
    _typed_name: ClassVar[str] = "{{ action.typed_name }}"
{% if action.has_body %}

    def __init__(self):
        super().__init__(
            interface_positions=[
{% for iface in action.interface_positions %}
{% if iface.constraint_class_names %}
                literal.InterfacePosition(
                    "{{ iface.typed_name }}",
                    constraints=[
{% for name in iface.constraint_class_names %}
                        {{ name }},
{% endfor %}
                    ],
                ),
{% else %}
                literal.InterfacePosition("{{ iface.typed_name }}"),
{% endif %}
{% endfor %}
            ],
            trigger_position_name="{{ action.trigger_position_name }}",
        )

    @override
    def execute(self):
{% set statements = action.body_statements %}
{% include "action_statements.j2" %}
{% endif %}
