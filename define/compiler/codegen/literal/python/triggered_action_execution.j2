{% from "position_expression.j2" import position_expression %}
{% macro destruction_continuation(continuation) -%}
{{ continuation.execution_class.module_name }}.{{ continuation.execution_class.class_name }}.{{ continuation.member_name }}
{%- endmacro %}
{% macro initialize_action_execution(action_execution) %}
{% set destruction_connection_class = "tracing.DestructionConnection" if action_execution.trace_action_name is not none else "literal.DestructionConnection" %}
        {% for connection in action_execution.created_destruction_connections %}
        self.{{ connection.member_name }} = {{ destruction_connection_class }}(
            self.scheduler,
            {{ destruction_continuation(connection.destruction_continuation) }},
            {{ connection.expected_completions }},
            {% for method_name in connection.start_method_names %}
            self.{{ method_name }},
            {% endfor %}
        {% if action_execution.forwards_destruction_connections %}
            forwarded_connection=self.destruction_connections.connection({{ destruction_continuation(connection.destruction_continuation) }}) if self.destruction_connections is not None else None,
        {% endif %}
        )
        {% for registration in connection.destructor_guarantee_registrations %}
        self.guarantees.{{ registration.child_guarantees_name }}.{{ registration.guarantee_name }}.append(
            self.{{ connection.member_name }}.complete
        )
        {% endfor %}
        {% endfor %}
        {% if action_execution.created_destruction_connections %}
        self.{{ action_execution.destruction_connections_member_name }} = literal.DestructionConnections(
            {% for connection in action_execution.created_destruction_connections %}
            self.{{ connection.member_name }},
            {% endfor %}
            {% if action_execution.forwards_destruction_connections %}
            direct=self.destruction_connections,
            {% endif %}
        )
        {% endif %}
        self.{{ action_execution.execution_name }} = {{ action_execution.execution_class.module_name }}.{{ action_execution.execution_class.class_name }}(
        {% if action_execution.execution_needs_action %}
            {{ position_expression(action_execution.action_expression, extra_indent="    ") }},
        {% endif %}
            self.scheduler,
        {% if action_execution.trace_action_name is not none %}
            {% if action_execution.trace_parent_action_name is not none %}
            self.scheduler.execution_created(
                self.trace_execution,
                "{{ action_execution.trace_parent_action_name }}",
            ),
            {% else %}
            self.trace_execution,
            {% endif %}
            "{{ action_execution.trace_action_name }}",
        {% endif %}
        {% if action_execution.execution_needs_guarantees %}
            self.guarantees.{{ action_execution.child_guarantees_name }},
        {% endif %}
        {% if action_execution.destruction_connections_member_name %}
            destruction_connections=self.{{ action_execution.destruction_connections_member_name }},
        {% endif %}
        )
{% endmacro %}
{% macro destruction_contract_destructor_methods(action_executions) %}
    {% for action_execution in action_executions %}
    {% for connection in action_execution.created_destruction_connections %}
    {% for destructor in connection.destruction_contract_destructors %}

    def {{ destructor.trigger_method_name }}(self):
        execution = {{ destructor.execution_class.module_name }}.{{ destructor.execution_class.class_name }}(
            self.scheduler,
        {% if destructor.trace_action_name is not none %}
            self.{{ connection.member_name }}.trace_execution,
            "{{ destructor.trace_action_name }}",
        {% endif %}
        )
        execution.{{ destructor.action_parent_binding_method_name }}()
    {% endfor %}
    {% endfor %}
    {% endfor %}
{% endmacro %}
