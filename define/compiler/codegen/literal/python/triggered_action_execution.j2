{% from "position_expression.j2" import position_expression %}
{% from "join_value.j2" import join_value %}
{% from "guarantee_consumption.j2" import configure_guarantee_consumption %}
{% macro destruction_continuation(continuation) -%}
{{ continuation.execution_class.module_name }}.{{ continuation.execution_class.class_name }}.{{ continuation.member_name }}
{%- endmacro %}
{% macro _construct_action_execution(action_execution) %}
    {% set destruction_connection_class = "tracing.DestructionConnection" if action_execution.trace_action_name is not none else "literal.DestructionConnection" %}
    {% for connection in action_execution.created_destruction_connections %}
        self.{{ connection.member_name }} = {{ destruction_connection_class }}(
            self.scheduler,
            {{ connection.predecessor_count }},
        {% for method_name in connection.start_method_names %}
            self.{{ method_name }},
        {% endfor %}
        {% if action_execution.forwards_destruction_connections %}
            forwarded_connection=self.destruction_connections.connection({{ destruction_continuation(connection.destruction_continuation) }}) if self.destruction_connections is not None else None,
        {% endif %}
        )
    {% endfor %}
        self.{{ action_execution.execution_name }} = {{ action_execution.execution_class.module_name }}.{{ action_execution.execution_class.class_name }}(
    {% if action_execution.execution_needs_action %}
            {{ position_expression(action_execution.action_expression, extra_indent="    ") }},
    {% endif %}
            self.scheduler,
    {% if action_execution.trace_action_name is not none %}
        {% if action_execution.trace_parent_action_name is not none %}
            self.scheduler.execution_created(
                self.trace_execution,
                "{{ action_execution.trace_parent_action_name }}",
            ),
        {% else %}
            self.trace_execution,
        {% endif %}
            "{{ action_execution.trace_action_name }}",
    {% endif %}
    {% if action_execution.created_destruction_connections %}
            destruction_connections=literal.DestructionConnections(
            {
        {% for connection in action_execution.created_destruction_connections %}
                {{ destruction_continuation(connection.destruction_continuation) }}: self.{{ connection.member_name }},
        {% endfor %}
            },
        {% if action_execution.forwards_destruction_connections %}
            forwarded=self.destruction_connections,
        {% endif %}
            ),
    {% elif action_execution.forwards_destruction_connections %}
            destruction_connections=self.destruction_connections,
    {% endif %}
        )
{% endmacro %}
{% macro _configure_action_execution(action_execution) %}
    {% for assignment in action_execution.callee_join_assignments %}
        self.{{ action_execution.execution_name }}
            {%- for execution_member_name in assignment.execution_member_names -%}
.{{ execution_member_name }}
            {%- endfor -%}
.{{ assignment.member_name }} = {{ join_value(assignment.dependency_count, "self.scheduler") }}
    {% endfor %}
    {% for consumption in action_execution.guarantee_consumptions %}
        {% if consumption.init_method_name is not none %}
{{ configure_guarantee_consumption(consumption, "inits", consumption.init_method_name) -}}
        {% endif %}
        {% for method_name in consumption.consumer_method_names %}
{{ configure_guarantee_consumption(consumption, "consumers", method_name) -}}
        {% endfor %}
    {% endfor %}
{% endmacro %}
{% macro run_inits(inits) %}
    {% for action_execution in inits.action_executions %}
{{ _construct_action_execution(action_execution) -}}
{{ _configure_action_execution(action_execution) -}}
    {% endfor %}
    {% for method_name in inits.callee_binding_method_names %}
        self.{{ method_name }}()
    {% endfor %}
{% endmacro %}
{% macro init_methods(init_methods) %}
    {% for init_method in init_methods %}

    def {{ init_method.method_name }}(self):
{{ run_inits(init_method.inits) -}}
    {% endfor %}
{% endmacro %}
