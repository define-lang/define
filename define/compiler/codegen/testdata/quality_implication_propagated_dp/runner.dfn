define the potential action<my.domain.com:my_lib:/runner> {
    define the position<run>.
    define the position<wrapper> {
        it may only contain dimension points where {
            it has the action</middle>.
        }
    }
    it happens when {
        the position<run> has a dimension point.
    } and it does {
        create a dimension point in position<wrapper>::action</middle>::position<box>.
        create a dimension point in position<wrapper>::action</middle>::position<box>::action</inner>::position<input>.
        create a dimension point in position<wrapper>::action</middle>::position<run>.
    }
}
