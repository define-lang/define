define the potential action<my.domain.com:my_lib:/middle> {
    define the position<run>.
    define the position<box> {
        it may only contain dimension points where {
            it has the action</inner>.
        }
    }
    define the position<final> {
        it may only contain dimension points where {
            it has the position</implied>.
        }
    }
    it happens when {
        the position<run> has a dimension point.
    } and it does {
        create a dimension point in position<box>::action</inner>::position<run>.
        move the dimension point in position<box>::action</inner>::position<output> to position<final>.
    }
}
