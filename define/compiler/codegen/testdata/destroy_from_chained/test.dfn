define the potential position<my.domain.com:my_lib:/test> {
    it may only contain particles where {
        it has the action</act>.
    }
    after it is assigned {
        create a particle in position</test>.
        create a particle in position</test>::action</act>::position<chain_src>.
        create a particle in position</test>::action</act>::position<chain_src>::position</mid>.
        create a particle in position</test>::action</act>::position<chain_src>::position</mid>::position</end>.
        create a particle in position</test>::action</act>::position<trigger>.
    }
}
