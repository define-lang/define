define the potential position<my.domain.com:my_lib:/test> {
    it may only contain dimension points where {
        it has the action</runner>.
    }
    after it is assigned {
        create a dimension point in position</test>.
        create a dimension point in position</test>::action</runner>::position<wrap>.
        create a dimension point in position</test>::action</runner>::position<wrap>::position</mid>.
        create a dimension point in position</test>::action</runner>::position<wrap>::position</mid>::position</leaf>.
        create a dimension point in position</test>::action</runner>::position<run>.
    }
}
