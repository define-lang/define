define the potential position<my.domain.com:my_lib:/test> {
    after it is assigned {
        define the position<local_dest>.
        define the position<chain_start> {
            it may only contain particles where {
                it has the position</mid>.
            }
        }
        create a particle in position</test>.
        create a particle in position<chain_start>.
        create a particle in position<chain_start>::position</mid>.
        move the particle in position</test> to position<local_dest>.
        move the particle in position<local_dest> to position</test>.
        move the particle in position</test> to position<chain_start>::position</mid>::position</end>.
        move the particle in position<chain_start>::position</mid>::position</end> to position</test>.
    }
}
