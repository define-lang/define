define the potential position<my.domain.com:my_lib:/test> {
    it may only contain particles where {
        it has the action</outer>.
    }
    after it is assigned {
        create a particle in position</test>.
        create a particle in position</test>::action</outer>::position<middle_iface>.
        create a particle in position</test>::action</outer>::position<middle_iface>::action</middle>::position<inner_iface>.
        create a particle in position</test>::action</outer>::position<run>.
    }
}
