define the potential action<my.domain.com:my_lib:/runner> {
    define the position<run>.
    define the position<source> {
        it may only contain particles where {
            it has the position</implier>.
        }
    }
    define the position<dest> {
        it may only contain particles where {
            it has the position</transitive_implied>.
        }
    }
    it happens when {
        the position<run> has a particle.
    } and it does {
        create a particle in position<source>.
        create a particle in position<source>::position</implier>.
        destroy the particle in position<source>::position</implier>.
        move the particle in position<source> to position<dest>.
    }
}
