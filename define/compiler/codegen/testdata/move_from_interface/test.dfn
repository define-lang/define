define the potential position<my.domain.com:my_lib:/test> {
    it may only contain particles where {
        it has the action</act>.
    }
    after it is assigned {
        create a particle in position</test>.
        create a particle in position</test>::action</act>::position<chain_dest>.
        create a particle in position</test>::action</act>::position<chain_dest>::position</mid_dest>.
        create a particle in position</test>::action</act>::position<trigger>.
    }
}
