load("@rules_py//py:defs.bzl", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_library(
    name = "diagnostics",
    srcs = ["diagnostics.py"],
    visibility = [
        "//define/compiler:__subpackages__",
        "//define/testdata:__pkg__",
        "//tools:__pkg__",
        "//tools/generators:__pkg__",
    ],
    deps = [
        ":invisible_characters",
        "//defcl/python:errors",
        "//define/compiler:constants",
        "//define/compiler:name_types",
        "//define/compiler/validator/reference_graph:propagation_step",
        "//define/compiler/validator/structural/resolver:local_dependency_entry",
        "//source_rendering/python:rendering",
        "@pypi//msgspec",
    ],
)

py_library(
    name = "errors",
    srcs = ["__init__.py"],
)

py_library(
    name = "exceptions",
    srcs = ["exceptions.py"],
    visibility = ["//define/compiler:__subpackages__"],
    deps = [
        "//define/compiler:constants",
    ],
)

py_library(
    name = "invisible_characters",
    srcs = ["invisible_characters.py"],
    visibility = ["//define/compiler:__subpackages__"],
)

py_library(
    name = "parser_exceptions",
    srcs = ["parser_exceptions.py"],
    visibility = ["//define/compiler:__subpackages__"],
    deps = [
        ":exceptions",
        ":invisible_characters",
        "//define/compiler:constants",
        "//source_rendering/python:rendering",
    ],
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    deps = [
        ":diagnostics",
        ":errors",
        ":exceptions",
        ":invisible_characters",
        ":parser_exceptions",
    ],
)

check_build_file()
