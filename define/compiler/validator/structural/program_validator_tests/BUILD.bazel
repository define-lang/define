load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:format.bzl", "format_test")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_library(
    name = "init_py",
    srcs = ["__init__.py"],
)

# These test files each run in a fraction of a second, so a separate pytest
# process for each one spent most of its time starting up. Running them in one
# py_test is an exception to the one-rule-per-source-file convention.
py_test(
    name = "program_validator_tests",
    size = "small",
    srcs = [
        "action_operation_execution_test.py",
        "action_statements_block_test.py",
        "cross_fqun_walking_test.py",
        "destroy_particle_test.py",
        "diagnostic_collection_test.py",
        "duplicate_definitions_test.py",
        "duplicate_position_constraint_test.py",
        "encoding_definition_test.py",
        "encoding_operation_definition_test.py",
        "entry_action_test.py",
        "error_messages_test.py",
        "file_not_found_test.py",
        "file_validation_result_test.py",
        "fqun_mismatch_test.py",
        "global_name_walking_test.py",
        "local_name_conflicts_test.py",
        "move_particle_test.py",
        "name_format_positions_test.py",
        "non_filesystem_walk_test.py",
        "operation_definition_test.py",
        "operation_execution_test.py",
        "parallel_test.py",
        "path_mismatch_test.py",
        "position_constraint_references_test.py",
        "potential_literal_definition_test.py",
        "program_config_test.py",
        "quality_implication_test.py",
        "reserved_name_positions_test.py",
        "standard_library_test.py",
        "trigger_conditions_test.py",
        "universe_without_authority_test.py",
        "unreferenced_positions_test.py",
        "validation_timing_stats_test.py",
        "value_constraint_test.py",
        "value_definition_test.py",
        "value_setting_literal_test.py",
        "value_setting_test.py",
    ],
    data = [
        "//define/testdata/structural/action_operation_execution",
        "//define/testdata/structural/action_statements_block",
        "//define/testdata/structural/cross_fqun_walking",
        "//define/testdata/structural/destroy_particle",
        "//define/testdata/structural/diagnostic_collection",
        "//define/testdata/structural/duplicate_definitions",
        "//define/testdata/structural/duplicate_position_constraint",
        "//define/testdata/structural/encoding_definition",
        "//define/testdata/structural/encoding_operation_definition",
        "//define/testdata/structural/entry_action",
        "//define/testdata/structural/file_not_found",
        "//define/testdata/structural/fqun_mismatch",
        "//define/testdata/structural/global_name_walking",
        "//define/testdata/structural/local_name_conflicts",
        "//define/testdata/structural/move_particle",
        "//define/testdata/structural/name_format_positions",
        "//define/testdata/structural/non_filesystem_walk",
        "//define/testdata/structural/operation_definition",
        "//define/testdata/structural/operation_execution",
        "//define/testdata/structural/parallel",
        "//define/testdata/structural/path_mismatch",
        "//define/testdata/structural/position_constraint_references",
        "//define/testdata/structural/potential_literal_definition",
        "//define/testdata/structural/quality_implication",
        "//define/testdata/structural/reserved_name_positions",
        "//define/testdata/structural/standard_library",
        "//define/testdata/structural/trigger_conditions",
        "//define/testdata/structural/universe_without_authority",
        "//define/testdata/structural/unreferenced_positions",
        "//define/testdata/structural/value_constraint",
        "//define/testdata/structural/value_definition",
        "//define/testdata/structural/value_setting",
        "//define/testdata/structural/value_setting_literal",
    ],
    # Keep about 200 tests per shard.
    shard_count = 2,
    deps = [
        ":test_helpers",
        "//define/compiler:ast",
        "//define/compiler:config",
        "//define/compiler:conftest",
        "//define/compiler:name_types",
        "//define/compiler/data_structures:define_path",
        "//define/compiler/errors:diagnostics",
        "//define/compiler/errors:exceptions",
        "//define/compiler/errors:parser_exceptions",
        "//define/compiler/errors:source_map",
        "//define/compiler/validator:stats",
        "//define/compiler/validator:test_helpers",
        "//define/compiler/validator/structural:file_validator",
        "//define/compiler/validator/structural:program_validator",
        "@pypi//pytest",
    ],
)

py_library(
    name = "test_helpers",
    testonly = True,
    srcs = ["test_helpers.py"],
    deps = [
        "//define/compiler/parsing:parser",
        "//define/compiler/validator:test_helpers",
        "//define/compiler/validator:validation_result",
        "//define/compiler/validator/structural:program_validator",
        "@pypi//pytest",
    ],
)

filegroup(
    name = "test_sources",
    testonly = True,
    srcs = glob(["*_test.py"]),
    visibility = ["//define/testdata:__pkg__"],
)

# --- Format checking ---

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@multitool//tools/ruff",
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    deps = [
        ":init_py",
        ":program_validator_tests",
        ":test_helpers",
    ],
)

check_build_file()
