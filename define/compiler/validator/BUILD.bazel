load("@rules_py//py:defs.bzl", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_library(
    name = "scope_tracker",
    srcs = ["scope_tracker.py"],
    visibility = ["//define/compiler:__subpackages__"],
    deps = ["//define/compiler:ast"],
)

py_test(
    name = "scope_tracker_test",
    size = "small",
    srcs = ["scope_tracker_test.py"],
    deps = [
        ":scope_tracker",
        "//crates/source_rendering/python:rendering",
        "//define/compiler:ast",
        "//define/compiler:name_types",
        "@pypi//pytest",
    ],
)

py_library(
    name = "test_helpers",
    testonly = True,
    srcs = ["test_helpers.py"],
    visibility = ["//define/compiler:__subpackages__"],
    deps = [
        "//define/compiler:constants",
        "//define/compiler/data_structures:define_path",
        "//define/compiler/errors:diagnostics",
    ],
)

py_library(
    name = "validation_result",
    srcs = ["validation_result.py"],
    visibility = [
        "//define/compiler:__pkg__",
        "//define/compiler:__subpackages__",
    ],
    deps = [
        "//crates/source_rendering/python:rendering",
        "//define/compiler:ast",
        "//define/compiler/association_resolution:concrete_program",
        "//define/compiler/config:encoding_operations_config",
        "//define/compiler/data_structures:define_path",
        "//define/compiler/data_structures:typed_name_dict",
        "//define/compiler/errors:diagnostics",
        "//define/compiler/errors:syntax_errors",
        "//define/compiler/graphs:reference_graph",
        "//define/compiler/graphs:reference_graph_order",
        "//define/compiler/validator/reference_graph:action_contract",
        "@pypi//msgspec",
    ],
)

py_test(
    name = "validation_result_test",
    size = "small",
    srcs = ["validation_result_test.py"],
    deps = [
        ":validation_result",
        "//define/compiler:ast",
        "//define/compiler/data_structures:define_path",
        "//define/compiler/graphs:reference_graph",
        "//define/compiler/parsing:test_helpers",
    ],
)

py_library(
    name = "validator",
    srcs = ["__init__.py"],
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    deps = [
        ":scope_tracker",
        ":scope_tracker_test",
        ":test_helpers",
        ":validation_result",
        ":validation_result_test",
        ":validator",
    ],
)

check_build_file()
