load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//tools/bzl:format.bzl", "format_test")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

py_library(
    name = "literal",
    srcs = ["literal.py"],
    visibility = ["//define:__subpackages__"],
)

py_test(
    name = "literal_test",
    size = "small",
    srcs = ["literal_test.py"],
    deps = [
        ":literal",
        "@pypi//pytest",
    ],
)

py_library(
    name = "runtime",
    srcs = ["__init__.py"],
    visibility = ["//define:__subpackages__"],
)

# --- Format checking ---

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@multitool//tools/ruff",
)

# --- Type-checking ---

# IMPORTANT: When adding a new py_library, py_binary, or py_test target to this
# package, you must also add it to the deps list below.
pyright_test(
    name = "pyright_test",
    deps = [
        ":literal",
        ":literal_test",
        ":runtime",
    ],
)
