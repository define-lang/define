load("@rules_lean//lean:lean.bzl", "lean_axiom_test", "lean_library")

package(default_visibility = ["//proofs/operation_graph:__subpackages__"])

filegroup(
    name = "all_proofs",
    srcs = [
        ":definitions",
        ":operation_effects",
        ":particle_requirements",
        ":retained_requirements",
        ":vanishment_requirements",
    ],
)

lean_library(
    name = "definitions",
    srcs = ["definitions.lean"],
)

lean_axiom_test(
    name = "definitions_axioms_test",
    size = "small",
    allowed_axioms = [],
    imports = ["definitions"],
    theorems = [
        "Define.OperationGraph.acyclic_of_pointsBackward",
        "Define.OperationGraph.transitivelyMinimal_of_directDependenciesAreAntichains",
    ],
    deps = [":definitions"],
)

lean_library(
    name = "operation_effects",
    srcs = ["operation_effects.lean"],
)

lean_axiom_test(
    name = "operation_effects_axioms_test",
    size = "small",
    allowed_axioms = [
        "propext",
        "Classical.choice",
        "Quot.sound",
    ],
    imports = ["operation_effects"],
    theorems = [
        "Define.OperationGraph.ExactEffects.conflicting_enabled_pair_cannot_reverse",
        "Define.OperationGraph.ExactEffects.independent_apply_commutes",
        "Define.OperationGraph.ExactEffects.independent_enabled_exchange",
        "Define.OperationGraph.ExactEffects.independent_symm",
        "Define.OperationGraph.ExactEffects.unchanged_required_component",
    ],
    deps = [":operation_effects"],
)

lean_library(
    name = "particle_requirements",
    srcs = ["particle_requirements.lean"],
    deps = [":operation_effects"],
)

lean_library(
    name = "retained_requirements",
    srcs = ["retained_requirements.lean"],
    deps = [":operation_effects"],
)

lean_library(
    name = "vanishment_requirements",
    srcs = ["vanishment_requirements.lean"],
    deps = [":operation_effects"],
)

lean_axiom_test(
    name = "vanishment_requirements_axioms_test",
    size = "small",
    allowed_axioms = [
        "propext",
        "Classical.choice",
        "Quot.sound",
    ],
    imports = ["vanishment_requirements"],
    theorems = [
        "Define.OperationGraph.VanishmentRequirements.component_effect_valid",
        "Define.OperationGraph.VanishmentRequirements.use_enabled_iff",
        "Define.OperationGraph.VanishmentRequirements.vanish_enabled_iff",
        "Define.OperationGraph.VanishmentRequirements.vacate_preserves_existence",
        "Define.OperationGraph.VanishmentRequirements.vanish_preserves_vacancy",
        "Define.OperationGraph.VanishmentRequirements.use_after_vanish_invalid",
        "Define.OperationGraph.VanishmentRequirements.vacancy_and_use_independent",
        "Define.OperationGraph.VanishmentRequirements.vanish_conflicts_with_use",
        "Define.OperationGraph.VanishmentRequirements.vanish_conflicts_with_vacate",
        "Define.OperationGraph.VanishmentRequirements.combined_enabled_iff",
        "Define.OperationGraph.VanishmentRequirements.combined_apply_eq",
        "Define.OperationGraph.VanishmentRequirements.combined_effect_valid",
    ],
    deps = [":vanishment_requirements"],
)
