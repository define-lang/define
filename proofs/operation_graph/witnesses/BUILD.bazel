load("@rules_lean//lean:lean.bzl", "lean_axiom_test", "lean_library")

package(default_visibility = ["//proofs/operation_graph:__subpackages__"])

filegroup(
    name = "all_proofs",
    srcs = [
        ":destructor_order_choice",
    ],
)

lean_library(
    name = "destructor_order_choice",
    srcs = ["destructor_order_choice.lean"],
)

lean_axiom_test(
    name = "destructor_order_choice_axioms_test",
    size = "small",
    allowed_axioms = [
        "propext",
        "Classical.choice",
        "Quot.sound",
    ],
    imports = ["destructor_order_choice"],
    theorems = [
        "Define.OperationGraph.DestructorOrderChoice.both_serial_orders_restore_original_particle",
        "Define.OperationGraph.DestructorOrderChoice.common_precedence_is_respected_by_overlap",
        "Define.OperationGraph.DestructorOrderChoice.graph_admitting_both_orders_admits_overlap",
        "Define.OperationGraph.DestructorOrderChoice.no_graph_admits_both_orders_and_rejects_overlap",
        "Define.OperationGraph.DestructorOrderChoice.overlapping_moves_are_not_enabled",
        "Define.OperationGraph.DestructorOrderChoice.schedules_have_exactly_the_same_operations",
        "Define.OperationGraph.DestructorOrderChoice.sources_and_destinations_differ",
    ],
    deps = [":destructor_order_choice"],
)

