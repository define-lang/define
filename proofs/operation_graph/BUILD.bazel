load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@rules_lean//lean:lean.bzl", "lean_axiom_test", "lean_library")
load("//tools/bzl:format.bzl", "format_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

filegroup(
    name = "all_proofs",
    srcs = [
        ":completeness",
        ":definitions",
        ":independence_witnesses",
        ":maximum_safe_concurrency",
        ":minimality",
        ":minimality_witnesses",
        ":valid_history",
    ],
)

lean_library(
    name = "completeness",
    srcs = ["completeness.lean"],
    deps = [
        ":minimality",
        ":minimality_witnesses",
    ],
)

lean_axiom_test(
    name = "completeness_axioms_test",
    size = "small",
    allowed_axioms = [
        "propext",
        "Classical.choice",
        "Quot.sound",
    ],
    imports = ["completeness"],
    theorems = [
        "Define.OperationGraph.CompleteResolvedDefineGraph.reaches_of_relatedPrevious",
        "Define.OperationGraph.CompleteResolvedDefineGraph.reaches_iff_reaches_relatedPrevious",
        "Define.OperationGraph.CompleteResolvedDefineGraph.dependency_is_unique",
        "Define.OperationGraph.CompleteResolvedDefineGraph.dependency_isOrdinary",
    ],
    deps = [":completeness"],
)

lean_library(
    name = "definitions",
    srcs = ["definitions.lean"],
)

lean_axiom_test(
    name = "definitions_axioms_test",
    size = "small",
    allowed_axioms = [],
    imports = ["definitions"],
    theorems = [
        "Define.OperationGraph.acyclic_of_pointsBackward",
        "Define.OperationGraph.parentOrSame_antisymm",
        "Define.OperationGraph.transitivelyMinimal_of_directDependenciesAreAntichains",
    ],
    deps = [":definitions"],
)

lean_library(
    name = "independence_witnesses",
    srcs = ["independence_witnesses.lean"],
    deps = [":completeness"],
)

lean_axiom_test(
    name = "independence_witnesses_axioms_test",
    size = "small",
    allowed_axioms = [],
    imports = ["independence_witnesses"],
    theorems = [
        "Define.OperationGraph.IndependenceWitnesses.FillRuleParentPositions.weakened_misses_required_ordering",
        "Define.OperationGraph.IndependenceWitnesses.FillRuleMostRecent.weakened_misses_required_ordering",
        "Define.OperationGraph.IndependenceWitnesses.EmptyRuleChildPositions.weakened_misses_required_ordering",
        "Define.OperationGraph.IndependenceWitnesses.MoveChildEntries.weakened_not_transitively_minimal",
        "Define.OperationGraph.IndependenceWitnesses.ComparisonSimultaneity.weakened_not_transitively_minimal",
        "Define.OperationGraph.IndependenceWitnesses.MoveCorrection.weakened_not_transitively_minimal",
        "Define.OperationGraph.IndependenceWitnesses.FillDependencyRemoval.weakened_not_transitively_minimal",
        "Define.OperationGraph.IndependenceWitnesses.ActionParentOnlyAsFallback.weakened_not_transitively_minimal",
    ],
    deps = [":independence_witnesses"],
)

lean_library(
    name = "maximum_safe_concurrency",
    srcs = ["maximum_safe_concurrency.lean"],
    deps = [":completeness"],
)

lean_axiom_test(
    name = "maximum_safe_concurrency_axioms_test",
    size = "small",
    allowed_axioms = [
        "propext",
        "Classical.choice",
        "Quot.sound",
    ],
    imports = ["maximum_safe_concurrency"],
    theorems = ["Define.OperationGraph.occupancyAfter_comm"],
    deps = [":maximum_safe_concurrency"],
)

lean_library(
    name = "minimality",
    srcs = ["minimality.lean"],
    deps = [":valid_history"],
)

lean_axiom_test(
    name = "minimality_axioms_test",
    size = "small",
