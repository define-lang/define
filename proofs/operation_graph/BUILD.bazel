load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@rules_lean//lean:lean.bzl", "lean_library")
load("//tools/bzl:format.bzl", "format_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

lean_library(
    name = "minimality",
    srcs = ["minimality.lean"],
)

lean_library(
    name = "minimality_witnesses",
    srcs = ["minimality_witnesses.lean"],
    deps = [":minimality"],
)

py_binary(
    name = "minimality_checker",
    srcs = ["minimality_checker.py"],
    deps = ["@pypi//click"],
)

# --- Format checking ---

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@multitool//tools/ruff",
)

# --- Type-checking ---

# IMPORTANT: When adding a new py_library, py_binary, or py_test target to this
# package, you must also add it to the deps list below.
pyright_test(
    name = "pyright_test",
    deps = [
        ":minimality_checker",
    ],
)
