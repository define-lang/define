        "Define.OperationGraph.NonVacuity.exact_dependency",
        "Define.OperationGraph.ActionParentRule.exact_dependency",
        "Define.OperationGraph.VanishedChildName.exact_dependency",
        "Define.OperationGraph.MovedChildEntry.exact_dependency",
        "Define.OperationGraph.FillDependencyRemoval.exact_dependency",
    ],
    deps = [":minimality_witnesses"],
