load("@rules_py//py:defs.bzl", "py_library")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyo3.bzl", "pyo3_extension")
load("//tools/bzl:pyright.bzl", "pyright_test")
load("//tools/bzl:rust.bzl", "lint_config")

rust_library(
    name = "capsule",
    srcs = ["capsule.rs"],
    crate_name = "source_rendering_capsule",
    crate_root = "capsule.rs",
    lint_config = lint_config(),
    visibility = [
        "//defcl/python:__pkg__",
        "//define/compiler/parsing:__pkg__",
    ],
    deps = [
        "//source_rendering/rust:source_rendering",
        "@crates//:pyo3",
    ],
)

py_library(
    name = "python",
    srcs = ["__init__.py"],
    deps = ["//source_rendering"],
)

py_library(
    name = "rendering",
    srcs = ["rendering.pyi"],
    visibility = [
        "//defcl:__subpackages__",
        "//define:__subpackages__",
        "//tools:__subpackages__",
    ],
    deps = [
        ":rendering_extension",  # keep
    ],
)

pyo3_extension(
    name = "rendering_extension",
    srcs = ["rendering_extension.rs"],
    crate_root = "rendering_extension.rs",
    module_name = "rendering",
    stubs = False,
    visibility = ["//tools:__pkg__"],
    deps = [
        ":capsule",
        "//source_rendering/rust:source_rendering",
        "@crates//:rustc-hash",
    ],
)

py_test(
    name = "rendering_test",
    size = "small",
    srcs = ["rendering_test.py"],
    deps = [":rendering"],
)

# --- Linting ---

rust_clippy_test(
    name = "clippy_test",
    size = "small",
    tags = [
        "clippy",
        "precommit",
    ],
    targets = [
        ":capsule",
        ":rendering_extension_shared",
    ],
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    deps = [
        ":python",
        ":rendering",
        ":rendering_test",
    ],
)

check_build_file()
