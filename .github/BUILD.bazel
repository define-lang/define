load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")

filegroup(
    name = "github_workflows",
    srcs = glob(["workflows/*.yaml"]),
)

# The script checkers are pinned because jactionlint otherwise uses whatever
# shellcheck and pyflakes happen to be on PATH.
native_test(
    name = "jactionlint_test",
    size = "small",
    src = "@multitool//tools/jactionlint",
    out = "jactionlint_test_runner",
    args = [
        "--no-color",
        "--no-online",
        "--shellcheck=$(rootpath @multitool//tools/shellcheck)",
        "--ruff=$(rootpath @multitool//tools/ruff)",
        "$(rootpaths :github_workflows)",
    ],
    data = [
        ":github_workflows",
        "@multitool//tools/ruff",
        "@multitool//tools/shellcheck",
    ],
)

check_build_file()
