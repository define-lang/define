load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

filegroup(
    name = "github_workflows",
    srcs = glob(["workflows/*.yaml"]),
)

# Runs every rule, including those that ask the GitHub API, which a sandboxed
# test cannot reach.
py_binary(
    name = "jactionlint_online",
    srcs = ["jactionlint_online.py"],
    args = [
        "$(rlocationpath @multitool//tools/jactionlint)",
        "$(rlocationpath @multitool//tools/shellcheck)",
        "$(rlocationpath @multitool//tools/ruff)",
    ],
    data = [
        "@multitool//tools/jactionlint",
        "@multitool//tools/ruff",
        "@multitool//tools/shellcheck",
    ],
    deps = ["//tools:runfiles"],
)

# The script checkers are pinned because jactionlint otherwise uses whatever
# shellcheck and pyflakes happen to be on PATH.
py_test(
    name = "jactionlint_test",
    size = "small",
    srcs = ["jactionlint_test.py"],
    data = [
        "jactionlint.yaml",
        ":github_workflows",
        "@multitool//tools/jactionlint",
        "@multitool//tools/ruff",
        "@multitool//tools/shellcheck",
    ],
    env = {
        "GITHUB_WORKFLOWS": "$(rlocationpaths :github_workflows)",
        "JACTIONLINT": "$(rlocationpath @multitool//tools/jactionlint)",
        "JACTIONLINT_CONFIG": "$(rlocationpath jactionlint.yaml)",
        "RUFF": "$(rlocationpath @multitool//tools/ruff)",
        "SHELLCHECK": "$(rlocationpath @multitool//tools/shellcheck)",
    },
    deps = ["//tools:runfiles"],
)

pyright_test(
    name = "pyright_test",
    deps = [
        ":jactionlint_online",
        ":jactionlint_test",
    ],
)

check_build_file()
