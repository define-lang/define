load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:format.bzl", "format_test")

filegroup(
    name = "typestubs",
    srcs = glob(["**/*.pyi"]),
    tags = ["lint-with-ruff"],
    visibility = ["//visibility:public"],
)

format_test(
    name = "format_test",
    size = "small",
    srcs = glob(["**/*.pyi"]),
    python = "@multitool//tools/ruff",
)

check_build_file()
