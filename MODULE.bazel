module(
    name = "define",
    version = "0.0.1",
)

# --- Core dependencies ---

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_python", version = "1.8.3")
bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "33.5")
bazel_dep(name = "aspect_rules_py", version = "1.8.4")
bazel_dep(name = "rules_buf", version = "0.5.2")

# --- Python toolchain ---

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
)

# --- Python pip dependencies ---

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "compiler_pip",
    python_version = "3.12",
    requirements_lock = "//compiler:requirements.txt",
)
pip.parse(
    hub_name = "defcl_pip",
    python_version = "3.12",
    requirements_lock = "//defcl:requirements.txt",
)
pip.parse(
    hub_name = "compiler_test_pip",
    python_version = "3.12",
    requirements_lock = "//compiler:requirements_test.txt",
)
pip.parse(
    hub_name = "scripts_pip",
    python_version = "3.12",
    requirements_lock = "//scripts:requirements.txt",
)
use_repo(pip, "compiler_pip", "compiler_test_pip", "defcl_pip", "scripts_pip")

# --- Go SDK ---

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.7")

# --- Go dependencies from go.mod ---

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//defcl/buf:go.mod")
go_deps.gazelle_override(
    directives = [
        "gazelle:exclude wellknownimports/google/protobuf/compiler",
    ],
    path = "github.com/bufbuild/protocompile",
)
use_repo(go_deps, "build_buf_go_bufplugin", "org_golang_google_protobuf")

# --- uv toolchain (dev only, for lock file generation) ---

uv = use_extension(
    "@rules_python//python/uv:uv.bzl",
    "uv",
    dev_dependency = True,
)
uv.configure()

# --- Buf toolchain ---

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(version = "v1.65.0")
use_repo(buf, "rules_buf_toolchains")
