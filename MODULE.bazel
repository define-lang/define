module(
    name = "define",
    version = "0.0.1",
)

register_toolchains("//tools/bzl:python_toolchain_toolchain")

# --- Core dependencies ---

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "2.4.4")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_rs", version = "0.1.3")
bazel_dep(name = "llvm", version = "0.8.25")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "protovalidate", version = "1.2.2")
bazel_dep(name = "re2", version = "2025-11-05")
bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.6")
bazel_dep(name = "rules_buf", version = "0.5.4")
bazel_dep(name = "rules_multitool", version = "1.11.1")
bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "rules_nodejs", version = "6.7.7")

# Transitive overrides
bazel_dep(name = "rules_android", version = "0.8.0")  # Fix build breakage
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")  # Bazel 9 compat
bazel_dep(name = "with_cfg.bzl", version = "1.0.1")  # incompatible_stop_exporting_language_modules

local_path_override(
    module_name = "re2",
    path = "vendored/re2",
)

# TODO: Upgrade to an aspect_rules_py release with PR #1538 and remove this override.
# Windows free-threaded CPython's headers need Py_GIL_DISABLED defined for
# extensions to compile for the interpreter's ABI, which this patch adds.
# TODO: Remove the patch once an aspect_rules_py release includes
# https://github.com/aspect-build/rules_py/pull/1611.
# Windows CPython reads only a venv's Lib/site-packages, and it resolves a
# relative pyvenv.cfg home against its startup directory rather than the venv,
# so Python in a Windows venv finds neither its packages nor its stdlib. The
# venv layout patch puts site-packages and home where Windows CPython expects.
# TODO: Remove the venv layout patch once an aspect_rules_py release includes
# https://github.com/aspect-build/rules_py/pull/1614.
# Windows fails to load an extension module with an embedded manifest from a
# path longer than about 250 characters, even with long paths enabled, and
# Bazel's runfiles paths are often longer. The long extension paths patch loads
# such modules through extended-length paths.
# TODO: Remove the long extension paths patch once an aspect_rules_py release
# includes https://github.com/aspect-build/rules_py/pull/1625.
git_override(
    module_name = "aspect_rules_py",
    commit = "a75335de5bb06f0cdafb3653800a67e93f653906",
    patch_strip = 1,
    patches = [
        "//tools/patches:aspect_rules_py_windows_free_threaded_headers.patch",
        "//tools/patches:aspect_rules_py_windows_venv_layout.patch",
        "//tools/patches:aspect_rules_py_windows_long_extension_paths.patch",
    ],
    remote = "https://github.com/aspect-build/rules_py.git",
)

# The MSVC toolchain's case-insensitive SDK overlays need a tool that a Windows
# execution platform can only build with that same toolchain, so building on
# Windows with MSVC fails with a dependency cycle. The overlay patch is
# https://github.com/hermeticbuild/hermetic-llvm/pull/853, which omits the
# overlays on Windows execution platforms.
# TODO: Remove the overlay patch once an llvm release after 0.8.25 includes it.
# The libc crate links the MSVC runtime's legacy_stdio_definitions.lib, which
# the other patch exposes to links.
# TODO: Remove the legacy_stdio_definitions.lib patch once an llvm release
# includes https://github.com/hermeticbuild/hermetic-llvm/pull/864.
single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = [
        "//tools/patches:llvm_msvc_legacy_stdio_definitions.patch",
        "//tools/patches:llvm_windows_exec_sdk_case_overlays.patch",
    ],
)

# --- Python toolchain ---

interpreters = use_extension("@aspect_rules_py//py:extensions.bzl", "python_interpreters")
interpreters.configure(releases = ["20261020"])
interpreters.toolchain(
    python_version = "3.14",
)
use_repo(interpreters, "python_interpreters")

register_toolchains("@python_interpreters//:all")

# The libc and its version that aspect_rules_py detects on the host, which
# //tools/platforms:local_linux_for_windows_cross gives tools it builds.
# TODO: Remove this once aspect_rules_py fixes
# https://github.com/aspect-build/rules_py/issues/1574.
rules_py_host = use_extension("@aspect_rules_py//uv/private/host:extension.bzl", "host_platform")
use_repo(rules_py_host, "aspect_rules_py_uv_host")

# --- Python pip dependencies (via aspect_rules_py uv) ---

pypi = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv")
pypi.declare_hub(hub_name = "pypi")
pypi.project(
    hub_name = "pypi",
    lock = "//:uv.lock",
    pyproject = "//:pyproject.toml",
)
pypi.annotate_packages(
    src = "//:python_build_annotations.toml",
    lock = "//:uv.lock",
)

# The PyPI wheel's abi3 extension segfaults when imported by free-threaded CPython.
# TODO: Use the PyPI package when protobuf supports free-threaded CPython:
# https://github.com/protocolbuffers/protobuf/issues/23158
pypi.override_package(
    name = "protobuf",
    lock = "//:uv.lock",
    target = "@protobuf//:protobuf_python",
)
pypi.override_package(
    name = "google-re2",
    lock = "//:uv.lock",
    target = "@re2//python:re2",
)
use_repo(pypi, "pypi")

# --- Rust toolchain and locked Cargo dependencies ---

rust_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust_toolchains.toolchain(
    edition = "2024",
    version = "1.99.1",
)
use_repo(rust_toolchains, "default_rust_toolchains")

register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
)

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")

# pyo3_extension passes its extra arguments to both the Rust shared library and
# the Python library it creates, so it cannot take cc_runtime_linkage, which only
# the Rust shared library accepts. This patch forwards cc_runtime_linkage to the
# Rust shared library alone.
# TODO: Remove this patch once a rules_rs release includes
# https://github.com/hermeticbuild/rules_rust/pull/89.
rules_rust.patch(
    patches = ["//tools/patches:rules_rust_pyo3_cc_runtime_linkage.patch"],
    strip = 1,
)

# On Windows MSVC targets, the hermetic LLVM toolchain links through clang-cl,
# but rustc passes link.exe arguments that only lld-link accepts. This patch
# makes rustc link with clang-cl's lld-link.
# TODO: Remove this patch once a rules_rs release includes
# https://github.com/hermeticbuild/rules_rust/pull/92.
rules_rust.patch(
    patches = ["//tools/patches:rules_rust_msvc_lld_link.patch"],
    strip = 1,
)

# On Windows, Python's import library is a cc_import interface library, which
# the PyO3 toolchain does not search when it looks for Python libraries.
# TODO: Remove this patch once a rules_rs release includes
# https://github.com/bazelbuild/rules_rust/pull/4341.
rules_rust.patch(
    patches = ["//tools/patches:rules_rust_pyo3_interface_library.patch"],
    strip = 1,
)

# rules_rust's coverage collector for Rust tests reports only lines, since
# stable Rust has no branch coverage, and Rust tests cannot use another one.
# This patch adds a flag that chooses it, which .bazelrc sets to the one that
# also reports code regions.
# TODO: Remove this patch once rules_rust lets a test choose its coverage
# collector.
rules_rust.patch(
    patches = ["//tools/patches:rules_rust_coverage_collector_flag.patch"],
    strip = 1,
)
use_repo(rules_rust, "rules_rust")

rules_rust_pyo3 = use_extension("@rules_rs//rs:rules_rust_pyo3.bzl", "rules_rust_pyo3")
use_repo(rules_rust_pyo3, "rules_rust_pyo3")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")

# The crate extension forwards these strings to generated external repositories,
# so the labels must identify the canonical main repository.
# buildifier: disable=canonical-repository
crate.annotation(
    build_script_data = ["@@//tools:pyo3_config_file"],
    build_script_env = {"PYO3_CONFIG_FILE": "$(execpath @@//tools:pyo3_config_file)"},
    crate = "pyo3-ffi",
)

# buildifier: disable=canonical-repository
crate.annotation(
    build_script_data = ["@@//tools:pyo3_config_file"],
    build_script_env = {"PYO3_CONFIG_FILE": "$(execpath @@//tools:pyo3_config_file)"},
    crate = "pyo3",
)
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    generate_lint_config = True,
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

register_toolchains("//tools/bzl:rust_pyo3_toolchain")

register_toolchains(
    "@rules_rust_pyo3//toolchains:toolchain",
)

# --- Go SDK ---

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.3")

# --- Go dependencies from go.mod ---

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//defcl/buf:go.mod")
go_deps.gazelle_override(
    directives = [
        "gazelle:exclude wellknownimports/google/protobuf/compiler",
    ],
    path = "github.com/bufbuild/protocompile",
)

# On Windows, checktest marks a FilePaths entry in a subdirectory as an import,
# so rules that skip imports never check it.
# TODO: Remove this patch once a bufplugin release includes
# https://github.com/bufbuild/bufplugin-go/pull/34.
go_deps.module_override(
    patch_strip = 1,
    patches = ["//tools/patches:bufplugin_checktest_windows_file_paths.patch"],
    path = "buf.build/go/bufplugin",
)
use_repo(go_deps, "build_buf_go_bufplugin", "org_golang_google_protobuf")

# --- Buf toolchain ---

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(
    sha256 = "ca4df0bbe2327eaaca4eda4035b49164b2a7fd47f42345bfa4a126b4c28f1efb",
    version = "v1.74.0",
)
use_repo(buf, "rules_buf_toolchains")

# --- Multitool (ruff, uv binaries) ---

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//tools:multitool.lock.json")
use_repo(multitool, "multitool")

# --- dprint plugins ---

dprint = use_extension("//tools/rules_dprint:extensions.bzl", "dprint")
dprint.plugins(config = "//:dprint.jsonc")
use_repo(dprint, "dprint_plugins")

# --- NodeJS ---

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.22.1")

# Translate the pnpm-lock.yaml file to bazel targets
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

# Allows developers to use the matching pnpm version, for example:
# bazel run -- @pnpm --dir /home/runner/work/rules_js/rules_js install
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
use_repo(pnpm, "pnpm")
