# Avoid sizing the initial JVM heap from host RAM: 256 MiB is sufficient to
# start regular full-suite runs, and the heap can grow as needed.
startup --host_jvm_args=-Xms256m
# Let idle servers return more freed heap to the OS. Below 20, the savings are
# negligible.
startup --host_jvm_args=-XX:MinHeapFreeRatio=20
startup --host_jvm_args=-XX:MaxHeapFreeRatio=20

# Build for Windows with the native MSVC ABI.
common --enable_platform_specific_config
common:windows --host_platform=//tools/platforms:local_windows_msvc
# The hermetic MSVC toolchain downloads Microsoft's Visual C++ runtime, which
# it fetches only after this confirms the right to use it under
# https://visualstudio.microsoft.com/license-terms.
common:windows --repo_env=BAZEL_MSVC_RUNTIME_VISUAL_STUDIO_EULA=1
# Windows Bazel gives programs only a runfiles manifest by default, and
# aspect_rules_py's virtualenvs and our tests need a runfiles directory. Creating
# its symlinks requires Windows Developer Mode or administrator rights.
common:windows --enable_runfiles
# Without this, Bazel on Windows creates junctions in place of symlinks, and a
# junction to a file, such as a virtualenv's link to python.exe, can't run. It
# requires the same rights as runfiles directories.
startup:windows --windows_enable_symlinks

# Build for Windows from Linux.
build:windows_cross --platforms=//tools/platforms:windows_x86_64_msvc
build:windows_cross --host_platform=//tools/platforms:local_linux_for_windows_cross
# common:windows applies only on Windows hosts, but Windows programs built from
# Linux need runfiles directories for the same reasons.
build:windows_cross --enable_runfiles
# rules_js's default Windows launcher runs bash at the path a Linux host assumes
# for it, c:/msys64/usr/bin/bash.exe, so it fails wherever bash is elsewhere.
build:windows_cross --@aspect_rules_js//js:use_hermetic_launcher
common:windows_cross --repo_env=BAZEL_MSVC_RUNTIME_VISUAL_STUDIO_EULA=1

# Build for Windows here, and run the tests on the Windows VM; see
# tools/windows_vm/README.md.
build:windows_vm --config=windows_cross
build:windows_vm --remote_executor=grpc://localhost:2223
# Linux Bazel has no tw.exe or xml.exe, which Windows test actions run. See
# //tools/windows_vm:bazel_tools_override, which makes this directory.
build:windows_vm --override_repository=bazel_tools=%workspace%/.windows_vm/bazel_tools
# The released Windows launcher template lacks fixes that the tests need. See
# //tools/windows_vm:hermetic_launcher_override, which makes this directory.
# TODO: Remove once a hermetic-launcher release has
# https://github.com/hermeticbuild/hermetic-launcher/pull/87.
build:windows_vm --override_repository=hermetic_launcher++non_module_dependencies+runfiles_stub_x86_64_windows=%workspace%/.windows_vm/runfiles_stub_x86_64_windows
# The Linux platform comes first, so that actions with no constraints of their
# own keep running here. Test actions get the VM's platform, because their
# default test toolchain requires the target platform's constraints.
build:windows_vm --extra_execution_platforms=//tools/platforms:local_linux_for_windows_cross,//tools/platforms:windows_x86_64_msvc
# The VM can run only test actions. Everything else runs here, and stays out of
# the VM's cache.
build:windows_vm --spawn_strategy=worker,sandboxed,local
build:windows_vm --strategy=TestRunner=remote
build:windows_vm --modify_execution_info=^(?!TestRunner$).*=+no-remote
# Linux Bazel gives tests its own PATH. This is the VM's. Bazel reads a
# backslash here as an escape, even in quotes.
# TODO: Revisit once a Bazel release sets the default PATH from the execution
# platform: https://github.com/bazelbuild/bazel/pull/32049. Tests here also
# need Git's directory, which Bazel's Windows default lacks.
build:windows_vm --test_env='PATH=C:\\Windows\\system32;C:\\Windows;C:\\Windows\\System32\\Wbem;C:\\Windows\\System32\\WindowsPowerShell\\v1.0;C:\\Program Files\\PowerShell\\7;C:\\Program Files\\Git\\cmd'
# Linux runs these tests instead:
# - Clippy's runner is a Linux program.
# - Bazel runs a test tagged local only on this host.
# - A skylib unittest's result is decided during analysis, so it is the same on
#   every platform, but skylib picks its script for Linux here.
# TODO: Run the clippy tests here once the rules_rust that rules_rs uses
# builds their runner for the test's execution platform:
# https://github.com/bazelbuild/rules_rust/pull/4278
build:windows_vm --test_tag_filters=-clippy,-local,-skylib_unittest

# Show full command lines on failure
build --verbose_failures

# Only show output from failing tests
test --test_output=errors
test --test_summary=terse

# Limit coverage instrumentation and test selection to project code.
coverage --instrumentation_filter=^//(define|defcl|tools)[/:]
coverage --test_tag_filters=-no-coverage
# Rust tests report the coverage of each code region, which
# //tools:analyze_coverage reports, as Python tests that load Rust do.
coverage --@rules_rust//rust/coverage:collector=//tools/rust_coverage:collect_rust_coverage

# Opt into future Bazel defaults (green-field project)
# Uncomment when protobuf sets toolchain param on run_shell actions.
# https://github.com/protocolbuffers/protobuf/issues/19261
# common --incompatible_auto_exec_groups
common --incompatible_check_testonly_for_output_files
common --incompatible_config_setting_private_default_visibility
common --incompatible_default_to_explicit_init_py
common --incompatible_disable_native_android_rules
common --incompatible_disable_non_executable_java_binary
common --incompatible_disable_starlark_host_transitions
common --incompatible_disallow_sdk_frameworks_attributes
# Uncomment when protobuf stops using default provider fields.
# https://github.com/bazelbuild/bazel/issues/20183
# common --incompatible_disable_target_default_provider_fields
common --incompatible_enable_apple_toolchain_resolution
common --incompatible_enforce_starlark_utf8=error
common --incompatible_no_implicit_file_export
# Uncomment when rules_cc stops using the deprecated outputs parameter in rule().
# https://github.com/bazelbuild/rules_cc/issues/602
# common --incompatible_no_rule_outputs_param
common --incompatible_objc_alwayslink_by_default
common --incompatible_python_disallow_native_rules
common --incompatible_remote_local_fallback_for_remote_cache
common --incompatible_resolve_select_keys_eagerly
# Uncomment when rules_diff (aspect_rules_lint transitive dep) supports it.
# https://gitlab.arm.com/bazel/rules_diff/-/issues/3
# common --incompatible_stop_exporting_build_file_path
common --incompatible_stop_exporting_language_modules
common --incompatible_strip_executable_safely
common --incompatible_use_cc_configure_from_rules_cc
common --experimental_bzl_visibility
# Uncomment when ape module supports strict repo env on macOS.
# https://gitlab.arm.com/bazel/ape/-/issues/17
# common --experimental_strict_repo_env

# Set the default dependency group for aspect_rules_py package resolution.
# This is the setting that @pypi//dep_group aliases. Naming @pypi here would
# evaluate the uv extension on every command, which fails whenever
# pyproject.toml has a dependency that uv.lock does not, so even
# //:update_lock could not run to fix the lock.
build --@aspect_rules_py//uv/private/constraints/dep_group:dep_group=dev

# Use free-threaded Python 3.14t
common --@aspect_rules_py//py:python_version=3.14
build --@aspect_rules_py//py/private/interpreter:freethreaded=true

# Ruff linting via aspect_rules_lint
build --aspects=//tools/bzl:linters.bzl%ruff
build --@aspect_rules_lint//lint:fail_on_violation

# ast-grep linting
build --aspects=//tools/bzl:linters.bzl%ast_grep

# rustc links with clang++ from the hermetic LLVM toolchain, whose link flags
# include --unwindlib=none, which clang++ does not use when linking a shared
# library. Without this, rustc reports clang's unused-argument warning on every
# link. Windows MSVC links with lld-link, which rejects this clang flag.
build:linux --@rules_rust//rust/settings:extra_rustc_flag=-Clink-arg=-Qunused-arguments
build:macos --@rules_rust//rust/settings:extra_rustc_flag=-Clink-arg=-Qunused-arguments

# Builds and tests use every instruction this machine supports, including the
# vector instructions the parser's byte loops can compile to.
# TODO: Decide how to build Rust code for distribution before shipping the
# compiler: native code fails on CPUs without this machine's instructions, and
# a cache shared between machines would hand native code to other CPUs.
build --@rules_rust//rust/settings:extra_rustc_flag=-Ctarget-cpu=native
