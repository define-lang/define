# Show full command lines on failure
build --verbose_failures

# Only show output from failing tests
test --test_output=errors
test --test_summary=terse

# Limit coverage instrumentation and test selection to project code.
coverage --instrumentation_filter=^//(define|defcl|tools)[/:]
coverage --test_tag_filters=-no-coverage

# Opt into future Bazel defaults (green-field project)
# Uncomment when protobuf sets toolchain param on run_shell actions.
# https://github.com/protocolbuffers/protobuf/issues/19261
# common --incompatible_auto_exec_groups
common --incompatible_check_testonly_for_output_files
common --incompatible_config_setting_private_default_visibility
common --incompatible_default_to_explicit_init_py
common --incompatible_disable_native_android_rules
common --incompatible_disable_non_executable_java_binary
common --incompatible_disable_starlark_host_transitions
common --incompatible_disallow_sdk_frameworks_attributes
# Uncomment when protobuf stops using default provider fields.
# https://github.com/bazelbuild/bazel/issues/20183
# common --incompatible_disable_target_default_provider_fields
common --incompatible_enable_apple_toolchain_resolution
common --incompatible_enforce_starlark_utf8=error
common --incompatible_no_implicit_file_export
# Uncomment when rules_cc stops using the deprecated outputs parameter in rule().
# https://github.com/bazelbuild/rules_cc/issues/602
# common --incompatible_no_rule_outputs_param
common --incompatible_objc_alwayslink_by_default
common --incompatible_python_disallow_native_rules
common --incompatible_remote_local_fallback_for_remote_cache
common --incompatible_resolve_select_keys_eagerly
# Uncomment when rules_diff (aspect_rules_lint transitive dep) supports it.
# https://gitlab.arm.com/bazel/rules_diff/-/issues/3
# common --incompatible_stop_exporting_build_file_path
common --incompatible_stop_exporting_language_modules
common --incompatible_strip_executable_safely
common --incompatible_use_cc_configure_from_rules_cc
common --experimental_bzl_visibility
# Uncomment when ape module supports strict repo env on macOS.
# https://gitlab.arm.com/bazel/ape/-/issues/17
# common --experimental_strict_repo_env

# Set the default dependency group for aspect_rules_py package resolution.
build --@pypi//dep_group=dev

# Use free-threaded Python 3.14t
build --@aspect_rules_py//py/private/interpreter:freethreaded=true
build --@rules_python//python/config_settings:py_freethreaded=yes

# Ruff linting via aspect_rules_lint
build --aspects=//tools/bzl:linters.bzl%ruff
build --@aspect_rules_lint//lint:fail_on_violation
