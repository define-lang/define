load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:format.bzl", "format_test")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyright.bzl", "pyright_test")

# ast-grep does not load symlinked rule files, so consumers take each directory
# as a whole, which Bazel provides as a symlink to a directory of real files.
exports_files(
    ["rules"],
    visibility = ["//tools/bzl:__pkg__"],
)

py_test(
    name = "rules_test",
    size = "small",
    srcs = ["rules_test.py"],
    data = [
        "rule-tests",
        "rules",
        "//:sgconfig.yml",
        "@multitool//tools/ast-grep",
    ],
    env = {"AST_GREP": "$(rlocationpath @multitool//tools/ast-grep)"},
    deps = [
        "@pypi//pyyaml",
        "@rules_python//python/runfiles",
    ],
)

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@multitool//tools/ruff",
)

pyright_test(
    name = "pyright_test",
    deps = [
        ":rules_test",
    ],
)

check_build_file()
