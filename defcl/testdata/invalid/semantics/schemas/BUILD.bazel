load("@protobuf//bazel:proto_descriptor_set.bzl", "proto_descriptor_set")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_py//py:defs.bzl", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")

proto_library(
    name = "field_written_twice_proto",
    srcs = ["field_written_twice.proto"],
)

proto_library(
    name = "integer_enum_proto",
    srcs = ["integer_enum.proto"],
)

py_proto_library(
    name = "integer_enum_proto_py",
    visibility = ["//defcl/python:__pkg__"],
    deps = [":integer_enum_proto"],
)

proto_library(
    name = "message_values_for_scalar_fields_proto",
    srcs = ["message_values_for_scalar_fields.proto"],
)

proto_library(
    name = "multiple_errors_proto",
    srcs = ["multiple_errors.proto"],
)

proto_library(
    name = "nested_integer_enum_proto",
    srcs = ["nested_integer_enum.proto"],
)

proto_library(
    name = "nested_no_brackets_message_proto",
    srcs = ["nested_no_brackets_message.proto"],
)

proto_library(
    name = "nested_no_brackets_scalar_proto",
    srcs = ["nested_no_brackets_scalar.proto"],
)

proto_library(
    name = "no_brackets_message_proto",
    srcs = ["no_brackets_message.proto"],
)

proto_library(
    name = "no_brackets_scalar_proto",
    srcs = ["no_brackets_scalar.proto"],
)

proto_library(
    name = "no_package_proto",
    srcs = ["no_package.proto"],
)

proto_library(
    name = "non_repeated_fields_with_brackets_proto",
    srcs = ["non_repeated_fields_with_brackets.proto"],
)

proto_library(
    name = "oneofs_proto",
    srcs = ["oneofs.proto"],
)

proto_library(
    name = "out_of_range_proto",
    srcs = ["out_of_range.proto"],
)

proto_library(
    name = "repeated_integer_enum_proto",
    srcs = ["repeated_integer_enum.proto"],
)

proto_library(
    name = "scalars_for_message_fields_proto",
    srcs = ["scalars_for_message_fields.proto"],
)

py_library(
    name = "schemas",
    srcs = ["__init__.py"],
    deps = ["//defcl/testdata/invalid/semantics"],
)

# Every schema in this package, for the tests of the crates in //defcl/rust and
# of //defcl/python.
proto_descriptor_set(
    name = "schemas_descriptor_set",
    testonly = True,
    visibility = [
        "//defcl/python:__pkg__",
        "//defcl/rust:__subpackages__",
    ],
    deps = [
        ":field_written_twice_proto",
        ":integer_enum_proto",
        ":message_values_for_scalar_fields_proto",
        ":multiple_errors_proto",
        ":nested_integer_enum_proto",
        ":nested_no_brackets_message_proto",
        ":nested_no_brackets_scalar_proto",
        ":no_brackets_message_proto",
        ":no_brackets_scalar_proto",
        ":no_package_proto",
        ":non_repeated_fields_with_brackets_proto",
        ":oneofs_proto",
        ":out_of_range_proto",
        ":repeated_integer_enum_proto",
        ":scalars_for_message_fields_proto",
        ":wrong_value_kinds_proto",
    ],
)

proto_library(
    name = "wrong_value_kinds_proto",
    srcs = ["wrong_value_kinds.proto"],
)

check_build_file()
