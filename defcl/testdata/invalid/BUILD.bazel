load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:format.bzl", "format_test")

py_library(
    name = "invalid",
    srcs = ["__init__.py"],
    visibility = ["//defcl/testdata/invalid:__subpackages__"],
    deps = ["//defcl/testdata"],
)

filegroup(
    name = "invalid_files",
    srcs = glob(["**/*.defcl"]) + [
        "//defcl/testdata/invalid/semantics:semantics_files",
    ],
    visibility = ["//defcl/testdata:__pkg__"],
)

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@multitool//tools/ruff",
)

check_build_file()
