load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")

py_library(
    name = "invalid",
    srcs = ["__init__.py"],
    visibility = ["//defcl/testdata/invalid:__subpackages__"],
    deps = ["//defcl/testdata"],
)

