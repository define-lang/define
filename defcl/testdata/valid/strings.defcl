config: {
    basic: "hello"
    with_spaces: "hello world"
    with_newline: "line1\nline2"
    with_tab: "col1\tcol2"
    with_backslash: "path\\to\\file"
    with_quote: "say \"hello\""
    with_apostrophe: "it\'s fine"
    with_bell: "\a"
    with_backspace: "\b"
    with_formfeed: "\f"
    with_return: "\r"
    with_vtab: "\v"
    with_question: "\?"
    octal_escape: "\101"
    hex_escape: "\x41"
    unicode_short: "\u0041"
    unicode_long: "\U00041"
}
