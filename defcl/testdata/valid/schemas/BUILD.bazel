load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@protobuf//bazel:proto_descriptor_set.bzl", "proto_descriptor_set")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")

proto_library(
    name = "integers_proto",
    srcs = ["integers.proto"],
)

py_proto_library(
    name = "integers_proto_py",
    visibility = ["//defcl/python:__pkg__"],
    deps = [":integers_proto"],
)

proto_library(
    name = "nested_messages_proto",
    srcs = ["nested_messages.proto"],
)

py_proto_library(
    name = "nested_messages_proto_py",
    visibility = ["//defcl/python:__pkg__"],
    deps = [":nested_messages_proto"],
)

proto_library(
    name = "repeated_messages_proto",
    srcs = ["repeated_messages.proto"],
)

py_proto_library(
    name = "repeated_messages_proto_py",
    visibility = ["//defcl/python:__pkg__"],
    deps = [":repeated_messages_proto"],
)

py_library(
    name = "schemas",
    srcs = ["__init__.py"],
    visibility = ["//defcl/python:__pkg__"],
    deps = ["//defcl/testdata/valid"],
)

# Every schema in this package, for the Rust tests of //defcl/rust/semantics.
proto_descriptor_set(
    name = "schemas_descriptor_set",
    testonly = True,
    visibility = ["//defcl/rust/semantics:__pkg__"],
    deps = [
        ":integers_proto",
        ":nested_messages_proto",
        ":repeated_messages_proto",
        ":single_toplevel_proto",
        ":strings_proto",
    ],
)

proto_library(
    name = "single_toplevel_proto",
    srcs = ["single_toplevel.proto"],
)

py_proto_library(
    name = "single_toplevel_proto_py",
    visibility = ["//defcl/python:__pkg__"],
    deps = [":single_toplevel_proto"],
)

proto_library(
    name = "strings_proto",
    srcs = ["strings.proto"],
)

py_proto_library(
    name = "strings_proto_py",
    visibility = ["//defcl/python:__pkg__"],
    deps = [":strings_proto"],
)

check_build_file()
