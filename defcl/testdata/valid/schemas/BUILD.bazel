load("@protobuf//bazel:proto_descriptor_set.bzl", "proto_descriptor_set")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_py//py:defs.bzl", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")

proto_library(
    name = "enums_proto",
    srcs = ["enums.proto"],
)

proto_library(
    name = "floats_proto",
    srcs = ["floats.proto"],
)

proto_library(
    name = "imports_proto",
    srcs = ["imports.proto"],
    deps = [
        ":shared_proto",
        ":wrapper_proto",
    ],
)

py_proto_library(
    name = "imports_proto_py",
    visibility = ["//defcl/python:__pkg__"],
    deps = [":imports_proto"],
)

proto_library(
    name = "integers_proto",
    srcs = ["integers.proto"],
)

proto_library(
    name = "nested_messages_proto",
    srcs = ["nested_messages.proto"],
)

proto_library(
    name = "repeated_messages_proto",
    srcs = ["repeated_messages.proto"],
)

proto_library(
    name = "repeated_scalars_proto",
    srcs = ["repeated_scalars.proto"],
)

py_library(
    name = "schemas",
    srcs = ["__init__.py"],
    deps = ["//defcl/testdata/valid"],
)

# Every schema in this package, for the tests of the crates in //defcl/rust and
# of //defcl/python.
proto_descriptor_set(
    name = "schemas_descriptor_set",
    testonly = True,
    visibility = [
        "//defcl/python:__pkg__",
        "//defcl/rust:__subpackages__",
    ],
    deps = [
        ":enums_proto",
        ":floats_proto",
        ":integers_proto",
        ":nested_messages_proto",
        ":repeated_messages_proto",
        ":repeated_scalars_proto",
        ":single_toplevel_proto",
        ":strings_proto",
    ],
)

proto_library(
    name = "shared_proto",
    srcs = ["shared.proto"],
)

py_proto_library(
    name = "shared_proto_py",
    visibility = ["//defcl/python:__pkg__"],
    deps = [":shared_proto"],
)

proto_library(
    name = "single_toplevel_proto",
    srcs = ["single_toplevel.proto"],
)

py_proto_library(
    name = "single_toplevel_proto_py",
    visibility = ["//defcl/python:__pkg__"],
    deps = [":single_toplevel_proto"],
)

proto_library(
    name = "strings_proto",
    srcs = ["strings.proto"],
)

proto_library(
    name = "wrapper_proto",
    srcs = ["wrapper.proto"],
    deps = [":shared_proto"],
)

py_proto_library(
    name = "wrapper_proto_py",
    visibility = ["//defcl/python:__pkg__"],
    deps = [":wrapper_proto"],
)

check_build_file()
