load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")

py_library(
    name = "valid",
    srcs = ["__init__.py"],
    visibility = ["//defcl/testdata/valid:__subpackages__"],
    deps = ["//defcl/testdata"],
)

filegroup(
    name = "valid_files",
    srcs = glob(["*.defcl"]),
    visibility = ["//defcl/testdata:__pkg__"],
)

check_build_file()
