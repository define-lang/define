load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//extensions/prost:defs.bzl", "rust_prost_library")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:rust.bzl", "lint_config")

# The descriptor messages, generated from protobuf's descriptor.proto because
# the prost-types crate lacks the fields that editions add.
rust_prost_library(
    name = "descriptor_proto",
    proto = "@protobuf//:descriptor_proto",
)

rust_library(
    name = "semantics",
    srcs = [
        "error_messages_test.rs",
        "lib.rs",
        "schema.rs",
        "schema_restrictions.rs",
        "semantic_checks.rs",
        "semantic_checks_test.rs",
        "semantic_error.rs",
        "test_support.rs",
    ],
    crate_name = "defcl_semantics",
    crate_root = "lib.rs",
    lint_config = lint_config(),
    visibility = [
        "//defcl/python:__pkg__",
        "//defcl/rust:__pkg__",
    ],
    deps = [
        ":descriptor_proto",
        "//crates/source_rendering/rust:source_rendering",
        "//defcl/rust/parser",
        "@crates//:derive_more",
        "@crates//:rustc-hash",
        "@crates//:strum",
    ],
)

rust_test(
    name = "semantics_test",
    size = "small",
    # The tests read their DCL files with include_str!, and their schemas from
    # runfiles.
    compile_data = ["//defcl/testdata:testdata_files"],
    crate = ":semantics",
    data = [
        "//defcl/testdata/invalid/schemas:schemas_descriptor_set",
        "//defcl/testdata/invalid/semantics/schemas:schemas_descriptor_set",
        "//defcl/testdata/valid/schemas:schemas_descriptor_set",
    ],
    lint_config = lint_config(),
    proc_macro_deps = ["@crates//:indoc"],
    rustc_env = {
        "INVALID_SCHEMAS": "$(rlocationpath //defcl/testdata/invalid/schemas:schemas_descriptor_set)",
        "INVALID_SEMANTICS_SCHEMAS": "$(rlocationpath //defcl/testdata/invalid/semantics/schemas:schemas_descriptor_set)",
        "VALID_SCHEMAS": "$(rlocationpath //defcl/testdata/valid/schemas:schemas_descriptor_set)",
    },
    deps = [
        "@crates//:googletest",
        "@crates//:prost",
        "@rules_rust//rust/runfiles",
    ],
)

# --- Linting ---

rust_clippy_test(
    name = "clippy_test",
    size = "small",
    tags = [
        "clippy",
        "precommit",
    ],
    targets = [
        ":semantics",
        ":semantics_test",
    ],
)

check_build_file()
