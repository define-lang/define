load("@crates//:defs.bzl", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")

rust_library(
    name = "defcl",
    srcs = [
        "lib.rs",
        "parser.rs",
        "parser_test.rs",
        "scanner.rs",
        "source_location.rs",
        "syntax_error.rs",
        "syntax_tree.rs",
    ],
    crate_root = "lib.rs",
    lint_config = lint_config(),
)

rust_test(
    name = "parser_test",
    size = "small",
    # The test reads its DCL files with include_str!.
    compile_data = ["//defcl/testdata:testdata_files"],
    crate = ":defcl",
    lint_config = lint_config(),
    deps = ["@crates//:googletest"],
)

# --- Linting ---

rust_clippy_test(
    name = "clippy_test",
    size = "small",
    tags = [
        "clippy",
        "precommit",
    ],
    targets = [
        ":defcl",
        ":parser_test",
    ],
)

check_build_file()
