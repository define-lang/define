load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:rust.bzl", "lint_config")

rust_library(
    name = "validator",
    srcs = ["validator.rs"],
    crate_name = "defcl_validator",
    crate_root = "validator.rs",
    lint_config = lint_config(),
    visibility = ["//defcl/python:__pkg__"],
    deps = [
        "//defcl/rust/parser",
        "//defcl/rust/semantics",
    ],
)

rust_test(
    name = "validator_test",
    size = "small",
    # The tests read most of their DCL files with include_str!, and their
    # schemas and the files that validate_file reads from runfiles.
    compile_data = ["//defcl/testdata:testdata_files"],
    crate = ":validator",
    data = [
        "//defcl/testdata:testdata_files",
        "//defcl/testdata/invalid/semantics/schemas:schemas_descriptor_set",
        "//defcl/testdata/valid/schemas:schemas_descriptor_set",
    ],
    lint_config = lint_config(),
    rustc_env = {
        "INVALID_SEMANTICS_SCHEMAS": "$(rlocationpath //defcl/testdata/invalid/semantics/schemas:schemas_descriptor_set)",
        "VALID_SCHEMAS": "$(rlocationpath //defcl/testdata/valid/schemas:schemas_descriptor_set)",
    },
    deps = [
        "//source_rendering/rust:source_rendering",
        "@crates//:googletest",
        "@crates//:prost",
        "@rules_rust//rust/runfiles",
    ],
)

# --- Linting ---

rust_clippy_test(
    name = "clippy_test",
    size = "small",
    tags = [
        "clippy",
        "precommit",
    ],
    targets = [
        ":validator",
        ":validator_test",
    ],
)

check_build_file()
