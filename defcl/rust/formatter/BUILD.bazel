load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:rust.bzl", "binary_rustc_flags", "lint_config")

rust_binary(
    name = "defclfmt",
    srcs = ["main.rs"],
    lint_config = lint_config(),
    proc_macro_deps = ["@crates//indoc"],
    rustc_flags = binary_rustc_flags(),
    visibility = ["//tools/format:__pkg__"],
    deps = [
        ":formatter",
        "//crates/source_rendering/rust:source_rendering",
        "//defcl/rust/parser",
        "@crates//clap",
        "@crates//rayon",
    ],
)

rust_test(
    name = "defclfmt_test",
    size = "small",
    crate = ":defclfmt",
    data = [":defclfmt"],
    lint_config = lint_config(),
    proc_macro_deps = ["@crates//indoc"],
    rustc_env = {"DEFCLFMT": "$(rlocationpath :defclfmt)"},
    deps = [
        "@crates//googletest",
        "@rules_rust//rust/runfiles",
    ],
)

rust_library(
    name = "formatter",
    srcs = ["formatter.rs"],
    crate_name = "defcl_formatter",
    crate_root = "formatter.rs",
    lint_config = lint_config(),
    deps = ["//defcl/rust/parser"],
)

rust_test(
    name = "formatter_test",
    size = "small",
    # The tests read their defcl files with include_str!.
    compile_data = ["//defcl/testdata:testdata_files"],
    crate = ":formatter",
    lint_config = lint_config(),
    proc_macro_deps = ["@crates//indoc"],
    deps = [
        "//crates/source_rendering/rust:source_rendering",
        "@crates//googletest",
    ],
)

# --- Linting ---

rust_clippy_test(
    name = "clippy_test",
    size = "small",
    tags = [
        "clippy",
        "precommit",
    ],
    targets = [
        ":defclfmt",
        ":defclfmt_test",
        ":formatter",
        ":formatter_test",
    ],
)

check_build_file()
