load("@rules_py//py:defs.bzl", "py_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("//tools/bzl:build_file_checks.bzl", "check_build_file")
load("//tools/bzl:py_test.bzl", "py_test")
load("//tools/bzl:pyo3.bzl", "pyo3_extension")
load("//tools/bzl:pyright.bzl", "pyright_test")
load("//tools/bzl:rust.bzl", "lint_config")

py_library(
    name = "error_types",
    srcs = [":error_types.py"],
    visibility = [
        "//define/compiler:__pkg__",
        "//define/compiler/resource_tests:__pkg__",
    ],
)

# The generated enums, which tools:setup_local_dev copies into the source tree.
genrule(
    name = "error_types_gen",
    outs = ["error_types.py"],
    cmd = "$(execpath :generate_error_types) $@",
    tools = [":generate_error_types"],
    visibility = ["//tools:__pkg__"],
)

py_library(
    name = "errors",
    srcs = ["errors.py"],
    visibility = [
        "//define/compiler:__pkg__",
        "//define/compiler/errors:__pkg__",
        "//define/compiler/resource_tests:__pkg__",
        "//define/compiler/validator/structural/program_validator_tests:__pkg__",
    ],
    deps = [
        ":error_types",
        "//source_rendering/python:rendering",
        "@pypi//msgspec",
    ],
)

rust_binary(
    name = "generate_error_types",
    srcs = ["generate_error_types.rs"],
    lint_config = lint_config(),
    deps = [
        "//defcl/rust/parser",
        "//defcl/rust/semantics",
        "@crates//:strum",
    ],
)

py_library(
    name = "loader",
    srcs = ["loader.py"],
    visibility = ["//define/compiler:__pkg__"],
    deps = [
        ":errors",
        ":validator",
        "//source_rendering/python:rendering",
        "@pypi//msgspec",
        "@pypi//protobuf",
    ],
)

py_test(
    name = "loader_fuzz_test",
    size = "small",
    srcs = ["loader_fuzz_test.py"],
    deps = [
        ":errors",
        ":loader",
        "//defcl/testdata/valid/schemas:every_field_type_proto_py",
        "@pypi//hypothesis",
    ],
)

py_test(
    name = "loader_test",
    size = "small",
    srcs = ["loader_test.py"],
    data = ["//defcl/testdata:testdata_files"],
    deps = [
        ":error_types",
        ":errors",
        ":loader",
        "//defcl/testdata/invalid/semantics/schemas:integer_enum_proto_py",
        "//defcl/testdata/valid/schemas:imports_proto_py",
        "//defcl/testdata/valid/schemas:shared_proto_py",
        "//defcl/testdata/valid/schemas:single_toplevel_proto_py",
        "//defcl/testdata/valid/schemas:wrapper_proto_py",
        "//source_rendering/python:rendering",
        "//tools:runfiles",
    ],
)

py_library(
    name = "python",
    srcs = ["__init__.py"],
    deps = ["//defcl"],
)

py_library(
    name = "validator",
    srcs = ["validator.pyi"],
    deps = [
        ":error_types",  # keep: the native implementation looks up its kinds
        ":errors",
        ":validator_extension",  # keep: supplies the native implementation of this stub
        "//source_rendering/python:rendering",
    ],
)

pyo3_extension(
    name = "validator_extension",
    srcs = ["validator_extension.rs"],
    crate_root = "validator_extension.rs",
    module_name = "validator",
    stubs = False,
    visibility = ["//tools:__pkg__"],
    deps = [
        "//defcl/rust:validator",
        "//defcl/rust/parser",
        "//defcl/rust/semantics",
        "//source_rendering/python:capsule",
        "@crates//:prost",
    ],
)

py_test(
    name = "validator_test",
    size = "small",
    srcs = ["validator_test.py"],
    data = [
        "//defcl/testdata:testdata_files",
        "//defcl/testdata/invalid/semantics/schemas:schemas_descriptor_set",
        "//defcl/testdata/valid/schemas:schemas_descriptor_set",
    ],
    env = {
        "INVALID_SEMANTICS_SCHEMAS": "$(rlocationpath //defcl/testdata/invalid/semantics/schemas:schemas_descriptor_set)",
        "VALID_SCHEMAS": "$(rlocationpath //defcl/testdata/valid/schemas:schemas_descriptor_set)",
    },
    deps = [
        ":error_types",
        ":errors",
        ":validator",
        "//source_rendering/python:rendering",
        "//tools:runfiles",
        "@pypi//pytest",
    ],
)

# --- Linting ---

rust_clippy_test(
    name = "clippy_test",
    size = "small",
    tags = [
        "clippy",
        "precommit",
    ],
    targets = [
        ":generate_error_types",
        ":validator_extension_shared",
    ],
)

# --- Type-checking ---

pyright_test(
    name = "pyright_test",
    deps = [
        ":error_types",  # keep: generated, so the deps fixer does not analyze it
        ":errors",
        ":loader",
        ":loader_fuzz_test",
        ":loader_test",
        ":python",
        ":validator",
        ":validator_test",
    ],
)

check_build_file()
