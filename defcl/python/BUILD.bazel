load("@aspect_rules_lint//format:defs.bzl", "format_test")
load("@aspect_rules_py//py:defs.bzl", "py_library", "py_test")
load("//tools/lint:pyright.bzl", "pyright_test")

exports_files(["grammar.lark"])

py_library(
    name = "exceptions",
    srcs = ["exceptions.py"],
    visibility = [
        "//defcl/python:__subpackages__",
        "//define/compiler:__pkg__",
    ],
    deps = ["@pypi//lark"],
)

py_library(
    name = "parser",
    srcs = ["parser.py"],
    data = ["grammar.lark"],
    visibility = ["//define/compiler:__pkg__"],
    deps = [
        ":python",
        "//defcl/python/validator:semantics",
        "//defcl/python/validator:syntax",
        "@pypi//protobuf",
    ],
)

py_test(
    name = "parser_test",
    size = "small",
    srcs = ["parser_test.py"],
    data = ["//defcl/testdata:testdata_files"],
    pytest_main = True,
    deps = [
        ":parser",
        "//defcl/testdata/valid/schemas:integers_proto_py",
        "//defcl/testdata/valid/schemas:nested_messages_proto_py",
        "//defcl/testdata/valid/schemas:repeated_messages_proto_py",
        "//defcl/testdata/valid/schemas:schemas_py",
        "//defcl/testdata/valid/schemas:single_toplevel_proto_py",
        "//defcl/testdata/valid/schemas:strings_proto_py",
        "@pypi//pytest",
    ],
)

py_library(
    name = "python",
    srcs = ["__init__.py"],
    visibility = ["//defcl/python:__subpackages__"],
    deps = ["//defcl"],
)

# --- Format checking ---

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@aspect_rules_lint//format:ruff",
)

# --- Type-checking ---

# IMPORTANT: When adding a new py_library, py_binary, or py_test target to this
# package or its sub-packages, you must also add it to the deps list below.
pyright_test(
    name = "pyright_test",
    deps = [
        ":exceptions",
        ":parser",
        ":parser_test",
        ":python",
        "//defcl/python/validator",
        "//defcl/python/validator:semantics",
        "//defcl/python/validator:semantics_test",
        "//defcl/python/validator:syntax",
        "//defcl/python/validator:syntax_test",
    ],
)
