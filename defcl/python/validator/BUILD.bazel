load("@aspect_rules_lint//format:defs.bzl", "format_test")
load("@aspect_rules_py//py:defs.bzl", "py_library", "py_test")

py_library(
    name = "validator",
    srcs = ["__init__.py"],
    visibility = ["//defcl:__subpackages__"],
    deps = ["//defcl/python"],
)

py_library(
    name = "syntax",
    srcs = ["syntax.py"],
    data = ["//defcl/python:grammar.lark"],
    visibility = ["//visibility:public"],
    deps = [
        ":validator",
        "@pypi//lark",
    ],
)

format_test(
    name = "format_test",
    srcs = glob(["*.py"]),
    python = "@aspect_rules_lint//format:ruff",
)

py_test(
    name = "syntax_test",
    size = "small",
    srcs = ["syntax_test.py"],
    data = ["//defcl/testdata:testdata_files"],
    pytest_main = True,
    visibility = ["//defcl/python:__pkg__"],
    deps = [
        ":syntax",
        "@pypi//lark",
        "@pypi//pytest",
    ],
)
