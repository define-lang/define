load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "boolean",
    srcs = ["boolean.proto"],
)

py_library(
    name = "core_py",
    srcs = ["__init__.py"],
    deps = ["//defcl/schema"],
)

go_proto_library(
    name = "boolean_go_proto",
    importpath = "defcl/schema/core",
    proto = ":boolean",
)

go_library(
    name = "core",
    embed = [":boolean_go_proto"],
    importpath = "defcl/schema/core",
)
